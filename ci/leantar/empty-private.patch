From e6ea16e5d4365916f8f68ff03ee975b0e4b1add5 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sat, 31 Oct 2026 22:21:30 +0000
Subject: [PATCH] leantar: --empty-private writes each .olean.private as an
 empty placeholder

For a build that never reads private module data (one that imports modules only
as modules, loading their .olean and .olean.server), `-x --empty-private` writes
each module's .olean.private as an empty file, which is all Lake checks for, and
stops decoding the module's LGZ stream before it (its last part), saving most of
the unpacking's writing and some of its decoding. `ltar::unpack_with` takes it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015ajQWvKgPN6kBJ7wB52NGj
---
 src/ltar.rs             | 25 ++++++++++++++++++++++++-
 src/tar.rs              | 10 +++++++++-
 tests/ltar_roundtrip.rs | 13 +++++++++++++
 3 files changed, 46 insertions(+), 2 deletions(-)

diff --git a/src/ltar.rs b/src/ltar.rs
index d22c359..a202cda 100644
--- a/src/ltar.rs
+++ b/src/ltar.rs
@@ -501,7 +501,17 @@ fn get_version<R: BufRead>(tarfile: &mut R) -> Result<LtarVersion, UnpackError>
 }
 
 pub fn unpack<R: BufRead + Seek>(
+  basedir: &[PathBuf], tarfile: R, force: bool, trace_override: Option<u64>, verbose: bool,
+) -> Result<u64, UnpackError> {
+  unpack_with(basedir, tarfile, force, trace_override, verbose, false)
+}
+
+/// `unpack`, but with `empty_private`, a module's `.olean.private` is written as an
+/// empty file, without decoding it: a placeholder for a build that never reads it
+/// (Lake only checks that it exists), which saves most of the writing.
+pub fn unpack_with<R: BufRead + Seek>(
   basedir: &[PathBuf], mut tarfile: R, force: bool, trace_override: Option<u64>, verbose: bool,
+  empty_private: bool,
 ) -> Result<u64, UnpackError> {
   let version = get_version(&mut tarfile)?;
   let mut buf = vec![];
@@ -608,6 +618,7 @@ pub fn unpack<R: BufRead + Seek>(
         extra,
         &mut buf,
         &mut uncommitted,
+        empty_private,
       )?
     }
   }
@@ -629,6 +640,7 @@ pub fn unpack<R: BufRead + Seek>(
           extra,
           &mut buf,
           &mut uncommitted,
+          empty_private,
         )?;
       }
     } else if read_cstr(&mut buf, &mut tarfile)? {
@@ -654,7 +666,7 @@ pub fn unpack<R: BufRead + Seek>(
 fn unpack_one<R: BufRead>(
   _version: LtarVersion, tarfile: &mut R, trace_override: Option<u64>, verbose: bool,
   path: PathBuf, compression: u8, extra: Vec<PathBuf>, buf: &mut Vec<u8>,
-  uncommitted: &mut Vec<StagedFile>,
+  uncommitted: &mut Vec<StagedFile>, empty_private: bool,
 ) -> Result<(), UnpackError> {
   if verbose {
     println!("copying {}, compression = {compression}", path.display());
@@ -677,6 +689,14 @@ fn unpack_one<R: BufRead>(
       uncommitted.push(file.stage());
     }
     COMPRESSION_LGZ | COMPRESSION_LGZ_MODULE => {
+      // The parts are the `.olean`, then (a module's) `.olean.server` and `.olean.private`,
+      // decoded in that order: to leave the last out, decode one fewer.
+      let mut extra = extra;
+      let placeholder = if empty_private && compression == COMPRESSION_LGZ_MODULE {
+        extra.pop()
+      } else {
+        None
+      };
       let (out, ranges) = with_payload(tarfile, buf, |data| {
         #[cfg(feature = "zstd")]
         return with_decoders(|d| {
@@ -694,6 +714,9 @@ fn unpack_one<R: BufRead>(
         file.write_all(&out[r])?;
         uncommitted.push(file.stage());
       }
+      if let Some(path) = placeholder {
+        uncommitted.push(TempFile::new(path)?.stage());
+      }
     }
     COMPRESSION_HASH_PLAIN => {
       let mut file = TempFile::new(path)?;
diff --git a/src/tar.rs b/src/tar.rs
index f3e8b4a..5383483 100644
--- a/src/tar.rs
+++ b/src/tar.rs
@@ -98,6 +98,9 @@ fn main() {
       \n\
       \ndecompress opts:\
       \n  -f          Always unpack even if a matching trace file exists\
+      \n  --empty-private\
+      \n              Write each module's .olean.private as an empty file, without\
+      \n              decoding it (for a build that never reads it)\
       \n  -j          Read the '-' stdin input as JSON (default: one filename per line)\
       \n  -r, --delete-corrupted\
       \n              Delete input FILE.ltar files if they fail parsing\
@@ -114,6 +117,7 @@ fn main() {
   let mut do_show_comments = false;
   let mut verbose = false;
   let mut force = false;
+  let mut empty_private = false;
   let mut from_stdin = false;
   let mut json_stdin = false;
   let mut delete_corrupted = false;
@@ -143,6 +147,10 @@ fn main() {
         force = true;
         args.next();
       }
+      "--empty-private" => {
+        empty_private = true;
+        args.next();
+      }
       "-j" => {
         json_stdin = true;
         args.next();
@@ -332,7 +340,7 @@ fn main() {
         }
         e => io::Cursor::new(e.unwrap()),
       };
-      if let Err(e) = ltar::unpack(&basedirs, tarfile, force, hash, verbose) {
+      if let Err(e) = ltar::unpack_with(&basedirs, tarfile, force, hash, verbose, empty_private) {
         if matches!(&e, UnpackError::IOError(e)
           if matches!(e.kind(), io::ErrorKind::UnexpectedEof))
         {
diff --git a/tests/ltar_roundtrip.rs b/tests/ltar_roundtrip.rs
index b616b67..3b16c54 100644
--- a/tests/ltar_roundtrip.rs
+++ b/tests/ltar_roundtrip.rs
@@ -90,3 +90,16 @@ fn test_ltar_truncated() {
     }
   }
 }
+
+#[test]
+fn test_ltar_empty_private() {
+  let src = build_dir();
+  let archive = pack(src.path(), true);
+  let dir = tempfile::tempdir().unwrap();
+  let base = [PathBuf::from(dir.path())];
+  ltar::unpack_with(&base, Cursor::new(&archive[..]), true, None, false, true).ok().unwrap();
+  for f in ["Attr.olean", "Attr.olean.server", "Attr.ilean"] {
+    assert!(fs::read(src.path().join(f)).unwrap() == fs::read(dir.path().join(f)).unwrap(), "{f}");
+  }
+  assert!(fs::read(dir.path().join("Attr.olean.private")).unwrap().is_empty());
+}

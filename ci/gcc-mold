#!/bin/sh
# Cargo's linker for riscv64 in its runner image (ci/runner.Dockerfile): gcc,
# linking with mold rather than GNU ld. Linking the test binaries is a
# sizeable share of their build on RISE's riscv64 runners, and mold does it
# several times faster. A wrapper because the jobs set RUSTFLAGS, which
# overrides any target rustflags that could pass -fuse-ld=mold instead.
exec gcc -fuse-ld=mold "$@"

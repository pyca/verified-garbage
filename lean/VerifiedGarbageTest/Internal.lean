module

import VerifiedGarbage.TCB.Rust
meta import VerifiedGarbage.TCB.Rust
import VerifiedGarbage.Artifacts.Rc2.AArch64
meta import VerifiedGarbage.Artifacts.Rc2.AArch64

/-!
# Internal functions (`Rust.Internal`)

RC2's AArch64 artifacts without RC2-CBC's and the block function's: the
streaming functions call `vg_rc2_cbc_encrypt`, which calls
`vg_rc2_encrypt_block`, neither of them an artifact any more. The emitter
emits each as an internal function, from the code the calls run: a file of
its own, `internal/<name>.rs`, its text in `assembly/internal/<name>.s`,
the module `internal` declaring them, private to the crate, and the callers
naming them there.
-/

namespace VG.Test.Internal
open VG

def internal : List String := ["vg_rc2_cbc_encrypt", "vg_rc2_encrypt_block"]

def arts : List Artifact := Artifacts.Rc2.AArch64.artifacts.filter (!internal.contains ·.name)

def out : List (String × String) := match Rust.files arts with
  | .ok fs => fs
  | .error e => [("error", e)]

def file (n : String) : String := ((out.find? (·.1 == s!"verified-garbage-asm-aarch64/{n}")).map (·.2)).getD ""

def has (text part : String) : Bool := (text.splitOn part).length > 1

#guard out.map (·.1) == [
  "verified-garbage-asm-aarch64/src/lib.rs", "verified-garbage-asm-aarch64/src/internal/mod.rs",
  "verified-garbage-asm-aarch64/src/internal/vg_rc2_cbc_encrypt.rs",
  "verified-garbage-asm-aarch64/assembly/internal/vg_rc2_cbc_encrypt.s",
  "verified-garbage-asm-aarch64/src/internal/vg_rc2_encrypt_block.rs",
  "verified-garbage-asm-aarch64/assembly/internal/vg_rc2_encrypt_block.s",
  "verified-garbage-asm-aarch64/src/rc2.rs", "verified-garbage-asm-aarch64/assembly/rc2.s"]

-- The module of the internal functions, private to the crate.
#guard has (file "src/lib.rs") "#[rustfmt::skip]\nmod internal;\n"
#guard file "src/internal/mod.rs" ==
  "// @generated by lean/Emit.lean. DO NOT EDIT.\n\
  //! The internal functions of the verified functions for `aarch64` (`VG.Rust.Internal`).\n\
  #![allow(dead_code)]\n\
  \n\
  #[rustfmt::skip]\n\
  pub(crate) mod vg_rc2_cbc_encrypt;\n\
  \n\
  #[rustfmt::skip]\n\
  pub(crate) mod vg_rc2_encrypt_block;\n"

-- Callers name them in their modules, from the crate's modules and from
-- another internal function's.
#guard has (file "src/rc2.rs")
  "vg_rc2_cbc_encrypt = sym super::internal::vg_rc2_cbc_encrypt::vg_rc2_cbc_encrypt,\n"
#guard has (file "src/internal/vg_rc2_cbc_encrypt.rs")
  "vg_rc2_encrypt_block = sym crate::internal::vg_rc2_encrypt_block::vg_rc2_encrypt_block,\n"
#guard has (file "src/internal/vg_rc2_encrypt_block.rs")
  "#[unsafe(naked)]\npub(crate) unsafe extern \"C\" fn vg_rc2_encrypt_block() {\n"
#guard !has (file "src/rc2.rs") "fn vg_rc2_encrypt_block"

/-- `vg_rc2_encrypt_block`'s artifact, which the others call. -/
def block : Option Artifact := Artifacts.Rc2.AArch64.artifacts.find? (·.name == "vg_rc2_encrypt_block")

-- The internal function's code is the artifact's, and so is its text.
#guard match block with
  | some b => has (file "src/internal/vg_rc2_encrypt_block.rs")
      (Rust.asmOf b.target (Rust.bodyOf b (b.target.printer.function b.code)) (fun _ => "") "crate")
  | none => false
#guard match block with
  | some b => has (file "assembly/internal/vg_rc2_encrypt_block.s")
      (Rust.moduleAssembly.functionAssembly b.target b.name
        (Rust.bodyOf b (b.target.printer.function b.code)))
  | none => false

-- With every artifact, there is none.
#guard match Rust.files Artifacts.Rc2.AArch64.artifacts with
  | .ok fs => fs.all fun (n, t) => !has n "internal" && !has t "internal"
  | .error _ => false

-- An internal function's name is a Rust function's.
#guard Rust.internalName "vg_rc2_encrypt_block" && Rust.internalName "vg_x25519_2"
#guard ["", "vg_", "rc2_encrypt", "vg_Rc2", "vg_a-b", "vg_a()", "vg_a b", "vg_é"].all
  (!Rust.internalName ·)

end VG.Test.Internal

/-!
# Tests for the emitter's driver

`Emit.driver` writes the program that emits every artifact: these tests pin
down which modules it imports and how it lists their artifacts, and run it on
registrations of a target that is not the one `TCB/` defines (#6330), or of an
`Api` that is not one `Spec/` does.
-/

-- `#guard_msgs` compares every message of its command, which would include
-- the lakefile's profile of it (`ci/lean_profile.py`).
set_option profiler false

namespace VG.Test.Emit

open VG.Emit

-- Each registration module's list, with its name, of the target its directory names.
#guard (driver ["VerifiedGarbage.Artifacts.Sha3.X86_64", "VerifiedGarbage.Artifacts.Sha3.AArch64"]).toOption ==
  some "-- Generated by Emit.lean, which runs it. DO NOT EDIT.\n\
  module\n\
  \n\
  public import VerifiedGarbage.TCB.Audit\n\
  public meta import VerifiedGarbage.TCB.Audit\n\
  public import VerifiedGarbage.TCB.Axioms\n\
  public meta import VerifiedGarbage.TCB.Axioms\n\
  public import VerifiedGarbage.TCB.Emit\n\
  public meta import VerifiedGarbage.TCB.Emit\n\
  public import VerifiedGarbage.TCB.X86_64.Print\n\
  public meta import VerifiedGarbage.TCB.X86_64.Print\n\
  public import VerifiedGarbage.TCB.AArch64.Print\n\
  public meta import VerifiedGarbage.TCB.AArch64.Print\n\
  public import VerifiedGarbage.Artifacts.Sha3.X86_64\n\
  public meta import VerifiedGarbage.Artifacts.Sha3.X86_64\n\
  public import VerifiedGarbage.Artifacts.Sha3.AArch64\n\
  public meta import VerifiedGarbage.Artifacts.Sha3.AArch64\n\
  \n\
  public section\n\
  \n\
  namespace VG.Emit\n\
  \n\
  def all : List (String × List _root_.VG.EmitArtifact) := [\n  \
    (\"VerifiedGarbage.Artifacts.Sha3.X86_64\", \
    _root_.VG.EmitArtifact.ofList _root_.VG.X86_64.target _root_.VG.X86_64.emitter\n    \
    _root_.VG.Artifacts.Sha3.X86_64.artifacts),\n  \
    (\"VerifiedGarbage.Artifacts.Sha3.AArch64\", \
    _root_.VG.EmitArtifact.ofList _root_.VG.AArch64.target _root_.VG.AArch64.emitter\n    \
    _root_.VG.Artifacts.Sha3.AArch64.artifacts)]\n\
  \n\
  #assert_standard_axioms all\n\
  #assert_no_compiler_overrides all run\n\
  #assert_spec_origin\n\
  #assert_spec_apis (all.map fun p => p.2.map fun a => a.api)\n\
  \n\
  end VG.Emit\n\
  \n\
  def main (args : List String) : IO UInt32 :=\n  \
    VG.Emit.run VG.Emit.all args\n\
  \n\
  end\n"
#guard (driver []).toOption.any fun d =>
  (d.splitOn "def all : List (String × List _root_.VG.EmitArtifact) := []\n").length == 2
#guard (driver ["VerifiedGarbage.Artifacts.Sha3"]).toOption.isNone

-- The target directory of a registration module.
#guard targetDirOf "VerifiedGarbage.Artifacts.Sha3.X86_64" == some "X86_64"
#guard targetDirOf "VerifiedGarbage.Artifacts.Sha3" == none
#guard targetDirOf "VerifiedGarbage.Proof.Variants.Sha256Compress.X86_64" == none

-- The modules of each target directory, in order of its name.
#guard (parts ["VerifiedGarbage.Artifacts.Sha3.X86_64", "VerifiedGarbage.Artifacts.Sha3.AArch64",
    "VerifiedGarbage.Artifacts.Sha256.X86_64"]).toOption ==
  some [("AArch64", ["VerifiedGarbage.Artifacts.Sha3.AArch64"]),
       ("X86_64", ["VerifiedGarbage.Artifacts.Sha3.X86_64", "VerifiedGarbage.Artifacts.Sha256.X86_64"])]
#guard (parts ["VerifiedGarbage.Artifacts.Sha3"]).toOption.isNone

/-- `parseArgs`, with the directory as a string. -/
def args (as : List String) : Option (Bool × Option String × String) :=
  (parseArgs as).map fun (c, p, d) => (c, p, d.toString)

#guard args [] == some (false, none, "../crates")
#guard args ["--check", "--part", "f", "d"] == some (true, some "f", "d")
#guard args ["--part", "f"] == some (false, some "f", "../crates")
#guard args ["a", "b"] == none

-- A target whose artifacts two parts emitted.
#guard inTwoParts [[("x86_64", "c")], [("aarch64", "c")]] == none
#guard inTwoParts [[("x86_64", "c")], [("aarch64", "c"), ("x86_64", "c")]] == some "x86_64"

end VG.Test.Emit

/-! ## Artifacts of another target, another printer, and another contract

The commands of the driver (`driverBody`), run on registrations of this module
that each declare what a module a registration imports could: a target of
their own, an emitter, or an `Api`. -/

-- Public, as the driver's commands are.
public section

namespace VG.Artifacts.TestAbi.AArch64
open VG.AArch64

/-- AArch64's calling convention, but for a result in `x0 + x1`. -/
@[expose] def abi : Abi isa := { VG.AArch64.abi with ret := fun s => s.gpr .x0 + s.gpr .x1 }

/-- AArch64 with that calling convention, and no account of secret residue. A
registration file in this namespace would mean it by `target`, even with
`VG.AArch64` open. -/
@[expose, reducible] def target : Target :=
  { VG.AArch64.target with abi := abi, noResidue := some fun _ _ _ => True }

/-- No code: it leaves its arguments in `x0` and `x1`. -/
@[expose] def code : Prog isa := .block []

/-- What it does, on registers. -/
def contract : Contract isa where
  pre _ := True
  post s s' := s'.gpr .x0 + s'.gpr .x1 = Spec.Selftest.add (s.gpr .x0) (s.gpr .x1) ∧ s'.mem = s.mem
  pub _ _ := True

/-- A state satisfying the precondition. -/
def sat : State where
  gpr _ := 0
  sp := 0
  mem _ := 0
  rd := []
  wr := []

/-- On this target, it meets the contract of `vg_selftest_add`, which on AArch64
it does not: a caller finds its first argument in `x0`. -/
theorem verified : VerifiedScrubbed target code (Spec.Selftest.addContract abi) 64 where
  verified := Verified.of_correct (T := target) (k := contract)
    (fun s _ => ⟨[], s, .block rfl, ⟨fun _ _ => rfl, rfl, fun _ _ => rfl⟩, rfl, rfl⟩)
    (ConstantTime.of_silent fun _ _ _ _ e => by cases e with | block e => cases e; rfl)
    (by sig_implies [Spec.Selftest.addContract, Spec.Selftest.addSig, contract, abi, VG.AArch64.abi,
      argRegs] [sat] using sat)
  noResidue := trivial
  retAbi ty _ h := by cases ty <;> cases h

/-- Its registration, whose proofs the kernel accepts. -/
def artifacts : List (Artifact target) :=
  [Spec.Selftest.addApi.artifact target { code := code, verified := verified }]

end VG.Artifacts.TestAbi.AArch64

/-- AArch64's emitter, but for a printer that prints one instruction as another: on it,
`vg_ct_eq` would return 1 for any buffers of one length. -/
def VG.Test.Emit.swapped : Emitter VG.AArch64.isa :=
  { VG.AArch64.emitter with
    printer := { VG.AArch64.printer with
      instr := fun
        | .lsr .x .x0 .x4 63 => [.text "mov w0, #1"]
        | i => VG.AArch64.printer.instr i } }

-- The names the driver would find before `VG.AArch64.emitter` and `VG.AArch64.target`, in
-- the namespace it declares `all` in, if it did not name them from the root.
def VG.Emit.VG.AArch64.emitter : Emitter VG.AArch64.isa := VG.Test.Emit.swapped
def VG.Emit.AArch64.emitter : Emitter VG.AArch64.isa := VG.Test.Emit.swapped
def VG.Emit.VG.AArch64.target : Target := VG.Artifacts.TestAbi.AArch64.target

/-- `vg_ct_eq`, with that printer. -/
def VG.Artifacts.TestPrinter.AArch64.artifacts : List EmitArtifact :=
  EmitArtifact.ofList VG.AArch64.target VG.Test.Emit.swapped VG.Artifacts.Ct.AArch64.artifacts

namespace VG.Artifacts.TestApi.AArch64
open VG.AArch64

/-- A contract that says nothing of the result. -/
@[expose] def weakContract {M : ISA} (A : Abi M) : Contract M :=
  VG.Spec.Selftest.addSig.contract A (post := fun _ _ m m' _ => m' = m)

/-- `vg_selftest_add`, but for that contract. A registration file in this
namespace would mean it by `Spec.Selftest.addApi`. -/
@[expose] def Spec.Selftest.addApi : Api :=
  { VG.Spec.Selftest.addApi with contracts := some fun A _ => weakContract A }

/-- No code, which returns the first argument. -/
@[expose] def code : Prog isa := .block []

def contract : Contract isa where
  pre _ := True
  post s s' := s'.mem = s.mem
  pub _ _ := True

/-- It meets that contract, on the target `TCB/` defines. -/
theorem verified :
    VerifiedScrubbed VG.AArch64.target code (weakContract VG.AArch64.abi) 64 where
  verified := Verified.of_correct (T := VG.AArch64.target) (k := contract)
    (fun s _ => ⟨[], s, .block rfl, ⟨fun _ _ => rfl, rfl, fun _ _ => rfl⟩, rfl⟩)
    (ConstantTime.of_silent fun _ _ _ _ e => by cases e with | block e => cases e; rfl)
    (by sig_implies [weakContract, VG.Spec.Selftest.addSig, contract, VG.AArch64.abi, argRegs]
      [VG.Artifacts.TestAbi.AArch64.sat] using VG.Artifacts.TestAbi.AArch64.sat)
  noResidue := RTaint.noResidue_of_check ⟨_, by taint_decide⟩ _
  retAbi ty _ h := by cases ty <;> cases h

/-- Its registration, whose proofs the kernel accepts. -/
def artifacts : List (Artifact VG.AArch64.target) :=
  [Spec.Selftest.addApi.artifact VG.AArch64.target { code := code, verified := verified }]

end VG.Artifacts.TestApi.AArch64

namespace VG.Test.Emit

open Lean Elab Command

/-- The errors that the commands `src` give in this module so far, in no namespace,
which they leave as it is. -/
meta def errorsOf (src : String) : CommandElabM (List String) := do
  let saved ← get
  try
    let opts := saved.scopes.head!.opts
    modify fun s => { s with messages := {}, scopes := [{ header := "", opts }] }
    let ctx := Parser.mkInputContext src "<driver>"
    let mut pstate : Parser.ModuleParserState := {}
    let mut done := false
    while !done do
      let scope := (← get).scopes.head!
      let pmctx : Parser.ParserModuleContext := {
        env := ← getEnv, options := scope.opts, currNamespace := scope.currNamespace,
        openDecls := scope.openDecls }
      let (stx, pstate', msgs) := Parser.parseCommand ctx pmctx pstate (← get).messages
      pstate := pstate'
      modify fun s => { s with messages := msgs }
      if Parser.isTerminalCommand stx then done := true else elabCommand stx
    let errors := (← get).messages.toList.filter (·.severity matches .error)
    errors.mapM fun m => m.data.toString
  finally
    set saved

/-- The errors of the driver of the registration module `mod`, then of the commands `after`. -/
meta def driverErrors (mod : String) (after : String := "") : CommandElabM (List String) := do
  errorsOf ((← IO.ofExcept (Emit.driverBody [mod])) ++ after)

meta def fails (errors : List String) (part : String) : CommandElabM Unit :=
  unless errors.head?.any fun e => (e.splitOn part).length > 1 do
    throwError "not the error expected, {part}:{errors}"

-- Every error of a command is among its messages once it is elaborated.
set_option Elab.async false

-- The registration of `vg_ct_eq` passes the driver, whose artifacts are AArch64's,
-- printed by its printer.
run_cmd do
  let errors ← driverErrors "VerifiedGarbage.Artifacts.Ct.AArch64" "\n\
    #guard (VG.Emit.all.flatMap fun (_, as) => as.map (VG.Rust.function · fun _ => \"\")) ==\n  \
      VG.Artifacts.Ct.AArch64.artifacts.map fun a =>\n    \
        VG.Rust.function (VG.EmitArtifact.of VG.AArch64.emitter a) fun _ => \"\"\n\
    example : VG.Emit.all.map (fun (_, as) => as.map fun a => a.target) =\n  \
      [[VG.EmitTarget.of VG.AArch64.target VG.AArch64.emitter]] := rfl\n"
  unless errors.isEmpty do throwError "{errors}"

-- The check above tells the printers apart.
#guard Artifacts.TestPrinter.AArch64.artifacts.map (Rust.function · fun _ => "") !=
  Artifacts.Ct.AArch64.artifacts.map fun a => Rust.function (.of AArch64.emitter a) fun _ => ""

-- An altered calling convention fails it, whatever the registration proves on it.
run_cmd do
  fails (← driverErrors "VerifiedGarbage.Artifacts.TestAbi.AArch64") "type mismatch"

-- So does a registration that chooses its printer.
run_cmd do
  fails (← driverErrors "VerifiedGarbage.Artifacts.TestPrinter.AArch64") "type mismatch"

-- So does an `Api` that is not `Spec/`'s, whatever name the registration has for it.
run_cmd do
  fails (← driverErrors "VerifiedGarbage.Artifacts.TestApi.AArch64")
    "these artifacts' `Api`s are not ones `Spec/` declares"

/-! ## What an `Api` of `Spec/` is (`#assert_spec_apis`) -/

/-- A hash function's instance that is not `Spec/`'s. -/
def fakeInstance : VG.Spec.Hmac.Instance := { VG.Spec.Hmac.sha256I with rust := "sha512" }

/-- A value that a proof builds artifacts with. -/
structure Variant where
  I : VG.Spec.Hmac.Instance

def variants : List Variant := [⟨VG.Spec.Hmac.sha256I⟩, ⟨VG.Spec.Hmac.sha512I⟩]

-- Constants of `Spec/`, and functions of `Spec/` of one, however they are reached.
/-- info: the `Api`s of the 4 artifacts are ones `Spec/` declares -/
#guard_msgs in
#assert_spec_apis [[VG.Spec.Selftest.addApi, VG.Spec.Hmac.sha256I.pbkdf2Api], [],
  variants.map fun v => v.I.pbkdf2Api]

-- A function of `Spec/` of something that is not `Spec/`'s.
run_cmd do
  fails (← errorsOf "#assert_spec_apis [[VG.Spec.Selftest.addApi], [VG.Test.Emit.fakeInstance.pbkdf2Api]]")
    "not ones `Spec/` declares"

-- A function of `Spec/` given a name: that of another parameter set.
run_cmd do
  fails (← errorsOf "#assert_spec_apis [[VG.Spec.MlDsa.keyGenApi VG.Spec.MlDsa.mlDsa44 \"mldsa87\" \"ML-DSA-87\"]]")
    "not ones `Spec/` declares"
#guard_msgs (drop info) in
#assert_spec_apis [[VG.Spec.MlDsa.keyGen44Api]]

end VG.Test.Emit


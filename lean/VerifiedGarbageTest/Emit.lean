module

import VerifiedGarbage.TCB.Emit
meta import VerifiedGarbage.TCB.Emit

/-!
# Golden tests for the emitter's driver

`Emit.driver` writes the program that emits every artifact: these tests pin
down which modules it imports and how it lists their artifacts.
-/

namespace VG.Test.Emit

open VG.Emit

-- Instances of a caller of several interfaces: one qualified part per
-- interface whose variant has a suffix; the baseline instance keeps the name.
#guard qualifiedName "vg_argon2" [("blake2b", ""), ("g", "")] == "vg_argon2"
#guard qualifiedName "vg_argon2" [("blake2b", ""), ("g", "_avx512")] ==
  "vg_argon2_g_avx512"
#guard qualifiedName "vg_argon2" [("blake2b", "_avx2"), ("g", "_avx512")] ==
  "vg_argon2_blake2b_avx2_g_avx512"
-- The same suffix in different interfaces gives different names.
#guard qualifiedName "vg_argon2" [("blake2b", "_avx2"), ("g", "")] ==
  "vg_argon2_blake2b_avx2"
#guard qualifiedName "vg_argon2" [("blake2b", ""), ("g", "_avx2")] ==
  "vg_argon2_g_avx2"
#guard qualifiedName "vg_argon2" [("blake2b", "_avx2"), ("g", "_avx2")] ==
  "vg_argon2_blake2b_avx2_g_avx2"

-- Each registration module's list, with its name.
#guard driver ["VerifiedGarbage.Artifacts.Sha3.X86_64", "VerifiedGarbage.Artifacts.Sha3.AArch64"] ==
  "-- Generated by Emit.lean, which runs it. DO NOT EDIT.\n\
  module\n\
  \n\
  public import VerifiedGarbage.TCB.Audit\n\
  public meta import VerifiedGarbage.TCB.Audit\n\
  public import VerifiedGarbage.TCB.Axioms\n\
  public meta import VerifiedGarbage.TCB.Axioms\n\
  public import VerifiedGarbage.TCB.Emit\n\
  public meta import VerifiedGarbage.TCB.Emit\n\
  public import VerifiedGarbage.Artifacts.Sha3.X86_64\n\
  public meta import VerifiedGarbage.Artifacts.Sha3.X86_64\n\
  public import VerifiedGarbage.Artifacts.Sha3.AArch64\n\
  public meta import VerifiedGarbage.Artifacts.Sha3.AArch64\n\
  \n\
  public section\n\
  \n\
  namespace VG.Emit\n\
  \n\
  def all : List (String × List Artifact) := [\n  \
    (\"VerifiedGarbage.Artifacts.Sha3.X86_64\", VG.Artifacts.Sha3.X86_64.artifacts),\n  \
    (\"VerifiedGarbage.Artifacts.Sha3.AArch64\", VG.Artifacts.Sha3.AArch64.artifacts)]\n\
  \n\
  #assert_standard_axioms all\n\
  #assert_no_compiler_overrides all run\n\
  #assert_spec_origin\n\
  \n\
  end VG.Emit\n\
  \n\
  def main (args : List String) : IO UInt32 :=\n  \
    VG.Emit.run VG.Emit.all args\n\
  \n\
  end\n"
#guard ((driver []).splitOn "def all : List (String × List Artifact) := []\n").length == 2

-- The target directory of a registration module.
#guard targetDirOf "VerifiedGarbage.Artifacts.Sha3.X86_64" == some "X86_64"
#guard targetDirOf "VerifiedGarbage.Artifacts.Sha3" == none
#guard targetDirOf "VerifiedGarbage.Proof.Variants.Sha256Compress.X86_64" == none

-- The modules of each target directory, in order of its name.
#guard (parts ["VerifiedGarbage.Artifacts.Sha3.X86_64", "VerifiedGarbage.Artifacts.Sha3.AArch64",
    "VerifiedGarbage.Artifacts.Sha256.X86_64"]).toOption ==
  some [("AArch64", ["VerifiedGarbage.Artifacts.Sha3.AArch64"]),
       ("X86_64", ["VerifiedGarbage.Artifacts.Sha3.X86_64", "VerifiedGarbage.Artifacts.Sha256.X86_64"])]
#guard (parts ["VerifiedGarbage.Artifacts.Sha3"]).toOption.isNone

/-- `parseArgs`, with the directory as a string. -/
def args (as : List String) : Option (Bool × Option String × String) :=
  (parseArgs as).map fun (c, p, d) => (c, p, d.toString)

#guard args [] == some (false, none, "../crates")
#guard args ["--check", "--part", "f", "d"] == some (true, some "f", "d")
#guard args ["--part", "f"] == some (false, some "f", "../crates")
#guard args ["a", "b"] == none

-- A target whose artifacts two parts emitted.
#guard inTwoParts [[("x86_64", "c")], [("aarch64", "c")]] == none
#guard inTwoParts [[("x86_64", "c")], [("aarch64", "c"), ("x86_64", "c")]] == some "x86_64"

end VG.Test.Emit

/-- The words of the static: each entry's four field elements. -/
def baseBytesWords : List (BitVec 64) :=
  baseBytesAffine.flatMap fun q =>
    feWords (baseByteCached q).X ++ feWords (baseByteCached q).Y ++ feWords (baseByteCached q).Z ++
      feWords (baseByteCached q).T

/-- The static verification reads. -/
def baseBytesConsts : List (String × List (BitVec 64)) := [(baseBytesSym, baseBytesWords)]


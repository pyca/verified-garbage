/-- `[Y - X, Y + X, 2dT, 2Z]` of the negation `(-x, y, 1, -xy)` of the affine point `(x, y)`. -/
def baseOddCached (q : Spec.X25519.Fe × Spec.X25519.Fe) : Spec.Ed25519.Point :=
  ⟨q.2 - (0 - q.1), q.2 + (0 - q.1), (0 - q.1 * q.2) * 2 * Spec.Ed25519.d, 1 * 2⟩

/-- The static holding the entries. -/
def baseOddSym : String := "VG_ED25519_VERIFY_BASE"

/-- The bytes of the static: 128 entries of 128 bytes. -/
def baseOddBytes : Nat := 16384

/-- The words of the static: each entry's four field elements. -/
def baseOddWords : List (BitVec 64) :=
  baseOddAffine.flatMap fun q =>
    feWords (baseOddCached q).X ++ feWords (baseOddCached q).Y ++ feWords (baseOddCached q).Z ++
      feWords (baseOddCached q).T

/-- The static verification reads. -/
def baseOddConsts : List (String × List (BitVec 64)) := [(baseOddSym, baseOddWords)]

end VG.Impl.Ed25519.X86_64

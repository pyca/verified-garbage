/-- Allocated fixed-modulus matrix update. Its emitted words are checked by a proof certificate. -/
def update : List Instr := EcdhAllocatedCode.update

def batch : Prog isa := .seq (.block P.batchStart) <|
  .seq (.block packed) (.block update)

def extra : List Reg := [.x21,.x22,.x23,.x24,.x25,.x26,.x27,.x28,.x30]
def saveExtra : List Instr := extra.zipIdx.map fun (r,i) => st r (7800+8*i)
def restoreExtra : List Instr := extra.zipIdx.map fun (r,i) => ld r (7800+8*i)

/-- Ten fixed batches, including zero inputs. No secret controls the number of steps. -/
def inverse : Prog isa :=
  .seq (.block (saveExtra ++ [.movz .x .x27 0 0] ++ P.init)) <|
  .seq (.loop batch (.nonzero .x .x19)) <|
  .block (P.finish ++ restoreExtra)
end VG.Impl.P256.EcdhInverse

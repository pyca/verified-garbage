public import VerifiedGarbage.Impl.MlKem.AArch64.Ntt16.Fast

/-!
# ML-KEM's inverse NTT on AArch64 as mlkem-native schedules it

`invFast`, of a polynomial stored with 16-bit coefficients, in place: the
schedule of mlkem-native's `mlkem_intt_aarch64_asm` (layers 7–4 a block of 32
coefficients at a time, then layers 3–1 a column of eight vectors at a time,
the zetas multiplied by element, both loops software-pipelined), with:

* our zetas: each the negation `q - ζ` (in `[0, q)`) of the zeta of its block,
  as mlkem-native's differences are `a - b` where `NTT⁻¹`'s are `b - a`, with
  its `tw = round(z 2¹⁵ / q)`;
* the multiplication by `128⁻¹ = 3303` (mlkem-native's `512 = 2¹⁶ / 128`,
  for its Montgomery domain) at the start;
* each of mlkem-native's Barrett reductions (`SQDMULH` by `⌊2²⁶ / q⌉`, `SRSHR`
  by 11, `MLS` by `q`) replaced by `x - SQRDMULH(x, 10) · q` (`tw 1 = 10` in
  lane 2 of `v7`), a `MOV` where the `SRSHR` moved the estimate to another
  register;
* each coefficient reduced to `[0, q)` at the end (`Fast.normBody`), and the
  low halves of `v8`–`v15` kept in `x7`–`x14` (`Fast.save`, `Fast.restore`).

Post-indexed and unscaled addressing is rewritten as offsets from the base at
the start of each piece, which adds the distance it moved at its end.

* The tables (`tab12345`, `tab67`) hold, for each zeta, `q - ζ` and its `tw`:
  * `tab12345`: for each block `b` of layers 3 and 2, `ζ₁₅₋ᵦ, ζ₃₁₋₂ᵦ, ζ₃₀₋₂ᵦ`,
    then `ζ₁, ζ₃, ζ₂, ζ₇, ζ₆, ζ₅, ζ₄`;
  * `tab67`: for each block, the zetas of layer 5 (`ζ₆₃₋₄ᵦ₋ₑ/₂` in lane `e`)
    and of layer 6 (`ζ₁₂₇₋₈ᵦ₋₂(ₑ/₂)` and `ζ₁₂₆₋₈ᵦ₋₂(ₑ/₂)`), each followed by
    their `tw`.
-/

@[expose] public section
namespace VG.Impl.MlKem.AArch64.Ntt16.FastInv
open VG.AArch64
open VG.Impl.MlKem.AArch64 VG.Impl.MlKem.AArch64.Ntt16

/-- `q - ζ_k`. -/
def nz (k : Nat) : Nat := 3329 - zeta k

/-- `q - ζ_k`, then its `tw`. -/
def nzt (k : Nat) : List Nat := [nz k, tw (nz k)]

/-- The zetas of layers 1–5 (in `NTT⁻¹`'s order, its last five layers). -/
def tab12345 : List Nat :=
  ((List.range 8).flatMap fun b => nzt (15 - b) ++ nzt (31 - 2 * b) ++ nzt (30 - 2 * b) ++ [0, 0]) ++
    nzt 1 ++ nzt 3 ++ nzt 2 ++ nzt 7 ++ nzt 6 ++ nzt 5 ++ nzt 4 ++ [0, 0]

/-- Eight lanes, lane `e` the zeta `q - ζ_(f e)`, then eight of their `tw`. -/
def lanes (f : Nat → Nat) : List Nat :=
  (List.range 8).map (fun e => nz (f e)) ++ (List.range 8).map fun e => tw (nz (f e))

/-- The zetas of layers 6 and 7 (`NTT⁻¹`'s first two). -/
def tab67 : List Nat :=
  (List.range 8).flatMap fun b =>
    lanes (fun e => 63 - 4 * b - e / 2) ++ lanes (fun e => 127 - 8 * b - 2 * (e / 2)) ++
      lanes (fun e => 126 - 8 * b - 2 * (e / 2))

/-- Both tables, `tab67` 160 bytes in. -/
def tab : List Nat := tab12345 ++ tab67

def name : String := "VG_MLKEM16_INTT_ZETAS"

/-- `tab` as 64-bit words. -/
def tabWords : List (BitVec 64) := Readonly.words 16 tab

def tables : List (String × List (BitVec 64)) := [(name, tabWords)]


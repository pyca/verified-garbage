public import VerifiedGarbage.Impl.MlKem.AArch64.Ntt16.Readonly

/-!
# ML-KEM's NTT on AArch64 as mlkem-native schedules it

`fwdFast`, of a polynomial stored with 16-bit coefficients, in place: the
schedule of mlkem-native's `mlkem_ntt_aarch64_asm` (layers 1–3 a column of
eight vectors at a time, layers 4–7 a block of 32 coefficients at a time,
the zetas multiplied by element, both loops software-pipelined), with our
zetas (in `[0, q)`, so that the bounds of `Spec`'s transform hold), each
coefficient reduced to `[0, q)` at the end (`normBody`), and the low halves
of `v8`–`v15` kept in `x7`–`x14`.

* Post-indexed and unscaled addressing is rewritten as offsets from the
  base at the start of each piece, which adds the distance it moved at its
  end.
* The tables (`tab12345`, `tab67`) hold, for each zeta, `ζ` and
  `tw ζ = round(ζ 2¹⁵ / q)`:
  * `tab12345`: `ζ₁ … ζ₇`, then for each block `b` of layers 4 and 5
    `ζ₈₊ᵦ, ζ₁₆₊₂ᵦ, ζ₁₇₊₂ᵦ`;
  * `tab67`: for each block, the zetas of layer 6 (`ζ₃₂₊₄ᵦ₊ₑ/₂` in lane `e`)
    and of layer 7 (`ζ₆₄₊₈ᵦ₊₂(ₑ/₂)` and `ζ₆₅₊₈ᵦ₊₂(ₑ/₂)`), each followed by
    their `tw`.
-/

@[expose] public section
namespace VG.Impl.MlKem.AArch64.Ntt16.Fast
open VG.AArch64
open VG.Impl.MlKem.AArch64 VG.Impl.MlKem.AArch64.Ntt16

/-- `ζ_k`, then its `tw`. -/
def zt (k : Nat) : List Nat := [zeta k, tw (zeta k)]

/-- The zetas of layers 1–5. -/
def tab12345 : List Nat :=
  ((List.range 7).flatMap fun i => zt (i + 1)) ++ [0, 0] ++
    (List.range 8).flatMap fun b => zt (8 + b) ++ zt (16 + 2 * b) ++ zt (17 + 2 * b) ++ [0, 0]

/-- Eight lanes, lane `e` the zeta `f e`, then eight of their `tw`. -/
def lanes (f : Nat → Nat) : List Nat :=
  (List.range 8).map (fun e => zeta (f e)) ++ (List.range 8).map fun e => tw (zeta (f e))

/-- The zetas of layers 6 and 7. -/
def tab67 : List Nat :=
  (List.range 8).flatMap fun b =>
    lanes (fun e => 32 + 4 * b + e / 2) ++ lanes (fun e => 64 + 8 * b + 2 * (e / 2)) ++
      lanes (fun e => 65 + 8 * b + 2 * (e / 2))

/-- Both tables, `tab67` 160 bytes in. -/
def tab : List Nat := tab12345 ++ tab67

def name : String := "VG_MLKEM16_NTT_ZETAS"

/-- `tab` as 64-bit words. -/
def tabWords : List (BitVec 64) := Readonly.words 16 tab

def tables : List (String × List (BitVec 64)) := [(name, tabWords)]


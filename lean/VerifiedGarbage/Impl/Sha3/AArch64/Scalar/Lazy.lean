/-- Public round constant in whichever scratch register is free. -/
def constant (d : Reg) (r : Nat) : List Instr :=
  let v := Spec.Sha3.RC r
  [.movz .x d (v.extractLsb' 0 16) 0] ++
  (if v.extractLsb' 16 16 = 0 then [] else [.movk .x d (v.extractLsb' 16 16) 1]) ++
  (if v.extractLsb' 32 16 = 0 then [] else [.movk .x d (v.extractLsb' 32 16) 2]) ++
  (if v.extractLsb' 48 16 = 0 then [] else [.movk .x d (v.extractLsb' 48 16) 3])

def plan (r : Fin 24) : Plan := plans[r.val]'(by exact r.isLt)

def round (r : Fin 24) : List Instr :=
  (plan r).core.flatMap lowerVector ++ constant (plan r).constantReg r.val ++
    lowerVector (plan r).iota

def roundNat (r : Nat) : List Instr := round ⟨r % 24, Nat.mod_lt _ (by decide)⟩

def rounds : List Instr := (List.range 24).flatMap roundNat

/-- Restore the canonical layout once after all 24 rounds. -/
def normalize : List ScalarOp := [.ror .x8 .x8 24,.ror .x17 .x17 24,.move .x26 .x23,.ror .x23 .x1 24,.ror .x1 .x26 24,.move .x26 .x16,.ror .x16 .x9 24,.ror .x9 .x2 24,.ror .x2 .x26 24,.move .x26 .x21,.ror .x21 .x14 24,.ror .x14 .x3 24,.ror .x3 .x26 24,.move .x26 .x7,.ror .x7 .x13 24,.ror .x13 .x4 24,.ror .x4 .x26 24,.move .x26 .x24,.ror .x24 .x22 24,.ror .x22 .x5 24,.ror .x5 .x26 24,.move .x26 .x15,.ror .x15 .x6 24,.ror .x6 .x26 24,.move .x26 .x25,.ror .x25 .x20 24,.ror .x20 .x19 24,.ror .x19 .x10 24,.ror .x10 .x26 24,.move .x26 .x12,.ror .x12 .x11 24,.ror .x11 .x26 24]

def permutationCore : List Instr := rounds ++ normalize.flatMap lowerVector

def permute : Prog isa := Boundary.wrap (.block permutationCore)

def residentBody : Prog isa :=
  .seq Resident.xorBlock (.seq (.block permutationCore) (.block Resident.advance))

def bulk : Prog isa :=
  .seq (.block Resident.setup)
    (.seq (.loop residentBody (.zero .x .x26)) (.block Resident.finish))

end VG.Impl.Sha3.AArch64.Scalar.Lazy

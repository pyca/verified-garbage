/-! # The checked RSA private-key operation on ARMv7 -/

@[expose] public section

namespace VG.Generic.RsaPrivateCrt.Arm.Rsa

open VG.Proof.Rsa.Arm

def artifacts (v : CrtImpl) : List Artifact := [
  Spec.Rsa.privateCheckedApi.artifact Arm.target {
    suffix := v.suffix
    code := privCode v
    stack := stackBytes
    verified := code_verified v
    features := v.features },
  Spec.Rsa.publicPrecomputeApi.artifact Arm.target {
    suffix := v.suffix
    code := v.pc
    stack := 56
    verified := v.pcVerified
    features := v.features },
  Spec.Rsa.publicPrecomputedCheckedApi.artifact Arm.target {
    suffix := v.suffix
    code := v.pd
    stack := 56
    verified := v.pdVerified
    features := v.features }]

end VG.Generic.RsaPrivateCrt.Arm.Rsa

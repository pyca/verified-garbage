module

public import VerifiedGarbage.Spec.Rsa.Contract

/-!
# RSA prime factors by SP 800-56B Rev. 2 Appendix C.2

**Trusted** (as every file in `Spec/`). `vg_rsa_recover_primes_det`, in the
module `rsa`: the prime factors `(p, q)` of the modulus of the private key
`(n, e, d)` (SP 800-56B Rev. 2 §6.2.2's basic format) by Appendix C.2's
deterministic method (`recoverDet`), for `vg_rsa_crt_values`.

`vg_rsa_recover_primes` (`Spec/Rsa/Contract.lean`) recovers them by
Appendix C.1, which takes a full-size modular exponentiation for each
candidate `g` it tries (one or two for most keys). Appendix C.2 takes none:
a GCD, a product, two divisions and an integer square root. It finds the
factors of every key that meets its assumptions (two primes below
`2^(nBits/2)`, `e² ≤ n / (p + q − 1)`, and `d < λ(n)`, the least private
exponent), which every key generated by FIPS 186-5 Appendix A.1.3 does; a
key with a larger `d` is left to Appendix C.1, which the caller runs when
this one fails. Existing contracts are unchanged.

Whatever the key, a result `(p, q)` is a factorization of `n` with
`p > q > 1` (`b` and `ϒ` have the same parity as `b² − ϒ² = 4n`, and
`p q = (b² − ϒ²) / 4 = n`; `q = 1` would need `b = n + 1`, so `a = 0`, which
`d e ≥ 2` excludes); for two primes it is them.

Only the public key `(n, e)` may affect timing, not `d`, the factors, or
whether they were found.
-/

@[expose] public section

namespace VG.Spec.Rsa

/-- The integer square root: the greatest `s` with `s² ≤ x`, from that of
`x / 4` (digit by digit, two bits at a time). -/
def isqrt (x : Nat) : Nat :=
  if x < 2 then x else
    let s := 2 * isqrt (x / 4)
    if (s + 1) * (s + 1) ≤ x then s + 1 else s
termination_by x
decreasing_by omega

/-- SP 800-56B Rev. 2 Appendix C.2, `RecoverPrimeFactors(n, e, d)`: the
prime factors `(p, q)` of `n`, with `p > q`, or `none` (an error
indicator). `d e ≥ 2` is required, as Appendix C.1's step 1 requires
`d e − 1` to be positive, so that `a > 0`. -/
def recoverDet (n e d : Nat) : Option (Nat × Nat) :=
  if d * e < 2 then none else
    -- Step 1.
    let a := (d * e - 1) * Nat.gcd (n - 1) (d * e - 1)
    -- Step 2: `a = m n + r`, `0 ≤ r < n`.
    let m := a / n
    let r := a % n
    -- Step 3: `b` must be an integer with `b² > 4n`.
    if (n - r) % (m + 1) ≠ 0 then none else
      let b := (n - r) / (m + 1) + 1
      if b * b ≤ 4 * n then none else
        -- Step 4: `ϒ` must be an integer.
        let γ := isqrt (b * b - 4 * n)
        if γ * γ ≠ b * b - 4 * n then none else
          -- Step 5.
          some ((b + γ) / 2, (b - γ) / 2)

/-- The prime factors of the modulus `nB` of the private key `(nB, eB, dB)`
by Appendix C.2 (`recoverDet`): `some (p, q)` with `p > q`, as `k` octets
each, or `none` if the modulus is not valid (`modulusValid`) or the method
fails. -/
def primesKeyDet (nB eB dB : List Byte) : Option (List Byte × List Byte) :=
  let n := os2ip nB
  if modulusValid n nB.length then
    (recoverDet n (os2ip eB) (os2ip dB)).map fun (p, q) =>
      (i2osp p nB.length, i2osp q nB.length)
  else none

/-! ## `vg_rsa_recover_primes_det`

`vg_rsa_recover_primes`' signature (`recoverPrimesSig`), with `e` at most 8
octets. -/

/-- The prime factors of the modulus of the private key `(n, e, d)` by
Appendix C.2 (`primesKeyDet`). Constant time but for the public key. -/
def recoverPrimesDetContract {M : ISA} (A : Abi M) (stack : Nat := 0) : Contract M :=
  recoverPrimesSig.contract A
    (pre := fun _p pLen _q qLen _n nLen _e eLen _d dLen _scratch scratchLen _ =>
      lenValid nLen.toNat ∧ pLen.toNat = nLen.toNat ∧ qLen.toNat = nLen.toNat ∧
        1 ≤ eLen.toNat ∧ eLen.toNat ≤ 8 ∧ 1 ≤ dLen.toNat ∧ dLen.toNat ≤ nLen.toNat ∧
        scratchWords nLen.toNat ≤ scratchLen.toNat)
    (post := fun p _pLen q _qLen n nLen e eLen d dLen _scratch _scratchLen m m' r =>
      writtenAll m' [(p, nLen.toNat), (q, nLen.toNat)] r
        ((primesKeyDet (bytesAt m n nLen.toNat) (bytesAt m e eLen.toNat)
          (bytesAt m d dLen.toNat)).map fun v => [v.1, v.2]))
    (writeArgs := true) (stack := stack)
    (leak := some fun _p _pLen _q _qLen n nLen e eLen _d _dLen _scratch _scratchLen m =>
      (bytesAt m n nLen.toNat ++ bytesAt m e eLen.toNat).map (·.toNat))

def recoverPrimesDetApi : Api where
  module := "rsa"
  name := "vg_rsa_recover_primes_det"
  sig := recoverPrimesSig
  writeArgs := true
  contracts := some fun A stack => recoverPrimesDetContract A stack
  summary := "The prime factors `p > q` of the modulus of an RSA private key `(n, e, d)` \
    (SP 800-56B Rev. 2 §6.2.2's basic format), which bring it to the prime-factor format \
    `(p, q, d)` that `vg_rsa_crt_values` takes, recovered by SP 800-56B Rev. 2 Appendix C.2's \
    deterministic method. With the modulus `n` (`n_len` bytes, most significant first, odd, \
    from 512 to 8192 bits, its first byte not zero), the public exponent `e` (`e_len` bytes) \
    and the private exponent `d` (`d_len` bytes), both most significant first, writes `p` and \
    `q` (`n_len` bytes each, most significant first) and returns 1; or writes zeros to both \
    and returns 0 if `n` is not such a modulus or the method fails. It finds the factors of \
    every key with two primes below `2^(nBits/2)`, `e² ≤ n / (p + q − 1)` and the least \
    private exponent (`d < λ(n)`); for another key, recover them with \
    `vg_rsa_recover_primes` (Appendix C.1).\n\n\
    Contract: `VG.Spec.Rsa.recoverPrimesDetContract`. Constant time but for the public key: \
    timing may depend on the pointers, the lengths and the contents of `n` and `e`, not on \
    `d`, the factors, or whether they were found."
  safety := ["`n_len` must be in 64..=1024.", "`p_len` and `q_len` must be `n_len`.",
    "`e_len` must be in 1..=8.", "`d_len` must be in 1..=`n_len`."] ++ scratchSafety

end VG.Spec.Rsa

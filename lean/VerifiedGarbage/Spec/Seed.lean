/-- §2.2: `m0 = 0xFC`, `m1 = 0xF3`, `m2 = 0xCF` and `m3 = 0x3F`. -/
def m0 : Byte := 0xFC
def m1 : Byte := 0xF3
def m2 : Byte := 0xCF
def m3 : Byte := 0x3F

/-- §2.2: the function G, from `X = X3 || X2 || X1 || X0` to
`Z = Z3 || Z2 || Z1 || Z0`. -/
def g (x : Word) : Word :=
  let x0 : Byte := x.setWidth 8
  let x1 : Byte := (x >>> 8).setWidth 8
  let x2 : Byte := (x >>> 16).setWidth 8
  let x3 : Byte := (x >>> 24).setWidth 8
  let a0 := s0.getD x0.toNat 0
  let a1 := s1.getD x1.toNat 0
  let a2 := s0.getD x2.toNat 0
  let a3 := s1.getD x3.toNat 0
  let z0 := (a0 &&& m0) ^^^ (a1 &&& m1) ^^^ (a2 &&& m2) ^^^ (a3 &&& m3)
  let z1 := (a0 &&& m1) ^^^ (a1 &&& m2) ^^^ (a2 &&& m3) ^^^ (a3 &&& m0)
  let z2 := (a0 &&& m2) ^^^ (a1 &&& m3) ^^^ (a2 &&& m0) ^^^ (a3 &&& m1)
  let z3 := (a0 &&& m3) ^^^ (a1 &&& m0) ^^^ (a2 &&& m1) ^^^ (a3 &&& m2)
  z3 ++ z2 ++ z1 ++ z0

/-- §2.1: the round function F of the round key `Ki0 || Ki1` and the right
half `R0 || R1`, giving `R0' || R1'`. -/
def f (k0 k1 r0 r1 : Word) : Word × Word :=
  let a := r0 ^^^ k0
  let b := r1 ^^^ k1
  let c := g (a ^^^ b)
  let d := g (c + a)
  let e := g (d + c)
  (e + d, e)

/-- §2.3: `KC1` to `KC16`. -/
def kc : Vector Word 16 := #v[
  0x9E3779B9, 0x3C6EF373, 0x78DDE6E6, 0xF1BBCDCC,
  0xE3779B99, 0xC6EF3733, 0x8DDE6E67, 0x1BBCDCCF,
  0x3779B99E, 0x6EF3733C, 0xDDE6E678, 0xBBCDCCF1,
  0x779B99E3, 0xEF3733C6, 0xDE6E678D, 0xBCDCCF1B]

/-- Four bytes from `i`, as a big-endian word. -/
def wordAt (b : Block) (i : Nat) : Word :=
  b.getD i 0 ++ b.getD (i + 1) 0 ++ b.getD (i + 2) 0 ++ b.getD (i + 3) 0

/-- §2.3: the key schedule of the key `Key0 || Key1 || Key2 || Key3`. Round
`i` (from 1) is odd for `j = i - 1` even: it rotates `Key0 || Key1` right by
eight bits, and an even round `Key2 || Key3` left by eight bits. -/
def expandKey (key : Block) : Schedule := Id.run do
  let mut k0 := wordAt key 0
  let mut k1 := wordAt key 4
  let mut k2 := wordAt key 8
  let mut k3 := wordAt key 12
  let mut keys : Schedule := Vector.replicate 32 0
  for j in List.range 16 do
    let c := kc.getD j 0
    keys := keys.set! (2 * j) (g (k0 + k2 - c))
    keys := keys.set! (2 * j + 1) (g (k1 - k3 + c))
    if j % 2 = 0 then
      let t := (k0 ++ k1).rotateRight 8
      k0 := t.extractLsb' 32 32
      k1 := t.setWidth 32
    else
      let t := (k2 ++ k3).rotateLeft 8
      k2 := t.extractLsb' 32 32
      k3 := t.setWidth 32
  return keys

/-- §2: one of the first fifteen rounds, `T = R; R = L ^ F(Ki, R); L = T`,
on `(L0, L1, R0, R1)` with the round key `Ki0 || Ki1`. -/
def round (key : Word × Word) (s : Word × Word × Word × Word) : Word × Word × Word × Word :=
  let (l0, l1, r0, r1) := s
  let (f0, f1) := f key.1 key.2 r0 r1
  (r0, r1, l0 ^^^ f0, l1 ^^^ f1)

/-- §2: fifteen `round`s, then `L = L ^ F(K16, R)` without the swap, with
the round key `key j` in round `j + 1`. -/
def crypt (key : Nat → Word × Word) (b : Block) : Block :=
  let (l0, l1, r0, r1) := (List.range 15).foldl (fun s j => round (key j) s)
    (wordAt b 0, wordAt b 4, wordAt b 8, wordAt b 12)
  let (f0, f1) := f (key 15).1 (key 15).2 r0 r1
  let out : Vector Word 4 := #v[l0 ^^^ f0, l1 ^^^ f1, r0, r1]
  Vector.ofFn fun i => (out.getD (i.val / 4) 0 >>> (8 * (3 - i.val % 4))).setWidth 8

/-- Round `j + 1`'s key `Kj+1,0 || Kj+1,1`. -/
def roundKey (k : Schedule) (j : Nat) : Word × Word :=
  (k.getD (2 * j) 0, k.getD (2 * j + 1) 0)

def encryptBlock (k : Schedule) (b : Block) : Block :=
  crypt (roundKey k) b

/-- §2.4: the encryption procedure with the round keys in reverse order. -/
def decryptBlock (k : Schedule) (b : Block) : Block :=
  crypt (fun j => roundKey k (15 - j)) b

inductive Direction | encrypt | decrypt
  deriving DecidableEq, Repr

/-- SP 800-38A §6.1, including empty input. -/
def ecb (k : Schedule) (direction : Direction) (input : List Block) : List Block :=
  input.map (match direction with | .encrypt => encryptBlock k | .decrypt => decryptBlock k)

/-! ## Memory layouts for contracts -/

def blockAt (m : Mem) (p : Addr) : Block :=
  Vector.ofFn fun i => m (p + BitVec.ofNat 64 i.val)

/-- 128 bytes: 32 little-endian 32-bit round keys, in the order of
`Schedule`. -/
def scheduleAt (m : Mem) (p : Addr) : Schedule :=
  Vector.ofFn fun i =>
    (List.range 4).foldl (fun out j =>
      out ||| ((m (p + BitVec.ofNat 64 (4 * i.val + j))).zeroExtend 32 <<< (8 * j))) 0

def blocksAt (m : Mem) (p : Addr) (n : Nat) : List Block :=
  (List.range n).map fun i => blockAt m (p + BitVec.ofNat 64 (16 * i))

end VG.Spec.Seed

theorem point_top_double (h : Word) (ht : h.toNat<512) :
    (h+h).toNat=2*h.toNat ∧ (h+h) >>> 1=h ∧ (h*h).toNat=h.toNat*h.toNat := by
  have hd : (h+h).toNat=2*h.toNat := by
    rw [BitVec.toNat_add,Nat.mod_eq_of_lt (by omega)]
    omega
  refine ⟨hd,?_,?_⟩
  · apply BitVec.eq_of_toNat_eq
    simp only [BitVec.toNat_ushiftRight,Nat.shiftRight_eq_div_pow,hd]
    omega
  · rw [BitVec.toNat_mul,Nat.mod_eq_of_lt]
    have hb := Nat.mul_lt_mul'' ht ht
    omega


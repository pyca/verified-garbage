/-!
# Key expansion meets its contract, with the scratch buffer as an argument

`expandKey_verified`: `expandKey` is correct (`expandKey_ok`) and constant
time, by the taint analysis with the pointers and the stack pointer public,
against `Proof.Seed.expandKeyScratchContract` with the working space's 129
words (`Frame.lean` runs it in a frame).
-/

@[expose] public section

namespace VG.Proof.Seed.RISCV64

open VG VG.RISCV64

/-- Key expansion with its working space at `a2`. -/
def keyContract : Contract isa where
  pre s :=
    let key : Region := ⟨s.gpr .a0, 16⟩
    let sched : Region := ⟨s.gpr .a1, 128⟩
    let buf : Region := ⟨s.gpr .a2, 8 * Impl.Seed.RISCV64.scratchSlots⟩
    s.rd = [key] ∧ s.wr = [sched, buf] ∧ key.Disjoint sched ∧ key.Disjoint buf ∧ sched.Disjoint buf ∧
      (s.gpr .a2).toNat % 8 = 0
  post s s' :=
    Spec.Seed.scheduleAt s'.mem (s.gpr .a1) = Spec.Seed.expandKey (Spec.Seed.blockAt s.mem (s.gpr .a0))
  pub s₁ s₂ := s₁.sp = s₂.sp ∧ s₁.gpr .a0 = s₂.gpr .a0 ∧ s₁.gpr .a1 = s₂.gpr .a1 ∧ s₁.gpr .a2 = s₂.gpr .a2

theorem expandKey_correct (s : State) (hs : keyContract.pre s) :
    ∃ t s', Exec isa Impl.Seed.RISCV64.expandKey s t s' ∧ abiPreserved s s' ∧ keyContract.post s s' := by
  obtain ⟨rd, wr, ks, kb, sb, al⟩ := hs
  obtain ⟨t, s', he, hp⟩ := expandKey_ok (s := s)
    { scrAl := al
      scratch := by rw [wr]; exact List.mem_cons_of_mem _ List.mem_cons_self
      schedIn := by rw [wr]; exact List.mem_cons_self
      keyIn := by rw [rd]; exact List.mem_cons_self
      keySched := ks
      keyBuf := kb
      schedBuf := sb }
  exact ⟨t, s', he, ⟨hp.saved, Exec.sp he, hp.ra⟩, hp.sched⟩

theorem expandKey_ct :
    ConstantTime isa keyContract.pre keyContract.pub Impl.Seed.RISCV64.expandKey := by
  have hag : ∀ s₁ s₂, keyContract.pre s₁ → keyContract.pre s₂ → keyContract.pub s₁ s₂ →
      taint.Agree (Taint.ofRegs [.a0, .a1, .a2]) s₁ s₂ := by
    rintro s₁ s₂ - - ⟨hsp, h0, h1, h2⟩
    refine ⟨hsp, fun r hr => ?_⟩
    simp only [Taint.mem_ofRegs, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl
    exacts [h0, h1, h2]
  exact VG.Taint.constantTime (A := taint) (Taint.ofRegs [.a0, .a1, .a2]) hag (by taint_decide)

def keySatState : State where
  gpr r := match r with
    | .a0 => 0x1000 | .a1 => 0x2000 | .a2 => 0x3000 | _ => 0
  sp := 0x8000
  mem _ := 0
  rd := [⟨0x1000, 16⟩]
  wr := [⟨0x2000, 128⟩, ⟨0x3000, 8 * 129⟩]

theorem expandKey_verified : Verified target Impl.Seed.RISCV64.expandKey
    (Proof.Seed.expandKeyScratchContract abi 129) := by
  refine Verified.of_correct expandKey_correct expandKey_ct ?_
  sig_implies [Proof.Seed.expandKeyScratchContract, Proof.Seed.expandKeyScratchSig, Proof.Seed.expandKeyPost,
    abi, argRegs, keyContract, Impl.Seed.RISCV64.scratchSlots] [keySatState] using keySatState

end VG.Proof.Seed.RISCV64

end

end

/-!
# SEED on RISC-V, with its working space on the stack

Key expansion and ECB run their code, proved with the working space as an argument, in a frame
that allocates it and zeroes it after the code
(`Verified.stackScratchWiped`), since it holds the round keys and the data:
the 1032 bytes of the working space's 129 words, in a frame of 1040.
-/

@[expose] public section

namespace VG.Proof.Seed.RISCV64

open VG VG.RISCV64

def expandKeyFrameSat : State where
  gpr r := match r with
    | .a0 => 0x1000 | .a1 => 0x2000 | _ => 0
  sp := 0x8000
  mem _ := 0
  rd := [⟨0x1000, 16⟩]
  wr := [⟨0x2000, 128⟩]

theorem expandKeyFrameSat_pre : ∃ s, (Spec.Seed.expandKeyContract abi 1040).pre s := by
  implies_sat [Spec.Seed.expandKeyContract, Spec.Seed.expandKeySig, abi, argRegs]
    [expandKeyFrameSat] using expandKeyFrameSat

/-- Key expansion, with its working space on the stack. -/
theorem expandKey_framed :
    Verified target (Impl.StackScratch.RISCV64.withStackScratchWiped 1040 .a2 129 Impl.Seed.RISCV64.expandKey)
      (Spec.Seed.expandKeyContract abi 1040) :=
  Verified.stackScratchWiped (sig := Spec.Seed.expandKeySig) (nm := "scratch") (e := .u64)
    (n := 129) (post := Proof.Seed.expandKeyPost abi.ptrBits) (wa := false) (stack := 0)
    (bytes := 1040) (words := 129) expandKey_verified (by decide) (by decide) (by decide)
    (Proof.Seed.expandKeyPostOut_local _) expandKeyFrameSat_pre

def ecbFrameSat : State where
  gpr r := match r with
    | .a0 => 0x1000 | .a1 => 0x3000 | .a2 => 1 | _ => 0
  sp := 0x8000
  mem _ := 0
  rd := [⟨0x1000, 128⟩]
  wr := [⟨0x3000, 16⟩]

theorem ecbFrameSat_pre (d : Spec.Seed.Direction) : ∃ s, (Spec.Seed.ecbContract abi d 1040).pre s := by
  implies_sat [Spec.Seed.ecbContract, Spec.Seed.ecbSig, Spec.Seed.ecbPost, abi, argRegs]
    [ecbFrameSat] using ecbFrameSat

/-- ECB in the direction `d`, with its working space on the stack. -/
theorem ecb_framed (d : Spec.Seed.Direction) :
    Verified target (Impl.StackScratch.RISCV64.withStackScratchWiped 1040 .a3 129 (Impl.Seed.RISCV64.ecb d))
      (Spec.Seed.ecbContract abi d 1040) :=
  Verified.stackScratchWiped (sig := Spec.Seed.ecbSig) (nm := "scratch") (e := .u64)
    (n := 129) (post := Spec.Seed.ecbPost d abi.ptrBits) (wa := true) (stack := 0)
    (bytes := 1040) (words := 129) (ecb_verified d) (by decide) (by decide) (by decide)
    (Proof.Seed.ecbPostOut_local _ _) (ecbFrameSat_pre _)

end VG.Proof.Seed.RISCV64

end

end


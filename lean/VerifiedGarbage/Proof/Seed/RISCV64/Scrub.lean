/-!
# SEED's core for the modes on RISC-V

`inlineCoreSpec d`: SEED's core for the direction `d`
(`Impl.Seed.RISCV64.inlineCore d`) meets what the modes need of a core
(`Proof.Modes.RISCV64.CoreSpec`), with the key a schedule, read in place
through `a0`, its cipher `Proof.Seed.dirCipher d`, as on PPC64LE. The
schedule is readable and apart from the regions the mode writes (`KeyArgs`),
and from the frame (`Ready`), so nothing the mode or the core writes changes
it.

The core (`crypt_ok`) is ECB's prologue (`prologue_ok`), on ECB's scratch
buffer `ecbOff` bytes into the frame (at `E`), then ECB's batch taken apart
(`Batch.lean`): the copy in of one block (`copyIn_loop`), the rounds
(`rounds_ok`) and the copy out (`copyOut_loop`), and ECB's epilogue
(`Spill.restore_wp`). Around the block the modes' `s1`–`s3` wait in `a1`,
`a2` and `ra`, and `ra` in its slot.
-/

@[expose] public section

namespace VG.Proof.Seed.RISCV64.Mode

open VG VG.RISCV64 VG.RISCV64.Steps VG.Impl.Seed.RISCV64 VG.Proof.Seed.RISCV64
open VG.Impl.Aes.RISCV64 (sb movR t0 t1 t2)
open VG.Proof.Modes.RISCV64 (coreRegion blkRegion blkAddr slotA CoreSpec Layout ScrIn kept KeptBut)
open VG.Spec.Seed (Direction)
open VG.Spec.Aes (bytesAt)

/-- The schedule. -/
abbrev keyR (s : State) : Region := ⟨s.gpr .a0, 128⟩

/-- The schedule at `a0` is `k`, readable, and apart from the regions `rs`. -/
def KeyArgs (s : State) (rs : List Region) (k : Spec.Seed.Schedule) : Prop :=
  Spec.Seed.scheduleAt s.mem (s.gpr .a0) = k ∧ keyR s ∈ s.rd ++ s.wr ∧ ∀ r ∈ rs, (keyR s).Disjoint r

/-- The key's arguments, apart from the frame at `B` too, of the core on `g`
blocks. -/
def Ready (g : Nat) (s : State) (B : Addr) (ws : List Region) (k : Spec.Seed.Schedule) : Prop :=
  KeyArgs s ws k ∧ (keyR s).Disjoint ⟨B, 1088 + 16 * g⟩

theorem keyArgs_congr {s s' : State} {rs : List Region} {k : Spec.Seed.Schedule} (h : KeyArgs s rs k)
    (e : s'.gpr .a0 = s.gpr .a0) (hrd : s'.rd = s.rd) (hwr : ∃ ws, s'.wr = ws ++ s.wr)
    (hf : Frame rs s.mem s'.mem) : KeyArgs s' rs k := by
  obtain ⟨hk, hin, hd⟩ := h
  obtain ⟨ws, hw⟩ := hwr
  refine ⟨?_, ?_, by rw [keyR, e]; exact hd⟩
  · rw [e, Proof.Seed.scheduleAt_frame hf hd, hk]
  · rw [hrd, hw, keyR, e]
    rcases List.mem_append.mp hin with h | h
    · exact List.mem_append_left _ h
    · exact List.mem_append_right _ (List.mem_append_right _ h)

theorem ready_frame {g : Nat} {s s' : State} {B : Addr} {ws : List Region} {k : Spec.Seed.Schedule}
    {rs : List Region} (h : Ready g s B ws k) (e : s'.gpr .a0 = s.gpr .a0) (hrd : s'.rd = s.rd)
    (hwr : s'.wr = s.wr) (hf : Frame rs s.mem s'.mem) (hs : ∀ r ∈ rs, ∃ r' ∈ ws, Region.Sub r r') :
    Ready g s' B ws k := by
  obtain ⟨⟨hk, hin, hd⟩, hB⟩ := h
  obtain hd' : ∀ r ∈ rs, (keyR s).Disjoint r := fun r hr => by
    obtain ⟨r', hr', hsub⟩ := hs r hr
    exact (hd r' hr').sub_right hsub
  refine ⟨⟨?_, by rw [hrd, hwr, keyR, e]; exact hin, by rw [keyR, e]; exact hd⟩, by rw [keyR, e]; exact hB⟩
  rw [e, Proof.Seed.scheduleAt_frame hf hd', hk]

/-- The frame's bytes, of the core on `g` blocks. -/
theorem inline_total_eq (d : Direction) (g : Nat) : 8 * (inlineCore d g).total = 1088 + 16 * g := by
  simp only [inlineCore, bufSlot, Impl.Modes.RISCV64.coreSlot, scratchSlots]; omega_using []

theorem raOff_eq (g : Nat) : raOff g = 1032 + 16 * g := by simp only [raOff, scratchSlots]; omega_using []

theorem inlineLayout (d : Direction) {g : Nat} (hg1 : 1 ≤ g) (hg : g ≤ 16) : Layout (inlineCore d g) := by
  obtain e := inline_total_eq d g
  refine ⟨hg1, .inr rfl, Nat.le_add_right _ _, ?_, ?_, ?_, ?_⟩ <;>
    simp only [inlineCore, bufSlot, Impl.Modes.RISCV64.coreSlot, scratchSlots] at e ⊢ <;> omega_arith

theorem prepare_wp (d : Direction) (g : Nat) {s : State} {B : Addr} {rs : List Region} {k : Spec.Seed.Schedule}
    (hB : s.gpr Impl.Modes.RISCV64.sb = B) (_hS : ScrIn s B (inlineCore d g).total)
    (hm : (⟨B, 8 * (inlineCore d g).total⟩ : Region) ∈ rs) (hk : KeyArgs s rs k) :
    WP isa (inlineCore d g).prepare s fun s' => Ready g s' B rs k ∧ s'.gpr Impl.Modes.RISCV64.sb = B ∧
      (∀ r ∈ kept, s'.gpr r = s.gpr r) ∧ Frame [coreRegion (inlineCore d g) B] s.mem s'.mem ∧
      s'.rd = s.rd ∧ s'.wr = s.wr :=
  WP.block_nil ⟨⟨hk, by rw [← inline_total_eq d g]; exact hk.2.2 _ hm⟩, hB, fun _ _ => rfl, Frame.refl _ _, rfl, rfl⟩

/-! ## The block -/

/-- ECB's scratch buffer, the core's buffer and `ra`'s slot, after `g`
blocks, in the frame at `B`. -/
abbrev ecbA (B : Addr) : Addr := B + BitVec.ofNat 64 48
abbrev bufA (B : Addr) : Addr := ecbA B + BitVec.ofNat 64 1032
abbrev raA (B : Addr) (g : Nat) : Addr := ecbA B + BitVec.ofNat 64 (1032 + 16 * g)

/-- The block function in the direction `d`, on the modes' blocks. -/
theorem dirCipher_bytes (d : Direction) (k : Spec.Seed.Schedule) (m : Mem) (p : Addr) :
    Proof.Seed.dirCipher d k (bytesAt m p 16) = (cipher d k (Spec.Seed.blockAt m p)).toList := by
  obtain e : (Vector.ofFn fun i : Fin 16 => (Spec.Seed.blockAt m p).toList.getD i.val 0) =
      Spec.Seed.blockAt m p := by
    apply Vector.ext; intro i hi; simp
  cases d <;> simp only [Proof.Seed.dirCipher, Spec.Seed.cipher, Spec.Seed.invCipher, cipher,
    Proof.Seed.bytesAt_eq, e]

/-- An 8-byte aligned offset in the frame. -/
theorem frame_al {B : Addr} {N : Nat} (hal : B.toNat % 16 = 0) (hfit : B.toNat + N ≤ 2 ^ 64) {k : Nat}
    (hk : k % 8 = 0) (hk' : k < N) : (B + BitVec.ofNat 64 k).toNat % 8 = 0 := by
  obtain h₁ : k < 2 ^ 64 := by omega_arith
  obtain h₂ : B.toNat + k < 2 ^ 64 := by omega_arith
  rw [BitVec.toNat_add, BitVec.toNat_ofNat, Nat.mod_eq_of_lt h₁, Nat.mod_eq_of_lt h₂]
  omega_arith

theorem coreIn_eq (d : Direction) (g : Nat) : coreIn d g =
    ([.addi t0 Impl.Modes.RISCV64.sb (ecbOff : Int)] : List Instr) ++ prologue t0 ++ park g ++ copyFrom d g := rfl

theorem coreOut_eq (d : Direction) (g : Nat) : coreOut d g =
    ([.addi .a0 .a0 (-(keyStart d : Int))] : List Instr) ++ seedRestore ++
      ([.addi .s1 .a1 0, .addi .s2 .a2 0, .addi .s3 .ra 0, .load .d .ra sb (raOff g),
        .addi Impl.Modes.RISCV64.sb sb (-(ecbOff : Int))] : List Instr) := rfl

/-- What the core does to its block, and keeps. -/
theorem crypt_ok (d : Direction) {g : Nat} (hg1 : 1 ≤ g) (hg : g ≤ 16) {s : State} {B : Addr}
    (hB : s.gpr .s4 = B) (hS : ScrIn s B (bufSlot + 1 + 2 * g)) (hk : (keyR s).Disjoint ⟨B, 1088 + 16 * g⟩)
    (hkin : keyR s ∈ s.rd ++ s.wr) :
    WP isa (coreCrypt d g) s fun s' => s'.gpr .s4 = B ∧ (∀ r ∈ kept, s'.gpr r = s.gpr r) ∧
      Frame [⟨ecbA B, 1040 + 16 * g⟩] s.mem s'.mem ∧
      (∀ j < g, bytesAt s'.mem (bufA B + BitVec.ofNat 64 (16 * j)) 16 =
        Proof.Seed.dirCipher d (Spec.Seed.scheduleAt s.mem (s.gpr .a0))
          (bytesAt s.mem (bufA B + BitVec.ofNat 64 (16 * j)) 16)) ∧
      s'.rd = s.rd ∧ s'.wr = s.wr := by
  let E := ecbA B
  let P := bufA B
  obtain e8 : 8 * (bufSlot + 1 + 2 * g) = 1088 + 16 * g := by
    simp only [bufSlot, Impl.Modes.RISCV64.coreSlot, scratchSlots]; omega_using []
  obtain hfit : B.toNat + (1088 + 16 * g) ≤ 2 ^ 64 := by have := hS.fit; rw [e8] at this; exact this
  have hal : B.toNat % 16 = 0 := hS.al
  obtain hW : (⟨B, 1088 + 16 * g⟩ : Region) ∈ s.wr := by
    have := hS.whole (by rw [e8]; omega_using [hg]); rw [e8] at this; exact this
  obtain hEk : ∀ k, E + BitVec.ofNat 64 k = B + BitVec.ofNat 64 (48 + k) := fun k => Offset.add_add _ _ _
  obtain hin : ∀ k n, k + n ≤ 1040 + 16 * g → InRegions s.wr (E + BitVec.ofNat 64 k) n := fun k n h =>
    ⟨_, hW, by rw [hEk]; exact Offset.contains_base B (by omega_arith) (by omega_arith)⟩
  obtain hEal : E.toNat % 8 = 0 := frame_al hal hfit (by decide) (by omega_using [])
  obtain hEsub : ∀ k n, k + n ≤ 1040 + 16 * g → Region.Sub ⟨E + BitVec.ofNat 64 k, n⟩ ⟨B, 1088 + 16 * g⟩ :=
    fun k n h => by rw [hEk]; exact Offset.sub_base B (by omega_arith)
  have hP : P = E + BitVec.ofNat 64 1032 := rfl
  have hRA : raA B g = E + BitVec.ofNat 64 (1032 + 16 * g) := rfl
  obtain hscr : ∀ t : State, t.gpr sb = E → scratchR t = ⟨E, 8 * scratchSlots⟩ := fun t ht => by
    simp only [scratchR, ht]
  obtain harr : ∀ t : State, t.gpr sb = E → arraysR t = ⟨E + BitVec.ofNat 64 320, 512⟩ := fun t ht => by
    simp only [arraysR, ht]
  obtain hwork : ∀ t : State, t.gpr sb = E → workR t = ⟨E + BitVec.ofNat 64 0, 832⟩ := fun t ht => by
    simp only [workR, ht, BitVec.add_zero]
  -- ECB's base and prologue.
  rw [coreCrypt]
  apply WP.seq
  rw [coreIn_eq d g, WP.block_append_iff (M := isa), WP.block_append_iff (M := isa),
    WP.block_append_iff (M := isa)]
  refine wp_addi (by decide) fun s₀ u₀ => WP.block_nil ?_
  obtain t0₀ : s₀.gpr .t0 = E := u₀.gpr.trans (by show s.gpr .s4 + _ = _; rw [hB]; rfl)
  refine WP.mono (prologue_ok (r := t0) (by rw [show t0 = Reg.t0 from rfl, t0₀]; exact hEal)
    (by rw [show t0 = Reg.t0 from rfl, t0₀, u₀.wr]
        exact ⟨_, hW, Offset.contains_base B (d := 48) (by simp only [scratchSlots]; omega_using []) (by decide)⟩))
    fun s₁ P₁ => ?_
  obtain G₁ : ∀ r, r ≠ .a5 → r ≠ .a3 → r ≠ .t0 → r ≠ .t1 → s₁.gpr r = s.gpr r := fun r a b c e => by
    rw [P₁.regs r a b c e, u₀.other r c]
  obtain sb₁ : s₁.gpr sb = E := by rw [P₁.base]; exact t0₀
  obtain wr₁ : s₁.wr = s.wr := by rw [P₁.wr, u₀.wr]
  obtain rd₁ : s₁.rd = s.rd := by rw [P₁.rd, u₀.rd]
  obtain sp₁ : s₁.sp = s.sp := by rw [P₁.sp, u₀.sp]
  obtain f₁ : Frame [⟨E, 8 * scratchSlots⟩] s.mem s₁.mem := by
    have := P₁.frame; rw [show s₀.gpr t0 = E from t0₀, u₀.mem] at this; exact this
  -- The modes' state parked, and `ra` in its slot.
  rw [park]

    Verified RISCV64.target cfbDecryptFinal (Spec.Seed.cfbDecryptFinalContract RISCV64.abi (frameBytes 1)) := by
  refine Verified.of_correct cfbDecryptFinal_correct (cfbDecryptFinal_constantTime _) ?_
  contract_implies [Spec.Seed.cfbDecryptFinalContract, Spec.Seed.cfbFinalSig, RISCV64.abi,
    RISCV64.argRegs, finalContract, decFinalPost, modePub_iff] [modeSat] using modeSat

theorem ofbFinal_verified :
    Verified RISCV64.target ofbFinal (Spec.Seed.ofbFinalContract RISCV64.abi (frameBytes 1)) := by
  refine Verified.of_correct ofbFinal_correct (ofbFinal_constantTime _) ?_
  contract_implies [Spec.Seed.ofbFinalContract, Spec.Seed.ofbFinalSig, RISCV64.abi,
    RISCV64.argRegs, finalContract, ofbFinalPost, modePub_iff] [modeSat] using modeSat

end VG.Proof.Seed.RISCV64.Modes


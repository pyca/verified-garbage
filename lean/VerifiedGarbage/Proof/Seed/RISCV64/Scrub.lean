  · simp only [kept, RISCV64.preserved, List.mem_cons, List.not_mem_nil, or_false] at hr
    obtain pres : ∀ r, r ∈ savedOffs.map Prod.fst → r ≠ .s1 → r ≠ .s2 → r ≠ .s3 → r ≠ .s4 →
        s'.gpr r = s.gpr r := fun r hm a b c e => by
      rw [T r a b c (by rintro rfl; exact absurd hm (by decide)) e, R.gpr_of (Or.inl hm),
        u₀.other r (by rintro rfl; exact absurd hm (by decide))]
    rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · rw [T _ (by decide) (by decide) (by decide) (by decide) (by decide), R.other _ (by decide), u₁₆.gpr,
        K₁₅ _ (by simp), a0₉, BitVec.add_sub_cancel]
    · exact ra'
    · exact pres _ (by decide) (by decide) (by decide) (by decide) (by decide)
    · rw [u'.other _ (by decide), u₂₁.other _ (by decide), u₂₀.other _ (by decide),
        u₁₉.other _ (by decide), u₁₈.gpr, K _ (by simp), G₉ _ (by decide) (by decide) (by decide) (by decide)]
      exact st₅.1
    · rw [u'.other _ (by decide), u₂₁.other _ (by decide), u₂₀.other _ (by decide), u₁₉.gpr,
        u₁₈.other _ (by decide), K _ (by simp), G₉ _ (by decide) (by decide) (by decide) (by decide)]
      exact st₅.2.1
    · rw [u'.other _ (by decide), u₂₁.other _ (by decide), u₂₀.gpr, u₁₉.other _ (by decide),
        u₁₈.other _ (by decide), K _ (by simp), G₉ _ (by decide) (by decide) (by decide) (by decide)]
      exact st₅.2.2
    · rw [s4', hB]
    all_goals exact pres _ (by decide) (by decide) (by decide) (by decide) (by decide)
  · -- Memory: within the core's slots.
    rw [mem']
    refine (FA.sub fun r hr => ?_).trans (FW.sub fun r hr => ?_)
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · exact ⟨_, List.mem_singleton_self _, Region.sub_prefix (by simp only [scratchSlots]; omega_using [])⟩
      · exact ⟨_, List.mem_singleton_self _, Offset.sub_base E (by omega_using [])⟩
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · exact ⟨_, List.mem_singleton_self _, Region.sub_prefix (by omega_using [])⟩
      · exact ⟨_, List.mem_singleton_self _, Offset.sub_base E (by omega_using [])⟩
  · -- The blocks.
    intro j hj
    rw [mem', dirCipher_bytes, Proof.Seed.bytesAt_eq]
    refine congrArg Vector.toList ?_
    rw [← crypt_keysAt, crypt_eq, ← hq₁₁ j hj, ← quad₁₄]
    refine blockAt_of_bytes fun i hi => ?_
    obtain e := i₁₅.done j hj i hi
    rw [← Offset.add_add] at e
    rw [e, encodeSwapped_get _ _ hi]
  · rw [u'.rd, u₂₁.rd, rd₂₀]
  · rw [u'.wr, u₂₁.wr, wr₂₀]

/-- The key stays ready through what the core writes, its slots. -/
theorem ready_core {g : Nat} {s s' : State} {B : Addr} {ws : List Region} {k : Spec.Seed.Schedule}
    (h : Ready g s B ws k) (e : s'.gpr .a0 = s.gpr .a0) (hrd : s'.rd = s.rd) (hwr : s'.wr = s.wr)
    (hf : Frame [⟨ecbA B, 1040 + 16 * g⟩] s.mem s'.mem) : Ready g s' B ws k := by
  obtain ⟨⟨hk, hin, hd⟩, hB⟩ := h
  refine ⟨⟨?_, by rw [hrd, hwr, keyR, e]; exact hin, by rw [keyR, e]; exact hd⟩, by rw [keyR, e]; exact hB⟩
  rw [e, Proof.Seed.scheduleAt_frame hf fun r hr => by
    simp only [List.mem_singleton] at hr; subst hr; exact hB.sub_right (Offset.sub_base B (by omega_using [])), hk]

/-- The core's `j`th block. -/
theorem blkAddr_eq (d : Direction) (g : Nat) (B : Addr) (j : Nat) :
    blkAddr (inlineCore d g) B j = bufA B + BitVec.ofNat 64 (16 * j) := by
  show B + BitVec.ofNat 64 (8 * 135) + BitVec.ofNat 64 (16 * j) = B + BitVec.ofNat 64 48 + BitVec.ofNat 64 1032 + _
  rw [Offset.add_add B 48 1032]

/-- The core's slots. -/
theorem core_eq (d : Direction) (g : Nat) (B : Addr) :
    coreRegion (inlineCore d g) B = ⟨ecbA B, 1040 + 16 * g⟩ := by
  obtain e : 8 * ((inlineCore d g).total - Impl.Modes.RISCV64.coreSlot) = 1040 + 16 * g := by
    simp only [inlineCore, bufSlot, Impl.Modes.RISCV64.coreSlot, scratchSlots]; omega_using []
  rw [coreRegion, e]; rfl

/-- SEED's core on `g` blocks meets what the modes need. -/
def inlineCoreSpec (d : Direction) (g : Nat) (hg1 : 1 ≤ g) (hg : g ≤ 16) : CoreSpec (inlineCore d g) where
  Key := Spec.Seed.Schedule
  cipher := Proof.Seed.dirCipher d
  KeyArgs := KeyArgs
  Ready := Ready g
  cipher_len _ _ := by cases d <;> simp [Proof.Seed.dirCipher, Spec.Seed.cipher, Spec.Seed.invCipher, inlineCore]
  layout := inlineLayout d hg1 hg
  keyArgs_congr h e r w _ f := keyArgs_congr h e.a0 r w f
  ready_frame h e r w _ f hs _ := ready_frame h e.a0 r w f hs
  prepare_wp := prepare_wp d g
  crypt_wp {s B ws k} hB hS hR := by
    refine WP.mono (crypt_ok d hg1 hg hB hS hR.2 hR.1.2.1) fun s' ⟨h5, hk, hf, hb, hrd, hwr⟩ => ?_
    refine ⟨h5, hk, ready_core hR (hk .a0 (by decide)) hrd hwr hf, by rw [core_eq]; exact hf, fun j hj => ?_,
      hrd, hwr⟩
    rw [show 4 * (inlineCore d g).bw = 16 from rfl, blkAddr_eq, hb j hj, hR.1.1]

open VG.Proof.Modes.RISCV64 (KeyMove ReadyMove)

theorem shared_key (d : Direction) (g : Nat) (hg1 : 1 ≤ g) (hg : g ≤ 16) : KeyMove (inlineCoreSpec d g hg1 hg) := by
  intro s t rs ts k hk ha rd wr hf hs
  obtain ⟨hk, hin, hd⟩ := keyArgs_congr hk ha rd wr hf
  exact ⟨hk, hin, fun r hr => by
    obtain ⟨r', hr', sub⟩ := hs r hr
    exact (hd r' hr').sub_right sub⟩

theorem shared_ready (d : Direction) (g : Nat) (hg1 : 1 ≤ g) (hg : g ≤ 16) : ReadyMove (inlineCoreSpec d g hg1 hg) := by
  intro s t B ws k rs hr ha rd wr hf hs hd
  exact ready_frame hr ha rd wr hf hs

def dirCoreSpec (d : Direction) (g : Nat) (hg1 : 1 ≤ g) (hg : g ≤ 16) : CoreSpec (dirCore d g) :=
  (inlineCoreSpec d g hg1 hg).shared
    (by simp only [inlineCore, bufSlot, scratchSlots, Impl.Modes.RISCV64.coreSlot]; omega_using [hg])
    (by left; simp only [inlineCore, bufSlot, scratchSlots, Impl.Modes.RISCV64.coreSlot]; omega_using [hg])
    (shared_key d g hg1 hg) (shared_ready d g hg1 hg) rfl rfl _ _

theorem layout (d : Direction) {g : Nat} (hg1 : 1 ≤ g) (hg : g ≤ 16) : Layout (dirCore d g) :=
  VG.Proof.Modes.RISCV64.shared_layout (inlineLayout d hg1 hg)
    (by simp only [inlineCore, bufSlot, scratchSlots, Impl.Modes.RISCV64.coreSlot]; omega_using [hg]) _ _

theorem total_eq (d : Direction) (g : Nat) : 8 * (dirCore d g).total = 1104 + 16 * g := by
  simp only [dirCore, Impl.Modes.RISCV64.Core.shared, inlineCore, bufSlot, scratchSlots,
    Impl.Modes.RISCV64.coreSlot]; omega_using []

end VG.Proof.Seed.RISCV64.Mode

end

end

/-!
# SEED's modes on RISC-V meet their contracts

`cbcEncryptChained_verified`, `ofb_verified`, … : the modes of
`Proof/Modes/RISCV64/` over SEED's core (`Mode.dirCoreSpec`) meet the
shared contracts, with `stack := frameBytes g`: the mode's frame of
`136 + 2 g` slots below the stack pointer, which holds ECB's scratch buffer
and which it zeroes before returning, for the core on `g` blocks: 1104 bytes
for the modes on one block, 1344 for CBC and CFB decryption, sixteen
(`Proof/Modes/RISCV64/Wide.lean`). The proofs are written against
`modeContract`, which states the frame.
-/

@[expose] public section

namespace VG.Proof.Seed.RISCV64.Modes

open VG VG.RISCV64 VG.Impl.Seed.RISCV64 VG.Impl.Modes
open VG.Proof.Modes.RISCV64 (SeqPre ivR scrRegion Fb)
open VG.Proof.Seed.RISCV64.Mode (dirCoreSpec KeyArgs layout total_eq)
open VG.Proof.Seed.RISCV64 (modePub)

/-- The frame's bytes, of the core on `g` blocks. -/
abbrev frameBytes (g : Nat) : Nat := 1104 + 16 * g

/-- SEED under the schedule at `a0`, and its inverse. -/
abbrev ciph (s : State) : Spec.Cbc.Cipher := Spec.Seed.cipher (Spec.Seed.scheduleAt s.mem (s.gpr .a0))
abbrev invCiph (s : State) : Spec.Cbc.Cipher :=
  Spec.Seed.invCipher (Spec.Seed.scheduleAt s.mem (s.gpr .a0))
/-- The chaining value. -/
abbrev ivAt (m : Mem) (s : State) : List Byte := Spec.Aes.bytesAt m (s.gpr .a1) 16
/-- The data, in blocks. -/
abbrev dataAt (m : Mem) (s : State) : List (List Byte) := Spec.Cbc.blocksAt m (s.gpr .a2) (s.gpr .a3).toNat

/-- The functions' postconditions. -/
def cbcEncPost (s s' : State) : Prop :=
  dataAt s'.mem s = Spec.Cbc.encrypt (ciph s) (ivAt s.mem s) (dataAt s.mem s) ∧
    ivAt s'.mem s = Spec.Cbc.next (ivAt s.mem s) (Spec.Cbc.encrypt (ciph s) (ivAt s.mem s) (dataAt s.mem s))
def cbcDecPost (s s' : State) : Prop :=
  dataAt s'.mem s = Spec.Cbc.decrypt (invCiph s) (ivAt s.mem s) (dataAt s.mem s) ∧
    ivAt s'.mem s = Spec.Cbc.next (ivAt s.mem s) (dataAt s.mem s)
def ofbPost (s s' : State) : Prop :=
  dataAt s'.mem s = Spec.Ofb.crypt (ciph s) (ivAt s.mem s) (dataAt s.mem s) ∧
    ivAt s'.mem s = Spec.Ofb.next (ciph s) (ivAt s.mem s) (s.gpr .a3).toNat
def cfbEncPost (s s' : State) : Prop :=
  dataAt s'.mem s = Spec.Cfb.encrypt (ciph s) (ivAt s.mem s) (dataAt s.mem s) ∧
    ivAt s'.mem s = Spec.Cbc.next (ivAt s.mem s) (Spec.Cfb.encrypt (ciph s) (ivAt s.mem s) (dataAt s.mem s))
def cfbDecPost (s s' : State) : Prop :=
  dataAt s'.mem s = Spec.Cfb.decrypt (ciph s) (ivAt s.mem s) (dataAt s.mem s) ∧
    ivAt s'.mem s = Spec.Cbc.next (ivAt s.mem s) (dataAt s.mem s)

/-- A mode's function on RISC-V, with its frame below the stack pointer,
and the postcondition `post`, over the core on `g` blocks. -/
def modeContract (g : Nat) (post : State → State → Prop) : Contract isa where
  pre s :=
    let key : Region := ⟨s.gpr .a0, 128⟩
    let iv : Region := ⟨s.gpr .a1, 16⟩
    let data : Region := ⟨s.gpr .a2, 16 * (s.gpr .a3).toNat⟩
    let stack : Region := ⟨s.sp - frameBytes g, frameBytes g⟩
    s.rd = [key] ∧ s.wr = [iv, data] ∧
      key.Disjoint iv ∧ key.Disjoint data ∧ iv.Disjoint data ∧
      (s.gpr .a1).toNat + 16 ≤ 2 ^ 64 ∧ (s.gpr .a2).toNat + 16 * (s.gpr .a3).toNat ≤ 2 ^ 64 ∧
      s.sp.toNat % 16 = 0 ∧ frameBytes g ≤ s.sp.toNat ∧ stack.Disjoint key ∧ stack.Disjoint iv ∧
      stack.Disjoint data
  post := post
  pub := modePub

/-- The frame, of the core on `g` blocks. -/
theorem scr_eq (d : Spec.Seed.Direction) (g : Nat) (s : State) :
    scrRegion (dirCore d g) (Fb s (dirCore d g)) = ⟨s.sp - frameBytes g, frameBytes g⟩ := by
  rw [scrRegion, Fb, total_eq]; rfl

/-- `modeContract`'s precondition gives the modes'. -/
theorem seqPre_of {post : State → State → Prop} {M : Mode} (d : Spec.Seed.Direction) {g : Nat}
    (hg1 : 1 ≤ g) (hg : g ≤ 16) (hstep : M.step = 16)
    {s : State} (h : (modeContract g post).pre s) : SeqPre (dirCore d g) M s := by
  obtain ⟨-, hwr, -, -, dVD, fV, fD, al, sp, -, dSV, dSD⟩ := h
  have e16 : 4 * (dirCore d g).bw = 16 := rfl
  have eV : ivR s (dirCore d g) = ⟨s.gpr .a1, 16⟩ := rfl
  refine ⟨al, by rw [total_eq]; exact sp, by rw [eV, hwr]; simp, fun _ => by rw [eV, hwr]; simp,
    by rw [e16]; exact fV, by rw [hwr, hstep]; simp, by rw [hstep]; exact fD,
    by rw [hstep, scr_eq]; exact dSD.symm, by rw [eV, scr_eq]; exact dSV.symm,
    fun _ => by rw [eV, hstep]; exact dVD, ⟨by omega_using [hstep], by rw [e16]; omega_using [hstep]⟩, layout d hg1 hg⟩

theorem keyArgs_of {post : State → State → Prop} {M : Mode} (d : Spec.Seed.Direction) {g : Nat}
    (hstep : M.step = 16) {s : State} (h : (modeContract g post).pre s) :
    KeyArgs s (Proof.Modes.RISCV64.wrs0 (dirCore d g) M s) (Spec.Seed.scheduleAt s.mem (s.gpr .a0)) := by
  obtain ⟨hrd, -, -, dKD, -, -, -, -, -, dSK, -, -⟩ := h
  refine ⟨rfl, by rw [hrd]; exact List.mem_append_left _ (List.mem_singleton_self _), fun r hr => ?_⟩
  simp only [Proof.Modes.RISCV64.wrs0, Proof.Modes.RISCV64.wrs, List.mem_cons, List.not_mem_nil,
    or_false] at hr
  rcases hr with rfl | rfl
  · show (Region.mk (s.gpr .a0) 128).Disjoint ⟨s.gpr .a2, M.step * (s.gpr .a3).toNat⟩
    rw [hstep]; exact dKD
  · rw [scr_eq]; exact dSK.symm

/-! ## Correctness -/

theorem cipher_enc {g : Nat} {h1 : 1 ≤ g} {h2 : g ≤ 16} (k : Spec.Seed.Schedule) :
    (dirCoreSpec .encrypt g h1 h2).cipher k = Spec.Seed.cipher k := by kernel_rfl
theorem cipher_dec {g : Nat} {h1 : 1 ≤ g} {h2 : g ≤ 16} (k : Spec.Seed.Schedule) :
    (dirCoreSpec .decrypt g h1 h2).cipher k = Spec.Seed.invCipher k := by kernel_rfl

theorem cbcEncryptChained_correct (s : State) (hs : (modeContract 1 cbcEncPost).pre s) :
    ∃ t s', Exec isa cbcEncryptChained s t s' ∧ abiPreserved s s' ∧ (modeContract 1 cbcEncPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.cbcEncChained_wp (dirCoreSpec .encrypt 1 (by decide) (by decide))
    (seqPre_of .encrypt (by decide) (by decide) (M := Mode.cbcEncChained 4) rfl hs)
    (keyArgs_of .encrypt (M := Mode.cbcEncChained 4) rfl hs))
    fun _ ⟨h1, h2, h3⟩ => by simp only [cipher_enc] at h2 h3; exact ⟨h1, h2, h3⟩

theorem cbcDecryptChained_correct (s : State) (hs : (modeContract 16 cbcDecPost).pre s) :
    ∃ t s', Exec isa cbcDecryptChained s t s' ∧ abiPreserved s s' ∧ (modeContract 16 cbcDecPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.cbcDecLevels_wp (dirCoreSpec .decrypt 16 (by decide) (by decide)) (by decide)
    (seqPre_of .decrypt (by decide) (by decide) (M := Mode.cbcDecChained 4) rfl hs)
    (keyArgs_of .decrypt (M := Mode.cbcDecChained 4) rfl hs))
    fun _ ⟨h1, h2, h3, _⟩ => by simp only [cipher_dec] at h2 h3; exact ⟨h1, h2, h3⟩

theorem ofb_correct (s : State) (hs : (modeContract 1 ofbPost).pre s) :
    ∃ t s', Exec isa ofb s t s' ∧ abiPreserved s s' ∧ (modeContract 1 ofbPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.ofb_wp (dirCoreSpec .encrypt 1 (by decide) (by decide))
    (seqPre_of .encrypt (by decide) (by decide) (M := Mode.ofb 4) rfl hs)
    (keyArgs_of .encrypt (M := Mode.ofb 4) rfl hs))
    fun _ ⟨h1, h2, h3⟩ => by simp only [cipher_enc] at h2 h3; exact ⟨h1, h2, h3⟩

theorem cfbEncrypt_correct (s : State) (hs : (modeContract 1 cfbEncPost).pre s) :
    ∃ t s', Exec isa cfbEncrypt s t s' ∧ abiPreserved s s' ∧ (modeContract 1 cfbEncPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.cfbEnc_wp (dirCoreSpec .encrypt 1 (by decide) (by decide))
    (seqPre_of .encrypt (by decide) (by decide) (M := Mode.cfbEnc 4) rfl hs)
    (keyArgs_of .encrypt (M := Mode.cfbEnc 4) rfl hs))
    fun _ ⟨h1, h2, h3⟩ => by simp only [cipher_enc] at h2 h3; exact ⟨h1, h2, h3⟩

theorem cfbDecrypt_correct (s : State) (hs : (modeContract 16 cfbDecPost).pre s) :
    ∃ t s', Exec isa cfbDecrypt s t s' ∧ abiPreserved s s' ∧ (modeContract 16 cfbDecPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.cfbDecLevels_wp (dirCoreSpec .encrypt 16 (by decide) (by decide)) (by decide)
    (seqPre_of .encrypt (by decide) (by decide) (M := Mode.cfbDecEarly 4) rfl hs)
    (keyArgs_of .encrypt (M := Mode.cfbDecEarly 4) rfl hs))
    fun _ ⟨h1, h2, h3, _⟩ => by simp only [cipher_enc] at h2 h3; exact ⟨h1, h2, h3⟩

/-! ## The contracts -/

/-- A state satisfying the modes' precondition: the schedule at `0x1000`,
the IV at `0x3000`, no data at `0x4000`, and the stack below `0x8000`. -/
def modeSat : State where
  gpr r := match r with
    | .a0 => 0x1000 | .a1 => 0x3000 | .a2 => 0x4000 | _ => 0
  sp := 0x8000
  mem _ := 0
  rd := [⟨0x1000, 128⟩]
  wr := [⟨0x3000, 16⟩, ⟨0x4000, 0⟩]

theorem modePub_iff (s₁ s₂ : State) : modePub s₁ s₂ ↔
    s₁.sp = s₂.sp ∧ s₁.gpr .a0 = s₂.gpr .a0 ∧ s₁.gpr .a1 = s₂.gpr .a1 ∧ s₁.gpr .a2 = s₂.gpr .a2 ∧
      s₁.gpr .a3 = s₂.gpr .a3 := by
  simp [modePub]

theorem cbcEncryptChained_verified :
    Verified RISCV64.target cbcEncryptChained (Spec.Seed.cbcEncryptChainedContract RISCV64.abi (frameBytes 1)) := by
  refine Verified.of_correct cbcEncryptChained_correct (cbcEncryptChained_constantTime _) ?_
  contract_implies [Spec.Seed.cbcEncryptChainedContract, Spec.Seed.cbcChainedSig,
    RISCV64.abi, RISCV64.argRegs, modeContract, frameBytes, cbcEncPost, modePub_iff] [modeSat] using modeSat

theorem cbcDecryptChained_verified :
    Verified RISCV64.target cbcDecryptChained (Spec.Seed.cbcDecryptChainedContract RISCV64.abi (frameBytes 16)) := by
  refine Verified.of_correct cbcDecryptChained_correct (cbcDecryptChained_constantTime _) ?_
  contract_implies [Spec.Seed.cbcDecryptChainedContract, Spec.Seed.cbcChainedSig,
    RISCV64.abi, RISCV64.argRegs, modeContract, frameBytes, cbcDecPost, modePub_iff] [modeSat] using modeSat

theorem ofb_verified : Verified RISCV64.target ofb (Spec.Seed.ofbContract RISCV64.abi (frameBytes 1)) := by
  refine Verified.of_correct ofb_correct (ofb_constantTime _) ?_
  contract_implies [Spec.Seed.ofbContract, Spec.Seed.ofbSig, RISCV64.abi, RISCV64.argRegs,
    modeContract, frameBytes, ofbPost, modePub_iff] [modeSat] using modeSat

theorem cfbEncrypt_verified :
    Verified RISCV64.target cfbEncrypt (Spec.Seed.cfbEncryptContract RISCV64.abi (frameBytes 1)) := by
  refine Verified.of_correct cfbEncrypt_correct (cfbEncrypt_constantTime _) ?_
  contract_implies [Spec.Seed.cfbEncryptContract, Spec.Seed.cfbSig, RISCV64.abi,
    RISCV64.argRegs, modeContract, frameBytes, cfbEncPost, modePub_iff] [modeSat] using modeSat

theorem cfbDecrypt_verified :
    Verified RISCV64.target cfbDecrypt (Spec.Seed.cfbDecryptContract RISCV64.abi (frameBytes 16)) := by
  refine Verified.of_correct cfbDecrypt_correct (cfbDecrypt_constantTime _) ?_
  contract_implies [Spec.Seed.cfbDecryptContract, Spec.Seed.cfbSig, RISCV64.abi,
    RISCV64.argRegs, modeContract, frameBytes, cfbDecPost, modePub_iff] [modeSat] using modeSat

end VG.Proof.Seed.RISCV64.Modes

end

end

/-!
# SEED-CFB128 and SEED-OFB of a message's last piece on RISC-V meet their contracts

The modes' CFB and OFB over a message's last piece (`Proof.Modes.RISCV64.cfbEncFinal_wp`,
`cfbDecFinal_wp`, `ofbFinal_wp`) over Seed's one-block encryption core meet the contracts,
with `stack := 1104`, that core's frame (`ModesVerified.lean`), whose
precondition, with the data `len` bytes, is `seq`'s for the data a byte at a
time (`byteMode`). Constant time as the whole-block functions.
-/

@[expose] public section

namespace VG.Proof.Seed.RISCV64.Modes

open VG VG.RISCV64 VG.Impl.Seed.RISCV64 VG.Impl.Modes
open VG.Proof.Modes.RISCV64 (SeqPre ivR scrRegion Fb byteMode)
open VG.Proof.Seed.RISCV64.Mode (dirCoreSpec KeyArgs layout total_eq)
open VG.Proof.Seed.RISCV64 (modePub modes_ofRegs)

/-- The final functions' postconditions. -/
def encFinalPost (s s' : State) : Prop :=
  Spec.Cfb.EncryptFinal (ciph s) 16 s.mem s'.mem (s.gpr .a1) (s.gpr .a2) (s.gpr .a3).toNat
def decFinalPost (s s' : State) : Prop :=
  Spec.Cfb.DecryptFinal (ciph s) 16 s.mem s'.mem (s.gpr .a1) (s.gpr .a2) (s.gpr .a3).toNat
def ofbFinalPost (s s' : State) : Prop :=
  Spec.Ofb.CryptFinal (ciph s) 16 s.mem s'.mem (s.gpr .a1) (s.gpr .a2) (s.gpr .a3).toNat

/-- A final function on RISC-V, with its frame below the stack pointer, the
data `len` bytes, and the postcondition `post`. -/
def finalContract (post : State → State → Prop) : Contract isa where
  pre s :=
    let key : Region := ⟨s.gpr .a0, 128⟩
    let iv : Region := ⟨s.gpr .a1, 16⟩
    let data : Region := ⟨s.gpr .a2, (s.gpr .a3).toNat⟩
    let stack : Region := ⟨s.sp - frameBytes 1, frameBytes 1⟩
    s.rd = [key] ∧ s.wr = [iv, data] ∧
      key.Disjoint iv ∧ key.Disjoint data ∧ iv.Disjoint data ∧
      (s.gpr .a1).toNat + 16 ≤ 2 ^ 64 ∧ (s.gpr .a2).toNat + (s.gpr .a3).toNat ≤ 2 ^ 64 ∧
      s.sp.toNat % 16 = 0 ∧ frameBytes 1 ≤ s.sp.toNat ∧ stack.Disjoint key ∧ stack.Disjoint iv ∧
      stack.Disjoint data
  post := post
  pub := modePub

theorem seqPreF_of {post : State → State → Prop} {s : State} (h : (finalContract post).pre s) :
    SeqPre (dirCore .encrypt 1) byteMode s := by
  obtain ⟨-, hwr, -, -, dVD, fV, fD, al, sp, -, dSV, dSD⟩ := h
  have eb : 4 * (dirCore .encrypt 1).bw = 16 := rfl
  have eS := scr_eq .encrypt 1 s
  have eV : ivR s (dirCore .encrypt 1) = ⟨s.gpr .a1, 16⟩ := rfl
  have eD : Proof.Modes.RISCV64.dataRegion (s.gpr .a2) byteMode.step (s.gpr .a3).toNat =
      ⟨s.gpr .a2, (s.gpr .a3).toNat⟩ := by
    simp only [Proof.Modes.RISCV64.dataRegion, byteMode, Nat.one_mul]
  refine ⟨al, by rw [total_eq]; exact sp, by rw [eV, hwr]; simp, fun _ => by rw [eV, hwr]; simp, by rw [eb]; exact fV,
    by rw [eD, hwr]; simp, by simp only [byteMode, Nat.one_mul]; exact fD, by rw [eD, eS]; exact dSD.symm,
    by rw [eV, eS]; exact dSV.symm, fun _ => by rw [eV, eD]; exact dVD, ⟨by decide, by rw [eb]; decide⟩,
    layout .encrypt (by decide) (by decide)⟩

theorem keyArgsF_of {post : State → State → Prop} {s : State} (h : (finalContract post).pre s) :
    KeyArgs s (Proof.Modes.RISCV64.wrs0 (dirCore .encrypt 1) byteMode s) (Spec.Seed.scheduleAt s.mem (s.gpr .a0)) := by
  obtain ⟨hrd, -, -, dKD, -, -, -, -, -, dSK, -, -⟩ := h
  refine ⟨rfl, by rw [hrd]; exact List.mem_append_left _ (List.mem_singleton_self _), fun r hr => ?_⟩
  simp only [Proof.Modes.RISCV64.wrs0, Proof.Modes.RISCV64.wrs, List.mem_cons, List.not_mem_nil,
    or_false] at hr
  rcases hr with rfl | rfl
  · show (Region.mk (s.gpr .a0) 128).Disjoint ⟨s.gpr .a2, 1 * (s.gpr .a3).toNat⟩
    rw [Nat.one_mul]; exact dKD
  · rw [scr_eq]; exact dSK.symm

theorem cfbEncryptFinal_correct (s : State) (hs : (finalContract encFinalPost).pre s) :
    ∃ t s', Exec isa cfbEncryptFinal s t s' ∧ abiPreserved s s' ∧ (finalContract encFinalPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.cfbEncFinal_wp (dirCoreSpec .encrypt 1 (by decide) (by decide)) (seqPreF_of hs) (keyArgsF_of hs))
    fun _ ⟨h1, h2, _⟩ => by simp only [cipher_enc] at h2; exact ⟨h1, h2⟩

theorem cfbDecryptFinal_correct (s : State) (hs : (finalContract decFinalPost).pre s) :
    ∃ t s', Exec isa cfbDecryptFinal s t s' ∧ abiPreserved s s' ∧ (finalContract decFinalPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.cfbDecFinal_wp (dirCoreSpec .encrypt 1 (by decide) (by decide)) (seqPreF_of hs) (keyArgsF_of hs))
    fun _ ⟨h1, h2, _⟩ => by simp only [cipher_enc] at h2; exact ⟨h1, h2⟩

theorem ofbFinal_correct (s : State) (hs : (finalContract ofbFinalPost).pre s) :
    ∃ t s', Exec isa ofbFinal s t s' ∧ abiPreserved s s' ∧ (finalContract ofbFinalPost).post s s' :=
  WP.mono (Proof.Modes.RISCV64.ofbFinal_wp (dirCoreSpec .encrypt 1 (by decide) (by decide)) (seqPreF_of hs) (keyArgsF_of hs))
    fun _ ⟨h1, h2, _⟩ => by simp only [cipher_enc] at h2; exact ⟨h1, h2⟩

/-! ## Constant time -/

theorem cfbEncryptFinal_constantTime (pre : State → Prop) : ConstantTime isa pre modePub cfbEncryptFinal :=
  VG.Taint.constantTime_of_exists (A := taint) (Taint.ofRegs [.a0, .a1, .a2, .a3])
    (fun _ _ _ _ hp => modes_ofRegs _ _ hp) (by taint_decide_sum [roundsSum])

theorem cfbDecryptFinal_constantTime (pre : State → Prop) : ConstantTime isa pre modePub cfbDecryptFinal :=
  VG.Taint.constantTime_of_exists (A := taint) (Taint.ofRegs [.a0, .a1, .a2, .a3])
    (fun _ _ _ _ hp => modes_ofRegs _ _ hp) (by taint_decide_sum [roundsSum])

theorem ofbFinal_constantTime (pre : State → Prop) : ConstantTime isa pre modePub ofbFinal :=
  VG.Taint.constantTime_of_exists (A := taint) (Taint.ofRegs [.a0, .a1, .a2, .a3])
    (fun _ _ _ _ hp => modes_ofRegs _ _ hp) (by taint_decide_sum [roundsSum])

/-! ## The contracts -/

theorem cfbEncryptFinal_verified :
    Verified RISCV64.target cfbEncryptFinal (Spec.Seed.cfbEncryptFinalContract RISCV64.abi (frameBytes 1)) := by
  refine Verified.of_correct cfbEncryptFinal_correct (cfbEncryptFinal_constantTime _) ?_
  contract_implies [Spec.Seed.cfbEncryptFinalContract, Spec.Seed.cfbFinalSig, RISCV64.abi,
    RISCV64.argRegs, finalContract, encFinalPost, modePub_iff] [modeSat] using modeSat


module
public import VerifiedGarbage.Proof.Bignum.AArch64.PubSetup

import VerifiedGarbage.Proof.Bignum.Octets
import VerifiedGarbage.Proof.Framework.Offset
public import Mathlib.Tactic.ToDual
import VerifiedGarbage.Proof.Dsa.AArch64.Run
import VerifiedGarbage.Proof.Framework.Contract
import VerifiedGarbage.Proof.Framework.RegionsSub

/-! # Previously generated byte buffers as arithmetic inputs -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Proof.Bignum VG.Proof.Bignum.AArch64

theorem arena_source {s : State} {B work : Addr} {size Z d : Nat} {bs : List Byte}
    (h : Scr s B size) (hb : d + bs.length ≤ size) (hlen : bs.length < 2 ^ 64)
    (bytes : Spec.Rsa.bytesAt s.mem (VG.Proof.Bignum.off B d) bs.length = bs)
    (sep : (⟨VG.Proof.Bignum.off B d, bs.length⟩ : Region).Disjoint ⟨work, Z⟩) : Src s work Z (VG.Proof.Bignum.off B d) bs := by
  refine ⟨fun i hi => ?_, fun i hi => ?_, fun i hi => ?_⟩
  · change InRegions (s.rd ++ s.wr) (VG.Proof.Bignum.off (VG.Proof.Bignum.off B d) i) 1
    rw [VG.Proof.Bignum.off_off]
    obtain ⟨r, hr, hc⟩ := h.region (d := d + i) (n := 1) (by omega) (by decide)
    exact ⟨r, List.mem_append_right _ hr, hc⟩
  · have he := congrArg (fun xs : List Byte => xs[i]?) bytes
    simpa only [Spec.Rsa.bytesAt, List.getElem?_map, List.getElem?_range, hi, ↓reduceIte,
      Option.map_some, List.getElem?_eq_getElem hi, Option.some.injEq] using he
  · exact out_scr sep (Offset.contains_base _ (by omega) (by omega))

end VG.Proof.Dsa.AArch64.Generation

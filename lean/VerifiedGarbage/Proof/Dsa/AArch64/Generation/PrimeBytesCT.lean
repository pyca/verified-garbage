/-! ### `Dsa.AArch64.Generation.TrialCT`, which only this module used -/

section

/-! Trial division to the first divisor leaks the same in runs with the same candidate:
RSA's timing proof of a word of the table, and a count of words that the candidate gives. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Rsa.AArch64.Keys VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.Rsa.AArch64 VG.Proof.RsaKeyGen.AArch64
open VG.Proof.MlKem.AArch64 VG.Impl.Dsa.AArch64.Generation

theorem nativeTrialHead_ok {q : VG.Proof.RsaKeyGen.AArch64.FPub} {s : State} (hw : VG.Proof.Rsa.AArch64.Ws s q.B q.Z q.w)
    (hT : slot q.w aTab + 2048 ≤ q.Z) :
    WP isa (.block (ws ++ base aTab .x9 ++ tabWrite ++ [movi .x3 128, movi .x4 256, movi .x5 17,
      .subs .x .x6 .x12 .x5, .csel .x .x10 .x4 .x3, movi .x1 0, movi .x7 0, .subImm .x .x8 .x7 1])) s fun t =>
      (0 < trN q ∧ TI q 0 t) ∧ wv t.mem q.B (slot q.w aN) q.w = wv s.mem q.B (slot q.w aN) q.w := by
  have hn := hw.scr.nowrap
  rw [WP.block_append_iff, WP.block_append_iff, WP.block_append_iff]
  refine WP.mono hw.ws_ok fun s₁ ⟨⟨h12₁, h11₁, hm₁, _⟩, k₁⟩ => ?_
  refine WP.mono (base_ok aTab .x9 ((k₁.gpr .x0 (by decide)).trans hw.x0) h11₁)
    fun s₂ ⟨⟨h9₂, hm₂, _⟩, k₂⟩ => ?_
  refine WP.mono (tabWrites_ok (hw.scr.congr (k₁.trans k₂).wr) hT h9₂ 256 (Nat.le_refl _))
    fun s₃ ⟨htab₃, ho₃, k₃⟩ => ?_
  rw [hm₂, hm₁] at ho₃
  have h12₃ : s₃.gpr .x12 = BitVec.ofNat 64 q.w :=
    (k₃.gpr .x12 (by decide)).trans ((k₂.gpr .x12 (by decide)).trans h12₁)
  refine WP.mono (trialInit_ok s₃ h12₃ hw.w2) fun s₄ ⟨⟨h10₄, h1₄, h7₄, h8₄, hm₄⟩, k₄⟩ => ?_
  have k14 := ((k₁.trans k₂).trans k₃).trans k₄
  have hf₄ : Frm q.B [(slot q.w aTab, 2048)] s.mem s₄.mem := by rw [hm₄]; exact Frm.of_outside ho₃ (by simp)
  have hTa : slot q.w aN + 8 * q.w ≤ slot q.w aTab := by unfold slot aN aTab; omega
  refine ⟨?_, by rw [hm₄, ho₃.wv (Or.inl hTa) (by omega_using [hT, hn, hTa])]⟩
  refine ⟨(trN_le q).2, hw.congr' hf₄ (fun r hr => by rw [List.mem_singleton.mp hr]; exact KMut.ofSlot _ _ _) k14
    (by decide), hT, by rw [k₄.gpr .x9 (by decide), k₃.gpr .x9 (by decide), h9₂, Nat.mul_zero, Nat.add_zero],
    by rw [h10₄, Nat.sub_zero]; rfl, h7₄, h8₄, fun i hi => by rw [hm₄]; exact htab₃ i hi,
    by rw [h1₄, Nat.mul_zero, anyPre_zero]; rfl⟩

/-- The public data of DSA's trial division: the workspace, and the candidate. -/
abbrev EPub := VG.Proof.RsaKeyGen.AArch64.FPub × Nat

/-- The words of the table the loop runs for the candidate. -/
abbrev earlyN (q : EPub) : Nat := earlyWords q.2 (trN q.1)

/-- Before word `k` of the table. -/
def EI (q : EPub) (k : Nat) (s : State) : Prop :=
  TI q.1 k s ∧ wv s.mem q.1.B (slot q.1.w aN) q.1.w = q.2

/-- One word of the table, and whether the loop runs another. -/
theorem earlyTrialIter_ok {q : EPub} {k : Nat} {s : State} (hk : k < earlyN q) (h : EI q k s) :
    WP isa (seqs (trialWord ++
      ([.block [.logic .eor .x .x3 .x1 .x8, .logic .and .x .x10 .x10 .x3]] : List (Prog isa)))) s fun t =>
      isa.eval (.nonzero .x .x10) t = some (decide (k + 1 < earlyN q)) ∧ (k + 1 < earlyN q → EI q (k + 1) t) ∧
        (k + 1 = earlyN q → True) := by
  obtain ⟨⟨hw, hT, h9, h10, h7, h8, htab, h1⟩, hc⟩ := h
  have hN := trN_le q.1
  have hkT : k < trN q.1 := Nat.lt_of_lt_of_le hk (earlyWords_le _ _)
  rw [hc] at h1
  refine WP.mono (earlyIter_ok (s₀ := s) hc hT hkT hN.1 htab ⟨hw, h7, h8, rfl, Keep.refl _ _⟩ h9 h1 h10)
    fun t ⟨hI, h9', h1', h10'⟩ => ⟨?_, fun hk' => ⟨⟨hI.ws, hT, h9', ?_, hI.x7, hI.x8, fun i hi => by
      rw [hI.mem]; exact htab i hi, by rw [h1', hI.mem, hc]⟩, by rw [hI.mem]; exact hc⟩, fun _ => trivial⟩
  · rw [eval_nonzero, h10']
    exact congrArg some (early_cond hk hN.1)
  · rw [h10', (lt_earlyWords.mp hk').2]; rfl

/-- One word of the table leaks the same. -/
theorem earlyTrialBody_ct : RelCT isa (Two fun (p : EPub × Nat) s => p.2 < earlyN p.1 ∧ EI p.1 p.2 s)
    (seqs (trialWord ++
      ([.block [.logic .eor .x .x3 .x1 .x8, .logic .and .x .x10 .x10 .x3]] : List (Prog isa))))
    fun _ _ => True := by
  refine RelCT.seqs_append trialWord_ne (by simp) (RelCT.seq (two_post (Ψ := fun _ _ => True)
    (two_map (fun p : EPub × Nat => (p.1.1, p.2))
      (fun p s h => ⟨Nat.lt_of_lt_of_le h.1 (earlyWords_le _ _), h.2.1⟩) trialBody_ct)
    (fun p s h => ?_)) (two_taint [] (pins_nil₀ _) (by taint_decide)))
  obtain ⟨hk, ⟨hw, hT, h9, h10, h7, h8, htab, h1⟩, hc⟩ := h
  have hN := trN_le p.1.1
  have hkT : p.2 < trN p.1.1 := Nat.lt_of_lt_of_le hk (earlyWords_le _ _)
  exact WP.mono (tlIter_ok (s₀ := s) rfl hT (by omega_using [hkT, hN])
    htab ⟨hw, h7, h8, rfl, Keep.refl _ _⟩ h9 h1) fun _ _ => trivial

/-- Trial division to the first divisor leaks the same in runs with the same
workspace and candidate. It needs the table's actual bound, without RSA
keygen's larger arena. -/
theorem trialEarly_ct :
    RelCT isa (Two fun (q : EPub) s => VG.Proof.Rsa.AArch64.Ws s q.1.B q.1.Z q.1.w ∧
      slot q.1.w aTab + 2048 ≤ q.1.Z ∧ wv s.mem q.1.B (slot q.1.w aN) q.1.w = q.2) (seqs trialEarly)
      (fun _ _ => True) := by
  have hh := fun (q : EPub) s (h : VG.Proof.Rsa.AArch64.Ws s q.1.B q.1.Z q.1.w ∧ slot q.1.w aTab + 2048 ≤ q.1.Z ∧
      wv s.mem q.1.B (slot q.1.w aN) q.1.w = q.2) =>
    WP.mono (nativeTrialHead_ok h.1 h.2.1) fun t ⟨⟨_, hI⟩, hc⟩ =>
      (⟨earlyWords_pos q.2 (trN_le q.1).2, hI, hc.trans h.2.2⟩ : 0 < earlyN q ∧ EI q 0 t)
  simp only [List.append_assoc] at hh
  simp only [trialEarly, seqs, List.append_assoc]
  refine RelCT.seq (two_post (ws_block_ct0 (fun q : EPub => q.1.B) (fun q => q.1.Z) (fun q => q.1.w)
      (fun _ _ h => h.1) (by taint_decide)) hh)
    ((two_loop (Φ := EI) (Ψ := fun _ _ => True) earlyN earlyTrialBody_ct fun _ _ _ hk h => earlyTrialIter_ok hk h).mono
      (fun _ _ h => h) fun _ _ _ => trivial)

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! Timing of the complete native probable-prime operation. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG.Impl.RsaKeyGen.AArch64.Candidate
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.RsaKeyGen.AArch64 VG.Proof.MillerRabin.AArch64

structure PrimeCallPublic where
  draw : DrawPublic
  arena : Addr
  base : draw.prime.B = VG.Proof.Bignum.off arena VG.Impl.Dsa.Generation.Layout.arithmetic
  width : draw.prime.w ≤ 48
  tab : slot draw.prime.w aTab + 2048 ≤ draw.prime.Z
  large : 8161 < draw.prime.N
  policy : 1024 < Spec.Dsa.bitLength draw.prime.N ↔ 16 < draw.prime.w

def PrimeCallBefore (len drawBytes : Nat) (p : PrimeCallPublic) (s : State) : Prop :=
  PrimeInput p.draw.prime p.draw.used s ∧ p.draw.used ≤ p.draw.prime.rand.length ∧
    p.draw.prime.len = len ∧ p.draw.prime.drawBytes = drawBytes

/-- Trial division uses only the public workspace coordinates from RSA's context. -/
def PrimeParams.trialPublic (p : PrimeParams) : VG.Proof.RsaKeyGen.AArch64.FPub :=
  ⟨p.B, p.Z, p.w, [], 0, 0, 0, [], 0, 0, 0, 0, ⟨false, false, false, none⟩⟩

theorem primeTrial_ct (len drawBytes : Nat) : RelCT isa (Two (PrimeCallBefore len drawBytes)) (seqs Impl.Dsa.AArch64.Generation.trialEarly) (fun _ _ => True) :=
  two_map (fun p : PrimeCallPublic => (p.draw.prime.trialPublic, p.draw.prime.N))
    (fun p _ h => ⟨h.1.ws, p.tab, h.1.n⟩) trialEarly_ct

def PrimeCallTested (len drawBytes : Nat) (p : PrimeCallPublic) (s : State) : Prop :=
  PrimeCallBefore len drawBytes p s ∧
    isa.eval (.zero .x .x1) s = some (!Spec.RsaKeyGen.obviouslyComposite (Spec.Dsa.bitLength p.draw.prime.N) p.draw.prime.N)

theorem primeTrial_tested {len drawBytes : Nat} {p : PrimeCallPublic} {s : State} (h : PrimeCallBefore len drawBytes p s) :
    WP isa (seqs Impl.Dsa.AArch64.Generation.trialEarly) s (PrimeCallTested len drawBytes p) :=
  WP.mono (primeTrial_ok h.1 p.width p.tab p.large p.policy) fun _ ⟨hz, ht, _, _⟩ => ⟨⟨ht, h.2⟩, hz⟩

theorem primeCall_setup {len drawBytes : Nat} {p : PrimeCallPublic} {s : State} (h : PrimeCallBefore len drawBytes p s) :
    PrimeSetupBefore p.draw.prime s := ⟨h.1.ws, h.1.n, p.width⟩

theorem primeCall_ready (M : Mont) {len drawBytes : Nat} {p : PrimeCallPublic} {s : State} (h : PrimeCallBefore len drawBytes p s) :
    WP isa (Impl.Dsa.AArch64.Generation.primeSetup M.mm) s
      (fun t => DrawBefore len drawBytes p.draw t ∧ p.draw.used ≤ p.draw.prime.rand.length) :=
  WP.mono (primeInputSetup_ok M h.1 p.width) fun _ ⟨ht, _, _⟩ => ⟨⟨ht, h.2.2⟩, h.2.1⟩

theorem probablePrime_ct (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) (len drawBytes : Nat) {hc₁ hc₂ : VG.Taint.Hint VG.AArch64.Taint.T}
    (ht₁ : (taint.check (Taint.ofRegs [.x0])
      (.block (Impl.Dsa.AArch64.Generation.drawCopyArgs len drawBytes)) hc₁).isSome = true)
    (ht₂ : (taint.check (Taint.ofRegs [.x1])
      (.block (Impl.Dsa.AArch64.Generation.forceWitness len)) hc₂).isSome = true) :
    RelCT isa (Two (PrimeCallBefore len drawBytes)) (Impl.Dsa.AArch64.Generation.probablePrime M.mm K.run len drawBytes) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.probablePrime
  refine RelCT.seq (two_post (primeTrial_ct len drawBytes) (fun _ _ h => primeTrial_tested h)) ?_
  refine two_ite (fun _ _ _ hs ht => hs.2.trans ht.2.symm) ?_ ?_
  · refine RelCT.seq (two_post
      (two_map (fun p : PrimeCallPublic => p.draw.prime) (fun _ _ h => primeCall_setup h.1.1) (primeSetup_ct M))
      (fun _ _ h => primeCall_ready M h.1.1)) ?_
    exact two_map PrimeCallPublic.draw (fun _ _ h => h) (millerRabin_ct M K len drawBytes ht₁ ht₂)
  · exact two_taint [.x0] (fun _ _ _ hs ht r hr => by
      obtain rfl := List.mem_singleton.mp hr
      exact hs.1.1.1.ws.x0.trans ht.1.1.1.ws.x0.symm) (by taint_decide)

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! Test saved candidate bytes using the shared native primality operation. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MillerRabin.AArch64
open VG.Impl.Bignum.AArch64 VG.Impl.RsaKeyGen.AArch64.Candidate

structure PrimeBytesPublic where
  call : PrimeCallPublic
  source : Addr
  bytes : List Byte
  length : bytes.length = call.draw.prime.len
  value : Spec.Rsa.os2ip bytes = call.draw.prime.N

def PrimeBytesBefore (len drawBytes : Nat) (p : PrimeBytesPublic) (s : State) : Prop :=
  PrimeArguments p.call.draw.prime p.call.draw.used s ∧
    word s.mem p.call.draw.prime.B 160 = p.source ∧ Src s p.call.draw.prime.B p.call.draw.prime.Z p.source p.bytes ∧
    p.call.draw.used ≤ p.call.draw.prime.rand.length ∧ p.call.draw.prime.len = len ∧ p.call.draw.prime.drawBytes = drawBytes

theorem primeBytesLoad_ct (len drawBytes : Nat) : RelCT isa (Two (PrimeBytesBefore len drawBytes))
    (seqs (Impl.Rsa.AArch64.Keys.loadA 0 20 kUsedP)) (fun _ _ => True) :=
  VG.Proof.RsaKeyGen.AArch64.loadA_ct0 (fun p : PrimeBytesPublic => p.call.draw.prime.B)
    (fun p => p.call.draw.prime.Z) (fun p => p.call.draw.prime.w)
    (by decide) (by decide) (by decide) PrimeBytesPublic.source (fun p => p.call.draw.prime.len)
    (fun _ _ h => ⟨h.1.ws, h.2.1, h.1.len⟩) (by taint_decide) (by taint_decide) (by taint_decide)

theorem primeBytesLoad_ready {len drawBytes : Nat} {p : PrimeBytesPublic} {s : State}
    (h : PrimeBytesBefore len drawBytes p s) :
    WP isa (seqs (Impl.Rsa.AArch64.Keys.loadA 0 20 kUsedP)) s (PrimeCallBefore len drawBytes p.call) :=
  WP.mono (loadPrimeBytes_ok h.1 h.2.1 p.length p.value h.2.2.1) (fun _ ⟨ht, _, _⟩ => ⟨ht, h.2.2.2⟩)

theorem primeBytes_ct (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) (len drawBytes : Nat) {hc₁ hc₂ : VG.Taint.Hint VG.AArch64.Taint.T}
    (ht₁ : (taint.check (Taint.ofRegs [.x0])
      (.block (Impl.Dsa.AArch64.Generation.drawCopyArgs len drawBytes)) hc₁).isSome = true)
    (ht₂ : (taint.check (Taint.ofRegs [.x1])
      (.block (Impl.Dsa.AArch64.Generation.forceWitness len)) hc₂).isSome = true) :
    RelCT isa (Two (PrimeBytesBefore len drawBytes)) (Impl.Dsa.AArch64.Generation.primeBytes M.mm K.run len drawBytes) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.primeBytes
  exact RelCT.seq (two_post (primeBytesLoad_ct len drawBytes) (fun _ _ h => primeBytesLoad_ready h))
    (two_map PrimeBytesPublic.call (fun _ _ h => h) (probablePrime_ct M K len drawBytes ht₁ ht₂))

end VG.Proof.Dsa.AArch64.Generation

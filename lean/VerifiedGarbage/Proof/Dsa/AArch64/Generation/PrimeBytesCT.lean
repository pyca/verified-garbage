/-! Witness selection, the shared callable round, and its completion policy. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Rsa.AArch64.Keys VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.Rsa.AArch64 VG.Proof.RsaKeyGen.AArch64
open VG.Proof.MillerRabin.AArch64

structure RoundPublic where
  prime : PrimeParams
  witness : Nat

def BeforeRound (p : RoundPublic) (s : State) : Prop :=
  ModulusReady s p.prime.B p.prime.Z p.prime.w p.prime.N ∧
    wv s.mem p.prime.B (slot p.prime.w aX) p.prime.w = p.witness

def SamplePublic.round (p : SamplePublic) : RoundPublic :=
  ⟨p.prime, (Spec.RsaKeyGen.witness (p.prime.N - 1) (Spec.Rsa.os2ip p.bytes)).1⟩

theorem sampleRound_ready {len : Nat} {p : SamplePublic} {s : State} (h : SampleSized len p s) :
    WP isa (Impl.Dsa.AArch64.Generation.sampleWitness len) s (BeforeRound p.round) := by
  rw [← h.2]
  exact WP.mono (sampleWitness_ok h.1 p.prime.exponentRoom p.prime.odd
    (by rw [p.length]; exact p.prime.len2)
    (by rw [p.length]; have := p.prime.lenDraw; have := p.prime.drawMax; omega_arith)
    (by rw [p.length]; exact p.prime.lenWords) (by rw [p.length]; exact p.prime.predBits))
    (fun _ ⟨hr, hx, _, _, _⟩ => ⟨hr, hx⟩)

theorem witnessMont_ready (M : Mont) {p : RoundPublic} {s : State} (h : BeforeRound p s) :
    WP isa (M.mm aXm aX aR2) s (BeforeC (⟨p.prime.B, p.prime.Z, p.prime.w⟩, p.prime.N)) := by
  refine WP.mono (witnessMont_ok M h.1 p.prime.exponentRoom p.prime.odd (by have := p.prime.n3; omega_using [this]) h.2)
    fun t ⟨ht, hx, _, _⟩ => ?_
  refine ⟨p.prime.w4, p.prime.w128, p.prime.exponentRoom,
    wv t.mem p.prime.B (slot p.prime.w aB) p.prime.w, p.witness,
    ⟨ht.ws, ht.inverse, ht.modulus, rfl, ht.r1, ht.rm1⟩, ht.exponent, p.prime.odd, p.prime.n3, ?_⟩
  simpa only [Nat.mod_mul_mod] using hx

theorem witnessRound_ct (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) :
    RelCT isa (Two BeforeRound) (Impl.Dsa.AArch64.Generation.witnessRound M.mm K.run) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.witnessRound
  exact RelCT.seq (two_post
    (two_map (fun p : RoundPublic => (⟨p.prime.B, p.prime.Z, p.prime.w⟩ : VG.Proof.Bignum.AArch64.Ws))
      (fun _ _ h => ⟨_, h.1.ws.good⟩) (M.ct (o := aXm) (a := aX) (b := aR2) (by unfold MmUse; decide)))
    (fun _ _ h => witnessMont_ready M h))
    (two_map (fun p : RoundPublic => ((⟨p.prime.B, p.prime.Z, p.prime.w⟩, p.prime.N) : CPub))
      (fun _ _ h => h) K.ct)

def roundTailPublic (p : RoundPublic) : RoundTailPublic :=
  ⟨p.prime, Proof.MillerRabin.Round.round p.prime.N p.witness⟩

theorem roundTail_ready (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) {p : RoundPublic} {s : State} (h : BeforeRound p s) :
    WP isa (Impl.Dsa.AArch64.Generation.witnessRound M.mm K.run) s (RoundTailState (roundTailPublic p)) :=
  WP.mono (witnessRound_ok M K h.1 p.prime.w4 p.prime.w128 p.prime.exponentRoom p.prime.odd p.prime.n3 h.2)
    (fun _ ⟨ht, flag, _, _⟩ => ⟨ht.ws, flag⟩)

theorem sampleRound_ct (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) (len : Nat) {hc : VG.Taint.Hint VG.AArch64.Taint.T}
    (ht : (taint.check (Taint.ofRegs [.x1])
      (.block (Impl.Dsa.AArch64.Generation.forceWitness len)) hc).isSome = true) :
    RelCT isa (Two (SampleSized len)) (Impl.Dsa.AArch64.Generation.sampleRound M.mm K.run len) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.sampleRound
  refine RelCT.seq (two_post (sampleWitness_ct len ht) (fun _ _ h => sampleRound_ready h)) ?_
  exact RelCT.seq (two_post (two_map SamplePublic.round (fun _ _ h => h) (witnessRound_ct M K))
    (fun _ _ h => roundTail_ready M K h))
    (two_map (fun p : SamplePublic => roundTailPublic p.round) (fun _ _ h => h) roundTail_ct)

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! A complete entropy draw and shared primality round have a public trace. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Proof.Bignum.AArch64 VG.Proof.MillerRabin.AArch64

def DrawSized (len drawBytes : Nat) (p : DrawPublic) (s : State) : Prop :=
  DrawBefore len drawBytes p s ∧ p.used + p.prime.drawBytes ≤ p.prime.rand.length

def DrawPublic.sample (p : DrawPublic) (h : p.used + p.prime.drawBytes ≤ p.prime.rand.length) : SamplePublic :=
  ⟨p.prime, p.prime.drawSlice p.used, p.prime.slice_length h⟩

theorem drawSample_state {len drawBytes : Nat} {p : DrawPublic} {s : State} (h : DrawSized len drawBytes p s) :
    WP isa (Impl.Dsa.AArch64.Generation.drawCopy len drawBytes) s (SampleSized len (p.sample h.2)) := by
  have hw := drawBuffer_ok h.1.1 h.2
  rw [h.1.2.1, h.1.2.2] at hw
  exact WP.mono hw fun _ ⟨_, ht, _, _⟩ => ⟨ht, (p.prime.slice_length h.2).trans h.1.2.1⟩

theorem drawRound_ct (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) (len drawBytes : Nat) {hc₁ hc₂ : VG.Taint.Hint VG.AArch64.Taint.T}
    (ht₁ : (taint.check (Taint.ofRegs [.x0])
      (.block (Impl.Dsa.AArch64.Generation.drawCopyArgs len drawBytes)) hc₁).isSome = true)
    (ht₂ : (taint.check (Taint.ofRegs [.x1])
      (.block (Impl.Dsa.AArch64.Generation.forceWitness len)) hc₂).isSome = true) :
    RelCT isa (Two (DrawSized len drawBytes)) (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.drawRound
  refine RelCT.seq (two_post (Ψ := fun p s => ∃ h, SampleSized len (p.sample h) s)
    (two_map id (fun _ _ h => h.1) (drawCopy_ct len drawBytes ht₁))
    (fun _ _ h => WP.mono (drawSample_state h) fun _ ht => ⟨h.2, ht⟩)) ?_
  apply (sampleRound_ct M K len ht₂).mono
  · rintro s t ⟨p, ⟨hs, h⟩, ⟨ht, h'⟩, hsp⟩
    exact ⟨p.sample hs, h, h', hsp⟩
  · exact fun _ _ h => h

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! # The guarded primality iteration reveals only the public tape and round -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MillerRabin.AArch64
open VG.Proof.RsaKeyGen.AArch64

structure PrimeIterationPublic where
  draw : DrawPublic
  i : Nat
  uni : Nat

def IterationBefore (len drawBytes : Nat) (p : PrimeIterationPublic) (s : State) : Prop :=
  DrawBefore len drawBytes p.draw s ∧ p.draw.used ≤ p.draw.prime.rand.length ∧
    word s.mem p.draw.prime.B (8 * kI) = BitVec.ofNat 64 p.i ∧
    word s.mem p.draw.prime.B (8 * kUni) = BitVec.ofNat 64 p.uni ∧
    p.i < 2 ^ 62 ∧ p.uni < 2 ^ 62

def IterationChecked (len drawBytes : Nat) (p : PrimeIterationPublic) (s : State) : Prop :=
  IterationBefore len drawBytes p s ∧
    isa.eval (.zero .x .x5) s = some (decide (p.draw.prime.rand.length < p.draw.used + p.draw.prime.drawBytes))

theorem iterationCheck_state {len drawBytes : Nat} {p : PrimeIterationPublic} {s : State}
    (h : IterationBefore len drawBytes p s) :
    WP isa (.block Impl.Dsa.AArch64.Generation.tapeCheck) s (IterationChecked len drawBytes p) := by
  have hs := h.1.1
  refine WP.mono (tapeCheck_ok hs h.2.1) fun t ⟨hcf, hm, hk⟩ => ?_
  exact ⟨⟨⟨hs.of_mem hm (hk.mono (by decide)), h.1.2⟩, h.2.1,
    by rw [hm]; exact h.2.2.1, by rw [hm]; exact h.2.2.2.1, h.2.2.2.2⟩, hcf⟩

theorem iterationDraw_state (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) {len drawBytes : Nat}
    {p : PrimeIterationPublic} {s : State} (h : IterationBefore len drawBytes p s)
    (hr : p.draw.used + p.draw.prime.drawBytes ≤ p.draw.prime.rand.length) :
    WP isa (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes) s
      (fun t => t.gpr .x0 = p.draw.prime.B) := by
  have hs := h.1.1
  have hw := drawRound_ok M K hs hr h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2
  rw [h.1.2.1, h.1.2.2] at hw
  exact WP.mono hw fun _ ht => ht.1.ready.ws.x0

theorem primeIteration_ct (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) (len drawBytes : Nat)
    {hc₁ hc₂ : VG.Taint.Hint VG.AArch64.Taint.T}
    (ht₁ : (taint.check (Taint.ofRegs [.x0])
      (.block (Impl.Dsa.AArch64.Generation.drawCopyArgs len drawBytes)) hc₁).isSome = true)
    (ht₂ : (taint.check (Taint.ofRegs [.x1])
      (.block (Impl.Dsa.AArch64.Generation.forceWitness len)) hc₂).isSome = true) :
    RelCT isa (Two (IterationBefore len drawBytes))
      (Impl.Dsa.AArch64.Generation.primeIteration
        (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes)) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.primeIteration
  simp only [seqs]
  refine RelCT.seq (two_post (two_taint [.x0] ?_ (by taint_decide))
    (fun _ _ h => iterationCheck_state h)) ?_
  · intro p s t hs ht r hr
    simp only [List.mem_singleton] at hr
    subst r
    have hs := hs.1.1
    have ht := ht.1.1
    exact hs.ready.ws.x0.trans ht.ready.ws.x0.symm
  · refine two_ite_seq (fun _ _ _ hs ht => hs.2.trans ht.2.symm) ?_ ?_
    · exact two_taint [.x0] (by
        intro p s t hs ht r hr
        simp only [List.mem_singleton] at hr
        subst r
        have hs := hs.1.1.1.1
        have ht := ht.1.1.1.1
        exact hs.ready.ws.x0.trans ht.ready.ws.x0.symm) (by taint_decide)
    · have room (p : PrimeIterationPublic) (s : State)
          (h : IterationChecked len drawBytes p s ∧ isa.eval (.zero .x .x5) s = some false) :
          p.draw.used + p.draw.prime.drawBytes ≤ p.draw.prime.rand.length := by
        have he := Option.some.inj (h.1.2.symm.trans h.2)
        simpa only [decide_eq_false_iff_not, Nat.not_lt] using he
      refine RelCT.seq (two_post
        (two_map PrimeIterationPublic.draw (fun p s h => ⟨h.1.1.1, room p s h⟩)
          (drawRound_ct M K len drawBytes ht₁ ht₂))
        (fun p s h => iterationDraw_state M K h.1.1 (room p s h))) ?_
      exact two_taint [.x0] (by
        intro p s t hs ht r hr
        simp only [List.mem_singleton] at hr
        subst r
        exact hs.trans ht.symm) (by taint_decide)

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! # Public transitions of the finite DSA witness loop -/

-- Formerly `VerifiedGarbage/Proof/Dsa/AArch64/Generation/IterationPublic.lean`, which only this module imported.
section

/-! # The next primality branch and uniform counter are functions of public inputs -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MillerRabin.AArch64
open VG.Proof.RsaKeyGen.AArch64

def PrimeIterationPublic.witness (p : PrimeIterationPublic) : Nat × Bool :=
  Spec.RsaKeyGen.witness (p.draw.prime.N - 1)
    (Spec.Rsa.os2ip ((p.draw.prime.rand.drop p.draw.used).take p.draw.prime.drawBytes))

def PrimeIterationPublic.nextUniform (p : PrimeIterationPublic) : Nat := p.uni + p.witness.2.toNat

def PrimeIterationPublic.continues (p : PrimeIterationPublic) : Bool :=
  decide (p.draw.used + p.draw.prime.drawBytes ≤ p.draw.prime.rand.length) &&
    Proof.MillerRabin.Round.round p.draw.prime.N p.witness.1 &&
    decide (p.i + 1 < 17 ∨ p.nextUniform < p.draw.prime.checks)

theorem iteration_public (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) {p : PrimeIterationPublic} 
    {s₀ s : State} {res : Option (Bool × List Byte)}
    (h : PrimeLoopState p.draw.prime s₀ res p.i p.uni p.draw.used s) :
    WP isa (Impl.Dsa.AArch64.Generation.primeIteration
      (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run p.draw.prime.len p.draw.prime.drawBytes)) s
      (fun t => isa.eval (.zero .x .x3) t = some p.continues ∧
        (p.continues = true → word t.mem p.draw.prime.B (8 * kUni) = BitVec.ofNat 64 p.nextUniform)) := by
  unfold Impl.Dsa.AArch64.Generation.primeIteration
  simp only [seqs]
  refine WP.seq (WP.mono (tapeCheck_ok h.state h.usedBound) fun u ⟨hcf, hm, ku⟩ => ?_)
  have hu := h.of_mem hm (ku.mono (by decide))
  refine WP.seq (WP.ite (decide (p.draw.prime.rand.length < p.draw.used + p.draw.prime.drawBytes))
    hcf (fun hshort => ?_) (fun hroom => ?_))
  · have hs : ¬ p.draw.used + p.draw.prime.drawBytes ≤ p.draw.prime.rand.length := by
      simpa only [decide_eq_true_eq, Nat.not_le] using hshort
    exact WP.seq_iff.mp (WP.mono (loopExhausted_ok hu (by omega_using [hs])) fun _ ht => by
      simpa only [PrimeIterationPublic.continues, decide_eq_false hs, Bool.false_and,
        Bool.false_eq_true, false_implies, and_true] using ht.1)
  · have hr : p.draw.used + p.draw.prime.drawBytes ≤ p.draw.prime.rand.length := by
      simpa only [decide_eq_false_iff_not, Nat.not_lt] using hroom
    apply WP.seq_iff.mp
    refine WP.seq (WP.mono (drawRound_ok M K hu.state hr hu.ki hu.kuni
      hu.counter_bound.1 hu.counter_bound.2) fun v ⟨hv, hstat, hcount, _, _⟩ => ?_)
    change word v.mem p.draw.prime.B (8 * kStat) = BitVec.ofNat 64
      (if Proof.MillerRabin.Round.round p.draw.prime.N p.witness.1 then
        (if p.i + 1 < 17 ∨ p.nextUniform < p.draw.prime.checks then 4 else 1) else 3) at hstat
    refine WP.mono (statCmp_ok hv.ready.ws
      (by split <;> (try split) <;> decide) hstat) fun t ⟨hz, hmem, _⟩ => ?_
    constructor
    · by_cases hp : Proof.MillerRabin.Round.round p.draw.prime.N p.witness.1 = true <;>
        by_cases hg : p.i + 1 < 17 ∨ p.nextUniform < p.draw.prime.checks <;>
        simpa [PrimeIterationPublic.continues, hr, hp, hg] using hz
    · intro hg
      have hp : Proof.MillerRabin.Round.round p.draw.prime.N p.witness.1 = true := by
        have hh := hg
        simp only [PrimeIterationPublic.continues, Bool.and_eq_true] at hh
        exact hh.1.2
      rw [hmem]
      exact (hcount hp).2

end VG.Proof.Dsa.AArch64.Generation
end

end

@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MillerRabin.AArch64

def PrimeIterationPublic.next (p : PrimeIterationPublic) : PrimeIterationPublic :=
  ⟨⟨p.draw.prime, p.draw.used + p.draw.prime.drawBytes⟩, p.i + 1, p.nextUniform⟩

def LoopBefore (len drawBytes : Nat) (p : PrimeIterationPublic) (s : State) : Prop :=
  (∃ s₀ res, PrimeLoopState p.draw.prime s₀ res p.i p.uni p.draw.used s) ∧
    p.draw.prime.len = len ∧ p.draw.prime.drawBytes = drawBytes

theorem LoopBefore.iteration {len drawBytes : Nat} {p : PrimeIterationPublic} {s : State}
    (h : LoopBefore len drawBytes p s) : IterationBefore len drawBytes p s := by
  obtain ⟨s₀, res, hs⟩ := h.1
  exact ⟨⟨hs.state, h.2⟩, hs.usedBound, hs.ki, hs.kuni, hs.counter_bound⟩

def LoopAfter (len drawBytes : Nat) (p : PrimeIterationPublic) (s : State) : Prop :=
  isa.eval (.zero .x .x3) s = some p.continues ∧ (p.continues = true → LoopBefore len drawBytes p.next s)

theorem primeIteration_transition (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) {len drawBytes : Nat}
    {p : PrimeIterationPublic} {s : State} (h : LoopBefore len drawBytes p s) :
    WP isa (Impl.Dsa.AArch64.Generation.primeIteration
      (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes)) s (LoopAfter len drawBytes p) := by
  obtain ⟨s₀, res, hs⟩ := h.1
  have hw := wp_and (primeIteration_ok M K hs) (iteration_public M K hs)
  rw [h.2.1, h.2.2] at hw
  refine WP.mono hw fun t ⟨ht, hz, huni⟩ => ⟨hz, fun hgo => ?_⟩
  rcases ht with ⟨he, _⟩ | ⟨_, uni', hn⟩
  · rw [hz, hgo] at he
    cases he
  · have heq : BitVec.ofNat 64 uni' = BitVec.ofNat 64 p.nextUniform := hn.kuni.symm.trans (huni hgo)
    have hb : p.witness.2.toNat ≤ 1 := by cases p.witness.2 <;> decide
    have hsmall : p.nextUniform < 2 ^ 64 := by
      unfold PrimeIterationPublic.nextUniform
      have := hs.counter_bound.2
      omega_using [hb, this]
    have hsmall' : uni' < 2 ^ 64 := by have := hn.counter_bound.2; omega_using [this]
    have he : uni' = p.nextUniform := by
      have hh := congrArg BitVec.toNat heq
      simpa only [BitVec.toNat_ofNat, Nat.mod_eq_of_lt hsmall, Nat.mod_eq_of_lt hsmall'] using hh
    subst uni'
    exact ⟨⟨s₀, res, by simpa only [PrimeIterationPublic.next, h.2.2] using hn⟩, h.2⟩

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! # Constant-time composition of the complete blinded primality loop -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Proof.Bignum.AArch64 VG.Proof.MillerRabin.AArch64

private def loopInv (len drawBytes n : Nat) : State → State → Prop :=
  Two fun p s => p.draw.prime.rand.length - p.draw.used = n ∧ LoopBefore len drawBytes p s

section
variable (M : Mont) (K : VG.Proof.Dsa.AArch64.Generation.PublicKernel) (len drawBytes : Nat)
variable {hc₁ hc₂ : VG.Taint.Hint VG.AArch64.Taint.T}
variable (ht₁ : (taint.check (Taint.ofRegs [.x0])
  (.block (Impl.Dsa.AArch64.Generation.drawCopyArgs len drawBytes)) hc₁).isSome = true)
variable (ht₂ : (taint.check (Taint.ofRegs [.x1])
  (.block (Impl.Dsa.AArch64.Generation.forceWitness len)) hc₂).isSome = true)

include ht₁ ht₂

private theorem loop_step (n : Nat) :
    RelCT isa (loopInv len drawBytes n)
      (Impl.Dsa.AArch64.Generation.primeIteration
        (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes))
      (fun s t => isa.eval (.zero .x .x3) s = isa.eval (.zero .x .x3) t ∧
        (isa.eval (.zero .x .x3) s = some false → True) ∧
        (isa.eval (.zero .x .x3) s = some true → ∃ m < n, loopInv len drawBytes m s t)) := by
  have hw : RelCT isa (loopInv len drawBytes n)
      (Impl.Dsa.AArch64.Generation.primeIteration
        (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes))
      (Two fun p s => p.draw.prime.rand.length - p.draw.used = n ∧ LoopAfter len drawBytes p s) :=
    two_post (two_map id (fun _ _ h => h.2.iteration) (primeIteration_ct M K len drawBytes ht₁ ht₂))
      (fun _ _ h => WP.mono (primeIteration_transition M K h.2) fun _ ht => ⟨h.1, ht⟩)
  refine hw.mono (fun _ _ h => h) ?_
  rintro s t ⟨p, ⟨hn, hs⟩, ⟨_, ht⟩, hsp⟩
  refine ⟨hs.1.trans ht.1.symm, fun _ => True.intro, fun he => ?_⟩
  have hg : p.continues = true := Option.some.inj (hs.1.symm.trans he)
  have hnext := hs.2 hg
  obtain ⟨s₀, res, hstate⟩ := hnext.1
  have hroom : p.draw.used + p.draw.prime.drawBytes ≤ p.draw.prime.rand.length := hstate.usedBound
  have hdraw := p.draw.prime.drawMin
  refine ⟨p.draw.prime.rand.length - (p.draw.used + p.draw.prime.drawBytes), by omega_using [hn, hroom, hdraw],
    p.next, ⟨rfl, hnext⟩, ⟨rfl, ht.2 hg⟩, hsp⟩

theorem primeLoop_ct : RelCT isa (Two (LoopBefore len drawBytes))
    (.loop (Impl.Dsa.AArch64.Generation.primeIteration
      (Impl.Dsa.AArch64.Generation.drawRound M.mm K.run len drawBytes)) (.zero .x .x3)) (fun _ _ => True) := by
  rintro s t tr₁ tr₂ u v ⟨p, hs, ht, hsp⟩ e₁ e₂
  exact RelCT.loop (loopInv len drawBytes) (loop_step M K len drawBytes ht₁ ht₂)
    (p.draw.prime.rand.length - p.draw.used) s t tr₁ tr₂ u v ⟨p, ⟨rfl, hs⟩, ⟨rfl, ht⟩, hsp⟩ e₁ e₂

theorem millerRabin_ct :
    RelCT isa (Two fun p s => DrawBefore len drawBytes p s ∧ p.used ≤ p.prime.rand.length)
      (Impl.Dsa.AArch64.Generation.millerRabin M.mm K.run len drawBytes) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.millerRabin
  refine RelCT.seq (two_post (Ψ := fun p s => LoopBefore len drawBytes ⟨p, 1, 0⟩ s)
    (two_taint [.x0] ?_ (by taint_decide)) ?_) ?_
  · intro p s t hs ht r hr
    simp only [List.mem_singleton] at hr
    subst r
    have hs := hs.1.1
    have ht := ht.1.1
    exact hs.ready.ws.x0.trans ht.ready.ws.x0.symm
  · intro p s h
    have hs := h.1.1
    exact WP.mono (primeLoopInit_ok hs h.2) fun _ ht =>
      ⟨⟨s, primeRest p.prime 1 0 p.used, ht⟩, h.1.2⟩
  · exact two_map (fun p : DrawPublic => (⟨p, 1, 0⟩ : PrimeIterationPublic))
      (fun _ _ h => h) (primeLoop_ct M K len drawBytes ht₁ ht₂)

end
end VG.Proof.Dsa.AArch64.Generation

end

end

/-! ### `Dsa.AArch64.Generation.PrimeSetupCT`, which only this module used -/

section

/-! ### `Dsa.AArch64.Generation.ExponentCT`, which only this module used -/

section

/-! RSA's exponent preparation has a public trace for every DSA candidate. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Rsa.AArch64.Keys VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.Rsa.AArch64 VG.Proof.RsaKeyGen.AArch64

def ExponentBefore (p : PrimeParams) (s : State) : Prop :=
  PrimeGood p s ∧ wv s.mem p.B (slot p.w aN) p.w = p.N

def exponentRegs (p : PrimeParams) : Reg → BitVec 64
  | .x0 => p.B
  | .x12 => BitVec.ofNat 64 p.w
  | _ => BitVec.ofNat 64 (8 * (p.w + 2))

theorem lowWord_registers {p : PrimeParams} {s : State} (h : ExponentBefore p s) :
    WP isa (seqs lowWord) s fun t => ∀ r ∈ [Reg.x0, .x12, .x11], t.gpr r = exponentRegs p r :=
  WP.mono (lowWord_ok h.1 h.2 p.odd (by have := p.n3; omega_using [this])) fun t ⟨_, _, _, _, h11, h12, hk⟩ r hr => by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl
    · exact (hk.gpr .x0 (by decide)).trans h.1.x0
    · exact h12
    · exact h11

theorem primeExponent_ct : RelCT isa (Two ExponentBefore) (seqs expSetup) (fun _ _ => True) := by
  rw [expSetup_eq]
  apply RelCT.seqs_append (by simp [lowWord]) (by simp)
  refine RelCT.seq (R := Two fun (p : PrimeParams) t => ∀ r ∈ [Reg.x0, .x12, .x11], t.gpr r = exponentRegs p r) ?_ (two_taint [.x0, .x12, .x11]
    (fun _ _ _ hs ht r hr => (hs r hr).trans (ht r hr).symm) (by taint_decide))
  have e : seqs lowWord = Code.seq _ _ := rfl
  rw [e]
  exact ws_ct PrimeParams.B PrimeParams.Z PrimeParams.w (fun _ _ h => h.1) (by taint_decide)
    (fun _ _ h => lowWord_registers h)

end VG.Proof.Dsa.AArch64.Generation

end

end

/-! Compose Montgomery constants and exponent preparation timing proofs. -/
@[expose] public section
namespace VG.Proof.Dsa.AArch64.Generation
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Rsa.AArch64.Keys VG.Impl.RsaKeyGen.AArch64.Candidate
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.Rsa.AArch64 VG.Proof.RsaKeyGen.AArch64
open VG.Proof.Ffdh.AArch64.ParameterCandidate

theorem primeConstants_exponent (M : Mont) {p : PrimeParams} {s : State} (h : PrimeR2Ready p s) :
    WP isa (seqs (Impl.Dsa.AArch64.Generation.primeConstants M.mm)) s (ExponentBefore p) := by
  obtain ⟨hw, hi, hn, hone, hr2⟩ := h
  refine WP.mono (primeConstants_ok M hw hn p.odd (by have := p.n3; omega_using [this]) hi hone hr2)
    fun t ⟨ht, _, _, _, _, hf, _⟩ => ?_
  obtain ⟨_, _, hN⟩ := mp_fix hf hw.scr.nowrap hw.hZ
  exact ⟨ht, hN.trans hn⟩

theorem primeSetup_ct (M : Mont) : RelCT isa (Two PrimeSetupBefore)
    (Impl.Dsa.AArch64.Generation.primeSetup M.mm) (fun _ _ => True) := by
  unfold Impl.Dsa.AArch64.Generation.primeSetup
  refine RelCT.seq (two_post (primeR2_ct M) (fun _ _ h => primeR2_ready M h)) ?_
  exact RelCT.seqs_append (by simp [Impl.Dsa.AArch64.Generation.primeConstants]) (by simp [expSetup, lowWord])
    (RelCT.seq (two_post (primeConstants_ct M) (fun _ _ h => primeConstants_exponent M h)) primeExponent_ct)

end VG.Proof.Dsa.AArch64.Generation

end


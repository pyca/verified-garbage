/-! # Constant-time construction of the joint power table -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Dsa.AArch64
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MlKem.AArch64

def JointBuildPre (j : Nat) (p : XPub) (s : State) : Prop :=
  ∃ (minv : BitVec 64) (n g y : Nat), JointCtx s (off p.B p.o) p.wx n minv ∧
    JointBuildValues s.mem (off p.B p.o) p.wx n g y j ∧
    2 ≤ p.wx ∧ p.wx < 2 ^ 30 ∧ 0 < n ∧ Nat.Coprime (2 ^ (64 * p.wx)) n

theorem JointBuildPre.goodW {j : Nat} {p : XPub} {s : State} (h : JointBuildPre j p s) : GoodW p.ws s :=
  let ⟨minv, _, _, _, hc, _⟩ := h; ⟨minv, hc.mod.good, Nat.le_refl _⟩

theorem jointAdvance_ct (M : Mont) (j : Nat) :
    RelCT isa (Two (JointBuildPre j)) (Joint.advance M.mm j) (fun _ _ => True) := by
  unfold Joint.advance
  split
  · refine RelCT.seq (two_post (Ψ := fun p s => GoodW p.ws s)
      (two_map (fun p : XPub => p.ws) (fun _ _ h => h.goodW) (M.ct (by unfold MmUse; decide))) ?_)
      (two_map (fun p : XPub => p.ws) (fun _ _ h => h)
        (copyArr_ct (o := aY) (a := aX) (by decide) (by decide) (by taint_decide)))
    rintro p s ⟨minv, n, g, y, hc, hv, hw, hw', hn, hR⟩
    exact WP.mono (jointProduct_ok M hc hw hw' (by unfold MmUse; decide)
      (by rw [hv.gen]; exact Nat.mod_lt _ hn)) fun t ⟨ht, _⟩ => ⟨minv, ht.mod.good, Nat.le_refl _⟩
  · exact two_map (fun p : XPub => p.ws) (fun _ _ h => h.goodW) (M.ct (by unfold MmUse; decide))

def JointBuildCTInv (j : Nat) (p : XPub) (s : State) : Prop :=
  ∃ (t₀ : State) (minv : BitVec 64) (n g y : Nat), JointBuildInv t₀ (off p.B p.o) p.wx n g y minv j s ∧
    2 ≤ p.wx ∧ p.wx < 2 ^ 30 ∧ 0 < n ∧ Nat.Coprime (2 ^ (64 * p.wx)) n

theorem jointBuildStep_ct (M : Mont) (j : Nat) (hj : j < 16) :
    RelCT isa (Two (JointBuildCTInv j)) (Joint.buildStep M.mm j) (fun _ _ => True) := by
  unfold Joint.buildStep
  refine RelCT.seq (two_post (Ψ := JointBuildPre j) ?_ ?_) (jointAdvance_ct M j)
  · refine RelCT.seq (two_post (Ψ := fun p s => s.gpr .x0 = off p.B p.o)
      (two_map (fun p : XPub => (p, j)) ?_ (toEnt_ct (a := aY) (by taint_decide))) ?_) ?_
    · rintro p s ⟨t₀, minv, n, g, y, hI, hw, hw', hn, hR⟩
      exact ⟨⟨minv, n, _, hI.ctx.exp, by rw [hI.vals.gen]; exact Nat.mod_lt _ hn, hw, hw'⟩,
        hI.ent, hj, by decide⟩
    · rintro p s ⟨t₀, minv, n, g, y, hI, hw, hw', hn, hR⟩
      exact WP.mono (toEnt_ok hI.ctx.exp hw hw' (by decide) hj hI.ent)
        fun t ⟨_, _, hk⟩ => (hk.gpr .x0 (by decide)).trans hI.ctx.mod.good.x0
    · exact x0_ct (fun p : XPub => off p.B p.o) (fun _ _ h => h) (by taint_decide)
  · rintro p s ⟨t₀, minv, n, g, y, hI, hw, hw', hn, hR⟩
    refine WP.mono (jointStore_ok hI.ctx hw hw' hj hI.ent) fun t ⟨ht, harr, _, _, _, _, _, _⟩ => ?_
    exact ⟨minv, n, g, y, ht, hI.vals.congr harr, hw, hw', hn, hR⟩

theorem jointBuildSteps_ct (M : Mont) (j count : Nat) (hcount : j + count ≤ 16) :
    RelCT isa (Two (JointBuildCTInv j)) (Joint.buildSteps M.mm j count) (fun _ _ => True) := by
  induction count generalizing j with
  | zero =>
    exact x0_ct (fun p : XPub => off p.B p.o)
      (fun _ _ ⟨_, _, _, _, _, hI, _⟩ => hI.ctx.mod.good.x0) (by simp only [Joint.buildSteps]; taint_decide)
  | succ count ih =>
    unfold Joint.buildSteps
    refine RelCT.seq (two_post (Ψ := JointBuildCTInv (j + 1)) (jointBuildStep_ct M j (by omega_using [hcount])) ?_)
      (ih (j + 1) (by omega_using [hcount]))
    rintro p s ⟨t₀, minv, n, g, y, hI, hw, hw', hn, hR⟩
    exact WP.mono (jointBuildStep_ok M hw hw' hn hR (by omega_using [hcount]) hI)
      fun t ht => ⟨t₀, minv, n, g, y, ht, hw, hw', hn, hR⟩

theorem jointBuild_ct (M : Mont) :
    RelCT isa (Two (JointBuildPre 0)) (Joint.build M.mm) (fun _ _ => True) := by
  unfold Joint.build seqs
  refine RelCT.seq (two_post (Ψ := JointBuildCTInv 0)
    (x0_ct (fun p : XPub => off p.B p.o) (fun _ _ ⟨_, _, _, _, hc, _⟩ => hc.mod.good.x0)
      (by unfold Joint.tableInit; taint_decide)) ?_) ?_
  · rintro p s ⟨minv, n, g, y, hc, hv, hw, hw', hn, hR⟩
    exact WP.mono (jointTableInit_ok hc hw' hv)
      fun t ht => ⟨t, minv, n, g, y, ht, hw, hw', hn, hR⟩
  refine RelCT.seq (two_post (Ψ := JointBuildPre 16) (jointBuildSteps_ct M 0 16 (by decide)) ?_) ?_
  · rintro p s ⟨t₀, minv, n, g, y, hI, hw, hw', hn, hR⟩
    exact WP.mono (jointBuildSteps_ok M hw hw' hn hR (by decide) hI)
      fun t ht => ⟨minv, n, g, y, ht.ctx, ht.vals, hw, hw', hn, hR⟩
  refine RelCT.seq (two_post (Ψ := fun p s => GoodW p.ws s)
    (two_map (fun p : XPub => p.ws) (fun _ _ h => h.goodW)
      (copyArr_ct (o := aY) (a := aOne) (by decide) (by decide) (by taint_decide))) ?_) ?_
  · rintro p s ⟨minv, n, g, y, hc, hv, hw, hw', hn, hR⟩
    exact WP.mono (jointCopy_ok hc hw hw' (by decide) (by decide) (by decide) (by decide))
      fun t ⟨ht, _⟩ => ⟨minv, ht.mod.good, Nat.le_refl _⟩
  exact two_map (fun p : XPub => p.ws) (fun _ _ h => h)
    (smallW_ct (a := aOne) (by decide) (by taint_decide))

end VG.Proof.Dsa.AArch64

end

end

/-! ### `Dsa.AArch64.JointEncodeCT`, which only this module used -/

section

/-! # Constant-time encoding of both bases -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Dsa.AArch64
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MlKem.AArch64

theorem jointCopy_ct {o a : Nat} (ho : o < 8) (ha : a < 8) (hoa : o ≠ a)
    {hc : VG.Taint.Hint VG.AArch64.Taint.T}
    (hT : (taint.check (Taint.ofRegs [.x0]) (.block [ldh .x12 sW, ldh .x16 (sArr a), ldh .x17 (sArr o)])
      hc).isSome = true) :
    RelCT isa (Two fun p : ProductPublic => GoodL p.layout) (seqs (Crt.copyArr o a))
      (Two fun p : ProductPublic => GoodL p.layout) := by
  refine two_post (two_map (fun p : ProductPublic => p.layout.ws) (fun _ _ h => h.goodW)
    (copyArr_ct ho ha hT)) ?_
  intro p s hg
  refine WP.mono (copyArr_ok hg.1 p.fits (by have := p.lower; omega_using [this]) p.upper ho ha hoa)
    fun t ⟨_, hf, hk⟩ => ?_
  have ha : Arrays p.layout.B p.layout.w [o] s.mem t.mem :=
    Arrays.of_outside (List.mem_singleton_self o) hf (Nat.le_refl _) (by omega_using [])
  exact ⟨⟨hg.1.scr.congr hk.wr, (hk.gpr .x0 (by decide)).trans hg.1.x0, ha.hdr hg.1.hdr⟩, p.fits⟩

theorem jointEncode_ct (M : Mont) :
    RelCT isa (Two (Reduced [aR2, aOne])) (Joint.encode M.mm) (fun _ _ => True) := by
  unfold Joint.encode seqs
  apply RelCT.seq (mont_step_ct M (by unfold MmUse; decide) [aR2, aOne] (by decide) (by decide))
  apply RelCT.seq (mont_step_ct M (by unfold MmUse; decide) [aY, aR2, aOne] (by decide) (by decide))
  apply RelCT.seq (mont_step_ct M (by unfold MmUse; decide) [aX, aY, aR2, aOne] (by decide) (by decide))
  apply RelCT.seq (two_map (fun p : ProductPublic => p) (fun p _ h => ⟨h.1.good, p.fits⟩)
    (jointCopy_ct (o := aR2) (a := aX) (by decide) (by decide) (by decide) (by taint_decide)))
  apply RelCT.seq (jointCopy_ct (o := aOne) (a := aY) (by decide) (by decide) (by decide) (by taint_decide))
  exact (jointCopy_ct (o := aX) (a := aY) (by decide) (by decide) (by decide) (by taint_decide)).mono
    (fun _ _ h => h) (fun _ _ _ => True.intro)

end VG.Proof.Dsa.AArch64

end

end

/-! # Constant-time preparation of the joint exponentiation table -/

@[expose] public section

namespace VG.Proof.Dsa.AArch64
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Dsa.Layout VG.Impl.Dsa.AArch64
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MlKem.AArch64

theorem jointPrepare_ct (M : Mont) :
    RelCT isa (Two (fun p : ProductCallPublic => PowerCallPre p.toPowerCallPublic))
      (Joint.prepare M.mm) (fun _ _ => True) := by
  unfold Joint.prepare seqs
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => PowerCallPrepared p.toPowerCallPublic)
    (two_map (fun p : ProductCallPublic => p.toPowerPublic.product)
      (fun p _ h => ⟨h.2.1, p.width48, p.greater, p.odd⟩) (constants_ct M))
    (fun _ _ h => powerCall_prepare M h)) ?_
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => PowerCallPrepared p.toPowerCallPublic)
    (two_map (fun p : ProductCallPublic => (⟨p.x, p.base, p.baseLen⟩ : BPub)) ?_
      (loadArr_ct (j := aX) (sp := arg) (sl := argLen) (by decide) (by taint_decide) (by taint_decide))) ?_) ?_
  · intro p s ⟨⟨hc, _, bb, _, hp, hl, _, _, hbl, _, hb, _⟩, _⟩
    refine ⟨p.minv, bb, hc, p.lower, p.fits, p.upper, by decide, by decide, by decide,
      hp, hl, hbl, hb, hbl ▸ p.basePositive, ?_, hbl ▸ p.baseFits⟩
    have hbw : (bb.length + 7) / 8 ≤ p.x.wx := hbl ▸ p.baseFits
    have hw48 : p.x.wx ≤ 48 := p.width48
    omega_using [hbw, hw48]
  · intro p s h
    obtain ⟨bb, _, hp, hl, _, _, hbl, _, hb, _⟩ := h.1.2.2
    exact productCall_load (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      h hp hl hb (hbl ▸ p.basePositive) (hbl ▸ p.baseFits)
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => PowerCallPrepared p.toPowerCallPublic)
    (two_map (fun p : ProductCallPublic => p.bytes) ?_
      (loadArr_ct (j := aXm) (sp := arg2) (sl := arg2Len) (by decide) (by taint_decide) (by taint_decide))) ?_) ?_
  · intro p s ⟨⟨hc, _, _, eb, _, _, hp, hl, _, hel, _, hb⟩, _⟩
    refine ⟨p.minv, eb, hc, p.lower, p.fits, p.upper, by decide, by decide, by decide,
      hp, hl, hel, hb, hel ▸ p.expPositive, ?_, hel ▸ p.secondFits⟩
    have hbw : (eb.length + 7) / 8 ≤ p.x.wx := hel ▸ p.secondFits
    have hw48 : p.x.wx ≤ 48 := p.width48
    omega_using [hbw, hw48]
  · intro p s h
    obtain ⟨_, eb, _, _, hp, hl, _, hel, _, hb⟩ := h.1.2.2
    exact productCall_load (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      h hp hl hb (hel ▸ p.expPositive) (hel ▸ p.secondFits)
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => JointBuildPre 0 p.x)
    (two_map (fun p : ProductCallPublic => p.toPowerPublic.product) (fun p s ⟨⟨_, hm, _⟩, hone, hr2⟩ => by
    refine ⟨hm, ?_⟩
    intro j hj
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl
    · dsimp only [PowerPublic.product]
      rw [hr2]
      exact Nat.mod_lt _ (by have := p.greater; omega_using [this])
    · dsimp only [PowerPublic.product]
      rw [hone]
      exact p.greater) (jointEncode_ct M)) ?_) (two_map (fun p : ProductCallPublic => p.x) (fun _ _ h => h) (jointBuild_ct M))

  intro p s ⟨⟨hc, hm, _⟩, hone, hr2⟩
  have hr2' : wv s.mem (off p.x.B p.x.o) (slot p.x.wx aR2) p.x.wx =
      (2 ^ (64 * p.x.wx) * 2 ^ (64 * p.x.wx)) % p.modulus := by
    rw [hr2, ← Nat.pow_add, show 64 * p.x.wx + 64 * p.x.wx = 128 * p.x.wx by omega_using []]
  have hR := coprime_pow2 p.odd (64 * p.x.wx)
  exact WP.mono (jointEncode_ok M ⟨hm, hc.scrT⟩ p.lower (by have : p.x.wx ≤ 48 := p.width48; omega_using [this])
    p.greater hR rfl rfl hone hr2') fun t ⟨ht, hv, _, _⟩ =>
      ⟨p.minv, p.modulus, _, _, ht, hv, p.lower, by have : p.x.wx ≤ 48 := p.width48; omega_using [this],
        by have := p.greater; omega_using [this], hR⟩

end VG.Proof.Dsa.AArch64

end


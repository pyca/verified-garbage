/-! ### `Dsa.AArch64.JointWindowCT`, which only this module used -/

section

/-! # Constant time of a joint exponentiation window

As RSA's window (`crtWin_ct`, `Proof/Bignum/AArch64/CrtCTExp.lean`): the
digits flow only into data, the table is read by a selection from
every entry (`Crt.select`), and the header's addresses and counts are pinned in both runs
by the window's correctness. -/

@[expose] public section

namespace VG.Proof.Dsa.AArch64
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Dsa.AArch64
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MlKem.AArch64

/-- After `j` windows of a pair of bytes, in the workspace of `p`. -/
def JointWinI (p : XPub) (j : Nat) (s : State) : Prop :=
  ∃ (t₀ : State) (minv : BitVec 64) (n xc g y a b v z : Nat),
    JointWinInv t₀ (off p.B p.o) p.wx minv n xc g y a b v z j s ∧
    2 ≤ p.wx ∧ p.wx < 2 ^ 30 ∧ Nat.Coprime (2 ^ (64 * p.wx)) n ∧ v < 256 ∧ z < 256

/-- The table index into `sNib`, and `sV` up. -/
theorem jointMid_ct : RelCT isa (Two fun (q : XPub × Nat) s => WinQ q.1 s) (.block Joint.windowIndex)
    (Two fun (q : XPub × Nat) s => WinS q.1 s) := by
  refine two_piece [.x0] (pins_x0B (fun q : XPub × Nat => off q.1.B q.1.o) fun _ _ h => h.x0)
    (by unfold Joint.windowIndex; taint_decide) fun q s h => ?_
  obtain ⟨minv, X, Xc, V, hc, htab, hY, hV, hV', hw, hw', hR⟩ := h
  have hn := hc.scrT.nowrap
  refine WP.mono (joint_mid_ok hc hV (by omega_arith)) fun t ⟨hm, k⟩ => ?_
  have o1 := writeW_outside s.mem (off q.1.B q.1.o) (d := 8 * Crt.sV) (BitVec.ofNat 64 (4 * V)) (by decide)
  have o2 := writeW_outside (s.mem.writeW (off (off q.1.B q.1.o) (8 * Crt.sV)) (BitVec.ofNat 64 (4 * V)))
    (off q.1.B q.1.o) (d := 8 * Crt.sNib) (BitVec.ofNat 64 ((4 * (V / 16384 % 4) + V / 64 % 4))) (by decide)
  rw [← hm] at o2
  have f : Frm (off q.1.B q.1.o) (crtWinRanges q.1.wx) s.mem t.mem :=
    (Frm.of_outside o1 (by simp [crtWinRanges])).trans (Frm.of_outside o2 (by simp [crtWinRanges]))
  have hc' := hc.of_win f k.wr (k.gpr .x0 (by decide))
  have hY0 := slot_le (w := q.1.wx) (show aY < 8 by decide)
  have hYe : wv t.mem (off q.1.B q.1.o) (slot q.1.wx aY) q.1.wx =
      wv s.mem (off q.1.B q.1.o) (slot q.1.wx aY) q.1.wx := by
    rw [o2.wv (by have := hdr_lt_slot q.1.wx aY (show Crt.sNib < 32 by decide); omega_arith) (by omega_arith),
      o1.wv (by have := hdr_lt_slot q.1.wx aY (show Crt.sV < 32 by decide); omega_arith) (by omega_arith)]
  exact ⟨⟨minv, X, Xc, (4 * (V / 16384 % 4) + V / 64 % 4), hc', hw, hw',
      (VG.Proof.Dsa.joint_index (Nat.mod_lt _ (by decide)) (Nat.mod_lt _ (by decide))).1, by
        rw [hm, hdrStore_hdr _ _ _ (by decide) (by decide) (by decide),
          hdrStore_hdr _ _ _ (by decide) (by decide) (by decide)]; exact htab.tab,
        by rw [hm, word_writeW_self]⟩,
    minv, X, Xc, hc', htab.of_win f hn, hYe ▸ hY, hR⟩

/-- A joint window leaks the same in runs with the same workspace, whatever
the digits. -/
theorem jointWindow_ct (M : Mont) :
    RelCT isa (Two fun (q : XPub × Nat) s => q.2 < 4 ∧ JointWinI q.1 q.2 s) (seqs (Joint.window M.mm))
      fun _ _ => True := by
  simp only [Joint.window, VG.Impl.Rsa.AArch64.Crt.select, seqs]
  have sq : RelCT isa (Two fun (q : XPub × Nat) s => WinQ q.1 s) (M.mm aY aY aY)
      (Two fun (q : XPub × Nat) s => WinQ q.1 s) :=
    two_post (two_map (fun q : XPub × Nat => q.1.ws) (fun _ _ h => h.goodW) (M.ct (by unfold MmUse; decide)))
      fun _ _ h => winSq_q M h
  -- Two squarings.
  have sq0 : RelCT isa (Two fun (q : XPub × Nat) s => q.2 < 4 ∧ JointWinI q.1 q.2 s) (M.mm aY aY aY)
      (Two fun (q : XPub × Nat) s => WinQ q.1 s) :=
    two_post (two_map (fun q : XPub × Nat => q.1.ws)
      (fun _ _ ⟨_, _, _, _, _, _, _, _, _, _, _, hI, _⟩ => ⟨_, hI.ctx.good, Nat.le_refl _⟩)
      (M.ct (by unfold MmUse; decide))) fun q s ⟨hj, t₀, minv, n, xc, g, y, a, b, v, z, hI, hw, hw', hR, hv, hz⟩ => by
        have hp : (256 * v + z) * 4 ^ q.2 < 2 ^ 56 := by
          have : 4 ^ q.2 ≤ 4 ^ 3 := Nat.pow_le_pow_right (by decide) (by omega_arith)
          have := Nat.mul_le_mul_left (256 * v + z) this
          omega_arith
        have tab : CTab s.mem (off q.1.B q.1.o) q.1.wx n False 0 :=
          ⟨hI.tab.tab, hI.tab.lt, fun h _ _ => False.elim h⟩
        exact winSq_q M ⟨minv, n, xc, _, hI.ctx, tab, hI.ylt, hI.bytes, hp, hw, hw', hR⟩
  refine RelCT.seq sq0 (RelCT.seq sq (RelCT.seq jointMid_ct ?_))
  -- The selection, `Y := Y T` and the count.
  refine RelCT.seq (two_post (Ψ := fun (q : XPub × Nat) s => WinT q.1 s)
    (two_map (fun q : XPub × Nat => q.1) (fun _ _ h => h.1)
      (WindowVector.select_ct (Or.inl rfl) tabSel_ct)) fun q s h => ?_) ?_
  · obtain ⟨⟨minv, X, Xc, v, hc, hw, hw', hv, ht, hN⟩, minv', X', Xc', hc₂, htab, -, -⟩ := h
    refine WP.mono (WindowVector.select_ok (Or.inl rfl) (fun hu tab nib => tabSel_ok hu hw hw' hv tab nib)
      hc hw' hv ht hN) fun t ⟨hc', hT, _, _⟩ => ⟨minv, X, Xc, hc', ?_, hw, hw'⟩
    have hX : X' = X := hc₂.n.symm.trans hc.n
    rw [hT, ← hX]; exact htab.lt _ hv
  refine RelCT.seq (two_post (Ψ := fun (q : XPub × Nat) t => t.gpr .x0 = off q.1.B q.1.o)
    (two_map (fun q : XPub × Nat => q.1.ws) (fun _ _ ⟨minv, _, _, hc, _⟩ => ⟨minv, hc.good, Nat.le_refl _⟩)
      (M.ct (o := aY) (a := aY) (b := Crt.aT) (by unfold MmUse; decide)))
    fun q s ⟨minv, X, Xc, hc, hT, hw, hw'⟩ => ?_) ?_
  · exact WP.mono (M.mm_ok (o := aY) (a := aY) (b := Crt.aT) hc.good (Nat.le_refl _) hw (by omega_arith)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) hc.inv
      (by rw [hc.n]; exact hT)) fun t ⟨hg, _⟩ => hg.x0
  exact x0_ct (fun q : XPub × Nat => off q.1.B q.1.o) (fun _ _ h => h) (by taint_decide)

/-- The four windows of a pair of bytes leak the same in runs with the same
workspace. -/
theorem jointWindows_ct (M : Mont) :
    RelCT isa (Two fun p s => 0 < 4 ∧ JointWinI p 0 s) (.loop (seqs (Joint.window M.mm)) (.nonzero .x .x3))
      (Two fun p s => JointWinI p 4 s) :=
  two_loop (Φ := JointWinI) (fun _ => 4) (jointWindow_ct M)
    fun _ _ _ hj ⟨t₀, minv, n, xc, g, y, a, b, v, z, hI, hw, hw', hR, hv, hz⟩ =>
      WP.mono (jointWinStep_ok M hw hw' hR hv hz hj hI) fun _ ⟨hI', hflag⟩ =>
        ⟨eval_nz_count hj hflag, fun _ => ⟨t₀, minv, n, xc, g, y, a, b, v, z, hI', hw, hw', hR, hv, hz⟩,
          fun h => h ▸ ⟨t₀, minv, n, xc, g, y, a, b, v, z, hI', hw, hw', hR, hv, hz⟩⟩

end VG.Proof.Dsa.AArch64

end

end

/-! ### `Dsa.AArch64.JointByteHead`, which only this module used -/

section

/-! # Loading a pair of exponent bytes without secret-dependent addresses -/

@[expose] public section
namespace VG.Proof.Dsa.AArch64
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Dsa.AArch64
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MlKem.AArch64

theorem jointByteHeadInv_ok {t₀ t : State} {P : Addr} {w n xc g y : Nat}
    {minv : BitVec 64} {ep fp : Addr} {L : Nat} {eb fb : List Byte} {i : Nat}
    (hL : eb.length = L) (hF : fb.length = L) (hi : i < L)
    (hrd : ∀ i < L, InRegions (t₀.rd ++ t₀.wr) (ep + BitVec.ofNat 64 i) 1)
    (hbytes : ∀ i (h : i < L), t₀.mem (ep + BitVec.ofNat 64 i) = eb[i]'(by omega_using [hL, h]))
    (hout : ∀ i < L, slot w 8 + tabBytes w ≤ ofs P (ep + BitVec.ofNat 64 i))
    (frd : ∀ i < L, InRegions (t₀.rd ++ t₀.wr) (fp + BitVec.ofNat 64 i) 1)
    (fbytes : ∀ i (h : i < L), t₀.mem (fp + BitVec.ofNat 64 i) = fb[i]'(by omega_using [hF, h]))
    (fout : ∀ i < L, slot w 8 + tabBytes w ≤ ofs P (fp + BitVec.ofNat 64 i))
    (hI : JointByteInv t₀ P w minv n xc g y ep fp L eb fb i t) :
    WP isa (.block Joint.byteHead) t fun t₁ =>
      JointWinInv t₁ P w minv n xc g y (pre eb i) (pre fb i)
        (eb[i]'(by omega_using [hL, hi])).toNat (fb[i]'(by omega_using [hF, hi])).toNat 0 t₁ := by
  have hn := hI.ctx.scrT.nowrap
  let v := (eb[i]'(by omega_using [hL, hi])).toNat
  let z := (fb[i]'(by omega_using [hF, hi])).toNat
  have hv : v < 256 := (eb[i]'(by omega_using [hL, hi])).isLt
  have hz : z < 256 := (fb[i]'(by omega_using [hF, hi])).isLt
  have er : InRegions (t.rd ++ t.wr) (ep + BitVec.ofNat 64 i) 1 := by
    rw [hI.keep.rd, hI.keep.wr]; exact hrd i hi
  have fr : InRegions (t.rd ++ t.wr) (fp + BitVec.ofNat 64 i) 1 := by
    rw [hI.keep.rd, hI.keep.wr]; exact frd i hi
  have ev : t.mem (ep + BitVec.ofNat 64 i) = eb[i]'(by omega_using [hL, hi]) := by
    rw [hI.frm _ fun r hr => Or.inr (by have := (crtExpRanges_ok w r hr).2; have := hout i hi; omega_arith)]
    exact hbytes i hi
  have fv : t.mem (fp + BitVec.ofNat 64 i) = fb[i]'(by omega_using [hF, hi]) := by
    rw [hI.frm _ fun r hr => Or.inr (by have := (crtExpRanges_ok w r hr).2; have := fout i hi; omega_arith)]
    exact fbytes i hi
  refine WP.mono (jointByteHead_ok hI.ctx hI.idx hI.e hI.f er fr ev fv)
    fun t₁ ⟨hm₁, k₁⟩ => ?_
  have o1 := writeW_outside t.mem P (d := 8 * Crt.sV) (BitVec.ofNat 64 (256 * v + z)) (by decide)
  have o2 := writeW_outside (t.mem.writeW (off P (8 * Crt.sV)) (BitVec.ofNat 64 (256 * v + z))) P
    (d := 8 * Crt.sBit) (BitVec.ofNat 64 4) (by decide)
  rw [← hm₁] at o2
  have f₁ : Frm P (crtWinRanges w) t.mem t₁.mem :=
    (Frm.of_outside o1 (by simp [crtWinRanges])).trans (Frm.of_outside o2 (by simp [crtWinRanges]))
  have hc₁ := hI.ctx.of_win f₁ k₁.wr (k₁.gpr .x0 (by decide))
  have hY0 := slot_le (w := w) (show aY < 8 by decide)
  have hYe : wv t₁.mem P (slot w aY) w = wv t.mem P (slot w aY) w := by
    rw [o2.wv (by have := hdr_lt_slot w aY (show Crt.sBit < 32 by decide); omega_using [this]) (by omega_using [hn, hY0]),
      o1.wv (by have := hdr_lt_slot w aY (show Crt.sV < 32 by decide); omega_using [this]) (by omega_using [hn, hY0])]
  have hB0 : JointWinInv t₁ P w minv n xc g y (pre eb i) (pre fb i) v z 0 t₁ := by
    refine ⟨hc₁, hI.tab.of_win f₁ hn, hYe ▸ hI.ylt, ?_, ?_, ?_, Frm.refl _ _ _, Keep.refl _ _⟩
    · rw [hYe, hI.val, Nat.pow_zero, Nat.mul_one, Nat.mul_one, Nat.sub_zero,
        Nat.div_eq_of_lt (show v < 4 ^ 4 from hv), Nat.div_eq_of_lt (show z < 4 ^ 4 from hz),
        Nat.add_zero, Nat.add_zero]
    · rw [o2.word (by decide) (by decide), word_writeW_self, Nat.pow_zero, Nat.mul_one]
    · rw [hm₁, word_writeW_self]
  exact hB0

end VG.Proof.Dsa.AArch64

end

end

/-! # Constant-time scanning of two equal-length exponents

As RSA's bytes (`crtByte_ct`): the bytes are read at public addresses (the
exponents' pointers plus the byte index), which the head computes before
it loads them. -/

@[expose] public section

namespace VG.Proof.Dsa.AArch64
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Impl.Bignum.Public
open VG.Impl.Rsa.AArch64 VG.Impl.Dsa.AArch64
open VG.Proof.Bignum VG.Proof.Bignum.AArch64 VG.Proof.MlKem.AArch64

/-- The public part of both exponents: the workspace, the pointers and the
length. -/
structure JointBytesPublic where
  x : XPub
  ep : Addr
  fp : Addr
  len : Nat

/-- After `i` bytes of both exponents. -/
def JointBytesInv (p : JointBytesPublic) (i : Nat) (s : State) : Prop :=
  ∃ (t₀ : State) (minv : BitVec 64) (n xc g y : Nat) (eb fb : List Byte),
    JointByteInv t₀ (off p.x.B p.x.o) p.x.wx minv n xc g y p.ep p.fp p.len eb fb i s ∧
    2 ≤ p.x.wx ∧ p.x.wx < 2 ^ 30 ∧ Nat.Coprime (2 ^ (64 * p.x.wx)) n ∧
    eb.length = p.len ∧ fb.length = p.len ∧ p.len < 2 ^ 31 ∧
    Src t₀ p.x.B p.x.Z p.ep eb ∧ Src t₀ p.x.B p.x.Z p.fp fb ∧
    (∀ i < p.len, slot p.x.wx 8 + tabBytes p.x.wx ≤ ofs (off p.x.B p.x.o) (p.ep + BitVec.ofNat 64 i)) ∧
    (∀ i < p.len, slot p.x.wx 8 + tabBytes p.x.wx ≤ ofs (off p.x.B p.x.o) (p.fp + BitVec.ofNat 64 i))

/-- Both bytes' addresses. -/
def jointByteAddr : List Instr :=
  [ldh .x3 Crt.sExp, ldh .x4 Crt.sI, .add .x .x3 .x3 .x4, ldh .x5 Joint.sExp2, .add .x .x5 .x5 .x4]

/-- Both bytes into `sV`, and the window count. -/
def jointByteLoad : List Instr :=
  [.ldrb .x3 .x3 0, .ldrb .x5 .x5 0, .lsl .x .x3 .x3 8, .add .x .x3 .x3 .x5, sth .x3 Crt.sV, movi .x3 4,
    sth .x3 Crt.sBit]

theorem jointByteHead_eq : Joint.byteHead = jointByteAddr ++ jointByteLoad := rfl

/-- After both addresses: them, and the rest of the head. -/
def JHeadMid (q : JointBytesPublic × Nat) (s : State) : Prop :=
  s.gpr .x0 = off q.1.x.B q.1.x.o ∧ s.gpr .x3 = q.1.ep + BitVec.ofNat 64 q.2 ∧
    s.gpr .x5 = q.1.fp + BitVec.ofNat 64 q.2 ∧
    WP isa (.block jointByteLoad) s fun t => 0 < 4 ∧ JointWinI q.1.x 0 t

theorem pins_jBytes :
    Pins (fun (q : JointBytesPublic × Nat) s => q.2 < q.1.len ∧ JointBytesInv q.1 q.2 s) [.x0] :=
  pins_x0B (fun q : JointBytesPublic × Nat => off q.1.x.B q.1.x.o)
    fun _ _ ⟨_, _, _, _, _, _, _, _, _, hI, _⟩ => hI.ctx.good.x0

theorem pins_jHeadMid : Pins JHeadMid [.x0, .x3, .x5] := by
  rintro q s₁ s₂ ⟨a₁, b₁, c₁, -⟩ ⟨a₂, b₂, c₂, -⟩ r hr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl
  · rw [a₁, a₂]
  · rw [b₁, b₂]
  · rw [c₁, c₂]

/-- Both addresses, in the workspace at `P`. -/
theorem jointByteAddr_run {t : State} {P : Addr} {wx : Nat} {minv : BitVec 64} {X Xc : Nat}
    (hc : CExpCtx t P wx minv X Xc) {ep fp : Addr} {i : Nat} (he : word t.mem P (8 * Crt.sExp) = ep)
    (hf : word t.mem P (8 * Joint.sExp2) = fp) (hi : word t.mem P (8 * Crt.sI) = BitVec.ofNat 64 i) :
    WP isa (.block jointByteAddr) t fun t' => (t'.gpr .x3 = ep + BitVec.ofNat 64 i ∧
      t'.gpr .x5 = fp + BitVec.ofNat 64 i) ∧ Keep [.x3, .x4, .x5] t t' := by
  refine WP.keep [.x3, .x4, .x5] ?_ (by decide) (by decide) (by decide +kernel)
  brun [jointByteAddr, hc.good.x0, hdr_enc (show Crt.sExp < 32 by decide), hdr_enc (show Crt.sI < 32 by decide),
    hdr_enc (show Joint.sExp2 < 32 by decide), hc.ld (i := Crt.sExp) (by decide), hc.ld (i := Crt.sI) (by decide),
    hc.ld (i := Joint.sExp2) (by decide), he, hf, hi]

/-- Both addresses, and the rest of the head by `jointByteHeadInv_ok`. -/
theorem jointByteAddr_ok {q : JointBytesPublic × Nat} {s : State}
    (h : q.2 < q.1.len ∧ JointBytesInv q.1 q.2 s) :
    WP isa (.block jointByteAddr) s (JHeadMid q) := by
  obtain ⟨hi, t₀, minv, n, xc, g, y, eb, fb, hI, hw, hw', hR, hL, hF, -, he, hf, hout, fout⟩ := h
  have hc := hI.ctx
  have hw₁ := WP.block_append_iff.mp (jointByteHead_eq ▸ jointByteHeadInv_ok hL hF hi
    (by simpa only [hL] using he.rd) (by simpa only [hL] using he.val) hout
    (by simpa only [hF] using hf.rd) (by simpa only [hF] using hf.val) fout hI)
  refine WP.mono (wp_and hw₁ (jointByteAddr_run hc hI.e hI.f hI.idx)) fun t ⟨h₂, ⟨h3, h5⟩, k⟩ =>
    ⟨(k.gpr .x0 (by decide)).trans hc.good.x0, h3, h5, WP.mono h₂ fun t' hB =>
      ⟨by decide, t', minv, n, xc, g, y, _, _, _, _, hB, hw, hw', hR,
        (eb[q.2]'(by omega_arith)).isLt, (fb[q.2]'(by omega_arith)).isLt⟩⟩

/-- One pair of bytes leaks the same in runs with the same workspace and the
same exponents' pointers and length. -/
theorem jointByte_ct (M : Mont) :
    RelCT isa (Two fun (q : JointBytesPublic × Nat) s => q.2 < q.1.len ∧ JointBytesInv q.1 q.2 s)
      (seqs [.block Joint.byteHead, .loop (seqs (Joint.window M.mm)) (.nonzero .x .x3),
        .block Joint.byteNext]) (fun _ _ => True) := by
  simp only [seqs]
  rw [jointByteHead_eq]
  have h₃ : RelCT isa (Two fun (p : XPub) s => JointWinI p 4 s) (.block Joint.byteNext) fun _ _ => True :=
    x0_ct (fun p : XPub => off p.B p.o) (fun _ _ ⟨_, _, _, _, _, _, _, _, _, _, hI, _⟩ => hI.ctx.good.x0)
      (by taint_decide)
  exact RelCT.seq (RelCT.block_append (RelCT.seq
      (two_piece _ pins_jBytes (by taint_decide) fun _ _ h => jointByteAddr_ok h)
      (two_piece _ pins_jHeadMid (by taint_decide) fun _ _ h => h.2.2.2)))
    (RelCT.seq (two_map (fun q : JointBytesPublic × Nat => q.1.x) (fun _ _ h => h) (jointWindows_ct M)) h₃)

theorem jointBytes_ct (M : Mont) :
    RelCT isa (Two fun p s => 0 < p.len ∧ JointBytesInv p 0 s) (Joint.bytes M.mm)
      (Two fun p s => JointBytesInv p p.len s) := by
  apply two_loop (Φ := JointBytesInv) (fun p => p.len) (jointByte_ct M)
  rintro p i s hi ⟨t₀, minv, n, xc, g, y, eb, fb, hI, hw, hw', hR, hL, hF, hL', he, hf, hout, fout⟩
  refine WP.mono (jointByte_ok M hw hw' hR hL hF hL' hi
    (by simpa only [hL] using he.rd) (by simpa only [hL] using he.val) hout
    (by simpa only [hF] using hf.rd) (by simpa only [hF] using hf.val) fout hI)
    fun t ⟨hI', hz⟩ => ⟨eval_nz_count hi hz, ?_, ?_⟩
  · intro _
    exact ⟨t₀, minv, n, xc, g, y, eb, fb, hI', hw, hw', hR, hL, hF, hL', he, hf, hout, fout⟩
  · intro h
    exact h ▸ ⟨t₀, minv, n, xc, g, y, eb, fb, hI', hw, hw', hR, hL, hF, hL', he, hf, hout, fout⟩

end VG.Proof.Dsa.AArch64


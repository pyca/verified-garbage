    ⟨h.1, h.1.1.availableLocal .q inverse (by decide) (scalar_space (by decide) p),
      h.1.1.availableLocal .q v (by decide) (scalar_space (by decide) p)⟩) h7).mono
    (fun _ _ h => h) (fun _ _ => two_mono (fun _ _ h => h.1))

theorem coreSign_ct (M : Mont) (Sq : MontS) : RelCT isa (Two (ScheduleState signInputs))
    (Core.sign Sq.mm M.mm) (fun _ _ => True) :=
  (coreSignSchedule_ct M Sq signInputs signInputs_stable (fun _ _ h => h)).mono
    (fun _ _ h => h) (fun _ _ _ => True.intro)

end VG.Proof.Dsa.X86_64

end

end

/-! ### `Dsa.X86_64.PrivateKeyCT`, which this module and modules that import it used -/

section

/-! # Constant time of private-key consistency and nonce validation -/

@[expose] public section

namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64
open VG.Impl.Dsa.Layout VG.Impl.Dsa.X86_64
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

theorem privateKey_ct (M : Mont) (Sq : MontS) (inputs : SchedulePublic → List (Operand × Nat))
    (stable : ∀ p a, a ∈ inputs p → a.1.length ≠ .mask ∧ stablePointer a.1.pointer)
    (hg : ∀ p, (Core.generator, p.layout.pLen) ∈ inputs p)
    (hy : ∀ p, (Core.publicValue, p.layout.pLen) ∈ inputs p)
    (hx : ∀ p, (Core.privateScalar, p.layout.qLen) ∈ inputs p)
    (hk : ∀ p, (Core.nonce, p.layout.qLen) ∈ inputs p) :
    RelCT isa (Two (ScheduleState inputs)) (Checks.privateKey Sq.mm M.mm)
      (Two (ScheduleState inputs)) := by
  have pp (p : SchedulePublic) : 1 ≤ p.layout.pLen := by have := p.layout.widths; omega_using [this]
  have qp (p : SchedulePublic) : 1 ≤ p.layout.qLen := p.layout.widths.1
  have qb (p : SchedulePublic) : p.layout.qLen ≤ 1024 := by have := p.layout.widths; omega_using [this]
  have pf (p : SchedulePublic) : (p.layout.pLen + 7) / 8 ≤ ModulusSide.p.words p.layout := Nat.le_refl _
  have qf (p : SchedulePublic) : (p.layout.qLen + 7) / 8 ≤ ModulusSide.q.words p.layout := Nat.le_refl _
  have h1 := scheduleRange_ct inputs stable .q Core.privateScalar (fun p => p.layout.qLen) false
    (by simp [pointerFits, Core.privateScalar]) (by simp [stablePointer, Core.privateScalar]) qp qf (by taint_decide)
  have h2 := scheduleRange_ct inputs stable .q Core.nonce (fun p => p.layout.qLen) false
    (by simp [pointerFits, Core.nonce]) (by simp [stablePointer, Core.nonce]) qp qf (by taint_decide)
  have h3 := schedulePow_ct M Sq inputs stable .p t Core.generator Core.privateScalar
    (fun p => p.layout.pLen) (fun p => p.layout.qLen)
    (by simp [pointerFits, Core.generator]) (by simp [pointerFits, Core.privateScalar])
    (by simp [stablePointer, Core.generator]) (by simp [stablePointer, Core.privateScalar])
    pp pf qp qb (by decide) (by decide) (element_space (by decide)) (by taint_decide)
  have h4 := scheduleEqual_ct inputs stable (Core.element t) Core.publicValue (fun p => p.layout.pLen) false
    (by change t < 2 ^ 31; decide) (by simp [pointerFits, Core.publicValue])
    (by simp [stablePointer, Core.element]) (by simp [stablePointer, Core.publicValue]) (by decide)
    pp (by intro p; have := p.layout.widths; omega_using [this]) (by taint_decide)
  unfold Checks.privateKey seqs
  refine RelCT.seq (two_map (Φ := ScheduleState inputs) (fun p => p)
    (fun p st h => ⟨h, (h.2.1 _ (hx p)).active⟩) h1) ?_
  refine RelCT.seq (two_map (fun p => p) (fun p st h => ⟨h, (h.2.1 _ (hk p)).active⟩) h2) ?_
  refine RelCT.seq (two_map (fun p => p) (fun p st h =>
    ⟨h, (h.2.1 _ (hg p)).active, (h.2.1 _ (hx p)).active⟩) h3) ?_
  exact two_map (fun p => p) (fun p st h =>
    ⟨h.1, h.1.1.availableLocal .p t (by decide) (element_space (by decide) p),
      (h.1.2.1 _ (hy p)).active⟩) h4

end VG.Proof.Dsa.X86_64

end

end

/-! # Constant time of validation and signing/verification together -/

@[expose] public section

namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64
open VG.Impl.Dsa.Layout VG.Impl.Dsa.X86_64
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

def signComputeInputs (p : SchedulePublic) : List (Operand × Nat) :=
  (Core.publicValue, p.layout.pLen) :: (⟨.input .q, .qLen⟩, p.layout.qLen) :: signInputs p

def verifyComputeInputs (p : SchedulePublic) : List (Operand × Nat) :=
  (⟨.input .q, .qLen⟩, p.layout.qLen) :: verifyInputs p

theorem signComputeInputs_stable (p : SchedulePublic) (a : Operand × Nat)
    (ha : a ∈ signComputeInputs p) : a.1.length ≠ .mask ∧ stablePointer a.1.pointer := by
  simp only [signComputeInputs, List.mem_cons] at ha
  rcases ha with rfl | rfl | ha
  · simp [Core.publicValue, stablePointer]
  · change Field.qLen ≠ .mask ∧ Field.q ≠ .mask
    decide
  · exact signInputs_stable p a ha

theorem verifyComputeInputs_stable (p : SchedulePublic) (a : Operand × Nat)
    (ha : a ∈ verifyComputeInputs p) : a.1.length ≠ .mask ∧ stablePointer a.1.pointer := by
  simp only [verifyComputeInputs, List.mem_cons] at ha
  rcases ha with rfl | ha
  · change Field.qLen ≠ .mask ∧ Field.q ≠ .mask
    decide
  · exact verifyInputs_stable p a ha

theorem signCompute_ct (M : Mont) (Sq : MontS) : RelCT isa (Two (PublicKeyPre signComputeInputs))
    (signCompute Sq.mm M.mm) (Two (ScheduleState signComputeInputs)) := by
  have h1 := signingKey_ct M Sq signComputeInputs signComputeInputs_stable
    (by intro p; simp [signComputeInputs, signInputs])
    (by intro p; simp [signComputeInputs]) (by intro p; simp [signComputeInputs])
  have h2 := privateKey_ct M Sq signComputeInputs signComputeInputs_stable
    (by intro p; simp [signComputeInputs, signInputs]) (by intro p; simp [signComputeInputs])
    (by intro p; simp [signComputeInputs, signInputs]) (by intro p; simp [signComputeInputs, signInputs])
  have h3 := coreSignSchedule_ct M Sq signComputeInputs signComputeInputs_stable
    (by intro p a ha; simp [signComputeInputs, ha])
  have h4 := scheduleZero_ct signComputeInputs signComputeInputs_stable (Core.scalar r)
    (fun p => p.layout.qLen) true (by change r < 2 ^ 31; decide) (by trivial) (by decide)
    (fun p => p.layout.widths.1) (by intro p; have := p.layout.widths; omega_using [this]) (by taint_decide)
  have h5 := scheduleZero_ct signComputeInputs signComputeInputs_stable (Core.scalar s)
    (fun p => p.layout.qLen) true (by change s < 2 ^ 31; decide) (by trivial) (by decide)
    (fun p => p.layout.widths.1) (by intro p; have := p.layout.widths; omega_using [this]) (by taint_decide)
  unfold signCompute seqs
  refine RelCT.seq h1 (RelCT.seq h2 (RelCT.seq h3 (RelCT.seq (R := Two (ScheduleState signComputeInputs)) ?_ ?_)))
  · exact two_map (fun p => p) (fun p st h =>
      ⟨h, h.1.availableLocal .q r (by decide) (scalar_space (by decide) p)⟩) h4
  · exact two_map (fun p => p) (fun p st h =>
      ⟨h, h.1.availableLocal .q s (by decide) (scalar_space (by decide) p)⟩) h5

theorem verifyCompute_ct (M : Mont) (Sq : MontS) : RelCT isa (Two (PublicKeyPre verifyComputeInputs))
    (verifyCompute Sq.mm M.mm) (Two (ScheduleState verifyComputeInputs)) := by
  have h1 := publicKey_ct M Sq verifyComputeInputs verifyComputeInputs_stable
    (by intro p; simp [verifyComputeInputs, verifyInputs])
    (by intro p; simp [verifyComputeInputs, verifyInputs]) (by intro p; simp [verifyComputeInputs])
  have h2 := scheduleRange_ct verifyComputeInputs verifyComputeInputs_stable .q Core.signatureR
    (fun p => p.layout.qLen) false (by trivial) (by simp [stablePointer, Core.signatureR])
    (fun p => p.layout.widths.1) (fun _ => Nat.le_refl _) (by taint_decide)
  have h3 := scheduleRange_ct verifyComputeInputs verifyComputeInputs_stable .q Core.signatureS
    (fun p => p.layout.qLen) false (by trivial) (by trivial)
    (fun p => p.layout.widths.1) (fun _ => Nat.le_refl _) (by taint_decide)
  have h4 := coreVerifySchedule_ct M Sq verifyComputeInputs verifyComputeInputs_stable
    (by intro p a ha; simp [verifyComputeInputs, ha])
  have h5 := scheduleEqual_ct verifyComputeInputs verifyComputeInputs_stable (Core.scalar u) Core.signatureR
    (fun p => p.layout.qLen) false (by change u < 2 ^ 31; decide) (by trivial) (by trivial)
    (by simp [stablePointer, Core.signatureR]) (by decide)
    (fun p => p.layout.widths.1) (by intro p; have := p.layout.widths; omega_using [this]) (by taint_decide)
  unfold verifyCompute seqs
  refine RelCT.seq h1 (RelCT.seq (R := Two (ScheduleState verifyComputeInputs)) ?_
    (RelCT.seq (R := Two (ScheduleState verifyComputeInputs)) ?_ (RelCT.seq h4 ?_)))
  · exact two_map (fun p => p) (fun p st h =>
      ⟨h, (h.2.1 (Core.signatureR, p.layout.qLen) (by simp [verifyComputeInputs, verifyInputs])).active⟩) h2
  · exact two_map (fun p => p) (fun p st h =>
      ⟨h, (h.2.1 (Core.signatureS, p.layout.qLen) (by simp [verifyComputeInputs, verifyInputs])).active⟩) h3
  · exact two_map (fun p => p) (fun p st h =>
      ⟨h, h.1.availableLocal .q u (by decide) (scalar_space (by decide) p),
        (h.2.1 (Core.signatureR, p.layout.qLen) (by simp [verifyComputeInputs, verifyInputs])).active⟩) h5

end VG.Proof.Dsa.X86_64

end

end

/-! # Constant time through validation, computation and the ABI return -/

@[expose] public section

namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64
open VG.Impl.Dsa.Layout VG.Impl.Dsa.X86_64
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

def SigningBodyPre (p : SchedulePublic) (s : State) : Prop :=
  Ready p.layout s ∧
  (∃ data yb qb, SigningOperands p.layout data yb qb s ∧ data.digest.length = p.digestLen) ∧
  (∃ valid : Bool, word s.mem p.layout.base Field.mask.offset = mask valid) ∧
  (∀ i < 2 * p.layout.qLen, InRegions s.wr (p.layout.fields .out + BitVec.ofNat 64 i) 1) ∧
  (∀ i < 2 * p.layout.qLen, usedBytes ≤ ofs p.layout.base (p.layout.fields .out + BitVec.ofNat 64 i))

theorem SigningBodyPre.schedule {p : SchedulePublic} {s : State} (h : SigningBodyPre p s) :
    PublicKeyPre signComputeInputs p s := by
  obtain ⟨hr, ⟨data, yb, qb, ho, hd⟩, hm, _, _⟩ := h
  refine ⟨⟨hr, ?_, hm⟩, qb, ho.subgroup, ho.subgroupLength, ho.subgroupValue⟩
  intro a ha
  simp only [signComputeInputs, signInputs, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨yb, ho.publicValue, ho.publicLength⟩
  · exact ⟨qb, ho.subgroup, ho.subgroupLength⟩
  · exact ⟨data.generator, ho.generator, ho.generatorLength⟩
  · exact ⟨data.nonce, ho.nonce, ho.nonceLength⟩
  · exact ⟨data.privateScalar, ho.privateScalar, ho.privateLength⟩
  · exact ⟨data.digest, ho.digest, hd⟩

def SchedulePublic.release (p : SchedulePublic) : ReleasePublic where
  base := p.layout.base
  output := p.layout.fields .out
  width := p.layout.qLen
  positive := p.layout.widths.1
  bound := p.layout.widths.2.1

theorem signingComputeRelease_ok (M : Mont) (Sq : MontS) {p : SchedulePublic} {s : State} (h : SigningBodyPre p s) :
    WP isa (signCompute Sq.mm M.mm) s (ReleasePre p.release) := by
  obtain ⟨hr, ⟨data, yb, qb, ho, _⟩, ⟨valid, hm⟩, hw, hsep⟩ := h
  refine WP.mono (signCompute_ok M Sq hr p.pGreater p.qGreater p.pOdd p.qOdd p.pFits p.qFits data
    ho.generator ho.publicValue ho.subgroup ho.privateScalar ho.nonce ho.digest
    ho.generatorLength ho.publicLength ho.subgroupLength ho.privateLength ho.nonceLength
    ho.digestBound ho.subgroupValue hm) fun t ⟨ht, hm, _, _, _, hk⟩ => ?_
  exact ⟨ht.scratch, ht.parent.rdi, ht.fields .out (by decide),
    (ht.fields .qLen (by decide)).trans p.layout.qLength, ⟨_, hm⟩,
    fun i hi => by rw [hk.2.2]; exact hw i hi, hsep⟩

theorem signBody_ct (M : Mont) (Sq : MontS) : RelCT isa (Two SigningBodyPre) (signBody Sq.mm M.mm) (fun _ _ => True) := by
  refine RelCT.seq (R := Two (fun p : SchedulePublic => ReleasePre p.release)) ?_ ?_
  · refine two_post ((two_map (fun p => p) (fun _ _ h => h.schedule) (signCompute_ct M Sq)).mono
      (fun _ _ h => h) (fun _ _ _ => trivial)) ?_
    exact fun _ _ h => signingComputeRelease_ok M Sq h
  · exact two_map SchedulePublic.release (fun _ _ h => h) signRelease_ct

def VerifyingBodyPre (p : SchedulePublic) (s : State) : Prop :=
  Ready p.layout s ∧
  (∃ data qb, VerificationOperands p.layout data qb s ∧ data.digest.length = p.digestLen) ∧
  ∃ valid : Bool, word s.mem p.layout.base Field.mask.offset = mask valid

theorem VerifyingBodyPre.schedule {p : SchedulePublic} {s : State} (h : VerifyingBodyPre p s) :
    PublicKeyPre verifyComputeInputs p s := by
  obtain ⟨hr, ⟨data, qb, ho, hd⟩, hm⟩ := h
  refine ⟨⟨hr, ?_, hm⟩, qb, ho.subgroup, ho.subgroupLength, ho.subgroupValue⟩
  intro a ha
  simp only [verifyComputeInputs, verifyInputs, List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl
  · exact ⟨qb, ho.subgroup, ho.subgroupLength⟩
  · exact ⟨data.generator, ho.generator, ho.generatorLength⟩
  · exact ⟨data.publicValue, ho.publicValue, ho.publicLength⟩
  · exact ⟨data.signatureR, ho.signatureR, ho.rLength⟩
  · exact ⟨data.signatureS, ho.signatureS, ho.sLength⟩
  · exact ⟨data.digest, ho.digest, hd⟩

theorem verifyingComputeReturn_ok (M : Mont) (Sq : MontS) {p : SchedulePublic} {s : State} (h : VerifyingBodyPre p s) :
    WP isa (verifyCompute Sq.mm M.mm) s (fun t => t.gpr .rdi = p.layout.base) := by
  obtain ⟨hr, ⟨data, qb, ho, _⟩, ⟨valid, hm⟩⟩ := h
  refine WP.mono (verifyCompute_ok M Sq hr p.pGreater p.qGreater p.pOdd p.qOdd p.pFits p.qFits data
    ho.generator ho.publicValue ho.subgroup ho.signatureR ho.signatureS ho.digest
    ho.generatorLength ho.publicLength ho.subgroupLength ho.rLength ho.sLength
    ho.digestBound ho.subgroupValue hm) fun _ h => h.1.parent.rdi

theorem verifyBody_ct (M : Mont) (Sq : MontS) : RelCT isa (Two VerifyingBodyPre) (verifyBody Sq.mm M.mm) (fun _ _ => True) := by
  refine RelCT.seq (R := Two (fun p : SchedulePublic => fun t => t.gpr .rdi = p.layout.base)) ?_ ?_
  · refine two_post ((two_map (fun p => p) (fun _ _ h => h.schedule) (verifyCompute_ct M Sq)).mono
      (fun _ _ h => h) (fun _ _ _ => trivial)) ?_
    exact fun _ _ h => verifyingComputeReturn_ok M Sq h
  · exact two_map (fun p => p.layout.base) (fun _ _ h => h) result_ct

end VG.Proof.Dsa.X86_64

/-! ### `Dsa.X86_64.JointEncodeCT`, which only this module used -/

section

/-! # Constant-time encoding of both bases -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64 VG.Impl.Dsa.X86_64
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

theorem jointCopy_ct {o a : Nat} (ho : o < 8) (ha : a < 8) (hoa : o ≠ a)
    {hc : VG.Taint.Hint VG.X86_64.Taint.T}
    (hT : (taint.check (Taint.ofRegs [.rdi]) (.block [.mov .r12 (.mem (hdr sW)), .mov .rsi (.mem (hdr (sArr a))),
      .mov .rbx (.mem (hdr (sArr o)))]) hc).isSome = true) :
    RelCT isa (Two fun p : ProductPublic => GoodL p.layout) (seqs (Crt.copyArr o a))
      (Two fun p : ProductPublic => GoodL p.layout) := by
  refine two_post (two_map (fun p : ProductPublic => p.layout.ws) (fun _ _ h => h.goodW)
    (copyArr_ct ho ha hT)) ?_
  intro p s hg
  refine WP.mono (copyArr_ok hg.1 p.fits (by have := p.lower; omega_using [this]) p.upper ho ha hoa)
    fun t ⟨_, hf, hk⟩ => ?_
  have ha : Arrays p.layout.B p.layout.w [o] s.mem t.mem :=
    Arrays.of_outside (List.mem_singleton_self o) hf (Nat.le_refl _) (by omega_using [])
  exact ⟨⟨hg.1.scr.congr hk.2.2, (hk.gpr (by decide)).trans hg.1.rdi, ha.hdr hg.1.hdr⟩, p.fits⟩

theorem jointEncode_ct (M : Mont) :
    RelCT isa (Two (Reduced [aR2, aOne])) (Joint.encode M.mm) (fun _ _ => True) := by
  unfold Joint.encode seqs
  apply RelCT.seq (mont_step_ct M (by unfold MmUse; decide) [aR2, aOne] (by decide) (by decide))
  apply RelCT.seq (mont_step_ct M (by unfold MmUse; decide) [aY, aR2, aOne] (by decide) (by decide))
  apply RelCT.seq (mont_step_ct M (by unfold MmUse; decide) [aX, aY, aR2, aOne] (by decide) (by decide))
  apply RelCT.seq (two_map (fun p : ProductPublic => p) (fun p _ h => ⟨h.1.good, p.fits⟩)
    (jointCopy_ct (o := aR2) (a := aX) (by decide) (by decide) (by decide) (by taint_decide)))
  apply RelCT.seq (jointCopy_ct (o := aOne) (a := aY) (by decide) (by decide) (by decide) (by taint_decide))
  exact (jointCopy_ct (o := aX) (a := aY) (by decide) (by decide) (by decide) (by taint_decide)).mono
    (fun _ _ h => h) (fun _ _ _ => True.intro)

end VG.Proof.Dsa.X86_64

end

end

/-! # Constant-time preparation of the joint exponentiation table -/

@[expose] public section

namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Dsa.Layout VG.Impl.Dsa.X86_64
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

theorem jointPrepare_ct (M : Mont) :
    RelCT isa (Two (fun p : ProductCallPublic => PowerCallPre p.toPowerCallPublic))
      (Joint.prepare M.mm) (fun _ _ => True) := by
  unfold Joint.prepare seqs
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => PowerCallPrepared p.toPowerCallPublic)
    (two_map (fun p : ProductCallPublic => p.toPowerPublic.product)
      (fun p _ h => ⟨h.2.1, p.width48, p.greater, p.odd⟩) (constants_ct M))
    (fun _ _ h => powerCall_prepare M h)) ?_
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => PowerCallPrepared p.toPowerCallPublic)
    (two_map (fun p : ProductCallPublic => (⟨p.x, p.base, p.baseLen⟩ : BPub)) ?_
      (loadArr_ct (j := aX) (sp := arg) (sl := argLen) (by decide) (by taint_decide) (by taint_decide))) ?_) ?_
  · intro p s ⟨⟨hc, _, bb, _, hp, hl, _, _, hbl, _, hb, _⟩, _⟩
    refine ⟨p.minv, bb, hc, p.lower, p.fits, p.upper, by decide, by decide, by decide,
      hp, hl, hbl, hb, hbl ▸ p.basePositive, ?_, hbl ▸ p.baseFits⟩
    have hbw : (bb.length + 7) / 8 ≤ p.x.wx := hbl ▸ p.baseFits
    have hw48 : p.x.wx ≤ 48 := p.width48
    omega_using [hbw, hw48]
  · intro p s h
    obtain ⟨bb, _, hp, hl, _, _, hbl, _, hb, _⟩ := h.1.2.2
    exact productCall_load (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      h hp hl hb (hbl ▸ p.basePositive) (hbl ▸ p.baseFits)
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => PowerCallPrepared p.toPowerCallPublic)
    (two_map (fun p : ProductCallPublic => p.bytes) ?_
      (loadArr_ct (j := aXm) (sp := arg2) (sl := arg2Len) (by decide) (by taint_decide) (by taint_decide))) ?_) ?_
  · intro p s ⟨⟨hc, _, _, eb, _, _, hp, hl, _, hel, _, hb⟩, _⟩
    refine ⟨p.minv, eb, hc, p.lower, p.fits, p.upper, by decide, by decide, by decide,
      hp, hl, hel, hb, hel ▸ p.expPositive, ?_, hel ▸ p.secondFits⟩
    have hbw : (eb.length + 7) / 8 ≤ p.x.wx := hel ▸ p.secondFits
    have hw48 : p.x.wx ≤ 48 := p.width48
    omega_using [hbw, hw48]
  · intro p s h
    obtain ⟨_, eb, _, _, hp, hl, _, hel, _, hb⟩ := h.1.2.2
    exact productCall_load (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      h hp hl hb (hel ▸ p.expPositive) (hel ▸ p.secondFits)
  refine RelCT.seq (two_post (Ψ := fun p : ProductCallPublic => JointBuildPre 0 p.x)
    (two_map (fun p : ProductCallPublic => p.toPowerPublic.product) (fun p s ⟨⟨_, hm, _⟩, hone, hr2⟩ => by
    refine ⟨hm, ?_⟩
    intro j hj
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl
    · dsimp only [PowerPublic.product]
      rw [hr2]
      exact Nat.mod_lt _ (by have := p.greater; omega_using [this])
    · dsimp only [PowerPublic.product]
      rw [hone]
      exact p.greater) (jointEncode_ct M)) ?_) (two_map (fun p : ProductCallPublic => p.x) (fun _ _ h => h) (jointBuild_ct M))

  intro p s ⟨⟨hc, hm, _⟩, hone, hr2⟩
  have hr2' : wv s.mem (off p.x.B p.x.o) (slot p.x.wx aR2) p.x.wx =
      (2 ^ (64 * p.x.wx) * 2 ^ (64 * p.x.wx)) % p.modulus := by
    rw [hr2, ← Nat.pow_add, show 64 * p.x.wx + 64 * p.x.wx = 128 * p.x.wx by omega_using []]
  have hR := coprime_pow2 p.odd (64 * p.x.wx)
  exact WP.mono (jointEncode_ok M ⟨hm, hc.scrT⟩ p.lower (by have : p.x.wx ≤ 48 := p.width48; omega_using [this])
    p.greater hR rfl rfl hone hr2') fun t ⟨ht, hv, _, _⟩ =>
      ⟨p.minv, p.modulus, _, _, ht, hv, p.lower, by have : p.x.wx ≤ 48 := p.width48; omega_using [this],
        by have := p.greater; omega_using [this], hR⟩

end VG.Proof.Dsa.X86_64

end

end

/-! ### `Dsa.X86_64.JointRunCT`, which this module and modules that import it used -/

section

/-! ### `Dsa.X86_64.JointByteCT`, which this module and modules that import it used -/

section

/-! ### `Dsa.X86_64.JointByteHead`, which this module and modules that import it used -/

section

/-! # Loading a pair of exponent bytes without secret-dependent addresses -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64 VG.Impl.Dsa.X86_64
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

theorem jointByteHeadInv_ok {t₀ t : State} {P : Addr} {w n xc g y : Nat}
    {minv : BitVec 64} {ep fp : Addr} {L : Nat} {eb fb : List Byte} {i : Nat}
    (hL : eb.length = L) (hF : fb.length = L) (hi : i < L)
    (hrd : ∀ i < L, InRegions (t₀.rd ++ t₀.wr) (ep + BitVec.ofNat 64 i) 1)
    (hbytes : ∀ i (h : i < L), t₀.mem (ep + BitVec.ofNat 64 i) = eb[i]'(by omega_using [hL, h]))
    (hout : ∀ i < L, slot w 8 + tabBytes w ≤ ofs P (ep + BitVec.ofNat 64 i))
    (frd : ∀ i < L, InRegions (t₀.rd ++ t₀.wr) (fp + BitVec.ofNat 64 i) 1)
    (fbytes : ∀ i (h : i < L), t₀.mem (fp + BitVec.ofNat 64 i) = fb[i]'(by omega_using [hF, h]))
    (fout : ∀ i < L, slot w 8 + tabBytes w ≤ ofs P (fp + BitVec.ofNat 64 i))
    (hI : JointByteInv t₀ P w minv n xc g y ep fp L eb fb i t) :
    WP isa (.block Joint.byteHead) t fun t₁ =>
      JointWinInv t₁ P w minv n xc g y (pre eb i) (pre fb i)
        (eb[i]'(by omega_using [hL, hi])).toNat (fb[i]'(by omega_using [hF, hi])).toNat 0 t₁ := by
  have hn := hI.ctx.scrT.nowrap
  let v := (eb[i]'(by omega_using [hL, hi])).toNat
  let z := (fb[i]'(by omega_using [hF, hi])).toNat
  have hv : v < 256 := (eb[i]'(by omega_using [hL, hi])).isLt
  have hz : z < 256 := (fb[i]'(by omega_using [hF, hi])).isLt
  have er : InRegions (t.rd ++ t.wr) (ep + BitVec.ofNat 64 i) 1 := by
    rw [hI.keep.2.1, hI.keep.2.2]; exact hrd i hi
  have fr : InRegions (t.rd ++ t.wr) (fp + BitVec.ofNat 64 i) 1 := by
    rw [hI.keep.2.1, hI.keep.2.2]; exact frd i hi
  have ev : t.mem (ep + BitVec.ofNat 64 i) = eb[i]'(by omega_using [hL, hi]) := by
    rw [hI.frm _ fun r hr => Or.inr (by have := (crtExpRanges_ok w r hr).2; have := hout i hi; omega_arith)]
    exact hbytes i hi
  have fv : t.mem (fp + BitVec.ofNat 64 i) = fb[i]'(by omega_using [hF, hi]) := by
    rw [hI.frm _ fun r hr => Or.inr (by have := (crtExpRanges_ok w r hr).2; have := fout i hi; omega_arith)]
    exact fbytes i hi
  refine WP.mono (jointByteHead_ok hI.ctx hI.idx hI.e hI.f er fr ev fv)
    fun t₁ ⟨hm₁, k₁⟩ => ?_
  have o1 := writeW_outside t.mem P (d := 8 * Crt.sV) (BitVec.ofNat 64 (256 * v + z)) (by decide)
  have o2 := writeW_outside (t.mem.writeW (off P (8 * Crt.sV)) (BitVec.ofNat 64 (256 * v + z))) P
    (d := 8 * Crt.sBit) (4 : BitVec 64) (by decide)
  rw [← hm₁] at o2
  have f₁ : Frm P (crtWinRanges w) t.mem t₁.mem :=
    (Frm.of_outside o1 (by simp [crtWinRanges])).trans (Frm.of_outside o2 (by simp [crtWinRanges]))
  have hc₁ := hI.ctx.of_win f₁ k₁.2.2 (k₁.gpr (by decide))
  have hY0 := slot_le (w := w) (show aY < 8 by decide)
  have hYe : wv t₁.mem P (slot w aY) w = wv t.mem P (slot w aY) w := by
    rw [o2.wv (by have := hdr_lt_slot w aY (show Crt.sBit < 32 by decide); omega_using [this]) (by omega_using [hn, hY0]),
      o1.wv (by have := hdr_lt_slot w aY (show Crt.sV < 32 by decide); omega_using [this]) (by omega_using [hn, hY0])]
  have hB0 : JointWinInv t₁ P w minv n xc g y (pre eb i) (pre fb i) v z 0 t₁ := by
    refine ⟨hc₁, hI.tab.of_win f₁ hn, hYe ▸ hI.ylt, ?_, ?_, ?_, Frm.refl _ _ _, Keep.refl _ _⟩
    · rw [hYe, hI.val, Nat.pow_zero, Nat.mul_one, Nat.mul_one, Nat.sub_zero,
        Nat.div_eq_of_lt (show v < 4 ^ 4 from hv), Nat.div_eq_of_lt (show z < 4 ^ 4 from hz),
        Nat.add_zero, Nat.add_zero]
    · rw [o2.word (by decide) (by decide), word_writeW_self, Nat.pow_zero, Nat.mul_one]
    · rw [hm₁, word_writeW_self]; rfl
  exact hB0

end VG.Proof.Dsa.X86_64

end

end

/-! ### `Dsa.X86_64.JointWindowCT`, which this module and modules that import it used -/

section

/-! # Joint exponentiation and conversion out of Montgomery representation -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64 VG.Impl.Dsa.X86_64 VG.Impl.Dsa.Layout
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

def JointWinI (p : XPub) (j : Nat) (s : State) : Prop :=
  ∃ (t₀ : State) (minv : BitVec 64) (n xc g y a b v z : Nat),
    JointWinInv t₀ (off p.B p.o) p.wx minv n xc g y a b v z j s ∧
    2 ≤ p.wx ∧ p.wx < 2 ^ 30 ∧ Nat.Coprime (2 ^ (64 * p.wx)) n ∧ v < 256 ∧ z < 256

theorem jointWindow_ct (M : Mont) (Sq : MontS) :
    RelCT isa (Two fun (q : XPub × Nat) s => q.2 < 4 ∧ JointWinI q.1 q.2 s) (Joint.window Sq.mm M.mm)
      fun _ _ => True := by
  unfold Joint.window seqs
  have sq : RelCT isa (Two fun (q : XPub × Nat) s => WinQ q.1 s Sq.bd) Sq.mm
      (Two fun (q : XPub × Nat) s => WinQ q.1 s Sq.bd) :=
    two_post (two_map (fun q : XPub × Nat => q.1.ws) (fun _ _ h => h.goodW) Sq.ct)
      fun _ _ h => winSqS_q Sq h
  -- Two squarings.
  have sq0 : RelCT isa (Two fun (q : XPub × Nat) s => q.2 < 4 ∧ JointWinI q.1 q.2 s) Sq.mm
      (Two fun (q : XPub × Nat) s => WinQ q.1 s Sq.bd) :=
    two_post (two_map (fun q : XPub × Nat => q.1.ws)
      (fun _ _ ⟨_, _, _, _, _, _, _, _, _, _, _, hI, _⟩ => ⟨_, hI.ctx.good, Nat.le_refl _⟩)
      Sq.ct) fun q s ⟨hj, t₀, minv, n, xc, g, y, a, b, v, z, hI, hw, hw', hR, hv, hz⟩ => by
        have hp : (256 * v + z) * 4 ^ q.2 < 2 ^ 56 := by
          have : 4 ^ q.2 ≤ 4 ^ 3 := Nat.pow_le_pow_right (by decide) (by omega_using [hj])
          have := Nat.mul_le_mul_left (256 * v + z) this
          omega_using [hv, hz, this]
        have tab : CTab s.mem (off q.1.B q.1.o) q.1.wx n False 0 :=
          ⟨hI.tab.tab, hI.tab.lt, fun h _ _ => False.elim h⟩
        have hnR : n ≤ 2 ^ (64 * q.1.wx) := by rw [← hI.ctx.n]; exact Nat.le_of_lt (wv_lt _ _ _ _)
        exact winSqS_q Sq ⟨minv, n, xc, _, hI.ctx, tab, Nat.lt_of_lt_of_le hI.ylt (Sq.le hnR), hI.bytes, hp, hw, hw', hR⟩
  -- The window, and `sV` up.
  have mid : RelCT isa (Two fun (q : XPub × Nat) s => WinQ q.1 s Sq.bd)
      (.block Joint.windowIndex)
      (Two fun (q : XPub × Nat) s => WinS q.1 s Sq.bd) := by
    refine two_piece [.rdi] (pins_rdi (fun q : XPub × Nat => off q.1.B q.1.o) fun _ _ h => h.rdi) (by unfold Joint.windowIndex; taint_decide)
      fun q s h => ?_
    obtain ⟨minv, X, Xc, V, hc, htab, hY, hV, hV', hw, hw', hR⟩ := h
    have hn := hc.scrT.nowrap
    refine WP.mono (joint_mid_ok hc hV (by omega_arith)) fun t ⟨hm, k⟩ => ?_
    have o1 := writeW_outside s.mem (off q.1.B q.1.o) (d := 8 * Crt.sV) (BitVec.ofNat 64 (4 * V)) (by decide)
    have o2 := writeW_outside (s.mem.writeW (off (off q.1.B q.1.o) (8 * Crt.sV)) (BitVec.ofNat 64 (4 * V)))
      (off q.1.B q.1.o) (d := 8 * Crt.sNib) (BitVec.ofNat 64 ((4 * (V / 16384 % 4) + V / 64 % 4))) (by decide)
    rw [← hm] at o2
    have f : Frm (off q.1.B q.1.o) (crtWinRanges q.1.wx) s.mem t.mem :=
      (Frm.of_outside o1 (by simp [crtWinRanges])).trans (Frm.of_outside o2 (by simp [crtWinRanges]))
    have hc' := hc.of_win f k.2.2 (k.gpr (by decide))
    have hY0 := slot_le (w := q.1.wx) (show Public.aY < 8 by decide)
    have hYe : wv t.mem (off q.1.B q.1.o) (slot q.1.wx Public.aY) q.1.wx =
        wv s.mem (off q.1.B q.1.o) (slot q.1.wx Public.aY) q.1.wx := by
      rw [o2.wv (by have := hdr_lt_slot q.1.wx Public.aY (show Crt.sNib < 32 by decide); omega_arith) (by omega_arith),
        o1.wv (by have := hdr_lt_slot q.1.wx Public.aY (show Crt.sV < 32 by decide); omega_arith) (by omega_arith)]
    exact ⟨⟨minv, X, Xc, (4 * (V / 16384 % 4) + V / 64 % 4), hc', hw, hw', (VG.Proof.Dsa.joint_index (Nat.mod_lt _ (by decide)) (Nat.mod_lt _ (by decide))).1, by
        rw [hm, hdrStore_hdr _ _ _ (by decide) (by decide) (by decide),
          hdrStore_hdr _ _ _ (by decide) (by decide) (by decide)]; exact htab.tab,
        by rw [hm, word_writeW_self]⟩,
      minv, X, Xc, hc', htab.of_win f hn, hYe ▸ hY, hR⟩
  refine RelCT.seq sq0 (RelCT.seq sq (RelCT.seq mid ?_))
  refine RelCT.seq (two_post (Ψ := fun (q : XPub × Nat) s => WinT q.1 s)
    (two_map (fun q : XPub × Nat => q.1) (fun _ _ h => h.1) tabSel_ct) fun q s h => ?_) ?_
  · obtain ⟨⟨minv, X, Xc, v, hc, hw, hw', hv, ht, hN⟩, minv', X', Xc', hc₂, htab, -, -⟩ := h
    refine WP.mono (tabSel_ok hc hw hw' hv ht hN) fun t ⟨hc', hT, _, _⟩ => ⟨minv, X, Xc, hc', ?_, hw, hw'⟩
    have hX : X' = X := hc₂.n.symm.trans hc.n
    rw [hT, ← hX]; exact htab.lt _ hv
  refine RelCT.seq (two_post (Ψ := fun (q : XPub × Nat) t => t.gpr .rdi = off q.1.B q.1.o)
    (two_map (fun q : XPub × Nat => q.1.ws) (fun _ _ ⟨minv, _, _, hc, _⟩ => ⟨minv, hc.good, Nat.le_refl _⟩)
      (M.ct (o := Public.aY) (a := Public.aY) (b := Crt.aT) (by unfold MmUse; decide)))
    fun q s ⟨minv, X, Xc, hc, hT, hw, hw'⟩ => ?_) ?_
  · exact WP.mono (M.mm_ok (o := Public.aY) (a := Public.aY) (b := Crt.aT) hc.good (Nat.le_refl _) hw (by omega_arith)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) hc.inv
      (by rw [hc.n]; exact hT)) fun t ⟨hg, _⟩ => hg.rdi
  exact rdi_ct (fun q : XPub × Nat => off q.1.B q.1.o) (fun _ _ h => h) (by taint_decide)

theorem jointWindows_ct (M : Mont) (Sq : MontS) :
    RelCT isa (Two fun p s => 0 < 4 ∧ JointWinI p 0 s) (.loop (Joint.window Sq.mm M.mm) .ne)
      (Two fun p s => JointWinI p 4 s) :=
  two_loop (Φ := JointWinI) (fun _ => 4) (jointWindow_ct M Sq)
    fun _ _ _ hj ⟨t₀, minv, n, xc, g, y, a, b, v, z, hI, hw, hw', hR, hv, hz⟩ =>
      WP.mono (jointWinStep_ok M Sq hw hw' hR hv hz hj hI) fun _ ⟨hflag, hI'⟩ =>
        ⟨eval_ne_count hj hflag, fun _ => ⟨t₀, minv, n, xc, g, y, a, b, v, z, hI', hw, hw', hR, hv, hz⟩,
          fun h => h ▸ ⟨t₀, minv, n, xc, g, y, a, b, v, z, hI', hw, hw', hR, hv, hz⟩⟩

end VG.Proof.Dsa.X86_64


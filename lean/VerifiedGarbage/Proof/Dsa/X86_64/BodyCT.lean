/-! # Constant time of the joint exponentiation loop and decoding -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64 VG.Impl.Dsa.X86_64 VG.Impl.Dsa.Layout
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

structure JointPublic extends ProductCallPublic where
  qLen : Nat
  qPositive : 0 < qLen
  qBound : qLen < 2 ^ 31
  parentSpace : 344 ≤ bytes.x.o

def JointPublic.scan (p : JointPublic) : JointBytesPublic :=
  ⟨p.x, off p.x.B u, off p.x.B v, p.qLen⟩

def JointScalars (p : JointPublic) (s : State) : Prop :=
  ∃ eb fb : List Byte, Src s p.x.B p.x.Z (off p.x.B u) eb ∧ Src s p.x.B p.x.Z (off p.x.B v) fb ∧
    eb.length = p.qLen ∧ fb.length = p.qLen ∧
    word s.mem p.x.B Field.qLen.offset = BitVec.ofNat 64 p.qLen

def JointRunPre (p : JointPublic) (s : State) : Prop :=
  SubCtx s p.x.B p.x.Z p.x.o p.x.w p.x.wx p.minv ∧
  JointCtx s (off p.x.B p.x.o) p.x.wx p.modulus p.minv ∧
  (∃ g y, JointTab s.mem (off p.x.B p.x.o) p.x.wx p.modulus g y) ∧
  wv s.mem (off p.x.B p.x.o) (slot p.x.wx aY) p.x.wx = 2 ^ (64 * p.x.wx) % p.modulus ∧
  wv s.mem (off p.x.B p.x.o) (slot p.x.wx aOne) p.x.wx = 1 ∧ JointScalars p s

theorem jointInit_ct : RelCT isa (Two JointRunPre) (.block Joint.expInit) (fun _ _ => True) := by
  change RelCT isa _ (.block ([.mov .rax (.mem (hdr Crt.sLink))] ++ Joint.expInit.tail)) _
  apply RelCT.block_append
  refine RelCT.seq (two_piece (Ψ := fun p s => s.gpr .rdi = off p.x.B p.x.o ∧ s.gpr .rax = p.x.B) [.rdi]
    (pins_rdi (fun p : JointPublic => off p.x.B p.x.o) (fun _ _ h => h.1.rdi)) (by taint_decide) ?_)
    (two_taint [.rdi, .rax] (pins_of (fun (p : JointPublic) r => if r = .rdi then off p.x.B p.x.o else p.x.B)
      (by intro p s h r hr; simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
          rcases hr with rfl | rfl
          · exact h.1
          · exact h.2)) (by simp only [Joint.expInit, List.tail_cons]; taint_decide))
  intro p s h
  have hc := h.1
  xrun [State.ea, hdr, hc.rdi, hdrOff, hc.link,
    hc.good.scr.ld (show 8 * Crt.sLink + 8 ≤ slot p.x.wx 8 by
      have := hdr_lt_slot p.x.wx 8 (show Crt.sLink < 32 by decide); omega_using [this])]

theorem jointRun_ct (M : Mont) (Sq : MontS) : RelCT isa (Two JointRunPre) (Joint.run Sq.mm M.mm) (fun _ _ => True) := by
  unfold Joint.run seqs
  refine RelCT.seq (two_post (Ψ := fun p : JointPublic => fun s => 0 < p.scan.len ∧ JointBytesInv p.scan 0 s)
    jointInit_ct ?_) ?_
  · rintro p s ⟨hc, hm, ⟨g, y, ht⟩, hy, ho, eb, fb, he, hf, hL, hF, hl⟩
    have hfield : 344 ≤ p.x.Z := by have := hc.hi; have : 344 ≤ p.x.o := p.parentSpace; omega_arith
    refine WP.mono (jointInit_ok hc hm ht hfield hl)
      fun t ⟨hct, hmt, htt, ha, ep, fp, len, idx, hfrm, hk⟩ => ?_
    have het := work_source hc hfrm hk he
    have hft := work_source hc hfrm hk hf
    have hyt := (ha aY (by decide)).trans hy
    have hI : JointByteInv t (off p.x.B p.x.o) p.x.wx p.minv p.modulus
        (wv t.mem (off p.x.B p.x.o) (slot p.x.wx Crt.aXc) p.x.wx) g y
        (off p.x.B u) (off p.x.B v) p.qLen eb fb 0 t := by
      refine ⟨hmt.exp, htt, ?_, ?_, idx, ep, fp, len, Frm.refl _ _ _, Keep.refl _ _⟩
      · rw [hyt]; exact Nat.mod_lt _ (by have := p.greater; omega_using [this])
      · rw [hyt, Nat.mod_mod, pre_zero, pre_zero, Nat.pow_zero, Nat.pow_zero, Nat.one_mul]
    dsimp only [JointBytesInv, JointPublic.scan]
    exact ⟨p.qPositive, t, p.minv, p.modulus, _, g, y, eb, fb, hI, p.lower,
      by have : p.x.wx ≤ 48 := p.width48; omega_using [this], coprime_pow2 p.odd _, hL, hF, p.qBound, het, hft,
      by simpa only [hL] using joint_source_out hct het,
      by simpa only [hF] using joint_source_out hct hft⟩
  refine RelCT.seq (two_map JointPublic.scan (fun _ _ h => h) (jointBytes_ct M Sq)) ?_
  exact two_map (fun p : JointBytesPublic => p.x.ws)
    (fun _ _ ⟨_, minv, _, _, _, _, _, _, hI, _⟩ => ⟨minv, hI.ctx.good, Nat.le_refl _⟩)
    (M.ct (by unfold MmUse; decide))

end VG.Proof.Dsa.X86_64

end

end

/-! # Constant time of complete joint DSA exponentiation -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64 VG.Impl.Dsa.X86_64 VG.Impl.Dsa.Layout
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

def JointPowerPre (p : JointPublic) (s : State) : Prop :=
  PowerCallPre p.toPowerCallPublic s ∧ JointScalars p s

theorem JointScalars.frame {p : JointPublic} {s t : State} (h : JointScalars p s)
    (hc : SubCtx s p.x.B p.x.Z p.x.o p.x.w p.x.wx p.minv)
    (hf : Frm (off p.x.B p.x.o) (workRanges p.x.wx) s.mem t.mem) (hk : Keep mmRegs s t) :
    JointScalars p t := by
  obtain ⟨eb, fb, he, hfb, hL, hF, hl⟩ := h
  refine ⟨eb, fb, work_source hc hf hk he, work_source hc hf hk hfb, hL, hF, ?_⟩
  have hnow := hc.scr.nowrap
  have hhi := hc.hi
  have hsmall : 256 ≤ slot p.x.wx 8 := by unfold slot hdrBytes; omega_using []
  rw [hf.word_below (fun r hr => (workRanges_ok p.x.wx r hr).2)
    (by omega_using [hnow, hhi]) (by omega_using [hnow, hhi, hsmall]) (show Field.qLen.offset + 8 ≤ p.x.o from p.parentSpace)]
  exact hl

theorem jointPower_ct (M : Mont) (Sq : MontS) : RelCT isa (Two JointPowerPre) (Joint.power Sq.mm M.mm) (fun _ _ => True) := by
  unfold Joint.power
  refine RelCT.seq (two_post (Ψ := JointRunPre)
    (two_map JointPublic.toProductCallPublic (fun _ _ h => h.1) (jointPrepare_ct M)) ?_)
    (jointRun_ct M Sq)
  intro p s ⟨⟨hc, hm, gb, yb, hg, hgl, hy, hyl, hgL, hyL, hgs, hys⟩, hs⟩
  refine WP.mono (jointPrepare_ok M hc p.lower p.width48 p.fits p.upper p.greater p.odd hm.modulus hm.inverse
    hg hgl hgs (hgL ▸ p.basePositive) (hgL ▸ p.baseFits)
    hy hyl hys (hyL ▸ p.expPositive) (hyL ▸ p.secondFits))
    fun t ⟨hct, hmt, ht, hyt, hot, hft, hkt⟩ => ?_
  exact ⟨hct, hmt, ⟨_, _, ht⟩, hyt, hot, hs.frame hc hft hkt⟩

end VG.Proof.Dsa.X86_64

end

end

/-! # Constant-time binding, execution and storage of a joint call -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64
open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64 VG.Impl.Dsa.X86_64 VG.Impl.Dsa.Layout
open VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64

structure JointCallPublic extends Call3ProductPublic where
  qLen : Nat
  qPositive : 0 < qLen
  qBound : qLen < 2 ^ 31
  parentSpace : 344 ≤ bytes.x.o

def JointCallPublic.joint (p : JointCallPublic) : JointPublic :=
  { p.toPowerCallPublic with
    secondFits := p.secondFits
    qLen := p.qLen
    qPositive := p.qPositive
    qBound := p.qBound
    parentSpace := p.parentSpace }

def JointCallAfter (p : JointCallPublic) (s : State) : Prop :=
  JointPowerPre p.joint s ∧ FinishPre p.toPowerFinishPublic.result s

theorem jointFinish_ct (M : Mont) (Sq : MontS) : RelCT isa (Two JointCallAfter)
    (.seq (Joint.power Sq.mm M.mm) (seqs Core.finish)) (fun _ _ => True) := by
  refine RelCT.seq (two_post (Ψ := fun p s => FinishPre p.toPowerFinishPublic.result s)
    (two_map JointCallPublic.joint (fun _ _ h => h.1) (jointPower_ct M Sq)) ?_)
    (two_map (fun p : JointCallPublic => p.toPowerFinishPublic.result) (fun _ _ h => h) finish_ct)
  rintro p s ⟨⟨⟨hc, hm, gb, yb, hg, hgl, hy, hyl, hgL, hyL, hgs, hys⟩,
    eb, fb, he, hf, hL, hF, hl⟩, hout⟩
  exact WP.mono (jointPower_ok M Sq hc p.lower p.width48 p.fits p.upper p.greater p.odd p.parentSpace
    hm.modulus hm.inverse hg hgl hgs (hgL ▸ p.basePositive) (hgL ▸ p.baseFits)
    hy hyl hys (hyL ▸ p.expPositive) (hyL ▸ p.secondFits) he hf (hF.trans hL.symm)
    (hL ▸ p.qPositive) (hL ▸ p.qBound) (hL ▸ hl))
    fun t ⟨hct, _, _, hft, hkt⟩ => hout.work hc hct hft hkt

theorem coreJoint_ct (M : Mont) (Sq : MontS) {a b output : Operand} {o : Nat}
    (ha : pointerFits a.pointer) (hb : pointerFits b.pointer) (ho : pointerFits output.pointer)
    {hc : VG.Taint.Hint VG.X86_64.Taint.T}
    (hT : (taint.check (Taint.ofRegs [.rdi]) (.block (callHead a b output o)) hc).isSome = true) :

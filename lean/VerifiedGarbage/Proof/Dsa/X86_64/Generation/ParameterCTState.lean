/-! # The controller tail determines whether the bounded p loop continues -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64
open VG.Impl.Dsa.X86_64.Generation

def SearchControlPublic.next (p : SearchControlPublic) (limit : Nat) : SearchControlPublic where
  B := p.B
  counter := if p.status = 3 then p.counter + 1 else p.counter
  stride := p.stride
  status := if p.status = 3 then (if p.counter + 1 < limit then 3 else 2) else p.status
  statusBound := by split; split <;> decide; exact p.statusBound

def SearchTailCompared (limit stride : Nat) (p : SearchControlPublic) (s : State) : Prop :=
  SearchAdvanceBefore limit stride p s ∧ s.zf = some (decide (p.status = 3))

theorem searchTail_compare {limit stride : Nat} {p : SearchControlPublic} {s : State}
    (h : SearchAdvanceBefore limit stride p s) :
    WP isa (.block pSearchStatusCmp) s (SearchTailCompared limit stride p) :=
  WP.mono (searchControl_compare h.1) fun _ ht => ⟨⟨ht.1, h.2⟩, ht.2⟩

theorem searchTail_advance {limit stride : Nat} (hl : limit ≤ 12288) (hs : stride ≤ 12)
    {p : SearchControlPublic} {s : State} (h : SearchTailCompared limit stride p s)
    (he : eval .e s = some true) :
    WP isa (pSearchAdvance limit stride) s (SearchControlBefore (p.next limit)) := by
  have retry : p.status = 3 := by simpa only [eval, h.2, Option.some.injEq, decide_eq_true_eq] using he
  have ctrl : SearchControl p.B p.counter stride s := by rw [← h.1.2.2]; exact h.1.1.1
  refine WP.mono (searchAdvance_ok ctrl h.1.2.1 hl hs) fun t ⟨hc, status, _, _⟩ => ?_
  change SearchControl p.B (if p.status = 3 then p.counter + 1 else p.counter) p.stride t ∧
    word t.mem p.B 16 = BitVec.ofNat 64 (if p.status = 3 then (if p.counter + 1 < limit then 3 else 2) else p.status)
  simpa only [retry, ite_true, h.1.2.2] using And.intro hc status

theorem searchTail_stop {limit stride : Nat} {p : SearchControlPublic} {s : State}
    (h : SearchTailCompared limit stride p s) (he : eval .e s = some false) :
    SearchControlBefore (p.next limit) s := by
  have retry : ¬ p.status = 3 := by simpa only [eval, h.2, Option.some.injEq, decide_eq_false_iff_not] using he
  simpa only [SearchControlBefore, SearchControlPublic.next, retry, ite_false] using h.1.1

theorem searchTail_ct (limit stride : Nat) (hl : limit ≤ 12288) (hs : stride ≤ 12)
    {hc : VG.Taint.Hint VG.X86_64.Taint.T}
    (ht : (taint.check (Taint.ofRegs [.rdi]) (.block (pSearchAdvanceHead limit stride)) hc).isSome = true) :
    RelCT isa (Two (SearchAdvanceBefore limit stride))
      (.seq (.block pSearchStatusCmp)
        (.seq (.ite .e (pSearchAdvance limit stride) (.block [])) (.block pSearchStatusCmp)))
      (Two (fun (p : SearchControlPublic) s => SearchControlCompared (p.next limit) s)) := by
  refine RelCT.seq (two_post (searchStatusCmp_ct.mono
    (fun _ _ => two_mono fun _ _ h => h.1) (fun _ _ _ => True.intro))
    (fun _ _ h => searchTail_compare h)) (RelCT.seq (R := Two (fun (p : SearchControlPublic) s => SearchControlBefore (p.next limit) s)) ?_ ?_)
  · refine two_ite (fun _ _ _ hs ht => by simp only [eval, hs.2, ht.2]) ?_ ?_
    · exact two_post ((searchAdvance_ct limit stride hl hs ht).mono
        (fun _ _ => two_mono fun _ _ h => h.1.1) (fun _ _ _ => True.intro))
        (fun _ _ h => searchTail_advance hl hs h.1 h.2)
    · exact RelCT.block_nil (fun _ _ => two_mono fun _ _ h => searchTail_stop h.1 h.2)
  · exact two_post ((two_map (fun p : SearchControlPublic => p.next limit) (fun _ _ h => h) searchStatusCmp_ct).mono
      (fun _ _ h => h) (fun _ _ _ => True.intro)) (fun _ _ h => searchControl_compare h)

end VG.Proof.Dsa.X86_64.Generation

end

end

/-! # Retrying a p iteration advances a public counter and an exact witness cursor -/

-- Formerly `VerifiedGarbage/Proof/Dsa/X86_64/Generation/SearchBodyReadyCT.lean`, which only this module imported.
section

/-! # A completed p attempt returns a public status and next witness cursor -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MillerRabin.X86_64
open VG.Proof.Pbkdf2.Md.X86_64 VG.Proof.RsaOaep.X86_64

def SearchPublic.result (p : SearchPublic) : Option (Bool × List Byte) :=
  p.plan.stepResult p.counter p.used

def SearchPublic.status (p : SearchPublic) : Nat :=
  match p.result with
  | none => 0
  | some (b, _) => if b then 1 else 3

def SearchPublic.nextUsed (p : SearchPublic) : Nat :=
  match p.result with
  | none => p.used
  | some (_, rest) => p.plan.attempt.rand.length - rest.length

def SearchPublic.control (p : SearchPublic) : SearchControlPublic where
  B := p.plan.C
  counter := p.counter
  stride := p.plan.attempt.construct.hash.count + 1
  status := p.status
  statusBound := by unfold SearchPublic.status; split; decide; split <;> decide

structure SearchBodyAfter (n : Nat) (p : SearchPublic) (s : State) : Prop where
  memory : ∃ W, SearchMemory p.plan W s ∧
    (p.status = 3 → W 16 = BitVec.ofNat 64 p.nextUsed ∧ p.nextUsed ≤ p.plan.attempt.rand.length)
  control : SearchControlBefore p.control s
  frame : FrV n p.plan.attempt.construct.hash.F p.ws s
  wr : s.wr = p.wr

theorem searchBody_ready (G1 G256 : Impl.Pbkdf2.Md.X86_64.Stream)
    (T : PrimeTest) {n pLen qLen : Nat} {H : Spec.Mgf1.Hash}
    (hG : Calls.StreamOK (if qLen = 20 then G1 else G256))
    (hmatch : ∀ x, H.hash x = hG.SH.H.hash x)
    (hsize : ∀ x, (H.hash x).length = (if qLen = 20 then G1 else G256).D)
    (hhash : ∀ bs, H.hash bs = Spec.Dsa.seedHash (8 * qLen) bs)
    (hseedsize : ∀ bs, 8 * (Spec.Dsa.seedHash (8 * qLen) bs).length = 8 * qLen)
    (hd : (if qLen = 20 then G1 else G256).D = qLen) {p : SearchPublic} {s : State}
    (h : SearchBefore n pLen qLen p s) :
    WP isa (Impl.Dsa.X86_64.Generation.pAttempt G1 G256 T.run pLen qLen) s (SearchBodyAfter n p) := by
  obtain ⟨⟨W, hs, hu⟩, ctrl, frame, wr, ub, hp, hq⟩ := h
  subst qLen
  have step := searchBody_ok hG hmatch hsize T hd hhash hseedsize hs ctrl p.bound hu ub
  rw [hp] at step
  refine WP.mono step fun t ⟨ct, W', used, status, memory, bound, wordUsed, _, wordStatus,
    _, _, exhausted, result, _, _, wrt⟩ => ?_
  have statusEq : status = BitVec.ofNat 64 p.status := by
    cases hr : p.result with
    | none => exact (exhausted hr).trans (by simp [SearchPublic.status, hr])
    | some pair =>
      obtain ⟨b, rest⟩ := pair
      exact (result b rest hr).1.trans (by simp [SearchPublic.status, hr])
  refine ⟨⟨W', memory, ?_⟩, ⟨ct, wordStatus.trans statusEq⟩,
    frame.congr (memory.layout.rsp.trans hs.layout.rsp.symm) wrt, wrt.trans wr⟩
  intro retry
  cases hr : p.result with
  | none => simp [SearchPublic.status, hr] at retry
  | some pair =>
    obtain ⟨b, rest⟩ := pair
    have usedEq : used = p.nextUsed := by simpa only [SearchPublic.nextUsed, hr] using (result b rest hr).2
    exact ⟨usedEq ▸ wordUsed, usedEq ▸ bound⟩

end VG.Proof.Dsa.X86_64.Generation
end

end

-- Formerly `VerifiedGarbage/Proof/Dsa/X86_64/Generation/SearchTailReadyCT.lean`, which only this module imported.
section

/-! # Controller-tail framing and the exact public continuation decision -/

section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64
open VG.Impl.Dsa.X86_64.Generation

theorem searchTail_ready {limit stride : Nat} (hl : limit ≤ 12288) (hs : stride ≤ 12)
    {p : SearchControlPublic} {s : State} (h : SearchAdvanceBefore limit stride p s) :
    WP isa (.seq (.block pSearchStatusCmp)
      (.seq (.ite .e (pSearchAdvance limit stride) (.block [])) (.block pSearchStatusCmp))) s fun t =>
      SearchControlCompared (p.next limit) t ∧ Outside p.B 0 24 s.mem t.mem ∧ Keep [.rax, .rcx] s t := by
  refine WP.seq (WP.mono (searchStatusCmp_ok h.1.1 p.statusBound h.1.2)
    fun u ⟨uz, um, uk⟩ => ?_)
  have ctrl := h.1.1.congr um uk
  have before : SearchTailCompared limit stride p u := ⟨⟨⟨ctrl, um ▸ h.1.2⟩, h.2⟩, uz⟩
  by_cases retry : p.status = 3
  · refine WP.seq (WP.ite true (by simp [eval, uz, retry]) (fun _ => ?_) (fun he => Bool.noConfusion he))
    have ctrl' : SearchControl p.B p.counter stride u := by rw [← h.2.2]; exact ctrl
    refine WP.mono (searchAdvance_ok ctrl' h.2.1 hl hs) fun v ⟨vc, vs, vf, vk⟩ => ?_
    have next : SearchControlBefore (p.next limit) v := by
      simpa only [SearchControlBefore, SearchControlPublic.next, retry, ite_true, h.2.2] using And.intro vc vs
    refine WP.mono (searchStatusCmp_ok next.1 (p.next limit).statusBound next.2)
      fun t ⟨tz, tm, tk⟩ => ?_
    refine ⟨⟨⟨next.1.congr tm tk, tm ▸ next.2⟩, tz⟩, ?_, ?_⟩
    · simpa only [tm, um] using vf
    · exact ((uk.trans vk).trans tk).mono (by decide)
  · refine WP.seq (WP.ite false (by simp [eval, uz, retry]) (fun he => Bool.noConfusion he)
      (fun _ => WP.block_nil ?_))
    have next := searchTail_stop before (by simp [eval, uz, retry])
    refine WP.mono (searchStatusCmp_ok next.1 (p.next limit).statusBound next.2)
      fun t ⟨tz, tm, tk⟩ => ?_
    refine ⟨⟨⟨next.1.congr tm tk, tm ▸ next.2⟩, tz⟩, ?_, (uk.trans tk).mono (by decide)⟩
    rw [tm, um]; exact Outside.refl _ _ _ _

end VG.Proof.Dsa.X86_64.Generation
end

end

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64
open VG.Impl.Dsa.X86_64.Generation

def SearchPublic.continues (p : SearchPublic) : Bool :=
  decide (p.status = 3 ∧ p.counter + 1 < 32 * p.plan.attempt.construct.len)

def SearchPublic.next (p : SearchPublic) (h : p.continues = true) : SearchPublic :=
  { p with counter := p.counter + 1, used := p.nextUsed
           bound := (of_decide_eq_true h).2 }

def SearchBodySized (n pLen qLen : Nat) (p : SearchPublic) (s : State) : Prop :=
  SearchBodyAfter n p s ∧ p.plan.attempt.construct.len = pLen ∧ p.plan.attempt.construct.hash.len = qLen

def SearchIterationAfter (n pLen qLen : Nat) (p : SearchPublic) (s : State) : Prop :=
  eval .e s = some p.continues ∧ ∀ hc : p.continues = true, SearchBefore n pLen qLen (p.next hc) s

theorem searchBody_control {n pLen qLen : Nat} {p : SearchPublic} {s : State}
    (h : SearchBodySized n pLen qLen p s) :
    SearchAdvanceBefore (32 * pLen) ((8 * pLen - 1) / (8 * qLen) + 1) p.control s := by
  refine ⟨h.1.control, ?_, ?_⟩
  · change p.counter < 32 * pLen; rw [← h.2.1]; exact p.bound
  · change p.plan.attempt.construct.hash.count + 1 = _
    rw [p.plan.attempt.construct.hashCount, h.2.1, h.2.2]

theorem searchIteration_tail {n pLen qLen : Nat} {p : SearchPublic} {s : State}
    (h : SearchBodySized n pLen qLen p s)
    (hl : 32 * pLen ≤ 12288) (hs : (8 * pLen - 1) / (8 * qLen) + 1 ≤ 12) :
    WP isa (.seq (.block pSearchStatusCmp)
      (.seq (.ite .e (pSearchAdvance (32 * pLen) ((8 * pLen - 1) / (8 * qLen) + 1)) (.block []))
        (.block pSearchStatusCmp))) s (SearchIterationAfter n pLen qLen p) := by
  refine WP.mono (searchTail_ready hl hs (searchBody_control h)) fun t ⟨ct, ff, hk⟩ => ?_
  have condition : eval .e t = some p.continues := by
    simp only [eval, ct.2]
    change some (decide ((p.control.next (32 * pLen)).status = 3)) = some p.continues
    simp only [SearchControlPublic.next, SearchPublic.control, SearchPublic.continues]
    rw [h.2.1]
    by_cases retry : p.status = 3 <;> by_cases hc : p.counter + 1 < 32 * pLen <;> simp [retry, hc]
  refine ⟨condition, ?_⟩
  intro cont
  have retry := (of_decide_eq_true cont).1
  obtain ⟨W, memory, cursor⟩ := h.1.memory
  obtain ⟨used, bound⟩ := cursor retry
  have mem := SearchMemory.stable memory ff hk
  refine ⟨⟨W, mem, used⟩, ?_, h.1.frame.congr (hk.gpr (by decide)) hk.2.2,
    hk.2.2.trans h.1.wr, bound, h.2⟩
  have ctrl := ct.1.1
  simpa only [SearchControlPublic.next, SearchPublic.control, SearchPublic.next, retry, ite_true] using ctrl

end VG.Proof.Dsa.X86_64.Generation

end

end

/-! # Complete p-search iteration, including its public continuation decision -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum.X86_64 VG.Proof.MillerRabin.X86_64
open VG.Proof.Pbkdf2.Md.X86_64 VG.Impl.Dsa.X86_64.Generation VG.Impl.Bignum.X86_64

theorem searchIteration_ct_of (G1 G256 : Impl.Pbkdf2.Md.X86_64.Stream)
    (T : PrimeTest) (n : Nat) (hn : n = 2 ∨ n = 3 ∨ n = 6) (H : Spec.Mgf1.Hash) (pLen qLen : Nat)
    (sizes : GenerationSizes pLen qLen)
    (hG : Calls.StreamOK (if qLen = 20 then G1 else G256))
    (hmatch : ∀ x, H.hash x = hG.SH.H.hash x)
    (hsize : ∀ x, (H.hash x).length = (if qLen = 20 then G1 else G256).D)
    (hhash : ∀ bs, H.hash bs = Spec.Dsa.seedHash (8 * qLen) bs)
    (hseedsize : ∀ bs, 8 * (Spec.Dsa.seedHash (8 * qLen) bs).length = 8 * qLen)
    (hd : (if qLen = 20 then G1 else G256).D = qLen)
    (hl : 32 * pLen ≤ 12288) (hs : (8 * pLen - 1) / (8 * qLen) + 1 ≤ 12)
    {hc : VG.Taint.Hint VG.X86_64.Taint.T}
    (ht : (taint.check (Taint.ofRegs [.rdi])
      (.block (pSearchAdvanceHead (32 * pLen) ((8 * pLen - 1) / (8 * qLen) + 1))) hc).isSome = true) :
    RelCT isa (Two (SearchBefore n pLen qLen))
      (pSearchIteration (pAttempt G1 G256 T.run pLen qLen)
        (32 * pLen) ((8 * pLen - 1) / (8 * qLen) + 1))
      (Two (SearchIterationAfter n pLen qLen)) := by
  unfold pSearchIteration
  simp only [seqs]
  have body : RelCT isa (Two (SearchBefore n pLen qLen)) (pAttempt G1 G256 T.run pLen qLen)
      (Two (SearchBodySized n pLen qLen)) := by
    refine two_post (searchBody_ct G1 G256 T n hn H pLen qLen sizes hG hmatch hsize hhash hseedsize hd) ?_
    intro p s h
    exact WP.mono (searchBody_ready G1 G256 T hG hmatch hsize hhash hseedsize hd h)
      fun _ ht => ⟨ht, h.2.2.2.2.2⟩
  refine RelCT.seq body (two_post ((two_map SearchPublic.control (fun _ _ h => searchBody_control h)
    (searchTail_ct (32 * pLen) ((8 * pLen - 1) / (8 * qLen) + 1) hl hs ht)).mono
    (fun _ _ h => h) (fun _ _ _ => True.intro)) (fun _ _ h => searchIteration_tail h hl hs))

theorem searchIteration_ct (G1 G256 : Impl.Pbkdf2.Md.X86_64.Stream)
    (T : PrimeTest) (n : Nat) (hn : n = 2 ∨ n = 3 ∨ n = 6) (H : Spec.Mgf1.Hash) (pLen qLen : Nat)
    (sizes : GenerationSizes pLen qLen)
    (hG : Calls.StreamOK (if qLen = 20 then G1 else G256))
    (hmatch : ∀ x, H.hash x = hG.SH.H.hash x)
    (hsize : ∀ x, (H.hash x).length = (if qLen = 20 then G1 else G256).D)
    (hhash : ∀ bs, H.hash bs = Spec.Dsa.seedHash (8 * qLen) bs)
    (hseedsize : ∀ bs, 8 * (Spec.Dsa.seedHash (8 * qLen) bs).length = 8 * qLen)
    (hd : (if qLen = 20 then G1 else G256).D = qLen) :
    RelCT isa (Two (SearchBefore n pLen qLen))
      (pSearchIteration (pAttempt G1 G256 T.run pLen qLen)
        (32 * pLen) ((8 * pLen - 1) / (8 * qLen) + 1))
      (Two (SearchIterationAfter n pLen qLen)) := by
  rcases sizes with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals
    exact searchIteration_ct_of G1 G256 T n hn H _ _ (by unfold GenerationSizes; decide)
      hG hmatch hsize hhash hseedsize hd (by decide) (by decide) (by taint_decide)

end VG.Proof.Dsa.X86_64.Generation

end

end

/-! ### `Dsa.X86_64.Generation.SearchInitCT`, which only this module used -/

section

/-! # Initialize the bounded p search without assumptions about old controller words -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64
open VG.Proof.RsaOaep.X86_64 VG.Impl.Dsa.X86_64.Generation

def SearchStart (n pLen qLen : Nat) (p : SearchPublic) (s : State) : Prop :=
  (∃ W, SearchMemory p.plan W s ∧ W 16 = BitVec.ofNat 64 p.used) ∧
    Scr s p.plan.C 24 ∧ FrV n p.plan.attempt.construct.hash.F p.ws s ∧ s.wr = p.wr ∧
    p.used ≤ p.plan.attempt.rand.length ∧ p.plan.attempt.construct.len = pLen ∧
    p.plan.attempt.construct.hash.len = qLen ∧ p.counter = 0

def SearchInitBefore (n pLen qLen : Nat) (p : SearchPublic) (s : State) : Prop :=
  SearchStart n pLen qLen p s ∧ s.gpr .rdi = p.plan.C

def SearchPublic.returnFrame (p : SearchPublic) : AttemptReturnPublic :=
  ⟨p.plan.attempt.construct.hash.F, p.plan.attempt.construct.hash.S, p.plan.attempt.construct.hash.W 5⟩

theorem searchStart_frame {n pLen qLen : Nat} {p : SearchPublic} {s : State}
    (h : SearchStart n pLen qLen p s) : AttemptReturnBefore p.returnFrame s := by
  obtain ⟨W, memory, _⟩ := h.1
  obtain ⟨V, R⟩ := memory.rep
  exact ⟨memory.layout, V, W, R, memory.slots 5 (by simp [searchSlots])⟩

theorem searchBase_ready {n pLen qLen : Nat} {p : SearchPublic} {s : State}
    (h : SearchStart n pLen qLen p s) :
    WP isa (.block controlBase) s (SearchInitBefore n pLen qLen p) := by
  obtain ⟨⟨W, memory, used⟩, scr, frame, wr, bound, hp, hq, counter⟩ := h
  obtain ⟨V, R⟩ := memory.rep
  have base : W 5 + BitVec.ofNat 64 Impl.Dsa.Generation.Layout.control = p.plan.C := by
    rw [memory.slots 5 (by simp [searchSlots])]; exact p.plan.controlBase
  refine WP.mono (controlBase_ok memory.layout R base) fun t ⟨hdi, hm, hk⟩ => ?_
  have L := memory.layout.congr (hk.gpr (by decide)) hk.2.2 (by rw [hm])
  have mt := memory.frame L ⟨V, hm ▸ R⟩ (fun _ _ => rfl)
    (by rw [hm]; exact Frame.refl _ _) hk.2.1 hk.2.2
  exact ⟨⟨⟨W, mt, used⟩, scr.congr hk.2.2, frame.congr (hk.gpr (by decide)) hk.2.2,
    hk.2.2.trans wr, bound, hp, hq, counter⟩, hdi⟩

theorem searchInit_ready {n pLen qLen : Nat} {p : SearchPublic} {s : State}
    (h : SearchInitBefore n pLen qLen p s) :
    WP isa (.block pSearchInit) s (SearchBefore n pLen qLen p) := by
  obtain ⟨⟨⟨W, memory, used⟩, scr, frame, wr, bound, hp, hq, counter⟩, hdi⟩ := h
  refine WP.mono (searchInit_ok scr hdi (p.plan.attempt.construct.hash.count + 1))
    fun t ⟨ctrl, ff, hk⟩ => ?_
  have mt := SearchMemory.stable memory (ff.mono (by decide) (by decide)) (hk.mono (by decide))
  exact ⟨⟨W, mt, used⟩, (by rw [counter]; exact ctrl), frame.congr (hk.gpr (by decide)) hk.2.2,
    hk.2.2.trans wr, bound, hp, hq⟩

theorem searchInit_ct (n pLen qLen : Nat) :
    RelCT isa (Two (SearchInitBefore n pLen qLen)) (.block pSearchInit) (Two (SearchBefore n pLen qLen)) := by
  refine two_post (two_taint [.rdi] ?_ (by taint_decide)) (fun _ _ h => searchInit_ready h)
  intro p s t hs ht r hr
  simp only [List.mem_singleton] at hr; subst r
  exact hs.2.trans ht.2.symm

end VG.Proof.Dsa.X86_64.Generation

end

end

/-! ### `Dsa.X86_64.Generation.ValidateCT`, which only this module used -/

section

/-! ### `Dsa.X86_64.Generation.DomainCallCT`, which only this module used -/

section

/-! # Call the existing domain checker with public packed bytes and pointers -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64
open VG.Impl.Dsa.X86_64

structure DomainCallPublic where
  input : ParametersInput
  pointer : Addr

def DomainCallBefore (p : DomainCallPublic) (s : State) : Prop :=
  ParametersPre p.input s ∧ s.gpr .rdi = p.pointer

theorem domainCall_related {s t : State} (h : Two DomainCallBefore s t) : Two ParametersStart s t := by
  obtain ⟨p, ⟨hs, hp⟩, ⟨ht, hq⟩⟩ := h
  let a : ParametersCall := ⟨p.input, s, hs⟩
  let b : ParametersCall := ⟨p.input, t, ht⟩
  have fields : checkFieldValues t p.input.accepted = checkFieldValues s p.input.accepted := by
    funext f
    cases f <;> simp only [checkFieldValues, hp, hq, hs.pLength, ht.pLength, hs.qLength, ht.qLength]
  have layout : b.layout = a.layout := by
    change p.input.layout t ht.pLength ht.qLength = p.input.layout s hs.pLength hs.qLength
    simp only [ParametersInput.layout, fields]
  exact ⟨a, ⟨a, ⟨rfl, rfl⟩, rfl⟩, ⟨b, ⟨layout, rfl⟩, rfl⟩⟩

theorem domainCall_ct (M : Mont) (Sq : MontS) :
    RelCT isa (Two DomainCallBefore) (Generate.checkParameters Sq.mm M.mm) (fun _ _ => True) :=
  (parametersMain_ct M Sq).mono (fun _ _ h => domainCall_related h) (fun _ _ h => h)


def DomainCalledBefore (p : DomainCallPublic × Addr) (s : State) : Prop :=
  DomainCallBefore p.1 s ∧ s.gpr .rsp = p.2 ∧
  (domainReturn s).Disjoint ⟨p.1.input.base, Impl.Dsa.Layout.usedBytes⟩ ∧
  (domainReturn s).Disjoint ⟨s.gpr .rdi, p.1.input.params.length⟩

theorem domainCall_called_ct (M : Mont) (Sq : MontS) (name : String) :
    RelCT isa (Two DomainCalledBefore)
      (.call name (Generate.checkParameters Sq.mm M.mm)) (fun _ _ => True) := by
  apply RelCT.callBody (domainCall_ct M Sq)
  · rintro s t ⟨p, hs, ht⟩
    refine ⟨p.1, ⟨parameters_callEntry hs.1.1 hs.2.2.2, ?_⟩,
      ⟨parameters_callEntry ht.1.1 ht.2.2.2, ?_⟩⟩
    · exact (State.callEntry_gpr s (by decide)).trans hs.1.2
    · exact (State.callEntry_gpr t (by decide)).trans ht.1.2
  · rintro s t ⟨p, hs, ht⟩
    exact hs.2.1.trans ht.2.1.symm

end VG.Proof.Dsa.X86_64.Generation

end

end

/-! # Timing of final parameter validation and its success/retry decision -/

@[expose] public section
namespace VG.Proof.Dsa.X86_64.Generation
open VG VG.X86_64 VG.Proof.Bignum VG.Proof.Bignum.X86_64 VG.Proof.MlKem.X86_64
open VG.Proof.RsaOaep.X86_64 VG.Impl.RsaOaep.X86_64
open VG.Impl.Dsa.Generation.Layout VG.Impl.Dsa.X86_64.Generation


variable {checkName : String}

structure ValidatePublic where
  input : ParametersInput
  B : Addr
  F : Addr
  S : Addr
  base : input.base = off B domainCheck
  frame : (⟨F, frameBytes⟩ : Region).Disjoint ⟨input.base, Impl.Dsa.Layout.usedBytes⟩
  hash : (⟨S, oRsa⟩ : Region).Disjoint ⟨input.base, Impl.Dsa.Layout.usedBytes⟩
  stack : (below F 8).Disjoint ⟨input.base, Impl.Dsa.Layout.usedBytes⟩
  paramsStack : (below F 8).Disjoint ⟨off B packed, input.params.length⟩

def ValidatePublic.call (p : ValidatePublic) : DomainCallPublic := ⟨p.input, off p.B packed⟩

def ValidateBefore (pLen qLen : Nat) (p : ValidatePublic) (s : State) : Prop :=
  Lay s p.F p.S ∧ (∃ V W, Rep s.mem p.F p.S V W ∧ W 5 = p.B) ∧
  Scr s p.input.base Impl.Dsa.Layout.usedBytes ∧
  Src s p.input.base Impl.Dsa.Layout.usedBytes (off p.B packed) p.input.params ∧
  p.input.pLen = pLen ∧ p.input.qLen = qLen

theorem validateArgs_ready {pLen qLen : Nat} {p : ValidatePublic} {s : State}
    (hp : pLen < 2 ^ 32) (hq : qLen < 2 ^ 32) (h : ValidateBefore pLen qLen p s) :
    WP isa (.block (validateArgs pLen qLen)) s (DomainCalledBefore (p.call, p.F)) := by
  obtain ⟨L, ⟨V, W, R, hb⟩, hs, src, heP, heQ⟩ := h
  refine WP.mono (validateArgs_ok L R hp hq) fun t ⟨hd, h8, hdx, hcx, hm, hk⟩ => ?_
  have hd' : t.gpr .rdi = off p.B packed := hb ▸ hd
  have hrsp : t.gpr .rsp = p.F := (hk.gpr (by decide)).trans L.rsp
  have before : DomainCallBefore p.call t := by
    refine ⟨⟨hs.congr hk.2.2, (hb ▸ h8).trans p.base.symm,
      by change t.gpr .rdx = BitVec.ofNat 64 p.input.pLen; rw [heP]; exact hdx,
      by change t.gpr .rcx = BitVec.ofNat 64 p.input.qLen; rw [heQ]; exact hcx, ?_⟩, hd'⟩
    rw [hd']
    exact src.congrK (fun _ _ => by rw [hm]) hk
  exact ⟨before, hrsp, by simpa only [domainReturn, hrsp, ValidatePublic.call] using p.stack,
    by simpa only [domainReturn, hrsp, hd', ValidatePublic.call] using p.paramsStack⟩

def ValidateResult (p : ValidatePublic) (s : State) : Prop :=
  s.gpr .rsp = p.F ∧ s.gpr .rax = BitVec.ofNat 64
    (if Spec.Dsa.checkParametersBytes p.input.pLen p.input.qLen p.input.params then 1 else 0)

theorem validateCore_result (M : Mont) (Sq : MontS) {pLen qLen : Nat} {p : ValidatePublic} {s : State}
    (hp : pLen < 2 ^ 32) (hq : qLen < 2 ^ 32) (h : ValidateBefore pLen qLen p s) :
    WP isa (.seq (.block (validateArgs pLen qLen)) (.call checkName (Impl.Dsa.X86_64.Generate.checkParameters Sq.mm M.mm)))
      s (ValidateResult p) := by
  obtain ⟨L, ⟨V, W, R, hb⟩, hs, src, heP, heQ⟩ := h
  have step := validateCore_ok (checkName := checkName) M Sq p.input L R (by rw [hb]; exact p.base)
    (by rw [heP]; exact hp) (by rw [heQ]; exact hq) hs (hb ▸ src) p.frame p.hash p.stack (by simpa only [hb] using p.paramsStack)
  rw [heP, heQ] at step
  exact WP.mono step fun t ⟨hr, Lt, _, _, _⟩ =>
    ⟨Lt.rsp, by simpa only [heP, heQ] using hr⟩

theorem validate_ct_of (M : Mont) (Sq : MontS) (pLen qLen : Nat)
    (hp : pLen < 2 ^ 32) (hq : qLen < 2 ^ 32)
    {hc : VG.Taint.Hint VG.X86_64.Taint.T}
    (ht : (taint.check (Taint.ofRegs [.rsp]) (.block (validateArgs pLen qLen)) hc).isSome = true) :
    RelCT isa (Two (ValidateBefore pLen qLen)) (validate (checkName := checkName) Sq.mm M.mm pLen qLen) (fun _ _ => True) := by
  have core : RelCT isa (Two (ValidateBefore pLen qLen))
      (.seq (.block (validateArgs pLen qLen)) (.call checkName (Impl.Dsa.X86_64.Generate.checkParameters Sq.mm M.mm)))
      (Two ValidateResult) := by
    refine two_post (RelCT.seq (two_piece [.rsp] ?_ ht
      (fun _ _ h => validateArgs_ready hp hq h))
      (two_map (fun p : ValidatePublic => (p.call, p.F)) (fun _ _ h => h) (domainCall_called_ct M Sq checkName)))
      (fun _ _ h => validateCore_result (checkName := checkName) M Sq hp hq h)
    intro p s t hs ht r hr
    obtain rfl := List.mem_singleton.mp hr
    exact hs.1.rsp.trans ht.1.rsp.symm
  unfold validate
  refine RelCT.seq core (RelCT.seq (two_piece (Ψ := fun (p : ValidatePublic) s => s.gpr .rsp = p.F ∧
    s.zf = some (!(Spec.Dsa.checkParametersBytes p.input.pLen p.input.qLen p.input.params)))
      [.rax] ?_ (by taint_decide) ?_) ?_)
  · intro p s t hs ht r hr
    obtain rfl := List.mem_singleton.mp hr
    exact hs.2.trans ht.2.symm
  · intro p s h
    exact WP.mono (validateTest_ok h.2) fun t ⟨hz, _, hk⟩ => ⟨(hk.gpr (by decide)).trans h.1, hz⟩
  · refine two_ite (fun _ _ _ hs ht => by simp only [eval, hs.2, ht.2]) ?_ ?_
    all_goals
      exact two_taint [.rsp] (fun _ _ _ hs ht r hr => by
        obtain rfl := List.mem_singleton.mp hr
        exact hs.1.1.trans ht.1.1.symm) (by taint_decide)

theorem validate_ct (M : Mont) (Sq : MontS) (pLen qLen : Nat)
    (sizes : (pLen = 128 ∧ qLen = 20) ∨ (pLen = 256 ∧ qLen = 32) ∨ (pLen = 384 ∧ qLen = 32)) :
    RelCT isa (Two (ValidateBefore pLen qLen)) (validate (checkName := checkName) Sq.mm M.mm pLen qLen) (fun _ _ => True) := by
  rcases sizes with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  all_goals exact validate_ct_of (checkName := checkName) M Sq _ _ (by decide) (by decide) (by taint_decide)

end VG.Proof.Dsa.X86_64.Generation


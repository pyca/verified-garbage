/-!
# RSA with AVX512_IFMA on x86-64: constant time, before the vector code

`pre` is `prep` for each prime, whose pieces (`redc`, copies, Montgomery
multiplications, and the blocks entering and leaving the prime's
workspace) are constant time: so is `prep` (`prep_ct`), for `prep_ok`'s
hypotheses, and `pre` (`pre_ct`), for `pre_ok`'s. Before each piece, a
predicate carries the piece's claim's hypotheses and what correctness gives
after it (`prep_chain`, `pre_chain`).
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Rsa.X86_64 VG.Impl.Rsa.X86_64.Crt
open VG.Proof.MlKem.X86_64 CrtCTQ

theorem redc_ct_Xm (M : Mont) : RedcCT M Public.aXm := redc_ct_of M (by taint_decide)

/-! ## `prep` -/

/-- `prep_ok`'s hypotheses, with the public data `p` (`n`'s workspace and
`-n⁻¹`, `n`, and the prime's workspace). -/
def PrepPre (sl : Nat) (p : UPub) (s : State) : Prop :=
  ∃ (mx : BitVec 64) (X : Nat), Good s p.B p.Z p.w p.minv ∧ p.w < 2 ^ 28 ∧ slot p.w 8 ≤ p.o ∧
    p.o + slot p.wx 8 + wsTab p.wx ≤ p.Z ∧ 2 ≤ p.wx ∧ p.wx ≤ p.w ∧ sl < 32 ∧
    word s.mem p.B (8 * sl) = off p.B p.o ∧ WsAt s.mem p.B p.o p.wx mx ∧ XVals s p.B p.o p.wx mx X ∧ 1 < X

/-- The prime's workspace. -/
abbrev UPub.pw (p : UPub) : Ws := ⟨off p.B p.o, slot p.wx 8, p.wx⟩

/-- Before leaving the prime's workspace. -/
def PP7 (p : UPub) (s : State) : Prop := s.gpr .rdi = off p.B p.o

/-- Before `aY := aY · 1`. -/
def PP6 (M : Mont) (p : UPub) (s : State) : Prop :=
  GoodW p.pw s ∧ WP isa (M.mm Public.aY Public.aY Public.aOne) s (PP7 p)

/-- Before `aXc := aT`. -/
def PP5 (M : Mont) (p : UPub) (s : State) : Prop :=
  GoodW p.pw s ∧ WP isa (seqs (copyArr aXc aT)) s (PP6 M p)

/-- Before `aT := aY aXc`. -/
def PP4 (M : Mont) (p : UPub) (s : State) : Prop :=
  GoodW p.pw s ∧ WP isa (M.mm aT Public.aY aXc) s (PP5 M p)

/-- Before the second `redc`. -/
def PP3 (M : Mont) (p : UPub) (s : State) : Prop :=
  RPre Public.aXm (xp p) s ∧ WP isa (seqs (redc M.mm Public.aXm)) s (PP4 M p)

/-- Entering the prime's workspace, from `n`'s. -/
theorem enter_rpre {s : State} {p : UPub} {sl j : Nat} (hj : j < 8) {mx : BitVec 64} {X : Nat}
    (hg : Good s p.B p.Z p.w p.minv)
    (hw28 : p.w < 2 ^ 28) (hlo : slot p.w 8 ≤ p.o) (hhi : p.o + slot p.wx 8 + wsTab p.wx ≤ p.Z)
    (hwx2 : 2 ≤ p.wx) (hwx : p.wx ≤ p.w) (hsl : sl < 32) (hslv : word s.mem p.B (8 * sl) = off p.B p.o)
    (hws : WsAt s.mem p.B p.o p.wx mx) (hX : XVals s p.B p.o p.wx mx X) (hX1 : 1 < X) :
    WP isa (.block [.mov .rdi (.mem (hdr sl))]) s fun t =>
      RPre j (xp p) t ∧ SubCtx t p.B p.Z p.o p.w p.wx mx ∧ XVals t p.B p.o p.wx mx X ∧ t.mem = s.mem ∧
        Keep [.rdi] s t := by
  have hs := hg.scr
  have hn := hs.nowrap
  obtain h8 := hdr_lt_slot p.w 8 (show 31 < 32 by decide)
  refine WP.mono (WP.keep [.rdi] (Q := fun t => t.gpr .rdi = off p.B p.o ∧ t.mem = s.mem)
    (by xrun [State.ea, hdr, hg.rdi, hdrOff, hs.ld (d := 8 * sl) (by omega_arith), hslv]) rfl)
    fun t ⟨⟨hdi, hm⟩, k⟩ => ?_
  obtain hc : SubCtx t p.B p.Z p.o p.w p.wx mx :=
    SubCtx.mk' (hs.congr k.2.2) (by rw [hm]; exact hg.hdr) (by rw [hm]; exact hws) hdi hlo (by have := tabBytes_le_wsTab p.wx; omega_arith)
  obtain hX' : XVals t p.B p.o p.wx mx X := by
    rw [show t = { t with mem := s.mem } by rw [← hm]]; exact ⟨hX.n, hX.inv, hX.one⟩
  exact ⟨⟨mx, X, hc, hX', hwx2, hwx, show p.w < 2 ^ 30 by omega_arith, hX1, hj⟩, hc, hX', hm, k⟩

/-- `PP3` from the prime's workspace's facts, as `prep_ok` runs the rest of `prep`. -/
theorem prep_chain3 (M : Mont) {p : UPub} {s₃ : State} {mx : BitVec 64} {X : Nat}
    (hc₃ : SubCtx s₃ p.B p.Z p.o p.w p.wx mx) (hX₃ : XVals s₃ p.B p.o p.wx mx X) (hwx2 : 2 ≤ p.wx)
    (hwx : p.wx ≤ p.w) (hw30 : p.w < 2 ^ 30) (hX1 : 1 < X) : PP3 M p s₃ := by
  obtain hX8 : 256 ≤ slot p.wx 8 := by unfold slot hdrBytes; omega_arith
  obtain lC := slot_le (w := p.wx) (show aXc < 8 by decide)
  obtain hC0 := hdr_lt_slot p.wx aXc (show 31 < 32 by decide)
  refine ⟨⟨mx, X, hc₃, hX₃, hwx2, hwx, hw30, hX1, by decide⟩, ?_⟩
  -- `redc` of `x R_n`.
  refine WP.mono (redc_ok M hc₃ hX₃ hwx2 hwx (by omega_arith) hX1 (j := Public.aXm) (by decide))
    fun s₄ ⟨hc₄, hX₄, hlt₄, _, _, _⟩ => ⟨⟨mx, hc₄.good, Nat.le_refl _⟩, ?_⟩
  -- `aT := aY aXc`.
  refine WP.mono (M.mm_ok (o := aT) (a := Public.aY) (b := aXc) hc₄.good (Nat.le_refl _) hwx2 (by omega_arith)
    (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) hX₄.inv
    (by rw [hX₄.n]; exact hlt₄)) fun s₅ ⟨_, _, _, ha₅, k₅⟩ => ?_
  obtain ⟨hc₅, hX₅, _⟩ := hc₄.of_arrays hX₄ ha₅ (by
    intro j hj; simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl <;> decide) k₅.2.2 (k₅.gpr (by decide)) (by omega_arith)
  refine ⟨⟨mx, hc₅.good, Nat.le_refl _⟩, ?_⟩
  -- `aXc := aT`.
  refine WP.mono (copyArr_ok hc₅.good (Nat.le_refl _) (by omega_arith) (by omega_arith) (o := aXc) (a := aT)
    (by decide) (by decide) (by decide)) fun s₆ ⟨_, ho₆, k₆⟩ => ?_
  obtain hc₆ := hc₅.of_frm (rs := [(slot p.wx aXc, 8 * p.wx)]) (Frm.of_outside ho₆ (by simp)) (fun r hr => by
    rw [List.mem_singleton.mp hr]; simp only; omega_arith) k₆.2.2 (k₆.gpr (by decide))
  obtain hX₆ : XVals s₆ p.B p.o p.wx mx X := hX₅.of_outside ho₆ (by decide) (by decide) (by decide) (by omega_arith)
    (by have := hc₅.good.scr.nowrap; omega_arith)
  -- `aY := aY · 1`.
  exact ⟨⟨mx, hc₆.good, Nat.le_refl _⟩, WP.mono (M.mm_ok (o := Public.aY) (a := Public.aY) (b := Public.aOne)
    hc₆.good (Nat.le_refl _) hwx2 (by omega_arith) (by decide) (by decide) (by decide) (by decide) (by decide)
    (by decide) (by decide) hX₆.inv (by rw [hX₆.n, hX₆.one]; exact hX1)) fun _ h₇ => h₇.1.rdi⟩


/-- `prep` after `aY := aXc`. -/
def prepTail (mul : Nat → Nat → Nat → Prog isa) : List (Prog isa) :=
  redc mul Public.aXm ++ (([mul aT Public.aY aXc] : List (Prog isa)) ++
    (copyArr aXc aT ++ ([mul Public.aY Public.aY Public.aOne, .block [leave]] : List (Prog isa))))

/-- `prep` after `aY := aXc` is constant time. -/
theorem prepTail_ct (M : Mont) (hXm : RedcCT M Public.aXm) :
    RelCT isa (Two (PP3 M)) (seqs (prepTail M.mm)) fun _ _ => True := by
  unfold prepTail
  refine ct_steps (by simp [redc]) (by simp) xp (fun _ _ h => h.1) (fun _ _ h => h.2) hXm ?_
  refine ct_steps (by simp) (by simp [copyArr]) UPub.pw (fun _ _ h => h.1) (fun _ _ h => h.2)
    (M.ct (by unfold MmUse; decide)) ?_
  refine ct_steps (by simp [copyArr]) (by simp) UPub.pw (fun _ _ h => h.1) (fun _ _ h => h.2)
    (copyArr_ct (by decide) (by decide) (by taint_decide)) ?_
  exact ct_step UPub.pw (fun _ _ h => h.1) (fun _ _ h => h.2) (M.ct (by unfold MmUse; decide))
    (two_taint [.rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_singleton] at hr; subst hr; rw [show s₁.gpr .rdi = _ from h₁, h₂]) (by taint_decide))

/-! ## `r2X` -/

/-- The public data of `r2X`: the stack pointer, `pre`'s address, `n`'s
workspace's base and the prime's offset and words. -/
structure RXPub where
  sp : Addr
  A : Addr
  B : Addr
  o : Nat
  wx : Nat

/-- `maskN`'s block, split at the load of `n`'s base. -/
def mnBlk1 : List Instr := [.mov .rax (.mem (hdr sLink))]
def mnBlk2 (j : Nat) : List Instr :=
  [.mov .r15 (.mem (ws .rax Public.sMask)), .mov .r12 (.mem (hdr sW)), .mov .rbx (.mem (hdr (sArr j)))]
def mnLoop : Prog isa :=
  wordLoop 0 [.mov .rax (.mem (ix .rbx .r14)), .alu .and .rax (.reg .r15), .store (ix .rbx .r14) .rax]

theorem r2X_eqCT (q : Bool) (j : Nat) : CrtIfma.r2X q j =
    [.block (CrtIfma.r2XBlk q j), copyWords, .block (mnBlk1 ++ mnBlk2 j), mnLoop, .block CrtIfma.orOne] := rfl

/-- Before `orOne`. -/
def X4 (j : Nat) (p : RXPub) (s : State) : Prop := s.gpr .rbx = off (off p.B p.o) (slot p.wx j)

/-- Before the masking loop. -/
def X3 (j : Nat) (p : RXPub) (s : State) : Prop :=
  s.gpr .rbx = off (off p.B p.o) (slot p.wx j) ∧ s.gpr .r12 = BitVec.ofNat 64 p.wx ∧ WP isa mnLoop s (X4 j p)

/-- Before the loads of the mask and the array's base. -/
def X2b (j : Nat) (p : RXPub) (s : State) : Prop :=
  s.gpr .rax = p.B ∧ s.gpr .rdi = off p.B p.o ∧ WP isa (.block (mnBlk2 j)) s (X3 j p)

/-- Before the load of `n`'s base. -/
def X2 (j : Nat) (p : RXPub) (s : State) : Prop :=
  s.gpr .rdi = off p.B p.o ∧ WP isa (.block mnBlk1) s (X2b j p)

/-- Before the copy. -/
def X1 (q : Bool) (j : Nat) (p : RXPub) (s : State) : Prop :=
  s.gpr .rsi = off p.A (8 * r2XOff q p.wx) ∧ s.gpr .rbx = off (off p.B p.o) (slot p.wx j) ∧
    s.gpr .r12 = BitVec.ofNat 64 p.wx ∧ WP isa copyWords s (X2 j p)

/-- Before `r2X`. -/
def X0 (q : Bool) (j : Nat) (p : RXPub) (s : State) : Prop :=
  s.gpr .rsp = p.sp ∧ s.gpr .rdi = off p.B p.o ∧ WP isa (.block (CrtIfma.r2XBlk q j)) s (X1 q j p)

/-- `r2X_ok`'s hypotheses give `X0`, as `r2X_ok` runs the pieces. -/
theorem r2X_chain {q : Bool} {j : Nat} (hj : j < 8) {s : State} {B : Addr} {Z o w wx : Nat} {minv : BitVec 64}
    {V : Nat} {c : Bool} (hc : SubCtx s B Z o w wx minv) (hw2 : 2 ≤ wx) (hwx : wx ≤ w) (hw30 : w < 2 ^ 30)
    (hm : word s.mem B (8 * Public.sMask) = mask c) (hp : PreW s B Z (r2XOff q wx) wx V) :
    X0 q j ⟨s.gpr .rsp, stackArg s 12, B, o, wx⟩ s := by
  have hg := hc.good
  have hBn := hc.scr.nowrap
  have hGn : (off B o).toNat + slot wx 8 ≤ 2 ^ 64 := hg.scr.nowrap
  have hi := hc.hi
  have hlo := hc.lo
  obtain sJ := slot_le (w := wx) hj
  obtain hJ0 := hdr_lt_slot wx j (show 31 < 32 by decide)
  obtain h256 : 256 ≤ slot wx 8 := by unfold slot hdrBytes; omega_arith
  refine ⟨rfl, hc.rdi, WP.mono (r2XBlk_ok hj hc hp) fun t₁ ⟨hsi, hbx, h12, hm₁, k₁⟩ => ⟨hsi, hbx, h12, ?_⟩⟩
  obtain hs₁ : Scr t₁ (off B o) (slot wx 8) := hg.scr.congr k₁.2.2
  obtain hout : ∀ i < wx, ∀ b < 8, slot wx 8 ≤
      ofs (off B o) (off (stackArg s 12) (8 * r2XOff q wx + 8 * i) + BitVec.ofNat 64 b) := fun i hi' b hb => by
    have := hp.out i hi' b hb
    rcases ofs_rebase B (off (stackArg s 12) (8 * r2XOff q wx + 8 * i) + BitVec.ofNat 64 b) (o := o)
      (by omega_arith) with ⟨_, h2⟩ | ⟨h1, _⟩
    · omega_arith
    · omega_arith
  refine WP.mono (copyWords_ok (S := stackArg s 12) (eS := 8 * r2XOff q wx) (D := off B o) (eD := slot wx j)
    hsi hbx h12 (by omega_arith) (by omega_arith) (by omega_arith)
    (fun i hi' => by rw [k₁.2.1, k₁.2.2]; exact hp.rd i hi') (fun i hi' => hs₁.st (by omega_arith))
    (fun i hi' b hb => Or.inr (by have := hout i hi' b hb; omega_arith))) fun t₂ ⟨_, _, ho₂, k₂⟩ => ?_
  rw [hm₁] at ho₂
  obtain k₁₂ := k₁.trans k₂
  obtain f₂ : Frm (off B o) [(slot wx j, 8 * wx)] s.mem t₂.mem := Frm.of_outside ho₂ (by simp)
  obtain hc₂ : SubCtx t₂ B Z o w wx minv := hc.of_frm f₂ (fun r hr => by
    rw [List.mem_singleton.mp hr]; simp only; omega_arith) k₁₂.2.2 (k₁₂.gpr (by decide))
  obtain hM₂ : word t₂.mem B (8 * Public.sMask) = mask c := by
    rw [f₂.word_below (L := slot wx 8) (fun r hr => by rw [List.mem_singleton.mp hr]; simp only; omega_arith)
      (by omega_arith) (by omega_arith) (by have := hdr_lt_slot w 8 (show Public.sMask < 32 by decide); omega_arith)]
    exact hm
  have g₂ := hc₂.good
  obtain hl : ∀ i < 32, InRegions (t₂.rd ++ t₂.wr) (off (off B o) (8 * i)) 8 := fun i hi' =>
    g₂.scr.ld (by have := hdr_lt_slot wx 8 hi'; omega_arith)
  obtain hln : ∀ i < 32, InRegions (t₂.rd ++ t₂.wr) (off B (8 * i)) 8 := fun i hi' =>
    hc₂.scr.ld (by have := hdr_lt_slot w 8 hi'; omega_arith)
  refine ⟨hc₂.rdi, WP.mono (WP.keep [.rax] (Q := fun t => t.gpr .rax = B ∧ t.mem = t₂.mem)
    (by unfold mnBlk1; xrun [State.ea, hdr, hc₂.rdi, hdrOff, hl Crt.sLink (by decide), hc₂.link]) rfl)
    fun t₃ ⟨⟨hax, hm₃⟩, k₃⟩ => ⟨hax, (k₃.gpr (by decide)).trans hc₂.rdi, ?_⟩⟩
  obtain hdi₃ : t₃.gpr .rdi = off B o := (k₃.gpr (by decide)).trans hc₂.rdi
  obtain hl₃ : ∀ i < 32, InRegions (t₃.rd ++ t₃.wr) (off (off B o) (8 * i)) 8 := fun i hi' => by
    rw [k₃.2.1, k₃.2.2]; exact hl i hi'
  obtain hln₃ : ∀ i < 32, InRegions (t₃.rd ++ t₃.wr) (off B (8 * i)) 8 := fun i hi' => by
    rw [k₃.2.1, k₃.2.2]; exact hln i hi'
  obtain hM₃ : word t₃.mem B (8 * Public.sMask) = mask c := by rw [hm₃]; exact hM₂
  have hH₃ := g₂.hdr
  rw [← hm₃] at hH₃
  refine WP.mono (WP.keep [.r15, .r12, .rbx] (Q := fun t => t.gpr .r15 = mask c ∧
      t.gpr .r12 = BitVec.ofNat 64 wx ∧ t.gpr .rbx = off (off B o) (slot wx j) ∧ t.mem = t₃.mem)
    (by unfold mnBlk2; xrun [State.ea, hdr, Crt.ws, hdi₃, hax, hdrOff, hln₃ Public.sMask (by decide), hM₃,
      hl₃ (sArr j) (by unfold sArr; omega_arith), hl₃ sW (by decide), hH₃.harr j hj, hH₃.hw]) rfl)
    fun t₄ ⟨⟨h15, h12', hbx', hm₄⟩, k₄⟩ => ⟨hbx', h12', ?_⟩
  obtain hs₄ : Scr t₄ (off B o) (slot wx 8) := g₂.scr.congr (k₃.2.2 ▸ k₄.2.2)
  obtain h0 : ∀ t, t.gpr .r14 = BitVec.ofNat 64 0 → t.mem = t₄.mem → Keep [.r14] t₄ t → t.cf = t₄.cf →
      MaskInv t₄ (off B o) (slot wx 8) (slot wx j) c 0 t := fun t h14 hm' k _ =>
    ⟨hs₄.congr k.2.2, k.mono (by decide), h14, by rw [hm']; exact Outside.refl _ _ _ _,
      fun i hi' => absurd hi' (Nat.not_lt_zero _)⟩
  exact WP.mono (wordLoop_ok (start := 0) (N := wx) (by omega_arith) (by omega_arith)
    (MaskInv t₄ (off B o) (slot wx 8) (slot wx j) c) h0
    (fun i _ hi' t hI => maskStep_ok hbx' h15 h12' (by omega_arith) (by omega_arith) hi' hI))
    fun t₅ hI => (hI.keep.gpr (by decide)).trans hbx'

/-- `r2X` is constant time. -/
theorem r2X_ct (q : Bool) (j : Nat) {h1 h2 h3 h4 h5 : VG.Taint.Hint VG.X86_64.Taint.T}
    (t1 : (taint.check (Taint.ofRegs [.rsp, .rdi]) (.block (CrtIfma.r2XBlk q j)) h1).isSome = true)
    (t2 : (taint.check (Taint.ofRegs [.rdi]) (.block mnBlk1) h2).isSome = true)
    (t3 : (taint.check (Taint.ofRegs [.rax, .rdi]) (.block (mnBlk2 j)) h3).isSome = true)
    (t4 : (taint.check (Taint.ofRegs [.rbx, .r12]) mnLoop h4).isSome = true)
    (t5 : (taint.check (Taint.ofRegs [.rbx]) (.block CrtIfma.orOne) h5).isSome = true) :
    RelCT isa (Two (X0 q j)) (seqs (CrtIfma.r2X q j)) fun _ _ => True := by
  rw [r2X_eqCT]
  simp only [seqs]
  refine ct_taint [.rsp, .rdi] (pins_of (fun (p : RXPub) r => if r = .rsp then p.sp else off p.B p.o)
    fun p s h r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · exact h.1
      · exact h.2.1) t1 (fun _ _ h => h.2.2) ?_
  refine ct_taint [.rsi, .rbx, .r12] (pins_of (fun (p : RXPub) r => if r = .rsi then off p.A (8 * r2XOff q p.wx)
      else if r = .rbx then off (off p.B p.o) (slot p.wx j) else BitVec.ofNat 64 p.wx)
    fun p s h r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl
      · exact h.1
      · exact h.2.1
      · exact h.2.2.1) (by taint_decide) (fun _ _ h => h.2.2.2) ?_
  refine RelCT.seq (RelCT.block_append (RelCT.seq
    (two_piece (Ψ := X2b j) [.rdi] (pins_of (fun p _ => off p.B p.o) fun p s h r hr => by
      simp only [List.mem_singleton] at hr; subst hr; exact h.1) t2 fun _ _ h => h.2)
    (two_piece (Ψ := X3 j) [.rax, .rdi] (pins_of (fun (p : RXPub) r => if r = .rax then p.B else off p.B p.o)
      fun p s h r hr => by
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl
        · exact h.1
        · exact h.2.1) t3 fun _ _ h => h.2.2))) ?_
  refine ct_taint [.rbx, .r12] (pins_of (fun (p : RXPub) r => if r = .rbx then off (off p.B p.o) (slot p.wx j)
      else BitVec.ofNat 64 p.wx)
    fun p s h r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · exact h.1
      · exact h.2.1) t4 (fun _ _ h => h.2.2) ?_
  exact two_taint [.rbx] (pins_of (fun p _ => off (off p.B p.o) (slot p.wx j)) fun p s h r hr => by
    simp only [List.mem_singleton] at hr; subst hr; exact h) t5

/-! ## `prepP` -/

/-- The public data of `prepP`: `prep`'s, the stack pointer and `pre`'s
address. -/
structure UPubP where
  u : UPub
  sp : Addr
  A : Addr

abbrev UPubP.rx (p : UPubP) : RXPub := ⟨p.sp, p.A, p.u.B, p.u.o, p.u.wx⟩

/-- `prepP_ok`'s hypotheses (with `q`'s words from `pre`), with the public
data `p`. -/
def PrepPreP (sl : Nat) (q : Bool) (p : UPubP) (s : State) : Prop :=
  PrepPre sl p.u s ∧ s.gpr .rsp = p.sp ∧ stackArg s 12 = p.A ∧
    ∃ (c : Bool) (V : Nat), word s.mem p.u.B (8 * Public.sMask) = mask c ∧
      PreW s p.u.B p.u.Z (r2XOff q p.u.wx) p.u.wx V

/-- Before `r2X`. -/
def PPP1 (M : Mont) (q : Bool) (p : UPubP) (s : State) : Prop :=
  X0 q Public.aY p.rx s ∧ WP isa (seqs (CrtIfma.r2X q Public.aY)) s (PP3 M p.u)

/-- Before `prepP`. -/
def PPP0 (M : Mont) (sl : Nat) (q : Bool) (p : UPubP) (s : State) : Prop :=
  s.gpr .rdi = p.u.B ∧ WP isa (.block [.mov .rdi (.mem (hdr sl))]) s (PPP1 M q p)

theorem prepP_split (mul : Nat → Nat → Nat → Prog isa) (sl : Nat) (q : Bool) :
    CrtIfma.prepP mul sl q = ([.block [.mov .rdi (.mem (hdr sl))]] : List (Prog isa)) ++
      (CrtIfma.r2X q Public.aY ++ prepTail mul) := by
  simp only [CrtIfma.prepP, prepTail, List.append_assoc]

/-- `prepP_ok`'s hypotheses give `PPP0`, as `prepP_ok` runs the pieces. -/
theorem prepP_chain (M : Mont) {sl : Nat} {q : Bool} {p : UPubP} {s : State} (h : PrepPreP sl q p s) :
    PPP0 M sl q p s := by
  obtain ⟨⟨mx, X, hg, hw28, hlo, hhi, hwx2, hwx, hsl, hslv, hws, hX, hX1⟩, hsp, hA, c, V, hm, hp⟩ := h
  have hs := hg.scr
  have hn := hs.nowrap
  obtain h8 := hdr_lt_slot p.u.w 8 (show 31 < 32 by decide)
  obtain lY := slot_le (w := p.u.wx) (show Public.aY < 8 by decide)
  obtain hY0 := hdr_lt_slot p.u.wx Public.aY (show 31 < 32 by decide)
  refine ⟨hg.rdi, WP.mono (enter_rpre (j := Public.aR2) (by decide) hg hw28 hlo hhi hwx2 hwx hsl hslv hws hX hX1)
    fun s₁ ⟨_, hc₁, hX₁, hm₁, k₁⟩ => ?_⟩
  obtain hi₁ : InScr p.u.B p.u.Z s.mem s₁.mem := fun x _ => by rw [hm₁]
  obtain hp₁ := hp.congr hi₁ (k₁.gpr (by decide)) k₁.2.1 k₁.2.2
  obtain hsp₁ : s₁.gpr .rsp = p.sp := (k₁.gpr (by decide)).trans hsp
  obtain hA₁ : stackArg s₁ 12 = p.A := (hp.arg_eq hi₁ (k₁.gpr (by decide))).trans hA
  obtain hm₁' : word s₁.mem p.u.B (8 * Public.sMask) = mask c := by rw [hm₁]; exact hm
  refine ⟨?_, WP.mono (r2X_ok (j := Public.aY) (c := c) (by decide) hc₁ hwx2 hwx (by omega_arith) hm₁' hp₁)
    fun s₃ ⟨hc₃, _, f₃, _⟩ => ?_⟩
  · have := r2X_chain (j := Public.aY) (by decide) hc₁ hwx2 hwx (by omega_arith) hm₁' hp₁
    rw [hsp₁, hA₁] at this
    exact this
  obtain ho₃ : Outside (off p.u.B p.u.o) (slot p.u.wx Public.aY) (8 * (p.u.wx + 2)) s₁.mem s₃.mem := fun x hx =>
    f₃ x fun r hr => by rw [List.mem_singleton.mp hr]; exact hx
  exact prep_chain3 M hc₃ (hX₁.of_outside ho₃ (by decide) (by decide) (by decide) (Nat.le_refl _)
    (by have := hc₁.good.scr.nowrap; omega_arith)) hwx2 hwx (by omega_arith) hX1

/-- `prepP` is constant time. -/
theorem prepP_ct (M : Mont) (sl : Nat) (q : Bool) (hXm : RedcCT M Public.aXm)
    {hc : VG.Taint.Hint VG.X86_64.Taint.T}
    (hT : (taint.check (Taint.ofRegs [.rdi]) (.block [.mov .rdi (.mem (hdr sl))]) hc).isSome = true)
    (hR : RelCT isa (Two (X0 q Public.aY)) (seqs (CrtIfma.r2X q Public.aY)) fun _ _ => True) :
    RelCT isa (Two (PrepPreP sl q)) (seqs (CrtIfma.prepP M.mm sl q)) fun _ _ => True := by
  refine two_map id (fun _ _ h => prepP_chain M h) ?_
  rw [prepP_split]
  refine RelCT.seqs_app (by simp) (by simp [CrtIfma.r2X]) (ct_taint [.rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_singleton] at hr; subst hr; rw [h₁.1, h₂.1]) hT (fun _ _ h => h.2) ?_)
  refine ct_steps (by simp [CrtIfma.r2X]) (by simp [prepTail, redc]) UPubP.rx (fun _ _ h => h.1)
    (fun _ _ h => h.2) hR ?_
  exact two_map UPubP.u (fun _ _ h => h) (prepTail_ct M hXm)

/-! ## `pre` -/

/-- The public data of `pre`: `n`'s workspace, `-n⁻¹`, `n`, and the primes'
workspaces (both of `wp` words). -/
structure PrePub where
  B : Addr
  Z : Nat
  w : Nat
  minv : BitVec 64
  N : Nat
  op : Nat
  oq : Nat
  wp : Nat

abbrev PrePub.uq (p : PrePub) : UPub := ⟨p.B, p.Z, p.w, p.minv, p.N, p.oq, p.wp⟩
abbrev PrePub.up (p : PrePub) : UPub := ⟨p.B, p.Z, p.w, p.minv, p.N, p.op, p.wp⟩

/-! ## `preP` -/

/-- The public data of `preP`: `pre`'s, the stack pointer and `pre`'s address. -/
structure PrePubP where
  p : PrePub
  sp : Addr
  A : Addr

abbrev PrePubP.uq (p : PrePubP) : UPubP := ⟨p.p.uq, p.sp, p.A⟩
abbrev PrePubP.up (p : PrePubP) : UPubP := ⟨p.p.up, p.sp, p.A⟩

/-- `preP_ok`'s hypotheses. -/
def PrePreP (p : PrePubP) (s : State) : Prop :=
  ∃ (mp mq : BitVec 64) (P Q C VP VQ : Nat) (c : Bool), Good s p.p.B p.p.Z p.p.w p.p.minv ∧ p.p.w < 2 ^ 28 ∧
    slot p.p.w 8 ≤ p.p.op ∧ p.p.op + slot p.p.wp 8 + wsTab p.p.wp ≤ p.p.oq ∧
    p.p.oq + slot p.p.wp 8 + wsTab p.p.wp ≤ p.p.Z ∧ 2 ≤ p.p.wp ∧ p.p.w = 2 * p.p.wp ∧
    word s.mem p.p.B (8 * sWsP) = off p.p.B p.p.op ∧ word s.mem p.p.B (8 * sWsQ) = off p.p.B p.p.oq ∧
    WsAt s.mem p.p.B p.p.op p.p.wp mp ∧ WsAt s.mem p.p.B p.p.oq p.p.wp mq ∧ NVals s p.p.B p.p.w p.p.minv p.p.N ∧
    wv s.mem p.p.B (slot p.p.w Public.aXm) p.p.w % p.p.N = C * 2 ^ (64 * p.p.w) % p.p.N ∧
    XVals s p.p.B p.p.op p.p.wp mp P ∧ 1 < P ∧ P % 2 = 1 ∧ XVals s p.p.B p.p.oq p.p.wp mq Q ∧ 1 < Q ∧
    Q % 2 = 1 ∧ s.gpr .rsp = p.sp ∧ stackArg s 12 = p.A ∧ word s.mem p.p.B (8 * Public.sMask) = mask c ∧
    PreW s p.p.B p.p.Z (r2XOff false p.p.wp) p.p.wp VP ∧ PreW s p.p.B p.p.Z (r2XOff true p.p.wp) p.p.wp VQ ∧
    (c = false → P = 3) ∧ (c = true → VP % P = 2 ^ (64 * p.p.wp * 2) % P) ∧
    (c = false → Q = 3) ∧ (c = true → VQ % Q = 2 ^ (64 * p.p.wp * 2) % Q)

/-- Before `preP`. -/
def PRP0 (M : Mont) (p : PrePubP) (s : State) : Prop :=
  PrepPreP sWsQ true p.uq s ∧ WP isa (seqs (CrtIfma.prepP M.mm sWsQ true)) s (PrepPreP sWsP false p.up)

/-- `preP_ok`'s hypotheses give `PRP0`, as `preP_ok` runs the pieces. -/
theorem preP_chain (M : Mont) {p : PrePubP} {s : State} (h : PrePreP p s) : PRP0 M p s := by
  obtain ⟨⟨B, Z, w, minv, N, op, oq, wp⟩, sp, A⟩ := p
  dsimp only [PrePreP] at h
  obtain ⟨mp, mq, P, Q, C, VP, VQ, c, hg, hw28, hlo, hpq, hoq, hwp2, hw2, hsp, hsq, hwsp, hwsq, hN, hXm, hP,
    hP1, hPodd, hQ, hQ1, hQodd, hrsp, hA, hM, hpP, hpQ, hP3, hVP, hQ3, hVQ⟩ := h
  have hs := hg.scr
  have hn := hs.nowrap
  obtain h8 := hdr_lt_slot w 8 (show 31 < 32 by decide)
  obtain hX8 : 256 ≤ slot wp 8 := by unfold slot hdrBytes; omega_arith
  obtain ho64 : oq < 2 ^ 64 := by omega_arith
  obtain hQd : ∀ r ∈ [xRange oq wp], r.1 + r.2 ≤ op ∨ op + slot wp 8 ≤ r.1 := fun r hr => by
    rw [List.mem_singleton.mp hr]; exact .inr (by simp only [xRange]; omega_arith)
  refine ⟨⟨by dsimp only [PrepPre, PrePubP.uq, PrePub.uq]; exact ⟨mq, Q, hg, hw28, by omega_arith, hoq, hwp2,
      by omega_arith, by decide, hsq, hwsq, hQ, hQ1⟩, hrsp, hA, c, VQ, hM, hpQ⟩,
    WP.mono (prepP_ok (C := C) M hg hw28 (by omega_arith) hoq hwp2 hw2 (by decide) hsq hwsq hXm hQ hQ1 hQodd
      hM hpQ hQ3 hVQ) fun s₁ ⟨hg₁, _, _, _, _, _, _, fQ, kQ, _⟩ => ?_⟩
  obtain hb : ∀ d, d + 8 ≤ oq → word s₁.mem B d = word s.mem B d := fun d hd => fQ.x_below hd ho64
  obtain hi : InScr B Z s.mem s₁.mem := InScr.of_frm fQ fun r hr => by
    rw [List.mem_singleton.mp hr]; simp only [xRange]; omega_arith
  dsimp only [PrepPreP, PrepPre, PrePubP.up, PrePub.up]
  exact ⟨⟨mp, P, hg₁, hw28, hlo, by omega_arith, hwp2, by omega_arith, by decide,
    by rw [hb _ (by unfold sWsP sFn; omega_arith)]; exact hsp,
    hwsp.of_disj fQ (fun r hr => by rcases hQd r hr with h | h <;> omega_arith) (by omega_arith),
    hP.of_disj fQ hQd (by omega_arith), hP1⟩, (kQ.gpr (by decide)).trans hrsp,
    (hpP.arg_eq hi (kQ.gpr (by decide))).trans hA, c, VP,
    by rw [hb _ (by have := hdr_lt_slot w 8 (show Public.sMask < 32 by decide); omega_arith)]; exact hM,
    hpP.congr hi (kQ.gpr (by decide)) kQ.2.1 kQ.2.2⟩

/-- `preP` is constant time. -/
theorem preP_ct (M : Mont) (hXm : RedcCT M Public.aXm) :
    RelCT isa (Two PrePreP) (seqs (CrtIfma.preP M.mm)) fun _ _ => True := by
  refine two_map id (fun _ _ h => preP_chain M h) ?_
  refine ct_steps (by simp [CrtIfma.prepP]) (by simp [CrtIfma.prepP]) PrePubP.uq (fun _ _ h => h.1)
    (fun _ _ h => h.2) (prepP_ct M sWsQ true hXm (by taint_decide)
      (r2X_ct true Public.aY (by taint_decide) (by taint_decide) (by taint_decide) (by taint_decide)
        (by taint_decide))) ?_
  exact ct_last PrePubP.up (fun _ _ h => h) (prepP_ct M sWsP false hXm (by taint_decide)
    (r2X_ct false Public.aY (by taint_decide) (by taint_decide) (by taint_decide) (by taint_decide)
      (by taint_decide)))

end VG.Proof.Bignum.X86_64

end

end

/-!
# RSA with AVX512_IFMA on x86-64: constant time, after the exponentiations

`post` is, in `p`'s workspace, a `redc`, the loads of `q`'s result's
address (split at each load whose address the previous one gave), its
copy, a Montgomery multiplication and a copy, then `hSteps` after its
`redc` (`h2_ct`): each is constant time, so `post` is (`post_ct`), for
`post_ok`'s hypotheses (`PostPre`), from which `post_chain` proves what
each piece needs, as `post_ok` runs them.
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Rsa.X86_64 VG.Impl.Rsa.X86_64.Crt
open VG.Proof.MlKem.X86_64 CrtCTQ

/-- The public data of `post`: `n`'s workspace, `p`'s and `q`'s (of `wx`
words each), and `qInv`'s pointer and length. -/
structure PostPub where
  B : Addr
  Z : Nat
  w : Nat
  op : Nat
  wx : Nat
  oq : Nat
  qp : Addr
  len : Nat

abbrev PostPub.pw (p : PostPub) : Ws := ⟨off p.B p.op, slot p.wx 8, p.wx⟩
abbrev PostPub.h (p : PostPub) : HPub := ⟨p.B, p.Z, p.w, p.op, p.wx, p.qp, p.len⟩

/-- `post`'s loads of `q`'s result's address: `n`'s base, `q`'s, and from them. -/
def postBlk1 : List Instr := [.mov .rax (.mem (hdr sLink))]
def postBlk2 : List Instr := [.mov .rax (.mem (ws .rax sWsQ))]
def postBlk3 : List Instr :=
  [.mov .rsi (.mem (ws .rax (sArr Public.aY))), .mov .r12 (.mem (hdr sW)), .mov .rbx (.mem (hdr (sArr aChunk)))]

/-- Before `aXc := aChunk`. -/
def Q7 (M : Mont) (p : PostPub) (s : State) : Prop :=
  GoodW p.pw s ∧ WP isa (seqs (copyArr aXc aChunk)) s (H2 M p.h)

/-- Before `aChunk := aChunk aXc`. -/
def Q6 (M : Mont) (p : PostPub) (s : State) : Prop :=
  GoodW p.pw s ∧ WP isa (M.mm aChunk aChunk aXc) s (Q7 M p)

/-- Before the copy of `m_q`. -/
def Q5 (M : Mont) (p : PostPub) (s : State) : Prop :=
  s.gpr .rsi = off (off p.B p.oq) (slot p.wx Public.aY) ∧ s.gpr .r12 = BitVec.ofNat 64 p.wx ∧
    s.gpr .rbx = off (off p.B p.op) (slot p.wx aChunk) ∧ WP isa copyWords s (Q6 M p)

/-- Before the loads from `q`'s workspace. -/
def Q4 (M : Mont) (p : PostPub) (s : State) : Prop :=
  s.gpr .rax = off p.B p.oq ∧ s.gpr .rdi = off p.B p.op ∧ WP isa (.block postBlk3) s (Q5 M p)

/-- Before the load of `q`'s base. -/
def Q3 (M : Mont) (p : PostPub) (s : State) : Prop :=
  s.gpr .rax = p.B ∧ s.gpr .rdi = off p.B p.op ∧ WP isa (.block postBlk2) s (Q4 M p)

/-- Before the load of `n`'s base. -/
def Q2 (M : Mont) (p : PostPub) (s : State) : Prop :=
  s.gpr .rdi = off p.B p.op ∧ WP isa (.block postBlk1) s (Q3 M p)

/-- `post` after its start, from `s₂` in `p`'s workspace with `R_p²` in its
`aXc` (`PostHead`): `Q2`, as `postWith_ok` runs the pieces. -/
theorem post_chain2 (M : Mont) {s s₂ : State} {B : Addr} {Z w op wx oq : Nat} {qp : Addr}
    {minv mx mq : BitVec 64} {N X : Nat} {qib : List Byte} {c : Bool}
    (hg : Good s B Z w minv) (hw28 : w < 2 ^ 28) (hw2 : w = 2 * wx)
    (hq : word s.mem B (8 * sWsQ) = off B oq) (hwsq : WsAt s.mem B oq wx mq)
    (hhiq : oq + slot wx 8 + wsTab wx ≤ Z) (hlo : slot w 8 ≤ op) (hhi : op + slot wx 8 + wsTab wx ≤ oq)
    (hwx2 : 2 ≤ wx) (hX1 : 1 < X) (hyl : wv s.mem (off B op) (slot wx Public.aY) wx < X)
    (hmask : word s.mem (off B op) (8 * sMaskX) = mask c) (hqp : word s.mem B (8 * sQinv) = qp)
    (hql : word s.mem B (8 * sPlen) = BitVec.ofNat 64 qib.length) (hqs : Src s B Z qp qib) (hq1 : 1 ≤ qib.length)
    (hq2 : qib.length < 2 ^ 31) (hqw : (qib.length + 7) / 8 ≤ wx) (hqi : c = true → Spec.Rsa.os2ip qib < X)
    (hh : PostHead s B Z w mx N X op wx s₂) :
    Q2 M ⟨B, Z, w, op, wx, oq, qp, qib.length⟩ s₂ := by
  obtain ⟨hc₂, hX₂, hlt₂, -, fx₂, hY₂, hk₂, k02⟩ := hh
  have hs := hg.scr
  have hn := hs.nowrap
  obtain h8 := hdr_lt_slot w 8 (show 31 < 32 by decide)
  obtain hX8 : 256 ≤ slot wx 8 := by unfold slot hdrBytes; omega_arith
  obtain ho64 : op < 2 ^ 64 := by omega_arith
  obtain hoL : op + slot wx 8 ≤ 2 ^ 64 := by omega_arith
  obtain hwx : wx ≤ w := by omega_arith
  obtain lY := slot_le (w := wx) (show Public.aY < 8 by decide)
  obtain lC := slot_le (w := wx) (show aChunk < 8 by decide)
  obtain hC0 := hdr_lt_slot wx aChunk (show 31 < 32 by decide)
  obtain lX := slot_le (w := wx) (show aXc < 8 by decide)
  obtain hX0 := hdr_lt_slot wx aXc (show 31 < 32 by decide)
  obtain hb₂ : ∀ d, d + 8 ≤ op → word s₂.mem B d = word s.mem B d := fun d hd => fx₂.x_below hd ho64
  obtain hab₂ : ∀ d, op + slot wx 8 + wsTab wx ≤ d → d + 8 ≤ 2 ^ 64 → word s₂.mem B d = word s.mem B d :=
    fun d hd hd' => fx₂.word_eq (fun r hr => by rw [List.mem_singleton.mp hr]; simp only [xRange]; omega_arith) hd'
  have hs₂ := hc₂.scr
  have hsP := hc₂.good.scr
  have hdi₂ := hc₂.rdi
  refine ⟨hdi₂, ?_⟩
  -- `rax := B`.
  refine WP.mono (WP.keep [.rax] (Q := fun t => t.gpr .rax = B ∧ t.mem = s₂.mem)
    (by xrun [postBlk1, State.ea, hdr, hdi₂, hdrOff, hsP.ld (d := 8 * sLink) (by unfold sLink sFn; omega_arith),
      hc₂.link]) rfl) fun s₃ ⟨⟨hax₃, hm₃⟩, k₃⟩ => ⟨hax₃, (k₃.gpr (by decide)).trans hdi₂, ?_⟩
  obtain hs₃ := hs₂.congr k₃.2.2
  -- `rax := q`'s base.
  refine WP.mono (WP.keep [.rax] (Q := fun t => t.gpr .rax = off B oq ∧ t.mem = s₃.mem)
    (by xrun [postBlk2, State.ea, ws, hax₃, hdrOff, hs₃.ld (d := 8 * sWsQ) (by unfold sWsQ sFn; omega_arith), hm₃,
      hb₂ (8 * sWsQ) (by unfold sWsQ sFn; omega_arith), hq]) rfl)
    fun s₄ ⟨⟨hax₄, hm₄⟩, k₄⟩ => ⟨hax₄, (k₄.gpr (by decide)).trans ((k₃.gpr (by decide)).trans hdi₂), ?_⟩
  obtain hs₄ := hs₃.congr k₄.2.2
  obtain hsP₄ := (hsP.congr k₃.2.2).congr k₄.2.2
  obtain hldq := (hs₄.sub (o := oq) (n := slot wx 8) (by omega_arith) (by omega_arith)).ld (d := 8 * sArr Public.aY)
    (by unfold sArr Public.aY; omega_arith)
  obtain hqa : word s₄.mem (off B oq) (8 * sArr Public.aY) = off (off B oq) (slot wx Public.aY) := by
    rw [hm₄, hm₃, word_off, hab₂ (oq + 8 * sArr Public.aY) (by omega_arith) (by unfold sArr Public.aY; omega_arith), ← word_off]
    exact hwsq.hdr.harr Public.aY (by decide)
  obtain hdi₄ : s₄.gpr .rdi = off B op := (k₄.gpr (by decide)).trans ((k₃.gpr (by decide)).trans hdi₂)
  obtain hpw : ∀ i < 32, word s₄.mem (off B op) (8 * i) = word s₂.mem (off B op) (8 * i) := fun i _ => by
    rw [hm₄, hm₃]
  -- `rsi`, `r12`, `rbx`.
  refine WP.mono (WP.keep [.rsi, .r12, .rbx] (Q := fun t =>
      t.gpr .rsi = off (off B oq) (slot wx Public.aY) ∧ t.gpr .r12 = BitVec.ofNat 64 wx ∧
      t.gpr .rbx = off (off B op) (slot wx aChunk) ∧ t.mem = s₄.mem)
    (by xrun [postBlk3, State.ea, hdr, ws, hax₄, hdi₄, hdrOff, hldq, hqa,
      hsP₄.ld (d := 8 * sW) (by unfold sW; omega_arith), hpw sW (by decide), hc₂.hdr.hw,
      hsP₄.ld (d := 8 * sArr aChunk) (by unfold sArr aChunk; omega_arith), hpw (sArr aChunk) (by decide),
      hc₂.hdr.harr aChunk (by decide)]) rfl)
    fun s₅ ⟨⟨hsi₅, h12₅, hbx₅, hm₅⟩, k₅⟩ => ⟨hsi₅, h12₅, hbx₅, ?_⟩
  obtain k25 := (k₃.trans k₄).trans k₅
  obtain hs₅ := hs₂.congr k25.2.2
  obtain hsP₅ := hsP.congr k25.2.2
  obtain hsi₅' : s₅.gpr .rsi = off B (oq + slot wx Public.aY) := by rw [hsi₅, off_off]
  -- `aChunk := m_q`.
  refine WP.mono (copyWords_ok (S := B) (eS := oq + slot wx Public.aY) (D := off B op) (eD := slot wx aChunk)
    (w := wx) hsi₅' hbx₅ h12₅ (by omega_arith) (by omega_arith) (by omega_arith) (fun j hj => hs₅.ld (by omega_arith))
    (fun j hj => hsP₅.st (by omega_arith)) (fun j hj b hb => Or.inr (by
      rw [show off B (oq + slot wx Public.aY + 8 * j) = off (off B op) (oq + slot wx Public.aY + 8 * j - op) by
        rw [off_off]; congr 1; omega_arith, ofs_off (off B op) (by omega_arith)]; omega_arith))) fun s₆ ⟨_, _, ho₆, k₆⟩ => ?_
  obtain hm25 : s₅.mem = s₂.mem := by rw [hm₅, hm₄, hm₃]
  rw [hm25] at ho₆
  obtain hz₂ : (off B op).toNat + slot wx 8 ≤ 2 ^ 64 := by have := hc₂.good.scr.nowrap; omega_arith
  obtain hX₆ : XVals s₆ B op wx mx X := hX₂.of_outside ho₆ (by decide) (by decide) (by decide) (by omega_arith) hz₂
  obtain hc₆ : SubCtx s₆ B Z op w wx mx := hc₂.of_frm (rs := [(slot wx aChunk, 8 * wx)]) (Frm.of_outside ho₆ (by simp)) (fun r hr => by
    rw [List.mem_singleton.mp hr]; simp only; omega_arith) (k25.trans k₆).2.2 ((k25.trans k₆).gpr (by decide))
  obtain hxc₆ : wv s₆.mem (off B op) (slot wx aXc) wx = wv s₂.mem (off B op) (slot wx aXc) wx := by
    have := slot_sep (w := wx) (show aXc ≠ aChunk by decide)
    exact ho₆.wv (by omega_arith) (by omega_arith)
  refine ⟨⟨mx, hc₆.good, Nat.le_refl _⟩, ?_⟩
  -- `aChunk := aChunk aXc`.
  refine WP.mono (M.mm_ok (o := aChunk) (a := aChunk) (b := aXc) hc₆.good (Nat.le_refl _) hwx2
    (by omega_arith) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) hX₆.inv
    (by rw [hX₆.n, hxc₆]; exact hlt₂)) fun s₇ ⟨_, hlt₇, _, ha₇, k₇⟩ => ?_
  rw [hX₆.n] at hlt₇
  obtain ⟨hc₇, hX₇, fx₇⟩ := hc₆.of_arrays hX₆ ha₇ (by
    intro j hj; simp only [List.mem_cons, List.not_mem_nil, or_false] at hj
    rcases hj with rfl | rfl | rfl <;> decide) k₇.2.2 (k₇.gpr (by decide)) (by omega_arith)
  refine ⟨⟨mx, hc₇.good, Nat.le_refl _⟩, ?_⟩
  -- `aXc := aChunk`.
  refine WP.mono (copyArr_ok hc₇.good (Nat.le_refl _) (by omega_arith) (by omega_arith) (o := aXc) (a := aChunk)
    (by decide) (by decide) (by decide)) fun s₈ ⟨hv₈, ho₈, k₈⟩ => ?_
  obtain hc₈ := hc₇.of_frm (rs := [(slot wx aXc, 8 * wx)]) (Frm.of_outside ho₈ (by simp)) (fun r hr => by
    rw [List.mem_singleton.mp hr]; simp only; omega_arith) k₈.2.2 (k₈.gpr (by decide))
  obtain hX₈ : XVals s₈ B op wx mx X := hX₇.of_outside ho₈ (by decide) (by decide) (by decide) (by omega_arith) hz₂
  obtain fx₈ : Frm B [xRange op wx] s₇.mem s₈.mem :=
    (ho₈.mono (o' := slot wx aXc) (n' := 8 * (wx + 2)) (Nat.le_refl _) (by omega_arith)).to_x
      (by decide) hoL (List.mem_singleton_self _)
  obtain fx₆ : Frm B [xRange op wx] s₂.mem s₆.mem :=
    (ho₆.mono (o' := slot wx aChunk) (n' := 8 * (wx + 2)) (Nat.le_refl _) (by omega_arith)).to_x
      (by decide) hoL (List.mem_singleton_self _)
  obtain f08 : Frm B [xRange op wx] s.mem s₈.mem := ((fx₂.trans fx₆).trans fx₇).trans fx₈
  obtain hb₈ : ∀ d, d + 8 ≤ op → word s₈.mem B d = word s.mem B d := fun d hd => f08.x_below hd ho64
  obtain i08 : InScr B Z s.mem s₈.mem :=
    InScr.of_frm f08 fun r hr => by rw [List.mem_singleton.mp hr]; simp only [xRange]; omega_arith
  obtain hY₈ : wv s₈.mem (off B op) (slot wx Public.aY) wx = wv s.mem (off B op) (slot wx Public.aY) wx := by
    have := slot_sep (w := wx) (show Public.aY ≠ aXc by decide)
    have := slot_sep (w := wx) (show Public.aY ≠ aChunk by decide)
    rw [ho₈.wv (by omega_arith) (by omega_arith), ha₇.wv_of_not_mem (by decide) (by decide) hz₂, ho₆.wv (by omega_arith) (by omega_arith),
      hY₂]
  obtain hM₈ : word s₈.mem (off B op) (8 * sMaskX) = mask c := by
    obtain hmx : 8 * sMaskX + 8 ≤ 8 * 31 + 8 := by unfold sMaskX sFn; omega_arith
    rw [ho₈.word (.inl (by omega_arith)) (by omega_arith), ha₇.hslot (by decide), ho₆.word (.inl (by omega_arith)) (by omega_arith),
      hk₂]; exact hmask
  exact h2_chain M hc₈ (show op + slot wx 8 + wsTab wx ≤ Z by omega_arith) hX₈ hX1 hw28 hwx2 hwx (by rw [hY₈]; exact hyl) (by rw [hv₈]; exact hlt₇) hM₈
    (by rw [hb₈ _ (by unfold sQinv sFn; omega_arith)]; exact hqp) (by rw [hb₈ _ (by unfold sPlen sFn; omega_arith)]; exact hql)
    (hqs.congrK i08 ((((k02.trans k25).trans k₆).trans k₇).trans k₈)) hq1 hq2 hqw hqi


/-- `post` after its start. -/
def postRestCT (mul : Nat → Nat → Nat → Prog isa) : List (Prog isa) :=
  .block (postBlk1 ++ (postBlk2 ++ postBlk3)) :: copyWords :: mul aChunk aChunk aXc ::
    (copyArr aXc aChunk ++ (subModArr aT Public.aY aXc ++ (loadArr aChunk sQinv sPlen ++ (maskArr aChunk ++
      ([mul Public.aY aT aChunk, .block [leave]] : List (Prog isa))))))

/-- `post` after its start is constant time. -/
theorem postTail_ct (M : Mont) (hL : LoadCT aChunk sQinv sPlen) :
    RelCT isa (Two (Q2 M)) (seqs (postRestCT M.mm)) fun _ _ => True := by
  unfold postRestCT
  simp only [seqs]
  obtain b1 : RelCT isa (Two (Q2 M)) (.block postBlk1) (Two (Q3 M)) :=
    two_piece [.rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_singleton] at hr; subst hr; rw [h₁.1, h₂.1]) (by taint_decide) fun _ _ h => h.2
  obtain b2 : RelCT isa (Two (Q3 M)) (.block postBlk2) (Two (Q4 M)) :=
    two_piece [.rax, .rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · rw [h₁.1, h₂.1]
      · rw [h₁.2.1, h₂.2.1]) (by taint_decide) fun _ _ h => h.2.2
  obtain b3 : RelCT isa (Two (Q4 M)) (.block postBlk3) (Two (Q5 M)) :=
    two_piece [.rax, .rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · rw [h₁.1, h₂.1]
      · rw [h₁.2.1, h₂.2.1]) (by taint_decide) fun _ _ h => h.2.2
  refine RelCT.seq (RelCT.block_append (RelCT.seq b1 (RelCT.block_append (RelCT.seq b2 b3)))) ?_
  refine ct_taint [.rsi, .r12, .rbx] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl
      · rw [h₁.1, h₂.1]
      · rw [h₁.2.1, h₂.2.1]
      · rw [h₁.2.2.1, h₂.2.2.1]) (by taint_decide) (fun _ _ h => h.2.2.2) ?_
  refine RelCT.seq (two_post (Ψ := Q7 M) (two_map PostPub.pw (fun _ _ h => h.1) (M.ct (by unfold MmUse; decide)))
    fun _ _ h => h.2) ?_
  exact ct_steps (by simp [copyArr]) (by simp [subModArr]) PostPub.pw (fun _ _ h => h.1) (fun _ _ h => h.2)
    (copyArr_ct (by decide) (by decide) (by taint_decide)) (two_map PostPub.h (fun _ _ h => h) (h2_ct M hL))


/-! ## `postP` -/

/-- The public data of `postP`: `post`'s, the stack pointer and `pre`'s address. -/
structure PostPubP where
  p : PostPub
  sp : Addr
  A : Addr

abbrev PostPubP.rx (p : PostPubP) : RXPub := ⟨p.sp, p.A, p.p.B, p.p.op, p.p.wx⟩

/-- `postP_ok`'s hypotheses, with what `postP` reads of them public. -/
def PostPreP (p : PostPubP) (s : State) : Prop :=
  ∃ (minv mx mq : BitVec 64) (X : Nat) (qib : List Byte) (c : Bool) (V : Nat),
    Good s p.p.B p.p.Z p.p.w minv ∧ p.p.w < 2 ^ 28 ∧ p.p.w = 2 * p.p.wx ∧
    word s.mem p.p.B (8 * sWsQ) = off p.p.B p.p.oq ∧ WsAt s.mem p.p.B p.p.oq p.p.wx mq ∧
    p.p.oq + slot p.p.wx 8 + wsTab p.p.wx ≤ p.p.Z ∧ slot p.p.w 8 ≤ p.p.op ∧
    p.p.op + slot p.p.wx 8 + wsTab p.p.wx ≤ p.p.oq ∧ 2 ≤ p.p.wx ∧
    word s.mem p.p.B (8 * sWsP) = off p.p.B p.p.op ∧ WsAt s.mem p.p.B p.p.op p.p.wx mx ∧
    XVals s p.p.B p.p.op p.p.wx mx X ∧
    1 < X ∧ wv s.mem (off p.p.B p.p.op) (slot p.p.wx Public.aY) p.p.wx < X ∧
    word s.mem (off p.p.B p.p.op) (8 * sMaskX) = mask c ∧ word s.mem p.p.B (8 * sQinv) = p.p.qp ∧
    word s.mem p.p.B (8 * sPlen) = BitVec.ofNat 64 qib.length ∧ Src s p.p.B p.p.Z p.p.qp qib ∧ 1 ≤ qib.length ∧
    qib.length < 2 ^ 31 ∧ (qib.length + 7) / 8 ≤ p.p.wx ∧ (c = true → Spec.Rsa.os2ip qib < X) ∧
    qib.length = p.p.len ∧ s.gpr .rsp = p.sp ∧ stackArg s 12 = p.A ∧
    word s.mem p.p.B (8 * Public.sMask) = mask c ∧ PreW s p.p.B p.p.Z (r2XOff false p.p.wx) p.p.wx V ∧
    (c = true → V < X)

/-- Before `r2X`. -/
def Q1P (M : Mont) (p : PostPubP) (s : State) : Prop :=
  X0 false aXc p.rx s ∧ WP isa (seqs (CrtIfma.r2X false aXc)) s (Q2 M p.p)

/-- Before `postP`. -/
def Q0P (M : Mont) (p : PostPubP) (s : State) : Prop :=
  s.gpr .rdi = p.p.B ∧ WP isa (.block [.mov .rdi (.mem (hdr sWsP))]) s (Q1P M p)

/-- `postP_ok`'s hypotheses give `Q0P`, as `postP_ok` runs the pieces. -/
theorem postP_chain (M : Mont) {p : PostPubP} {s : State} (h : PostPreP p s) : Q0P M p s := by
  obtain ⟨⟨B, Z, w, op, wx, oq, qp, len⟩, sp, A⟩ := p
  dsimp only [PostPreP] at h
  obtain ⟨minv, mx, mq, X, qib, c, V, hg, hw28, hw2, hq, hwsq, hhiq, hlo, hhi, hwx2, hsp, hws, hX, hX1, hyl, hmask,
    hqp, hql, hqs, hq1, hq2, hqw, hqi, rfl, hrsp, hA, hM, hp, hVl⟩ := h
  have hs := hg.scr
  have hn := hs.nowrap
  obtain hX8 : 256 ≤ slot wx 8 := by unfold slot hdrBytes; omega_arith
  obtain hoL : op + slot wx 8 ≤ 2 ^ 64 := by omega_arith
  obtain hwx : wx ≤ w := by omega_arith
  obtain lY := slot_le (w := wx) (show Public.aY < 8 by decide)
  obtain lC := slot_le (w := wx) (show aXc < 8 by decide)
  obtain hC0 := hdr_lt_slot wx aXc (show 31 < 32 by decide)
  obtain sYC := slot_sep (w := wx) (show Public.aY ≠ aXc by decide)
  obtain hmx : 8 * sMaskX + 8 ≤ 8 * 31 + 8 := by unfold sMaskX sFn; omega_arith
  refine ⟨hg.rdi, WP.mono (enter_ok (X := X) hg hlo (by omega_arith) (by decide) hsp hws hX)
    fun s₁ ⟨hc₁, hX₁, hm₁, k₁⟩ => ?_⟩
  obtain hi₁ : InScr B Z s.mem s₁.mem := fun x _ => by rw [hm₁]
  obtain hp₁ := hp.congr hi₁ (k₁.gpr (by decide)) k₁.2.1 k₁.2.2
  obtain hsp₁ : s₁.gpr .rsp = sp := (k₁.gpr (by decide)).trans hrsp
  obtain hA₁ : stackArg s₁ 12 = A := (hp.arg_eq hi₁ (k₁.gpr (by decide))).trans hA
  obtain hM₁ : word s₁.mem B (8 * Public.sMask) = mask c := by rw [hm₁]; exact hM
  refine ⟨?_, WP.mono (r2X_ok (j := aXc) (c := c) (by decide) hc₁ hwx2 hwx (by omega_arith) hM₁ hp₁)
    fun s₂ ⟨hc₂, hv₂, f₂, k₂⟩ => ?_⟩
  · have := r2X_chain (j := aXc) (by decide) hc₁ hwx2 hwx (by omega_arith) hM₁ hp₁
    rw [hsp₁, hA₁] at this
    exact this
  obtain ho₂ : Outside (off B op) (slot wx aXc) (8 * (wx + 2)) s₁.mem s₂.mem := fun x hx =>
    f₂ x fun r hr => by rw [List.mem_singleton.mp hr]; exact hx
  rw [hm₁] at f₂ ho₂
  obtain hz₁ : (off B op).toNat + slot wx 8 ≤ 2 ^ 64 := by have := hc₁.good.scr.nowrap; omega_arith
  refine post_chain2 (N := 1) M hg hw28 hw2 hq hwsq hhiq hlo hhi hwx2 hX1 hyl hmask hqp hql hqs hq1 hq2 hqw hqi
    ⟨hc₂, hX₁.of_outside (by rw [hm₁]; exact ho₂) (by decide) (by decide) (by decide) (Nat.le_refl _) hz₁, ?_,
      fun h0 => absurd (Nat.le_of_dvd (by decide) h0) (by omega_arith),
      f₂.to_x (fun r hr => by rw [List.mem_singleton.mp hr]; simp only; omega_arith) hoL (List.mem_singleton_self _),
      ho₂.wv (by omega_arith) (by omega_arith),
      f₂.word_eq (fun r hr => by rw [List.mem_singleton.mp hr]; simp only; omega_arith) (by omega_arith),
      (k₁.trans k₂).mono (by decide)⟩
  rw [hv₂]
  cases c
  · simp only [Bool.false_eq_true, ↓reduceIte]; exact hX1
  · simp only [↓reduceIte]; exact hVl rfl

theorem postP_eqCT (mul : Nat → Nat → Nat → Prog isa) :
    CrtIfma.postP mul = ([.block [.mov .rdi (.mem (hdr sWsP))]] : List (Prog isa)) ++
      (CrtIfma.r2X false aXc ++ postRestCT mul) := by
  simp only [CrtIfma.postP, postRestCT, enterP, postBlk1, postBlk2, postBlk3, List.append_assoc,
    List.cons_append, List.nil_append]

/-- `postP` is constant time. -/
theorem postP_ct (M : Mont) (hL : LoadCT aChunk sQinv sPlen) :
    RelCT isa (Two PostPreP) (seqs (CrtIfma.postP M.mm)) fun _ _ => True := by
  refine two_map id (fun _ _ h => postP_chain M h) ?_
  rw [postP_eqCT]
  refine RelCT.seqs_app (by simp) (by simp [CrtIfma.r2X]) (ct_taint [.rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_singleton] at hr; subst hr; rw [h₁.1, h₂.1]) (by taint_decide) (fun _ _ h => h.2) ?_)
  exact ct_steps (by simp [CrtIfma.r2X]) (by simp [postRestCT]) PostPubP.rx (fun _ _ h => h.1) (fun _ _ h => h.2)
    (r2X_ct false aXc (by taint_decide) (by taint_decide) (by taint_decide) (by taint_decide) (by taint_decide))
    (two_map PostPubP.p (fun _ _ h => h) (postTail_ct M hL))

end VG.Proof.Bignum.X86_64

end

end

/-! ### `Bignum.X86_64.CrtPreCT`, which the modules that import this one used -/

section

/-! ### `Bignum.X86_64.CrtCTP`, which this module and modules that import it used -/

section

/-!
# RSA with the CRT on x86-64: constant time, `p`'s phase

`pPhase` is constant time (`pPhase_ct`) given its pieces' claims: before
each piece, a predicate (`PO0` … `PO4`, then `hSteps`' `H0`) carries the
piece's hypotheses and what correctness gives after it; `o0_of` proves the
first from `PPre`, as `pPhase_ok` runs the pieces.
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Rsa.X86_64 VG.Impl.Rsa.X86_64.Crt
open VG.Proof.MlKem.X86_64

/-- The modulus' workspace. -/
abbrev PPhasePub.nw (p : PPhasePub) : Ws := ⟨p.ph.B, p.ph.Z, p.ph.w⟩

/-- The public data of the phase's first part. -/
abbrev PPhasePub.u (p : PPhasePub) : UPub := ⟨p.ph.B, p.ph.Z, p.ph.w, p.ph.minv, p.ph.N, p.ph.o, p.ph.wx⟩

/-- The public data of `m_q G mod n`. -/
abbrev PPhasePub.mq (p : PPhasePub) : MqPub := ⟨p.ph.B, p.ph.Z, p.ph.w, p.oq, p.wq⟩

/-- The public data of the exponentiation. -/
abbrev PPhasePub.pw (p : PPhasePub) : BPub := ⟨⟨p.ph.B, p.ph.Z, p.ph.o, p.ph.w, p.ph.wx⟩, p.ph.ep, p.ph.len⟩

/-- The public data of `h`. -/
abbrev PPhasePub.h (p : PPhasePub) : HPub := ⟨p.ph.B, p.ph.Z, p.ph.w, p.ph.o, p.ph.wx, p.qp, p.ph.len⟩

/-- Before the way back to the modulus' workspace. -/
def PO4 (M : Mont) (p : PPhasePub) (s : State) : Prop :=
  s.gpr .rdi = off p.ph.B p.ph.o ∧ WP isa (.block [leave]) s (H0 M p.h)

/-- Before the exponentiation. -/
def PO3 (M : Mont) (E : CrtExpL M) (p : PPhasePub) (s : State) : Prop :=
  PwPre sWsP sDp sPlen p.pw s ∧ WP isa (seqs (powSteps M.mm E.code sWsP sDp sPlen)) s (PO4 M p)

/-- Before `c G mod N`. -/
def PO2 (M : Mont) (E : CrtExpL M) (p : PPhasePub) (s : State) : Prop :=
  GoodW p.nw s ∧ WP isa (M.mm Public.aY Public.aXm Public.aY) s (PO3 M E p)

/-- Before `m_q G mod N`. -/
def PO1 (M : Mont) (E : CrtExpL M) (p : PPhasePub) (s : State) : Prop :=
  Mq0 M p.mq s ∧ WP isa (seqs (mqSteps M.mm)) s (PO2 M E p)

/-- Before `pPhase`. -/
def PO0 (M : Mont) (E : CrtExpL M) (p : PPhasePub) (s : State) : Prop :=
  UPre sWsP p.u s ∧ WP isa (seqs (unitSteps M.mm sWsP)) s (PO1 M E p)

/-- From before the exponentiation: `PO3`, as `pPhase_ok` runs the rest. -/
theorem o3_of (M : Mont) (E : CrtExpL M) {s : State} {B : Addr} {Z w : Nat} {minv mx : BitVec 64}
    {N X C o wx oq wq : Nat} {ep qp : Addr} {eb qib : List Byte} {c : Bool}
    (hg : Good s B Z w minv) (hw28 : w < 2 ^ 28) (hlo : slot w 8 ≤ o) (hhi : o + slot wx 8 + wsTab wx ≤ Z)
    (hwx2 : 2 ≤ wx) (hwx : wx ≤ w) (hslv : word s.mem B (8 * sWsP) = off B o) (hws : WsAt s.mem B o wx mx)
    (hX : XVals s B o wx mx X) (hX1 : 1 < X) (hXodd : X % 2 = 1)
    (hcg : wv s.mem B (slot w Public.aY) w % N = C * 2 ^ (64 * wx * (nChunks w wx + 1)) % N)
    (hpl : wv s.mem (off B o) (slot wx Public.aY) wx < X)
    (hpy : X ∣ N → wv s.mem (off B o) (slot wx Public.aY) wx % X = 2 ^ (64 * wx) % X)
    (hep : word s.mem B (8 * sDp) = ep) (hel : word s.mem B (8 * sPlen) = BitVec.ofNat 64 eb.length)
    (hL1 : 1 ≤ eb.length) (hL2 : eb.length ≤ 1024) (he : Src s B Z ep eb)
    (hmask : word s.mem (off B o) (8 * sMaskX) = mask c)
    (hqp : word s.mem B (8 * sQinv) = qp) (hql : qib.length = eb.length) (hqs : Src s B Z qp qib)
    (hqw : (qib.length + 7) / 8 ≤ wx) (hqi : c = true → Spec.Rsa.os2ip qib < X) :
    PO3 M E ⟨⟨B, Z, w, minv, N, o, wx, ep, eb.length⟩, oq, wq, qp⟩ s := by
  have hs := hg.scr
  have hn := hs.nowrap
  obtain h8 := hdr_lt_slot w 8 (show 31 < 32 by decide)
  obtain hX8 : 256 ≤ slot wx 8 := by unfold slot hdrBytes; omega_arith
  obtain ho64 : o < 2 ^ 64 := by omega_arith
  -- `c^dP R_p mod p`.
  refine ⟨⟨minv, mx, N, X, C, eb, hg, hw28, hlo, hhi, hwx2, hwx, by decide, hslv, hws, hX, hX1, hXodd, hcg, hpl,
      hpy, by decide, by decide, hep, hel, rfl, hL1, hL2, he⟩,
    WP.mono (powPhase_ok M E hg hw28 hlo hhi hwx2 hwx (sl := sWsP) (by decide) hslv hws hX hX1 hXodd hcg hpl hpy
      (sd := sDp) (slen := sPlen) (by decide) (by decide) hep hel hL1 hL2 he)
      fun s₄ ⟨hc₄, hX₄, hlt₄, _, hM₄, fx₄, k₄⟩ => ?_⟩
  -- Back to the modulus'.
  obtain hl₄ : InRegions (s₄.rd ++ s₄.wr) (off (off B o) (8 * sLink)) 8 :=
    hc₄.good.scr.ld (by unfold sLink sFn; omega_arith)
  refine ⟨hc₄.rdi, WP.mono (WP.keep [.rdi] (Q := fun t => t.gpr .rdi = B ∧ t.mem = s₄.mem)
    (by xrun [leave, State.ea, hdr, hc₄.rdi, hdrOff, hl₄, hc₄.link]) rfl) fun s₅ ⟨⟨hdi₅, hm₅⟩, k₅⟩ => ?_⟩
  obtain fx₅ : Frm B [xRange o wx] s.mem s₅.mem := by rw [hm₅]; exact fx₄
  obtain k05 := k₄.trans k₅
  obtain hb₅ : ∀ d, d + 8 ≤ o → word s₅.mem B d = word s.mem B d := fun d hd => fx₅.x_below hd ho64
  obtain hg₅ : Good s₅ B Z w minv := ⟨hs.congr k05.2.2, hdi₅, ⟨(hb₅ _ (by unfold sW; omega_arith)).trans hg.hdr.hw,
    (hb₅ _ (by unfold sMinv; omega_arith)).trans hg.hdr.hminv,
    fun j hj => (hb₅ _ (by have := hdr_lt_slot w 8 (show sArr j < 32 by unfold sArr; omega_arith); omega_arith)).trans
      (hg.hdr.harr j hj)⟩⟩
  obtain hX₅ : XVals s₅ B o wx mx X := ⟨by rw [hm₅]; exact hX₄.n, by rw [hm₅]; exact hX₄.inv, by rw [hm₅]; exact hX₄.one⟩
  obtain i05 : InScr B Z s.mem s₅.mem := InScr.of_frm fx₅ fun r hr => by
    rw [List.mem_singleton.mp hr]; simp only [xRange]; omega_arith
  -- `h`.
  obtain a1 : word s₅.mem B (8 * sWsP) = off B o := by rw [hb₅ _ (by unfold sWsP sFn; omega_arith)]; exact hslv
  obtain a2 : WsAt s₅.mem B o wx mx := by rw [hm₅]; exact hc₄.ws
  obtain a3 : wv s₅.mem (off B o) (slot wx Public.aY) wx < X := by rw [hm₅]; exact hlt₄
  obtain a5 : word s₅.mem (off B o) (8 * sMaskX) = mask c := by rw [hm₅, hM₄]; exact hmask
  obtain a6 : word s₅.mem B (8 * sQinv) = qp := by rw [hb₅ _ (by unfold sQinv sFn; omega_arith)]; exact hqp
  obtain a7 : word s₅.mem B (8 * sPlen) = BitVec.ofNat 64 qib.length := by
    rw [hb₅ _ (by unfold sPlen sFn; omega_arith), hql]; exact hel
  have := h_chain M hg₅ hw28 hlo hhi hwx2 hwx a1 a2 hX₅ hX1 a3 a5 a6 a7 (hqs.congrK i05 k05) (by omega_arith)
    (by omega_arith) hqw hqi
  rw [hql] at this
  exact this

/-- `pPhase_ok`'s hypotheses give `PO0`. -/
theorem o0_of (M : Mont) (E : CrtExpL M) {p : PPhasePub} {s : State} (h : PPre p s) : PO0 M E p s := by
  obtain ⟨⟨B, Z, w, minv, N, o, wx, ep, len⟩, oq, wq, qp⟩ := p
  dsimp only [PPre] at h
  obtain ⟨mx, mq, X, C, eb, qib, c, h⟩ := h
  sig_split h
  rename_i hg hw hw28 hlo hhi hqhi hwx2 hwx hwq hwq' hslv hws hslq hwsq hN hodd hN1 hXm hX hX1 hXodd
    hmask hc hep hel _ob1 hL1 hL2 he hqp hql hqs hqw
  obtain rfl := _ob1
  have hqi := h
  have hs := hg.scr
  have hn := hs.nowrap
  obtain h8 := hdr_lt_slot w 8 (show 31 < 32 by decide)
  obtain hX8 : 256 ≤ slot wx 8 := by unfold slot hdrBytes; omega_arith
  obtain hQ8 : 256 ≤ slot wq 8 := by unfold slot hdrBytes; omega_arith
  obtain hz : B.toNat + slot w 8 ≤ 2 ^ 64 := by omega_arith
  obtain hhi' : o + slot wx 8 + wsTab wx ≤ Z := by omega_arith
  obtain hsub : ∀ {rs : List (Nat × Nat)}, (∀ r ∈ rs, r ∈ pRanges w ++ [xRange o wx]) → ∀ {m m' : Mem},
      Frm B rs m m' → Frm B (pRanges w ++ [xRange o wx]) m m' := fun h _ _ f => f.mono h
  obtain sgx : ∀ r ∈ gRanges w ++ [xRange o wx], r ∈ pRanges w ++ [xRange o wx] := fun r hr =>
    (List.mem_append.mp hr).elim (fun h => List.mem_append_left _ (List.mem_append_left _ h))
      (fun h => List.mem_append_right _ h)
  obtain sp : ∀ r ∈ pRanges w, r ∈ pRanges w ++ [xRange o wx] := fun r hr => List.mem_append_left _ hr
  obtain sg : ∀ r ∈ gRanges w, r ∈ pRanges w ++ [xRange o wx] := fun r hr =>
    List.mem_append_left _ (List.mem_append_left _ hr)
  obtain hqh : ∀ {m m' : Mem}, Frm B (pRanges w ++ [xRange o wx]) m m' → ∀ i < 32,
      word m' (off B oq) (8 * i) = word m (off B oq) (8 * i) := fun f i hi => by
    rw [word_off, word_off]; exact f.px_above hlo (by omega_arith) (by omega_arith)
  -- `R_p mod p`.
  refine ⟨⟨mx, X, hg, hw, hw28, hlo, hhi', hwx2, hwx, by decide, by decide, by decide, hslv, hws, hN, hodd, hN1,
      hX, hX1, hXodd⟩,
    WP.mono (unitPhase_ok M hg hw hw28 hlo hhi' hwx2 hwx (sl := sWsP) (by decide) (by decide) (by decide) hslv
      hws hN hodd hN1 hX hX1 hXodd) fun s₁ ⟨hg₁, hws₁, hX₁, hlt₁, hG₁, hpl₁, hpy₁, hM₁, f₁, k₁⟩ => ?_⟩
  obtain f₁' := hsub sgx f₁
  obtain hN₁ := hN.of_frm f₁ hlo hz (by omega_arith)
  obtain hslq₁ : word s₁.mem B (8 * sWsQ) = off B oq := by
    rw [f₁'.px_hdr hlo (by decide) (by decide) (by decide)]; exact hslq
  obtain hwsq₁ : WsAt s₁.mem B oq wq mq := hwsq.of_words fun i hi => hqh f₁' i (by omega_arith)
  -- `m_q G mod N`.
  refine ⟨mq_chain M hg₁ hw hw28 hN₁ hslq₁ hwsq₁ (show slot w 8 ≤ oq by omega_arith) hqhi hwq hwq',
    WP.mono (mqPart_ok M hg₁ hw hw28 hN₁ hodd hlt₁ hG₁ hslq₁ hwsq₁ (show slot w 8 ≤ oq by omega_arith) hqhi hwq hwq')
    fun s₂ ⟨hg₂, _, hmq₂, hY₂, f₂, k₂⟩ => ?_⟩
  obtain f₂' := hsub sp f₂
  obtain f₀₂ := f₁'.trans f₂'
  obtain hN₂ : NVals s₂ B w minv N := by
    exact ⟨by rw [f₂'.px_wv hlo hz (by decide) (by decide) (by decide) (by decide) (by decide)]; exact hN₁.n,
      by rw [f₂'.px_word hlo hz (by decide) (by decide) (by decide) (by decide) (by decide)]; exact hN₁.inv,
      by rw [f₂'.px_wv hlo hz (by decide) (by decide) (by decide) (by decide) (by decide)]; exact hN₁.r2,
      by rw [f₂'.px_wv hlo hz (by decide) (by decide) (by decide) (by decide) (by decide)]; exact hN₁.r2lt,
      by rw [f₂'.px_wv hlo hz (by decide) (by decide) (by decide) (by decide) (by decide)]; exact hN₁.one⟩
  -- `c G mod N`.
  refine ⟨⟨minv, hg₂, show slot w 8 ≤ Z by omega_arith⟩,
    WP.mono (mmY_ok M hg₂ (by omega_arith) (by omega_arith) (by omega_arith) (a := Public.aXm) (by decide) (by decide)
      (by decide) hN₂ (by rw [hY₂]; exact hlt₁)) fun s₃ ⟨hg₃, _, hm₃, f₃, k₃⟩ => ?_⟩
  obtain f₃' := hsub sg f₃
  obtain f₀₃ := f₀₂.trans f₃'
  obtain hR : Nat.Coprime (2 ^ (64 * w)) N := VG.Proof.Bignum.coprime_pow2 hodd _
  obtain hXm₂ : wv s₂.mem B (slot w Public.aXm) w = wv s.mem B (slot w Public.aXm) w :=
    f₀₂.px_wv hlo hz (by decide) (by decide) (by decide) (by decide) (by decide)
  obtain hcg : wv s₃.mem B (slot w Public.aY) w % N = C * 2 ^ (64 * wx * (nChunks w wx + 1)) % N := by
    apply VG.Proof.Bignum.mont_cancel hR
    rw [hm₃, Nat.mul_mod, hXm₂, hXm, hY₂, hG₁, ← Nat.mul_mod]
    congr 1; ac_rfl
  obtain hpo : ∀ {m m' : Mem} {rs : List (Nat × Nat)}, Frm B rs m m' → (∀ r ∈ rs, r ∈ pRanges w) → ∀ d,
      o ≤ d → d + 8 ≤ 2 ^ 64 → word m' B d = word m B d := fun f hrs d hd hd' =>
    f.word_eq (fun r hr => Or.inr (by have := pRanges_le w r (hrs r hr); omega_arith)) hd'
  obtain hpw : ∀ {m m' : Mem} {rs : List (Nat × Nat)}, Frm B rs m m' → (∀ r ∈ rs, r ∈ pRanges w) → ∀ i < 32,
      word m' (off B o) (8 * i) = word m (off B o) (8 * i) := fun f hrs i hi => by
    rw [word_off, word_off]; exact hpo f hrs _ (by omega_arith) (by omega_arith)
  obtain sg' : ∀ r ∈ gRanges w, r ∈ pRanges w := fun r hr => List.mem_append_left _ hr
  obtain hpv : ∀ {m m' : Mem} {rs : List (Nat × Nat)}, Frm B rs m m' → (∀ r ∈ rs, r ∈ pRanges w) → ∀ d k,
      d + 8 * k ≤ slot wx 8 → wv m' (off B o) d k = wv m (off B o) d k := fun f hrs d k hd => by
    rw [wv_off, wv_off]; exact wv_congr fun i hi => hpo f hrs _ (by omega_arith) (by omega_arith)
  obtain hY8 := slot_le (w := wx) (show Public.aY < 8 by decide)
  obtain hpY₃ : wv s₃.mem (off B o) (slot wx Public.aY) wx = wv s₁.mem (off B o) (slot wx Public.aY) wx := by
    rw [hpv f₃ sg' _ _ (by omega_arith), hpv f₂ (fun r h => h) _ _ (by omega_arith)]
  obtain hws₃ : WsAt s₃.mem B o wx mx := hws₁.of_words fun i hi => by
    rw [hpw f₃ sg' i (by omega_arith), hpw f₂ (fun r h => h) i (by omega_arith)]
  obtain hX₃ : XVals s₃ B o wx mx X :=
    (hX₁.of_below f₂ (fun r hr => (pRanges_le w r hr).trans hlo) (by omega_arith)).of_below f₃
      (fun r hr => (pRanges_le w r (sg' r hr)).trans hlo) (by omega_arith)
  obtain i03 : InScr B Z s.mem s₃.mem := InScr.of_frm f₀₃ fun r hr => by have := pxR_bound hlo r hr; omega_arith
  obtain k03 := (k₁.trans k₂).trans k₃
  obtain hM₃ : word s₃.mem (off B o) (8 * sMaskX) = mask c := by
    rw [hpw f₃ sg' _ (by decide), hpw f₂ (fun r h => h) _ (by decide), hM₁]; exact hmask
  exact o3_of M E hg₃ hw28 hlo hhi' hwx2 hwx (by rw [f₀₃.px_hdr hlo (by decide) (by decide) (by decide)]; exact hslv)
    hws₃ hX₃ hX1 hXodd hcg (by rw [hpY₃]; exact hpl₁) (fun hd => by rw [hpY₃]; exact hpy₁ hd)
    (by rw [f₀₃.px_hdr hlo (by decide) (by decide) (by decide)]; exact hep)
    (by rw [f₀₃.px_hdr hlo (by decide) (by decide) (by decide)]; exact hel) hL1 hL2 (he.congrK i03 k03) hM₃
    (by rw [f₀₃.px_hdr hlo (by decide) (by decide) (by decide)]; exact hqp) hql (hqs.congrK i03 k03) hqw hqi

/-- `p`'s phase is constant time, given its pieces' claims. -/
theorem pPhase_ct (M : Mont) (E : CrtExpL M) (hU : UnitCT M sWsP) (hP : PowCT M E sWsP sDp sPlen) (hRX : RedcCT M Public.aX)
    (hL : LoadCT aChunk sQinv sPlen) : PPhaseCT M E := by
  unfold PPhaseCT
  refine two_map id (fun _ _ h => o0_of M E h) ?_
  rw [pPhase_eq]
  refine ct_steps (by simp [unitSteps]) (by simp [mqSteps]) PPhasePub.u (fun _ _ h => h.1) (fun _ _ h => h.2)
    hU ?_
  refine ct_steps (by simp [mqSteps]) (by simp) PPhasePub.mq (fun _ _ h => h.1) (fun _ _ h => h.2) (mq_ct M) ?_
  refine ct_steps (by simp) (by simp [powSteps]) PPhasePub.nw (fun _ _ h => h.1) (fun _ _ h => h.2)
    (M.ct (by unfold MmUse; decide)) ?_
  refine ct_steps (by simp [powSteps]) (by simp) PPhasePub.pw (fun _ _ h => h.1) (fun _ _ h => h.2) hP ?_
  refine RelCT.seqs_app (by simp) (by simp [hSteps]) (ct_taint [.rdi] (fun p s₁ s₂ h₁ h₂ r hr => by
      simp only [List.mem_singleton] at hr; subst hr; rw [h₁.1, h₂.1]) (by taint_decide) (fun _ _ h => h.2) ?_)
  exact two_map PPhasePub.h (fun _ _ h => h) (h_ct M hRX hL)

end VG.Proof.Bignum.X86_64

end

end

/-! ### `Bignum.X86_64.CrtCTFin`, which this module and modules that import it used -/

section

/-!
# RSA with the CRT on x86-64: the result in constant time

`finish` sums `m_q + q h` into the modulus' accumulators (`finishSum`), whose
parts keep the header and the primes' workspaces (`FA`), and stores it masked
(`outArr_ct`): `crtFinish_ct`.
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public VG.Impl.Rsa.X86_64
open VG.Proof.MlKem.X86_64

/-- What `finishSum`'s parts need, which they keep: the workspaces, `m_q`'s
base and the sizes. -/
def FA (p : RowsPub) (s : State) : Prop :=
  GoodW ⟨p.B, p.Z, p.w⟩ s ∧ RowsPre aY p s ∧
    word s.mem (off p.B p.oq) (8 * sArr aY) = off p.B (p.oq + slot p.wq aY) ∧ 1 ≤ p.wq ∧ p.wq ≤ p.w ∧
    p.w < 2 ^ 29

/-- `FA` after changes to the modulus' accumulators only. -/
theorem FA.outside {p : RowsPub} {s t : State} (h : FA p s) {n : Nat} (ho : Outside p.B (slot p.w aAcc) n s.mem t.mem)
    (hn : n ≤ 8 * (2 * p.w + 2)) {regs : List Reg} (k : Keep regs s t) (hr : .rdi ∉ regs) : FA p t := by
  obtain ⟨⟨minv, hg, hZ⟩, ⟨hs, hdi, hacc, hp, hq, hpw, hqw, hpa, hqa, hja, hlo, hop, hoq⟩, hqy, hwq, hwq', hw⟩ := h
  have hZ' : slot p.w 8 ≤ p.Z := hZ
  have hnw := hs.nowrap
  have eW : sW = 6 := rfl
  have eN : sArr aN = 8 := rfl
  have eY : sArr aY = 14 := rfl
  have hA := accs_le p.w
  have hh : ∀ i < 32, word t.mem p.B (8 * i) = word s.mem p.B (8 * i) := fun i hi =>
    ho.word (Or.inl (by have := hdr_lt_slot p.w aAcc hi; omega_arith)) (by omega_arith)
  have hab : ∀ {o d : Nat}, slot p.w 8 ≤ o → o + d + 8 ≤ 2 ^ 64 → word t.mem (off p.B o) d = word s.mem (off p.B o) d :=
    fun h1 h2 => word_above ho (by omega_arith) h2
  have h8p := hdr_lt_slot p.wp 8 (show 31 < 32 by decide)
  have h8q := hdr_lt_slot p.wq 8 (show 31 < 32 by decide)
  exact ⟨⟨minv, ⟨hg.scr.congr k.2.2, (k.gpr hr).trans hg.rdi, hg.hdr.of_outside ho (by
      unfold slot; omega_arith)⟩, hZ⟩,
    ⟨hs.congr k.2.2, (k.gpr hr).trans hdi, (hh _ (by decide)).trans hacc, (hh _ (by decide)).trans hp,
      (hh _ (by decide)).trans hq, (hab hlo (by omega_arith)).trans hpw, (hab (by omega_arith) (by omega_arith)).trans hqw,
      (hab hlo (by unfold sArr; omega_arith)).trans hpa, (hab (by omega_arith) (by omega_arith)).trans hqa, hja, hlo, hop, hoq⟩,
    (hab (by omega_arith) (by omega_arith)).trans hqy, hwq, hwq', hw⟩

/-- `finishSum`'s copy of `m_q`, in two parts: `q`'s workspace's base, then
its header through it. -/
theorem finishCopy_split : finishCopy = ([.mov .rax (.mem (hdr Crt.sWsQ))] : List Instr) ++
    ([.mov .rsi (.mem (Crt.ws .rax (sArr aY))), .mov .r12 (.mem (Crt.ws .rax sW)),
      .mov .rbx (.mem (hdr (sArr aAcc)))] : List Instr) := rfl

/-- After the copy's loads. -/
def FC (p : RowsPub) (s : State) : Prop :=
  FA p s ∧ s.gpr .rsi = off p.B (p.oq + slot p.wq aY) ∧ s.gpr .r12 = BitVec.ofNat 64 p.wq ∧
    s.gpr .rbx = off p.B (slot p.w aAcc)

/-- `finishSum` leaks the same in runs that agree on the workspaces. -/
theorem finSum_ct : RelCT isa (Two FA) (seqs finishSum) fun _ _ => True := by
  unfold finishSum
  refine RelCT.seqs_append (by simp [Crt.zeroAccs]) (by simp) (RelCT.seq (R := Two FA) ?_ ?_)
  · refine two_post (two_map (fun p : RowsPub => (⟨p.B, p.Z, p.w⟩ : Ws)) (fun _ _ h => h.1) zeroAccs_ct)
      fun p s h => ?_
    obtain ⟨⟨minv, hg, hZ⟩, -, -, -, -, hw⟩ := id h
    exact WP.mono (zeroAccs_ok hg hZ (show p.w < 2 ^ 30 by omega_arith)) fun t ⟨_, ho, k⟩ =>
      h.outside ho (Nat.le_refl _) k (by decide)
  simp only [seqs]
  refine RelCT.seq (R := Two FC) ?_ (RelCT.seq (R := Two FA) ?_
    (two_map id (fun _ _ h => h.2.1) (rows_ct (ja := aY) (by taint_decide))))
  · rw [finishCopy_split]
    refine RelCT.block_append (RelCT.seq (R := Two fun (p : RowsPub) t => FA p t ∧ t.gpr .rax = off p.B p.oq)
      (two_piece [.rdi] (pins_of (fun p _ => p.B) fun p s h r hr => by
        simp only [List.mem_singleton] at hr; subst hr; exact h.2.1.2.1) (by taint_decide) fun p s h => ?_)
      (two_piece [.rdi, .rax] (pins_of (fun p r => if r = .rdi then p.B else off p.B p.oq) fun p s h r hr => by
        simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
        rcases hr with rfl | rfl
        · exact h.1.2.1.2.1
        · exact h.2) (by taint_decide) fun p s h => ?_))
    · obtain ⟨hl, -, -⟩ := h.2.1.hl
      obtain ⟨-, ⟨-, hdi, -, -, hq, -⟩, -⟩ := id h
      exact WP.mono (WP.keep [.rax] (Q := fun t => t.gpr .rax = off p.B p.oq ∧ t.mem = s.mem)
        (by xrun [State.ea, hdr, hdi, hdrOff, hl Crt.sWsQ (by decide), hq]) rfl)
        fun t ⟨⟨hax, hm⟩, k⟩ => ⟨h.outside (n := 0) (by rw [hm]; exact Outside.refl _ _ _ _) (by omega_arith) k
          (by decide), hax⟩
    · obtain ⟨h, hax⟩ := h
      obtain ⟨hl, -, hlq⟩ := h.2.1.hl
      obtain ⟨-, ⟨-, hdi, hacc, -, -, -, hqw, -⟩, hqy, -⟩ := id h
      exact WP.mono (WP.keep [.rsi, .r12, .rbx] (Q := fun t => t.gpr .rsi = off p.B (p.oq + slot p.wq aY) ∧
          t.gpr .r12 = BitVec.ofNat 64 p.wq ∧ t.gpr .rbx = off p.B (slot p.w aAcc) ∧ t.mem = s.mem)
        (by xrun [State.ea, hdr, Crt.ws, hdi, hax, hdrOff, hl (sArr aAcc) (by decide),
          hlq (sArr aY) (by decide), hlq sW (by decide), hqy, hqw, hacc]) rfl)
        fun t ⟨⟨hsi, h12, hbx, hm⟩, k⟩ => ⟨h.outside (n := 0) (by rw [hm]; exact Outside.refl _ _ _ _) (by omega_arith) k
          (by decide), hsi, h12, hbx⟩
  · refine two_post (two_taint [.rsi, .rbx, .r12] (pins_of (fun p r => if r = .rsi then off p.B (p.oq + slot p.wq aY)
        else if r = .rbx then off p.B (slot p.w aAcc) else BitVec.ofNat 64 p.wq) fun p s h r hr => by
          simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
          rcases hr with rfl | rfl | rfl
          · exact h.2.1
          · exact h.2.2.2
          · exact h.2.2.1) (by taint_decide)) fun p s h => ?_
    obtain ⟨hf, hsi, h12, hbx⟩ := h
    obtain ⟨-, ⟨hs, -, -, -, -, -, -, -, -, -, hlo, hop, hoq⟩, -, hwq, hwq', hw⟩ := id hf
    have hn := hs.nowrap
    have hA := accs_le p.w
    have hqY := slot_le (w := p.wq) (show aY < 8 by decide)
    refine WP.mono (copyWords_ok hsi hbx h12 hwq (by omega_arith) (by omega_arith)
      (fun j hj => hs.ld (by omega_arith)) (fun j hj => hs.st (by omega_arith))
      (fun j hj b hb => by rw [ofs_off p.B (by omega_arith)]; omega_arith)) fun t ⟨_, _, ho, k⟩ =>
        hf.outside ho (by omega_arith) k (by decide)

/-- `finishSum`'s hypotheses after `p`'s phase. -/
theorem stage5_fa {p : CrtPub} {t : State} (h : Stage R5 p t) :
    FA ⟨p.B, p.Z, p.w, offP p.w, offQ p.w p.pl, wsWords p.pl, wsWords p.ql⟩ t := by
  unfold CrtPub.w
  obtain ⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, minv, mp, mq, hr⟩ := h
  have hk1 := h.k1
  have hk2 := h.k2
  have hpl2 := h.pl2
  have hql2 := h.ql2
  have hZq := h.z
  have hP8 : 256 ≤ slot (wsWords p.pl) 8 := by unfold slot hdrBytes; omega_arith
  have hQ8 : 256 ≤ slot (wsWords p.ql) 8 := by unfold slot hdrBytes; omega_arith
  have hwq2 : 2 ≤ wsWords p.ql := by unfold wsWords; omega_arith
  have hwq := wsWords_le (len := p.ql) (w := (p.k + 7) / 8) (by omega_arith) (by omega_arith)
  have hZ : slot ((p.k + 7) / 8) 8 ≤ p.Z := by unfold offQ at hZq; omega_arith
  unfold FA RowsPre
  dsimp only
  exact ⟨⟨minv, hr.good, hZ⟩, ⟨hr.good.scr, hr.good.rdi, hr.good.hdr.harr aAcc (by decide), hr.wsP, hr.wsQ,
      hr.pws.hdr.hw, hr.qws.hdr.hw, by rw [hr.pws.hdr.harr _ (by decide), off_off],
      by rw [hr.qws.hdr.harr _ (by decide), off_off], by decide, Nat.le_refl _, by unfold offQ offP; omega_arith, by omega_arith⟩,
    by rw [hr.qws.hdr.harr _ (by decide), off_off], by omega_arith, hwq, by omega_arith⟩

/-- `finishSum` leaves what the store needs. -/
theorem finSum_out {p : CrtPub} {t₂ : State} (h : Stage R5 p t₂) :
    WP isa (seqs finishSum) t₂ (OPreW ⟨p.B, p.Z, p.w, p.k, p.op⟩) := by
  have hfa := stage5_fa h
  obtain ⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, minv, mp, mq, hr⟩ := h
  obtain ⟨-, ⟨-, -, -, -, -, -, -, -, -, -, hlo, hop, hoq⟩, -, hwq, hwq', hw⟩ := hfa
  have hk1 := h.k1
  have hk2 := h.k2
  have hpl2 := h.pl2
  have hpl1 := h.pl1
  have hZq := h.z
  have hn := hr.good.scr.nowrap
  have hwp2 : 2 ≤ wsWords p.pl := by unfold wsWords; omega_arith
  have hwp := wsWords_le (len := p.pl) (w := (p.k + 7) / 8) (by omega_arith) (by omega_arith)
  have hZ : slot ((p.k + 7) / 8) 8 ≤ p.Z := by unfold offQ at hZq; omega_arith
  refine WP.mono (finishSum_ok hr.good (by unfold CrtPub.w at hw; omega_arith) hr.wsP hr.wsQ hr.pws.hdr.hw hr.qws.hdr.hw
    (by rw [hr.pws.hdr.harr _ (by decide), off_off]) (by rw [hr.qws.hdr.harr _ (by decide), off_off])
    (by rw [hr.qws.hdr.harr _ (by decide), off_off]) hlo (by unfold offQ offP; omega_arith) hZq (by omega_arith) hwp (by omega_arith) hwq')
    fun t₃ ⟨_, ho₃, k₃⟩ => ?_
  have hacc := accs_le ((p.k + 7) / 8)
  have hb₃ : ∀ i < 32, word t₃.mem p.B (8 * i) = word t₂.mem p.B (8 * i) := fun i hi =>
    ho₃.word (Or.inl (by have := hdr_lt_slot ((p.k + 7) / 8) Public.aAcc hi; omega_arith)) (by omega_arith)
  have hfx : ∀ i < 32, hFixed i = true → word t₃.mem p.B (8 * i) = word σ.mem p.B (8 * i) := fun i hi hf => by
    rw [hb₃ i hi]; exact hr.hfix i hi hf
  have k03 := hr.keep.trans k₃
  unfold OPreW OPre
  dsimp only
  exact ⟨minv, p.mask xb pb qb qib, ⟨hr.good.scr.congr k₃.2.2, (k₃.gpr (by decide)).trans hr.good.rdi,
      ⟨(hb₃ _ (by decide)).trans hr.good.hdr.hw, (hb₃ _ (by decide)).trans hr.good.hdr.hminv,
        fun j hj => (hb₃ _ (by unfold sArr; omega_arith)).trans (hr.good.hdr.harr j hj)⟩⟩, rfl, hZ, by omega_arith,
    by omega_arith, by rw [hfx _ (by decide) (by decide)]; exact h.hO, by rw [hfx _ (by decide) (by decide)]; exact h.hK,
    by rw [hb₃ _ (by decide)]; exact hr.msk, fun j hj => by rw [k03.2.2]; exact h.out j hj, h.outSep⟩

/-- `finish` leaks the same in runs that agree on the public data. -/
theorem crtFinish_ct : RelCT isa (Two (Stage R5)) (seqs Crt.finish) fun _ _ => True := by
  rw [finish_out]
  refine RelCT.seqs_append (by simp [finishSum, Crt.zeroAccs]) (by simp [outStepsArr])
    (RelCT.seq (R := Two OPreW) ?_ (outArr_ct (j := Public.aAcc) (by decide) (by taint_decide)))
  refine (two_post (Ψ := fun (p : CrtPub) t => OPreW ⟨p.B, p.Z, p.w, p.k, p.op⟩ t)
    (two_map (fun p : CrtPub => (⟨p.B, p.Z, p.w, offP p.w, offQ p.w p.pl, wsWords p.pl, wsWords p.ql⟩ : RowsPub))
      (fun _ _ h => stage5_fa h) finSum_ct) fun p t h => finSum_out h).mono (fun _ _ h => h)
    fun _ _ h => two_bind (fun (p : CrtPub) _ _ h₁ h₂ => ⟨(⟨p.B, p.Z, p.w, p.k, p.op⟩ : OPubW), h₁, h₂⟩) h

end VG.Proof.Bignum.X86_64

end

end

/-! ### `Bignum.X86_64.CrtPreCode`, which only this module used -/

section

/-!
# RSA with the CRT on x86-64, with the key's precomputed values: correctness

`Crt.codeP` is `Crt.code` with `R² mod n` copied from the key's precomputed
values `pre` (`r2Pre`) and without the check of `p q = n` (`checksP`),
which `crtContractP` requires `pre` to be `privatePrecompute`'s, and so
implies: from a state that contract allows, it writes
`privateCrt` of its inputs, as `Crt.code` does (`crtCodeP_correct`).
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Bignum.X86_64.Public VG.Impl.Rsa.X86_64 VG.Impl.Rsa.X86_64.Crt
open VG.Proof.MlKem.X86_64

/-! ## `main` -/

theorem nSetupP_eq (M : Mont) : nSetupP M.mm =
    (loadSteps ++ restSteps) ++ ([r2Pre] ++ [M.mm Public.aXm Public.aX Public.aR2]) := rfl

/-- `n`'s setup with `R² mod n` from `pre`, for a valid modulus. -/
theorem nPartP_ok (M : Mont) {s : State} {B : Addr} {Z k : Nat} {op np ip pp qp dpp dqp qip : Addr} {pl ql : Nat}
    {nb xb pb qb dpb dqb qib : List Byte}
    (h : CrtPre s B Z k op np ip pp qp dpp dqp qip pl ql nb xb pb qb dpb dqb qib)
    (hv : Spec.Rsa.modulusValid (Spec.Rsa.os2ip nb) k = true)
    (hp : PreR2 s B Z ((k + 7) / 8) (Spec.Rsa.os2ip nb)) :
    WP isa (seqs (nSetupP M.mm)) s fun t => ∃ minv,
      NReady s t B Z ((k + 7) / 8) minv (Spec.Rsa.os2ip nb) (Spec.Rsa.os2ip xb) := by
  obtain ⟨hodd, -, -⟩ := valid_facts hv h.k1
  have hk1 := h.k1
  have hk2 := h.k2
  have hZq := h.z
  have hZ : slot ((k + 7) / 8) 8 ≤ Z := by unfold offQ at hZq; omega_arith
  rw [nSetupP_eq]
  exact nPartWith_ok M _ h hv fun t₁ minv so hi k₁ =>
    r2Pre_ok so.good hZ (by omega_arith) (by omega_arith) so.r12 (by omega_arith)
      (hp.congr hi (k₁.gpr (by decide)) k₁.2.1 k₁.2.2)

/-- Up to the checks, for a valid modulus, with `R² mod n` from `pre`. -/
theorem frontP_ok (M : Mont) {s : State} {B : Addr} {Z k : Nat} {op np ip pp qp dpp dqp qip : Addr} {pl ql : Nat}
    {nb xb pb qb dpb dqb qib : List Byte}
    (h : CrtPre s B Z k op np ip pp qp dpp dqp qip pl ql nb xb pb qb dpb dqb qib)
    (hv : Spec.Rsa.modulusValid (Spec.Rsa.os2ip nb) k = true)
    (hp : PreR2 s B Z ((k + 7) / 8) (Spec.Rsa.os2ip nb))
    (hpq : Spec.Rsa.os2ip pb * Spec.Rsa.os2ip qb = Spec.Rsa.os2ip nb) :
    WP isa (seqs (nSetupP M.mm ++ primesSetup ++ checksP)) s fun t => ∃ minv mp mq,
      CrtReady s t B Z ((k + 7) / 8) pl ql minv mp mq (Spec.Rsa.os2ip nb) (Spec.Rsa.os2ip xb)
        (Spec.Rsa.os2ip pb) (Spec.Rsa.os2ip qb)
        (keyMask (decide (Spec.Rsa.os2ip xb < Spec.Rsa.os2ip nb)) (Spec.Rsa.os2ip nb) (Spec.Rsa.os2ip pb)
          (Spec.Rsa.os2ip qb) (Spec.Rsa.os2ip qib)) :=
  wp_seqs_append (by simp [nSetupP]) (by simp [checksP]) (wp_seqs_append (by simp [nSetupP])
    (by simp [primesSetup]) (WP.mono (nPartP_ok M h hv hp) fun _ ⟨minv, hr⟩ =>
      WP.mono (setupPart_ok h hr) fun _ ⟨_, _, hr'⟩ =>
        WP.mono (checksPartP_ok h hv hr' hpq) fun _ ⟨mp', mq', hr''⟩ => ⟨minv, mp', mq', hr''⟩))

theorem crtMainP_eq (mul : Nat → Nat → Nat → Prog isa) (ex : Nat → Nat → List (Prog isa)) :
    Crt.mainP mul ex = seqs ((nSetupP mul ++ primesSetup ++ checksP) ++ (qPhase mul ex ++ pPhase mul ex ++ finish)) := by
  simp only [Crt.mainP, List.append_assoc]

/-- `mainP`, for a valid modulus: as `crtMain_ok`. -/
theorem crtMainP_ok (M : Mont) (E : CrtExpL M) {s : State} {B : Addr} {Z k : Nat} {op np ip pp qp dpp dqp qip : Addr}
    {pl ql : Nat} {nb xb pb qb dpb dqb qib : List Byte}
    (h : CrtPre s B Z k op np ip pp qp dpp dqp qip pl ql nb xb pb qb dpb dqb qib)
    (hv : Spec.Rsa.modulusValid (Spec.Rsa.os2ip nb) k = true)
    (hp : PreR2 s B Z ((k + 7) / 8) (Spec.Rsa.os2ip nb))
    (hpq : Spec.Rsa.os2ip pb * Spec.Rsa.os2ip qb = Spec.Rsa.os2ip nb) :
    WP isa (Crt.mainP M.mm E.code) s fun t => ∃ Mk : Bool, MainPost s t B Z k op
      (if Mk then crtResult (Spec.Rsa.os2ip pb) (Spec.Rsa.os2ip qb) (Spec.Rsa.os2ip dpb) (Spec.Rsa.os2ip dqb)
        (Spec.Rsa.os2ip qib) (Spec.Rsa.os2ip xb) else 0) Mk ∧
      (Mk = true ↔ Spec.Rsa.os2ip xb < Spec.Rsa.os2ip nb ∧ Spec.Rsa.os2ip pb * Spec.Rsa.os2ip qb =
        Spec.Rsa.os2ip nb ∧ Spec.Rsa.os2ip qib < Spec.Rsa.os2ip pb) := by
  rw [crtMainP_eq]
  refine wp_seqs_append (by simp [nSetupP]) (by simp [qPhase]) (WP.mono (frontP_ok M h hv hp hpq)
    fun t₀ ⟨minv, mp, mq, hr⟩ => WP.mono (back_ok M E h hv hr rfl) fun t ht => ⟨_, ht, ?_⟩)
  simp only [keyMask, Bool.and_eq_true, decide_eq_true_eq, and_assoc]

/-! ## The precondition -/

/-- What `Crt.codeP` uses of its contract's precondition: `Crt.code`'s
(`CrtCtx`), and `R² mod n` in `pre` (`PreR2`), for a valid modulus. -/
theorem crtCtxP_of {s : State} (h : crtContractP.pre s) :
    CrtCtx s ∧ Spec.Rsa.modulusValid (Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (s.gpr .rdx) (s.gpr .rcx).toNat))
      (s.gpr .rcx).toNat = true ∧
    PreR2 s (stackArg s 10) ((stackArg s 11).toNat * 8) (((s.gpr .rcx).toNat + 7) / 8)
      (Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (s.gpr .rdx) (s.gpr .rcx).toNat)) ∧
    Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (stackArg s 0) (stackArg s 1).toNat) *
      Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (stackArg s 2) (stackArg s 3).toNat) =
      Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (s.gpr .rdx) (s.gpr .rcx).toNat) := by
  simp only [crtContractP] at h
  sig_split h
  rename_i hsp hrd hwr dOn dOi dOp dOq dOdp dOdq dOqi dOpr dOs dOa dns dis dps dqs ddps ddqs dqis dprs dsa
    dRo dRn dRi dRp dRq dRdp dRdq dRqi dRpr dRs dRa wO wN wI wP wQ wDp wDq wQi wS wPr hk hol hil hpl1 hpl2
    hql1 hql2 hdpl hqil hdql hsl hprl
  obtain ⟨hk1, hk2⟩ := hk
  unfold Spec.Rsa.scratchWords at hsl
  have hs : Scr s (stackArg s 10) ((stackArg s 11).toNat * 8) := Scr.of_mem (by rw [hwr]; simp) wS
  have hn := hs.nowrap
  have hargs : (⟨stackArgAddr s 0, 112⟩ : Region) ∈ s.rd ++ s.wr := by rw [hrd]; simp
  have hpre : (⟨stackArg s 12, (stackArg s 13).toNat * 8⟩ : Region) ∈ s.rd ++ s.wr := by rw [hrd]; simp
  have hpq := VG.Proof.Rsa.privatePrecompute_mul h
  have hpub := VG.Proof.Rsa.privatePrecompute_public h
  rw [bytesAt_length, Spec.Rsa.precomputedWords, Spec.Rsa.modulusWords] at hpub
  obtain ⟨hv, -, hval⟩ := pre_of_some (bytesAt_length _ _ _) hk1 hpub
  have hw2 : 2 * (((s.gpr .rcx).toNat + 7) / 8) ≤ (stackArg s 13).toNat := by
    rw [hprl]; unfold Spec.Rsa.privatePrecomputedWords Spec.Rsa.precomputedWords Spec.Rsa.modulusWords; omega_using []
  have hoff : ∀ d b : Nat, off (stackArg s 12) d + BitVec.ofNat 64 b = stackArg s 12 + BitVec.ofNat 64 (d + b) := by
    intro d b; simp only [off, BitVec.add_assoc, BitVec.ofNat_add_ofNat]
  refine ⟨⟨hk1, hk2, hpl1, hpl2, hql1, hql2, by omega_arith, hs,
    fun j hj => ⟨_, hargs, by rw [stackArgAddr_eq s j]; exact Offset.contains_base _ (by omega_arith) (by omega_arith)⟩,
    fun j hj m' ho => Mem.readW_congr fun b hb => ho _ (Or.inr (by
      have := out_scr dsa.symm (contains_byte (stackArgAddr s 0) (i := 8 * j + b) (len := 112) (by omega_arith) (by omega_arith))
      rw [← stackArgAddr_add s j b] at this; omega_arith)),
    src_of_region (by rw [hrd]; simp) (by omega_arith) dns,
    src_of_region (by rw [hrd, ← hil]; simp) (by omega_arith) (by rw [← hil]; exact dis),
    src_of_region (by rw [hrd]; simp) (by omega_arith) dps,
    src_of_region (by rw [hrd]; simp) (by omega_arith) dqs,
    src_of_region (by rw [hrd, ← hdpl]; simp) (by omega_arith) (by rw [← hdpl]; exact ddps),
    src_of_region (by rw [hrd, ← hdql]; simp) (by omega_arith) (by rw [← hdql]; exact ddqs),
    src_of_region (by rw [hrd, ← hqil]; simp) (by omega_arith) (by rw [← hqil]; exact dqis),
    fun j hj => ⟨_, by rw [hwr]; exact List.mem_cons_self, contains_byte _ (by omega_arith) (by omega_arith)⟩,
    fun j hj => out_scr dOs (contains_byte _ (by omega_arith) (by omega_arith)), fun b hb => ?_⟩, hv,
    ⟨⟨_, hargs, by rw [stackArgAddr_eq s 12]; exact Offset.contains_base _ (by omega_arith) (by omega_arith)⟩,
    fun b hb => by
      have := out_scr dsa.symm (contains_byte (stackArgAddr s 0) (i := 8 * 12 + b) (len := 112) (by omega_arith) (by omega_arith))
      rw [← stackArgAddr_add s 12 b] at this; exact this,
    fun j hj => ⟨_, hpre, Offset.contains_base _ (by omega_arith) (by omega_arith)⟩,
    fun j hj b hb => by
      rw [hoff]; exact out_scr dprs (contains_byte _ (by omega_arith) (by omega_arith)),
    by rw [hval]⟩, hpq⟩
  have hc := contains_byte (s.gpr .rsp) (i := b) (len := 8) (by omega_arith) (by omega_arith)
  exact ⟨out_scr dRs hc, fun j hj he => dRo _ hc (by rw [he]; exact contains_byte _ (by omega_arith) (by omega_arith))⟩

/-- `wordsAt`'s words, `toWords V n`, as the number `V`. -/
theorem wv_of_toWords {m : Mem} {p : Addr} {c n V : Nat}
    (h : Spec.Rsa.wordsAt m (p + BitVec.ofNat 64 (8 * c)) n = Spec.Rsa.toWords V n) (hV : V < 2 ^ (64 * n)) :
    wv m p (8 * c) n = V := by
  rw [← Nat.mod_eq_of_lt hV]
  refine wv_of_words fun i hi => ?_
  have := congrArg (fun l => l[i]?) h
  simp only [Spec.Rsa.wordsAt, Spec.Rsa.toWords, List.getElem?_map, List.getElem?_range hi, Option.map_some,
    Option.some.injEq] at this
  show (m.readW (p + BitVec.ofNat 64 (8 * c + 8 * i)) 64).toNat = _
  rw [← BitVec.ofNat_add_ofNat, ← BitVec.add_assoc, this, BitVec.toNat_ofNat]

/-- `n` words of `pre` from `k`, of the `L` it has, outside the working space. -/
theorem preW_of {s : State} {B : Addr} {Z k n V L : Nat}
    (hargs : (⟨stackArgAddr s 0, 112⟩ : Region) ∈ s.rd ++ s.wr)
    (hpre : (⟨stackArg s 12, L * 8⟩ : Region) ∈ s.rd ++ s.wr) (wPr : (stackArg s 12).toNat + L * 8 ≤ 2 ^ 64)
    (hkn : k + n ≤ L) (dprs : (⟨stackArg s 12, L * 8⟩ : Region).Disjoint ⟨B, Z⟩)
    (dsa : (⟨B, Z⟩ : Region).Disjoint ⟨stackArgAddr s 0, 112⟩)
    (hv : wv s.mem (stackArg s 12) (8 * k) n = V) : PreW s B Z k n V := by
  have hoff : ∀ d b : Nat, off (stackArg s 12) d + BitVec.ofNat 64 b = stackArg s 12 + BitVec.ofNat 64 (d + b) := by
    intro d b; simp only [off, BitVec.add_assoc, BitVec.ofNat_add_ofNat]
  refine ⟨⟨_, hargs, by rw [stackArgAddr_eq s 12]; exact Offset.contains_base _ (by omega_arith) (by omega_arith)⟩,
    fun b hb => ?_, fun j hj => ⟨_, hpre, Offset.contains_base _ (by omega_arith) (by omega_arith)⟩,
    fun j hj b hb => by rw [hoff]; exact out_scr dprs (contains_byte _ (by omega_arith) (by omega_arith)), hv⟩
  have := out_scr dsa.symm (contains_byte (stackArgAddr s 0) (i := 8 * 12 + b) (len := 112) (by omega_arith) (by omega_arith))
  rw [← stackArgAddr_add s 12 b] at this; exact this

/-- `R_p² mod p` and `R_q² mod q` in `pre`, after the modulus' values (`PreW`). -/
theorem crtPrimes_of {s : State} (h : crtContractP.pre s) :
    PreW s (stackArg s 10) ((stackArg s 11).toNat * 8) (2 * (((s.gpr .rcx).toNat + 7) / 8))
      (Spec.Rsa.primeWords (stackArg s 1).toNat)
      (2 ^ (128 * Spec.Rsa.primeWords (stackArg s 1).toNat) %
        Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (stackArg s 0) (stackArg s 1).toNat)) ∧
    PreW s (stackArg s 10) ((stackArg s 11).toNat * 8)
      (2 * (((s.gpr .rcx).toNat + 7) / 8) + Spec.Rsa.primeWords (stackArg s 1).toNat)
      (Spec.Rsa.primeWords (stackArg s 3).toNat)
      (2 ^ (128 * Spec.Rsa.primeWords (stackArg s 3).toNat) %
        Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (stackArg s 2) (stackArg s 3).toNat)) := by
  obtain ⟨c, hv, -, hpq⟩ := crtCtxP_of h
  have hk1 := c.hk1
  simp only [crtContractP] at h
  sig_split h
  rename_i hsp hrd hwr dOn dOi dOp dOq dOdp dOdq dOqi dOpr dOs dOa dns dis dps dqs ddps ddqs dqis dprs dsa
    dRo dRn dRi dRp dRq dRdp dRdq dRqi dRpr dRs dRa wO wN wI wP wQ wDp wDq wQi wS wPr hk hol hil hpl1 hpl2
    hql1 hql2 hdpl hqil hdql hsl hprl
  have hargs : (⟨stackArgAddr s 0, 112⟩ : Region) ∈ s.rd ++ s.wr := by rw [hrd]; simp
  have hpre : (⟨stackArg s 12, (stackArg s 13).toNat * 8⟩ : Region) ∈ s.rd ++ s.wr := by rw [hrd]; simp
  obtain ⟨eP, eQ⟩ := VG.Proof.Rsa.privatePrecompute_primes (m := s.mem) (pre := stackArg s 12)
    (nB := Spec.Rsa.bytesAt s.mem (s.gpr .rdx) (s.gpr .rcx).toNat)
    (pB := Spec.Rsa.bytesAt s.mem (stackArg s 0) (stackArg s 1).toNat)
    (qB := Spec.Rsa.bytesAt s.mem (stackArg s 2) (stackArg s 3).toNat)
    (by rw [bytesAt_length, bytesAt_length, bytesAt_length, ← hprl]; exact h)
  unfold Spec.Rsa.primeR2 at eP eQ
  rw [bytesAt_length, bytesAt_length, Spec.Rsa.precomputedWords, Spec.Rsa.modulusWords] at eP eQ
  rw [bytesAt_length] at eQ
  have hw : (stackArg s 13).toNat = 2 * (((s.gpr .rcx).toNat + 7) / 8) + Spec.Rsa.primeWords (stackArg s 1).toNat +
      Spec.Rsa.primeWords (stackArg s 3).toNat := by
    rw [hprl]; unfold Spec.Rsa.privatePrecomputedWords Spec.Rsa.precomputedWords Spec.Rsa.modulusWords; rfl
  have hN0 : Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (s.gpr .rdx) (s.gpr .rcx).toNat) ≠ 0 := by
    have := (valid_facts hv hk1).2.1; omega_arith
  clear dOn dOi dOp dOq dOdp dOdq dOqi dOpr dOs dOa dns dis dps dqs ddps ddqs dqis
    dRo dRn dRi dRp dRq dRdp dRdq dRqi dRpr dRs dRa wO wN wI wP wQ wDp wDq wQi wS hk hol hil hpl1
    hql1 hdpl hqil hdql hsl hprl h c
  have hlt : ∀ {l : Nat} (pa : Addr), l < (s.gpr .rcx).toNat → 0 < Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem pa l) →
      2 ^ (128 * Spec.Rsa.primeWords l) % Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem pa l) <
        2 ^ (64 * Spec.Rsa.primeWords l) := fun {l} pa _ h0 => by
    refine Nat.lt_of_lt_of_le (Nat.mod_lt _ h0) (Nat.le_trans
      (Nat.le_of_lt (show Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem pa l) < 2 ^ (8 * l) from ?_))
      (Nat.pow_le_pow_right (by decide) (by unfold Spec.Rsa.primeWords Spec.Rsa.modulusWords; omega_using [])))
    have := os2ip_lt (Spec.Rsa.bytesAt s.mem pa l)
    rwa [bytesAt_length, pow256_eq] at this
  rw [hw] at hpre dprs wPr
  refine ⟨preW_of hargs hpre wPr (by omega_using []) dprs dsa (wv_of_toWords eP (hlt _ hpl2 ?_)),
    preW_of hargs hpre wPr (by omega_using []) dprs dsa (wv_of_toWords eQ (hlt _ hql2 ?_))⟩
  · exact Nat.pos_of_ne_zero fun h0 => hN0 (by rw [← hpq, h0, Nat.zero_mul])
  · exact Nat.pos_of_ne_zero fun h0 => hN0 (by rw [← hpq, h0, Nat.mul_zero])

/-! ## The code -/

/-- `vg_rsa_private_crt_precomputed` with Montgomery multiplication `M`,
given that its code never loads MXCSR (which the registration file
evaluates). -/
theorem crtCodeP_correct (M : Mont) (E : CrtExpL M)
    (hmx : (Crt.codeP M.mm E.code).allInstrs (fun i => !loadsMxcsr i) = true)
    (s : State) (h : crtContractP.pre s) :
    ∃ t s', Exec isa (Crt.codeP M.mm E.code) s t s' ∧ abiPreserved s s' ∧ crtContractP.post s s' := by
  obtain ⟨c, hv, hp, hpq⟩ := crtCtxP_of h
  clear h
  have hZ' := c.hZ
  have hk1 := c.hk1
  have hk2 := c.hk2
  suffices hwp : WP isa (Crt.codeP M.mm E.code) s fun s' => gprPreserved s s' ∧ crtContract.post s s' by
    obtain ⟨t, s', he, hg, hp⟩ := hwp
    exact ⟨t, s', he, abiPreserved_of_exec hmx he hg, hp⟩
  unfold Crt.codeP
  refine WP.seq ?_
  rw [WP.block_append_iff]
  refine WP.mono (crtHead_ok c) fun t₁ h₁ => ?_
  have hnb₁ := c.hnb.congrK h₁.inScr h₁.keep
  refine WP.mono (invalid_ok h₁.rdx h₁.rcx hk1 hk2 (bytesAt_length _ _ _) (fun i hi => hnb₁.rd i (by
    rw [bytesAt_length]; exact hi)) (fun i hi => hnb₁.val i _)) fun t₂ ⟨hz₂, hm₂, k₂⟩ => ?_
  have hpre := crtPre_of c h₁ hm₂ k₂
  have kk := h₁.keep.trans k₂
  have hp₂ := hp.congr (by rw [hm₂]; exact h₁.inScr) (kk.gpr (by decide)) kk.2.1 kk.2.2
  refine WP.ite (!Spec.Rsa.modulusValid (Spec.Rsa.os2ip (Spec.Rsa.bytesAt s.mem (s.gpr .rdx) (s.gpr .rcx).toNat))
    (s.gpr .rcx).toNat) (by simp [eval, hz₂]) (fun hb => ?_) (fun _ => ?_)
  · exact absurd hb (by rw [hv]; decide)
  · exact WP.mono (crtMainP_ok M E hpre hv hp₂ hpq) fun t ⟨Mk, hp, hiff⟩ => crtCode_fin c h₁ hm₂ k₂ hp
      (fun _ => ⟨hiff, rfl⟩) fun h => absurd h (by rw [hv]; decide)

end VG.Proof.Bignum.X86_64

end

end

/-!
# RSA with the CRT on x86-64, with the key's precomputed values: constant time

`Crt.mainP` leaks what `Crt.main` leaks but for the check of `p q = n`,
which it does not make, and `r2Pre` only the stack pointer, `w`, the working
space and `pre`'s address (`crtMainP_ct`), from states that carry, besides
`main`'s stage, `p q = n`, the stack pointer, `pre`'s address and `R² mod n`
in `pre` (`StageP`); so `Crt.codeP` is constant
time but for `n` and `pre`'s address (`crtCodeP_constantTime`).
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Rsa.X86_64 VG.Impl.Rsa.X86_64.Crt
open VG.Proof.MlKem.X86_64

/-! ## `main` -/

/-- The stage `R` of a key with `p q = n`. -/
def StageRel.pq (R : StageRel) : StageRel := fun p σ xb pb qb dpb dqb qib t =>
  R p σ xb pb qb dpb dqb qib t ∧ Spec.Rsa.os2ip pb * Spec.Rsa.os2ip qb = p.N

theorem stage_of_pq {R : StageRel} {p : CrtPub} {t : State} (h : Stage R.pq p t) : Stage R p t := by
  obtain ⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, hr, -⟩ := h
  exact ⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, hr⟩

theorem two_stage_of_pq {R : StageRel} {s₁ s₂ : State} (h : Two (Stage R.pq) s₁ s₂) : Two (Stage R) s₁ s₂ :=
  two_bind (fun p _ _ h₁ h₂ => ⟨p, stage_of_pq h₁, stage_of_pq h₂⟩) h

/-- A part from `R` to `R'`, for keys with `p q = n`. -/
theorem stage_pq {R R' : StageRel} {c : Prog isa} (hct : RelCT isa (Two (Stage R)) c fun _ _ => True)
    (hw : ∀ p σ xb pb qb dpb dqb qib t,
      CrtPre σ p.B p.Z p.k p.op p.np p.ip p.pp p.qp p.dpp p.dqp p.qip p.pl p.ql p.nb xb pb qb dpb dqb qib →
      Spec.Rsa.modulusValid p.N p.k = true → R p σ xb pb qb dpb dqb qib t →
      WP isa c t (R' p σ xb pb qb dpb dqb qib)) :
    RelCT isa (Two (Stage R.pq)) c (Two (Stage R'.pq)) :=
  stage_step (hct.mono (fun _ _ h => two_stage_of_pq h) fun _ _ h => h)
    fun p σ xb pb qb dpb dqb qib t h hv ⟨hr, hpq⟩ => WP.mono (hw p σ xb pb qb dpb dqb qib t h hv hr) fun _ h' => ⟨h', hpq⟩

/-- A state of `main`'s stage `R`, for a key with `p q = n`, with the stack
pointer `q.2.1`, `pre`'s address `q.2.2` and `R² mod n` in `pre`. -/
def StageP (R : StageRel) (q : CrtPub × Addr × Addr) (t : State) : Prop :=
  Stage R.pq q.1 t ∧ t.gpr .rsp = q.2.1 ∧ stackArg t 12 = q.2.2 ∧ PreR2 t q.1.B q.1.Z q.1.w q.1.N

/-- The setup of `n` and the input, from `main`'s start with `pre`. -/
theorem setupAP_ct : RelCT isa (Two (StageP R0)) (seqs (loadSteps ++ restSteps)) (Two (StageP RA)) := by
  refine two_post (setupA_ct.mono (fun _ _ h => two_bind (fun q _ _ h₁ h₂ =>
    ⟨q.1, stage_of_pq h₁.1, stage_of_pq h₂.1⟩) h) fun _ _ _ => trivial) ?_
  rintro q σ ⟨⟨σ', xb, pb, qb, dpb, dqb, qib, h, hv, he, hpq⟩, hsp, harg, hp⟩
  subst he
  obtain ⟨hodd, -, -⟩ := valid_facts hv h.k1
  have := h.k1
  have := h.k2
  have hZq := h.z
  have hZ : slot ((q.1.k + 7) / 8) 8 ≤ q.1.Z := by unfold offQ at hZq; omega_arith
  refine WP.mono (setup_ok h.scr h.rdi hZ (by omega_arith) (by omega_arith) h.hK h.hN h.hIn
    h.n h.x h.nl h.xl hodd) fun t ⟨minv, so, f, k⟩ => ?_
  have hi : InScr q.1.B q.1.Z σ.mem t.mem := InScr.of_frm f fun r hr => Nat.le_trans (setupRanges_le _ r hr) hZ
  exact ⟨⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, ⟨minv, so⟩, hpq⟩, (k.gpr (by decide)).trans hsp,
    (hp.arg_eq hi (k.gpr (by decide))).trans harg, hp.congr hi (k.gpr (by decide)) k.2.1 k.2.2⟩

/-- `R² mod n` from `pre`. -/
theorem r2P_ct : RelCT isa (Two (StageP RA)) r2Pre (Two (Stage RB.pq)) := by
  refine (two_post (Ψ := fun (q : CrtPub × Addr × Addr) t => Stage RB.pq q.1 t)
    (two_map (fun q : CrtPub × Addr × Addr => (⟨q.2.1, q.1.B, q.1.w, q.2.2⟩ : R2PPub)) ?_ r2Pre_ct) ?_).mono
    (fun _ _ h => h) (fun _ _ h => two_bind (fun q _ _ h₁ h₂ => ⟨q.1, h₁, h₂⟩) h)
  · rintro q t ⟨⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, ⟨minv, so⟩, -⟩, hsp, harg, hp⟩
    have hZq := h.z
    have hZ : slot q.1.w 8 ≤ q.1.Z := by unfold CrtPub.w; unfold offQ at hZq; omega_arith
    have := r2PreCT_of so.good hZ so.r12 hp
    rw [hsp, harg] at this
    exact this
  · rintro q t ⟨⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, ⟨minv, so⟩, hpq⟩, -, -, hp⟩
    obtain ⟨hodd, -, -⟩ := valid_facts hv h.k1
    have := h.k1
    have := h.k2
    have hZq := h.z
    exact WP.mono (r2Pre_ok so.good (by unfold CrtPub.w; unfold offQ at hZq; omega_arith) (by unfold CrtPub.w; omega_arith)
      (by unfold CrtPub.w; omega_arith) so.r12 (by omega_arith) hp)
      fun t' ⟨hg, _⟩ => ⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, ⟨minv, hg⟩, hpq⟩

/-- `n`'s setup with `R² mod n` from `pre` leaks the same in runs that agree
on `n`, the stack pointer and `pre`'s address. -/
theorem nSetupP_ct (M : Mont) : RelCT isa (Two (StageP R0)) (seqs (nSetupP M.mm)) fun _ _ => True := by
  rw [nSetupP_eq]
  refine RelCT.seqs_append (by simp [loadSteps]) (by simp) (RelCT.seq setupAP_ct ?_)
  exact RelCT.seqs_append (by simp) (by simp)
    (RelCT.seq (r2P_ct.mono (fun _ _ h => h) fun _ _ h => two_stage_of_pq h) (nTail_ct M))

/-- Up to the checks, with `R² mod n` from `pre` and without the check of
`p q = n`, from `main`'s start with `pre`. -/
theorem frontP_ct (M : Mont) (hS : SetupCT) (hC : ChecksPCT) :
    RelCT isa (Two (StageP R0)) (seqs (nSetupP M.mm ++ primesSetup ++ checksP)) (Two (Stage R3)) := by
  refine RelCT.seqs_append (by simp [nSetupP]) (by simp [checksP])
    (RelCT.seq (R := Two (Stage R2.pq)) ?_ (checksSWith_ct (fun _ _ _ _ _ _ _ _ _ h => h.1) hC
      fun _ _ _ _ _ _ _ _ _ h hv ⟨⟨minv, _, _, hr⟩, hpq⟩ =>
        WP.mono (checksPartP_ok h hv hr hpq) fun _ ⟨mp', mq', h'⟩ => ⟨minv, mp', mq', h'⟩))
  refine RelCT.seqs_append (by simp [nSetupP]) (by simp [primesSetup])
    (RelCT.seq (R := Two (Stage R1.pq)) ?_ (stage_pq ((setupS_ct hS).mono (fun _ _ h => h) fun _ _ _ => trivial)
      fun _ _ _ _ _ _ _ _ _ h _ ⟨minv, hr⟩ => WP.mono (setupPart_ok h hr) fun _ h' => ⟨minv, h'⟩))
  refine (two_post (Ψ := fun (q : CrtPub × Addr × Addr) t => Stage R1.pq q.1 t) (nSetupP_ct M) ?_).mono
    (fun _ _ h => h) (fun _ _ h => two_bind (fun q _ _ h₁ h₂ => ⟨q.1, h₁, h₂⟩) h)
  rintro q σ ⟨⟨σ', xb, pb, qb, dpb, dqb, qib, h, hv, he, hpq⟩, -, -, hp⟩
  subst he
  exact WP.mono (nPartP_ok M h hv hp) fun _ ⟨minv, hr⟩ => ⟨σ, xb, pb, qb, dpb, dqb, qib, h, hv, ⟨minv, hr⟩, hpq⟩

/-- `mainP` leaks the same in runs that agree on the public data, the stack
pointer and `pre`'s address, given that its parts do. -/
theorem crtMainP_ct (M : Mont) (E : CrtExpL M) (hS : SetupCT) (hC : ChecksPCT) (hQ : QPhaseCT M E) (hP : PPhaseCT M E)
    (hF : RelCT isa (Two (Stage R5)) (seqs finish) fun _ _ => True) :
    RelCT isa (Two (StageP R0)) (Crt.mainP M.mm E.code) fun _ _ => True := by
  rw [crtMainP_eq]
  refine RelCT.seqs_append (by simp [nSetupP]) (by simp [qPhase]) (RelCT.seq (frontP_ct M hS hC) ?_)
  rw [List.append_assoc]
  refine RelCT.seqs_append (by simp [qPhase]) (by simp [pPhase]) (RelCT.seq (qS_ct M E hQ) ?_)
  exact RelCT.seqs_append (by simp [pPhase]) (by simp [finish]) (RelCT.seq (pS_ct M E hP) hF)

/-! ## The code -/

/-- A state `crtContractP` allows, with the public data `q.1` and `pre`'s
address `q.2`. -/
def CCRelP (q : CCPub × Addr) (s : State) : Prop := crtContractP.pre s ∧ CCEq q.1 s ∧ stackArg s 12 = q.2

theorem ccRelP_ok : CCOk Prod.fst CCRelP := fun _ _ h => ⟨(crtCtxP_of h.1).1, h.2.1⟩

/-- `CrtPre` after the head and the modulus' check, and `p q = n`. -/
theorem cc3P_pre {q : CCPub × Addr} {t : State} (h : CC3W Prod.fst CCRelP q t) :
    ∃ xb pb qb dpb dqb qib, CrtPre t q.1.m.B q.1.m.Z q.1.m.k q.1.m.op q.1.m.np q.1.m.ip q.1.m.pp q.1.m.qp q.1.m.dpp
      q.1.m.dqp q.1.m.qip q.1.m.pl q.1.m.ql q.1.m.nb xb pb qb dpb dqb qib ∧
      Spec.Rsa.os2ip pb * Spec.Rsa.os2ip qb = q.1.m.N := by
  obtain ⟨s, t₁, hs, h, hm, k, -⟩ := h
  obtain ⟨c, -, hB, hZ, hk, hop, hnp, hip, hpp, hqp, hdpp, hdqp, hqip, hpl, hql, hnb⟩ := ccRelP_ok q s hs
  obtain ⟨-, -, -, hpq⟩ := crtCtxP_of hs.1
  have := crtPre_of c h hm k
  rw [hB, hZ, hk, hop, hnp, hip, hpp, hqp, hdpp, hdqp, hqip, hpl, hql] at this
  rw [hpp, hqp, hpl, hql, hnp, hk] at hpq
  rw [hnp, hk] at hnb
  rw [hnb] at this hpq
  exact ⟨_, _, _, _, _, _, this, hpq⟩

/-- `main`'s stage with `pre`, after the head and the modulus' check. -/
theorem cc3P_stage {q : CCPub × Addr} {t : State} (h : CC3W Prod.fst CCRelP q t) (he : isa.eval .ne t = some false) :
    StageP R0 (q.1.m, q.1.rsp, q.2) t := by
  obtain ⟨xb, pb, qb, dpb, dqb, qib, hpre, hpq⟩ := cc3P_pre h
  obtain ⟨s, t₁, ⟨hs, heq, harg⟩, hh, hm, k, hz⟩ := h
  have hv : Spec.Rsa.modulusValid q.1.m.N q.1.m.k = true := by
    simp only [eval, hz] at he; simpa using he
  obtain ⟨-, -, hp, -⟩ := crtCtxP_of hs
  obtain ⟨hsp, hB, hZ, hk, -, hnp, -, -, -, -, -, -, -, -, hnb⟩ := heq
  rw [hB, hZ, hnb, hk] at hp
  have kk := hh.keep.trans k
  have hi : InScr q.1.m.B q.1.m.Z s.mem t.mem := by rw [hm, ← hB, ← hZ]; exact hh.inScr
  exact ⟨⟨t, xb, pb, qb, dpb, dqb, qib, hpre, hv, rfl, hpq⟩, (kk.gpr (by decide)).trans hsp,
    (hp.arg_eq hi (kk.gpr (by decide))).trans harg, hp.congr hi (kk.gpr (by decide)) kk.2.1 kk.2.2⟩

variable (M : Mont) (E : CrtExpL M)

/-- `vg_rsa_private_crt_precomputed` leaks the same in runs that agree on the
public data and `pre`'s address, given that `main`'s parts do. -/
theorem crtCodeP_ct (hS : SetupCT) (hC : ChecksPCT) (hQ : QPhaseCT M E) (hP : PPhaseCT M E)
    (hF : RelCT isa (Two (Stage R5)) (seqs finish) fun _ _ => True) :
    RelCT isa (Two CCRelP) (Crt.codeP M.mm E.code) fun _ _ => True := by
  unfold Crt.codeP
  refine crtEntryWith_ct ccRelP_ok _ ?_
  exact (crtMainP_ct M E hS hC hQ hP hF).mono (fun _ _ h => two_bind (fun q t₁ t₂ h₁ h₂ =>
    ⟨(q.1.m, q.1.rsp, q.2), cc3P_stage h₁.1 h₁.2, cc3P_stage h₂.1 h₂.2⟩) h) fun _ _ h => h

/-- `vg_rsa_private_crt_precomputed` is constant time but for `n` and `pre`'s
address, given that `main`'s parts are. -/
theorem crtCodeP_constantTime_of (hS : SetupCT) (hC : ChecksPCT) (hQ : QPhaseCT M E) (hP : PPhaseCT M E)
    (hF : RelCT isa (Two (Stage R5)) (seqs finish) fun _ _ => True) :
    ConstantTime isa crtContractP.pre crtContractP.pub (Crt.codeP M.mm E.code) := by
  refine RelCT.constantTime ((crtCodeP_ct M E hS hC hQ hP hF).mono
    (fun s₁ s₂ ⟨h₁, h₂, hp, h12, _, _⟩ => ⟨(ccPubOf s₁, stackArg s₁ 12), ?_, ?_⟩) fun _ _ h => h)
  · exact ⟨h₁, ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩, rfl⟩
  · obtain ⟨hr, a0, a1, a2, a3, a4, -, a6, -, a8, -, a10, a11, hn⟩ := hp
    have r : ∀ r ∈ [Reg.rdi, .rsi, .rdx, .rcx, .r8, .r9, .rsp], s₂.gpr r = s₁.gpr r := fun r h => (hr r h).symm
    exact ⟨h₂, ⟨r .rsp (by decide), a10.symm, by rw [← a11]; rfl, by rw [r .rcx (by decide)]; rfl,
      r .rdi (by decide), r .rdx (by decide), r .r8 (by decide), a0.symm, a2.symm, a4.symm, a6.symm, a8.symm,
      by rw [← a1]; rfl, by rw [← a3]; rfl, hn.symm⟩, h12.symm⟩

/-- `vg_rsa_private_crt_precomputed` is constant time but for `n` and `pre`'s
address. -/
theorem crtCodeP_constantTime (hE : E.CT) :
    ConstantTime isa crtContractP.pre crtContractP.pub (Crt.codeP M.mm E.code) :=
  crtCodeP_constantTime_of M E setup_ct checksP_ct
    (qPhase_ct M E (unit_ct M (gPow_ct_Q M) (redc_ct_Y M) (by taint_decide))
      (pow_ct M E (redc_ct_Y M) hE.2 (by taint_decide)))
    (pPhase_ct M E (unit_ct M (gPow_ct_P M) (redc_ct_Y M) (by taint_decide))
      (pow_ct M E (redc_ct_Y M) hE.1 (by taint_decide)) (redc_ct_X M) loadArr_ct_pI)
    crtFinish_ct

end VG.Proof.Bignum.X86_64

end

end

/-!
# RSA with AVX512_IFMA on x86-64, any size: `main` in constant time

`main` is `Crt.main` with a branch on the
sizes, which are public (`anySizes`), and within the IFMA branch another for the
vector code of each layout (`ifmaAny`): the IFMA branch's parts
(`pre`, `ifma`, `post`) are constant time for their correctness lemmas'
hypotheses (`pre_ct`, `ifma_ct`, `post_ct`), which the states of a run
between them satisfy (`prePre_of`, `ifPre_of`, `postPre_of`); the last
`else` is `vg_rsa_private_crt`'s (`qS_ct`, `pS_ct`). So `main` is
(`main_ct`).
-/

@[expose] public section

namespace VG.Proof.Bignum.X86_64.Ifma

open VG VG.X86_64 VG.Impl.Bignum.X86_64 VG.Impl.Rsa.X86_64 VG.Impl.Rsa.X86_64.Crt
open VG.Proof.MlKem.X86_64
open VG.Impl.Bignum.X86_64.Public
open VG.Impl.Rsa.X86_64.CrtIfma (Lay lay2048 lay3072 lay4096 sizes ifma vec result region sIfma)
open VG.Proof.Bignum.X86_64 (NSafe nsafe_word preRanges_nsafe APost PrePub PostPub
  pins_eqs StageRel Stage stage_step two_stage R0 R1 R2 R3 R5 CrtPub RedcCT LoadCT
  SetupCT ChecksCT QPhaseCT PPhaseCT setupS_ct checksS_ct qS_ct pS_ct nSetup_ct nPart_ok RelCT.seqs_append)

variable {l : VG.Impl.Rsa.X86_64.CrtIfma.Lay}

/-! ## The parts' hypotheses from a run's states -/

/-- `ifma`'s hypotheses, after `pre` (as `branchA2_ok` runs it). -/
theorem ifPre_of (hl : LayOk l) {s t₀ s₁ : State} {B : Addr} {Z k : Nat} {op np ip pp qp dpp dqp qip : Addr}
    {pl ql : Nat} {nb xb pb qb dpb dqb qib : List Byte} {minv mp mq : BitVec 64} {Mk : Bool}
    (h : CrtPre s B Z k op np ip pp qp dpp dqp qip pl ql nb xb pb qb dpb dqb qib)
    (hv : Spec.Rsa.modulusValid (Spec.Rsa.os2ip nb) k = true)
    (hr : CrtReady s t₀ B Z ((k + 7) / 8) pl ql minv mp mq (Spec.Rsa.os2ip nb) (Spec.Rsa.os2ip xb)
      (Spec.Rsa.os2ip pb) (Spec.Rsa.os2ip qb) Mk)
    (hMk : Mk = keyMask (decide (Spec.Rsa.os2ip xb < Spec.Rsa.os2ip nb)) (Spec.Rsa.os2ip nb) (Spec.Rsa.os2ip pb)
      (Spec.Rsa.os2ip qb) (Spec.Rsa.os2ip qib))
    (hw32 : (k + 7) / 8 = 2 * l.W) (hpl : wsWords pl = l.W) (hql : wsWords ql = l.W)
    (hZa : offQ ((k + 7) / 8) pl + slot l.W 8 + wsTab l.W + 2 * l.D + 8 ≤ Z)
    (hA : APost t₀ s₁ B Z ((k + 7) / 8) (offP ((k + 7) / 8)) (offQ ((k + 7) / 8) pl) l.W minv mp mq
      (Spec.Rsa.os2ip nb) (if Mk then Spec.Rsa.os2ip pb else 3) (if Mk then Spec.Rsa.os2ip qb else 3)
      (Spec.Rsa.os2ip xb)) :
    IfPre l ⟨B, Z, (k + 7) / 8, offP ((k + 7) / 8), offQ ((k + 7) / 8) pl,
      offQ ((k + 7) / 8) pl + slot l.W 8 + wsTab l.W, dpp, dqp, pl, ql⟩ s₁ := by
  obtain ⟨hodd, hN1, hPN, hQN⟩ := crt_bounds h hv
  have hk1 := h.k1
  have hpl1 := h.pl1
  have hql1 := h.ql1
  have hZq := h.z
  dsimp only [IfPre]
  generalize Spec.Rsa.os2ip nb = N at *
  generalize Spec.Rsa.os2ip xb = C at *
  generalize Spec.Rsa.os2ip pb = P at *
  generalize Spec.Rsa.os2ip qb = Q at *
  generalize Spec.Rsa.os2ip qib = QI at *
  obtain ⟨hMk', hP', hQ'⟩ := mask_facts hMk hodd hPN hQN
  have hn := hr.good.scr.nowrap
  have h8 := hdr_lt_slot ((k + 7) / 8) 8 (show 31 < 32 by decide)
  have h16 := hdr_lt_slot l.W 8 (show 31 < 32 by decide)
  have hT : wsTab l.W = 256 * (l.W + 2) := by unfold wsTab tabBytes; omega_arith
  obtain ⟨hW1, hW2⟩ := W_bounds hl
  have hEW : l.E = 8 * l.W := rfl
  have hpl' : pl ≤ l.E := by unfold wsWords at hpl; omega_arith
  have hql' : ql ≤ l.E := by unfold wsWords at hql; omega_arith
  have hop : offP ((k + 7) / 8) = slot ((k + 7) / 8) 8 := rfl
  have hoq : offQ ((k + 7) / 8) pl = slot ((k + 7) / 8) 8 + slot l.W 8 + wsTab l.W := by
    unfold offQ; rw [hpl]
  rw [hql] at hZq
  have hh₀ : ∀ i < 32, hFixed i = true → word t₀.mem B (8 * i) = word s.mem B (8 * i) := hr.hfix
  obtain ⟨hg₁, hN₁, rp, rq, f₁, k₁, mk₁⟩ := hA
  have ns₁ := preRanges_nsafe (w := (k + 7) / 8) (wp := l.W) (wq := l.W) (Nat.le_refl (offP ((k + 7) / 8)))
    (show slot ((k + 7) / 8) 8 ≤ offQ ((k + 7) / 8) pl by rw [hoq]; omega_arith)
  have hpr : ∀ r ∈ preRanges ((k + 7) / 8) (offP ((k + 7) / 8)) l.W (offQ ((k + 7) / 8) pl) l.W,
      r.1 + r.2 ≤ offQ ((k + 7) / 8) pl + slot l.W 8 + wsTab l.W := fun r hr => by
    simp only [preRanges, List.mem_append, List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with hr | rfl | rfl | rfl
    · have := (gRanges_lt _ r hr).2; rw [hoq]; omega_arith
    · have := slot_le (w := (k + 7) / 8) (show Public.aX < 8 by decide); rw [hoq]; simp only; omega_arith
    · simp only [xRange]; omega_arith
    · simp only [xRange]; rw [hoq, hop]; omega_arith
  have i₀₁ : InScr B Z t₀.mem s₁.mem := InScr.of_frm f₁ fun r hr => by have := hpr r hr; omega_arith
  have hb₁ : ∀ i < 32, i ≠ Crt.sD → i ≠ Public.sCnt → word s₁.mem B (8 * i) = word t₀.mem B (8 * i) :=
    fun i hi h1 h2 => nsafe_word f₁ ns₁ hi h1 h2
  have hf₁ : ∀ i < 32, hFixed i = true → word s₁.mem B (8 * i) = word s.mem B (8 * i) := fun i hi hf => by
    have h1 : i ≠ Crt.sD := by rintro rfl; revert hf; decide
    have h2 : i ≠ Public.sCnt := by rintro rfl; revert hf; decide
    rw [hb₁ i hi h1 h2, hh₀ i hi hf]
  have kk₁ := hr.keep.trans k₁
  have ip : IPre l s₁.mem B ((k + 7) / 8) (offP ((k + 7) / 8)) (offQ ((k + 7) / 8) pl) minv mp mq (mask Mk)
      (if Mk then P else 3) (if Mk then Q else 3) dpp dqp dpb.length dqb.length :=
    ⟨hg₁.hdr, by rw [hb₁ _ (by decide) (by decide) (by decide)]; exact hr.wsP,
      by rw [hb₁ _ (by decide) (by decide) (by decide)]; exact hr.wsQ, rp.ws, rq.ws, rp.x.n, rp.x.inv, rp.x.one,
      rq.x.n, rq.x.inv, rq.x.one, mk₁.trans hr.pmask, by rw [hf₁ _ (by decide) (by decide)]; exact h.hDp,
      by rw [hf₁ _ (by decide) (by decide), h.dpl]; exact h.hPl, by rw [hf₁ _ (by decide) (by decide)]; exact h.hDq,
      by rw [hf₁ _ (by decide) (by decide), h.dql]; exact h.hQl⟩
  exact ⟨minv, mp, mq, mask Mk, _, _, dpb, dqb, hg₁.scr, hg₁.rdi, ip, Nat.le_refl _, by rw [hoq, hop], rfl,
    by omega_arith, hP'.2, hQ'.2, rp.ylt, rq.ylt, rp.clt, rq.clt, h.dp.congrK (hr.iscr.trans i₀₁) kk₁,
    h.dq.congrK (hr.iscr.trans i₀₁) kk₁, by rw [h.dpl]; exact hpl1, by rw [h.dpl]; exact hpl',
    by rw [h.dql]; exact hql1, by rw [h.dql]; exact hql', h.dpl, h.dql⟩

/-! ## The stages of the IFMA branch -/

/-- After the checks, with the sizes of the IFMA branch. -/
def R3I (l : VG.Impl.Rsa.X86_64.CrtIfma.Lay) : StageRel := fun p σ xb pb qb dpb dqb qib t =>
  R3 p σ xb pb qb dpb dqb qib t ∧ p.w = 2 * l.W ∧ wsWords p.pl = l.W ∧ wsWords p.ql = l.W

/-- After `pre`. -/
def RAp (l : VG.Impl.Rsa.X86_64.CrtIfma.Lay) : StageRel := fun p σ xb pb qb _ _ qib t =>
  ∃ (minv mp mq : BitVec 64) (t₀ : State),
  CrtReady σ t₀ p.B p.Z p.w p.pl p.ql minv mp mq p.N (Spec.Rsa.os2ip xb) (Spec.Rsa.os2ip pb) (Spec.Rsa.os2ip qb)
    (p.mask xb pb qb qib) ∧ p.w = 2 * l.W ∧ wsWords p.pl = l.W ∧ wsWords p.ql = l.W ∧
  APost t₀ t p.B p.Z p.w (offP p.w) (offQ p.w p.pl) l.W minv mp mq p.N
    (if p.mask xb pb qb qib then Spec.Rsa.os2ip pb else 3) (if p.mask xb pb qb qib then Spec.Rsa.os2ip qb else 3)
    (Spec.Rsa.os2ip xb)

/-- After `ifma`. -/
def RID (l : VG.Impl.Rsa.X86_64.CrtIfma.Lay) : StageRel := fun p σ xb pb qb dpb dqb qib t =>
  ∃ (minv mp mq : BitVec 64),
  IDone l σ t p.B p.Z p.w (offP p.w) (offQ p.w p.pl) (offQ p.w p.pl + slot l.W 8 + wsTab l.W) minv mp mq p.N
    (Spec.Rsa.os2ip xb) (Spec.Rsa.os2ip pb) (Spec.Rsa.os2ip qb) p.dpp p.dqp p.qip p.pl p.ql dpb dqb
    (p.mask xb pb qb qib) ∧ p.w = 2 * l.W ∧ wsWords p.pl = l.W ∧ wsWords p.ql = l.W

theorem ifmaS_ct (hl : LayOk l) : RelCT isa (Two (Stage (RAp l))) (seqs (ifma l)) (Two (Stage (RID l))) :=
  stage_step ((ifma_ct hl).mono (fun _ _ h => two_stage (fun p _ => (⟨p.B, p.Z, p.w, offP p.w, offQ p.w p.pl,
    offQ p.w p.pl + slot l.W 8 + wsTab l.W, p.dpp, p.dqp, p.pl, p.ql⟩ : IfPub))
    (fun _ _ _ _ _ _ _ _ _ h hv ⟨minv, _, _, _, hr, hw, hp, hq, hA⟩ =>
      ⟨minv, hA.2.1, ifPre_of hl h hv hr rfl hw hp hq (ifmaZ_of hl h.zk hw hp) hA⟩) h) fun _ _ h => h)
    fun _ _ _ _ _ _ _ _ _ h hv ⟨minv, mp, mq, _, hr, hw, hp, hq, hA⟩ =>
      WP.mono (branchA2_ok hl h hv hr rfl hw hp hq (ifmaZ_of hl h.zk hw hp) hA) fun _ ⟨hd, _⟩ =>
        ⟨minv, mp, mq, hd, hw, hp, hq⟩

/-- After the sizes' check. -/
def R3Z (l : VG.Impl.Rsa.X86_64.CrtIfma.Lay) : StageRel := fun p σ xb pb qb dpb dqb qib t =>
  R3 p σ xb pb qb dpb dqb qib t ∧
    t.zf = some (decide (p.w = 2 * l.W ∧ (p.pl + 7) / 8 = l.W ∧ (p.ql + 7) / 8 = l.W))

theorem sizesT (hl : LayOk l) : TOk [.rdi] (.block (sizes l)) := by
  rcases hl with rfl | rfl | rfl | rfl <;> exact ⟨_, by taint_decide⟩

theorem sizesS_ct (hl : LayOk l) : RelCT isa (Two (Stage R3)) (.block (sizes l)) (Two (Stage (R3Z l))) := by
  obtain ⟨_, hT⟩ := sizesT hl
  refine stage_step (two_taint [.rdi] (pins_eqs (fun p _ => p.B) fun p t h r hr => by
      obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, hr'⟩ := h
      rw [List.mem_singleton.mp hr]; exact hr'.good.rdi) hT) ?_
  intro p _ _ _ _ _ _ _ _ h hv ⟨minv, mp, mq, hr⟩
  have hn := hr.good.scr.nowrap
  have h8 := hdr_lt_slot ((p.k + 7) / 8) 8 (show 31 < 32 by decide)
  have hZq := h.z
  have hk2 := h.k2
  have hpl2 := h.pl2
  have hql2 := h.ql2
  exact WP.mono (sizes_ok hl (pl := p.pl) (ql := p.ql) hr.good
    (by rw [hr.hfix _ (by decide) (by decide)]; exact h.hPl) (by rw [hr.hfix _ (by decide) (by decide)]; exact h.hQl)
    (by unfold offQ at hZq; omega_arith) (show (p.k + 7) / 8 < 2 ^ 64 by omega_arith) (by omega_arith) (by omega_arith))
    fun t' ⟨zf, me, k⟩ => ⟨⟨minv, mp, mq, hr.of_regs me k⟩, zf⟩

local notation "CLay" => VG.Impl.Rsa.X86_64.CrtIfma.Lay

/-- The layout of a key with `w` words, if it has one. -/
def layOf (l2 : CLay) (w : Nat) : CLay :=
  if w = 2 * lay2048.W then l2 else if w = 2 * lay3072.W then lay3072 else lay4096

theorem layOf_of (l2 : CLay) (w : Nat) : LayOf l2 (layOf l2 w) := by
  unfold layOf; split
  · exact .inl rfl
  · split
    · exact .inr (.inl rfl)
    · exact .inr (.inr rfl)

theorem layOf_ok {l2 : CLay} (h2 : Lay2 l2) (w : Nat) : LayOk (layOf l2 w) := (layOf_of l2 w).ok h2

theorem layOf_two {l2 : CLay} (h2 : Lay2 l2) (hl : LayOf l2 l) : layOf l2 (2 * l.W) = l := by
  rcases h2 with rfl | rfl <;> rcases hl with rfl | rfl | rfl <;> rfl

/-- A relation of each layout, for the layout of the key's sizes. -/
def AtLay (l2 : CLay) (R : CLay → StageRel) : StageRel := fun p => R (layOf l2 p.w) p

/-- The sizes of one of the layouts. -/
abbrev AnyOf (w pl ql : Nat) : Prop := SizesOf lay2048 w pl ql ∨ SizesOf lay3072 w pl ql ∨ SizesOf lay4096 w pl ql

theorem sizesOf_layOf {l2 : CLay} (h2 : Lay2 l2) {w pl ql : Nat} (h : AnyOf w pl ql) :
    SizesOf (layOf l2 w) w pl ql := by
  rcases h with h | h | h
  · have h' := (h2.sizes _ _ _).2 h
    rw [show layOf l2 w = l2 by rw [h'.1, layOf_two h2 (.inl rfl)]]; exact h'
  · rw [show layOf l2 w = lay3072 by rw [h.1, layOf_two h2 (.inr (.inl rfl))]]; exact h
  · rw [show layOf l2 w = lay4096 by rw [h.1, layOf_two h2 (.inr (.inr rfl))]]; exact h

/-- After `anySizes`. -/
def R3A : StageRel := fun p σ xb pb qb dpb dqb qib t =>
  R3 p σ xb pb qb dpb dqb qib t ∧ t.zf = some (decide (AnyOf p.w p.pl p.ql))

theorem anySizes_ct : RelCT isa (Two (Stage R3)) CrtIfma.anySizes (Two (Stage R3A)) := by
  have cond : ∀ {l : CLay} (p : CrtPub) (s₁ s₂ : State), Stage (R3Z l) p s₁ → Stage (R3Z l) p s₂ →
      isa.eval .e s₁ = isa.eval .e s₂ := fun p s₁ s₂ h₁ h₂ => by
    obtain ⟨_, _, _, _, _, _, _, _, _, _, z₁⟩ := h₁
    obtain ⟨_, _, _, _, _, _, _, _, _, _, z₂⟩ := h₂
    simp only [eval, z₁, z₂]
  have drop : ∀ {l : CLay} {b : Bool} (x y : State),
      Two (fun p s => Stage (R3Z l) p s ∧ isa.eval .e s = some b) x y → Two (Stage R3) x y :=
    fun _ _ h => two_mono (fun p s ⟨⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, hr, _⟩, _⟩ =>
      ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, hr⟩) h
  have hct : RelCT isa (Two (Stage R3)) CrtIfma.anySizes fun _ _ => True := by
    unfold CrtIfma.anySizes
    refine RelCT.seq (sizesS_ct (Or.inl rfl)) (two_ite cond (VG.RelCT.block_nil fun _ _ _ => trivial) ?_)
    refine (RelCT.seq (sizesS_ct (Or.inr (Or.inl rfl))) (two_ite cond (VG.RelCT.block_nil fun _ _ _ => trivial)
      ((sizesS_ct (Or.inr (Or.inr (Or.inl rfl)))).mono drop fun _ _ _ => trivial))).mono drop fun _ _ h => h
  exact stage_step hct fun p σ xb pb qb dpb dqb qib t h hv ⟨minv, mp, mq, hr⟩ =>
    WP.mono (anySizes_ok h hr) fun t' ⟨zf, hr', _⟩ => ⟨⟨minv, mp, mq, hr'⟩, zf⟩

/-- `sizes l` after `pre`, with any condition `X` on the public data. -/
theorem sizesAS_ct {l2 : CLay} (hl : LayOk l) (X : CrtPub → Prop) :
    RelCT isa (Two (Stage fun p σ xb pb qb dpb dqb qib t => AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ X p))
      (.block (sizes l)) (Two (Stage fun p σ xb pb qb dpb dqb qib t =>
        (AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ X p) ∧ t.zf = some (decide (SizesOf l p.w p.pl p.ql)))) := by
  obtain ⟨_, hT⟩ := sizesT hl
  refine stage_step (two_taint [.rdi] (pins_eqs (fun p _ => p.B) fun p t h r hr => ?_) hT) ?_
  · obtain ⟨_, _, _, _, _, _, _, _, _, ⟨_, _, _, _, _, _, _, _, hA⟩, _⟩ := h
    rw [List.mem_singleton.mp hr]; exact hA.1.rdi
  · intro p σ xb pb qb dpb dqb qib t h hv ⟨⟨minv, mp, mq, t₀, hr, hw, hp, hq, hA⟩, hX⟩
    exact WP.mono (sizesA_ok hl h hr hA) fun t' ⟨zf, a', _⟩ => ⟨⟨⟨minv, mp, mq, t₀, hr, hw, hp, hq, a'⟩, hX⟩, zf⟩

/-- `RAp` of the layout of the sizes is that of the layout whose sizes they are. -/
theorem rap_of {l2 l : CLay} (h2 : Lay2 l2) (hl : LayOf l2 l) {p : CrtPub} {σ : State}
    {xb pb qb dpb dqb qib : List Byte} {t : State}
    (h : AtLay l2 RAp p σ xb pb qb dpb dqb qib t) (hs : SizesOf l p.w p.pl p.ql) :
    RAp l p σ xb pb qb dpb dqb qib t := by
  have e : layOf l2 p.w = l := by rw [hs.1, layOf_two h2 hl]
  unfold AtLay at h; rw [e] at h; exact h

/-- `RAp` of the layout of the sizes: the key has its sizes. -/
theorem sizes_of_rap {l2 : CLay} (h2 : Lay2 l2) {p : CrtPub} {σ : State} {xb pb qb dpb dqb qib : List Byte} {t : State}
    (h : AtLay l2 RAp p σ xb pb qb dpb dqb qib t) : SizesOf (layOf l2 p.w) p.w p.pl p.ql := by
  obtain ⟨_, _, _, _, _, hw, hp, hq, _⟩ := h
  obtain ⟨hW1, -⟩ := W_bounds (layOf_ok h2 p.w)
  unfold wsWords at hp hq
  exact ⟨hw, by omega_arith, by omega_arith⟩

/-- The vector code of `l`, for the states where the sizes are `l`'s. -/
theorem ifmaL_ct {l2 : CLay} (h2 : Lay2 l2) (hl : LayOf l2 l) (X : CrtPub → Prop)
    (hX : ∀ p σ xb pb qb dpb dqb qib t, AtLay l2 RAp p σ xb pb qb dpb dqb qib t → X p → SizesOf l p.w p.pl p.ql) :
    RelCT isa (Two (Stage fun p σ xb pb qb dpb dqb qib t => AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ X p))
      (seqs (ifma l)) (Two (Stage (AtLay l2 RID))) :=
  (ifmaS_ct (hl.ok h2)).mono
    (fun _ _ h => two_mono (fun p s ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, h, hx⟩ =>
      ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, rap_of h2 hl h (hX _ _ _ _ _ _ _ _ _ h hx)⟩) h)
    fun _ _ h => two_mono (fun p s ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, h⟩ => ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ,
      hv, by
        have e : layOf l2 p.w = l := by obtain ⟨_, _, _, _, hw, _⟩ := h; rw [hw, layOf_two h2 hl]
        show RID (layOf l2 p.w) p σ xb pb qb dpb dqb qib s
        rw [e]; exact h⟩) h

theorem ifmaAny_ct {l2 : CLay} (h2 : Lay2 l2) :
    RelCT isa (Two (Stage (AtLay l2 RAp))) (CrtIfma.ifmaAny l2) (Two (Stage (AtLay l2 RID))) := by
  have cond : ∀ {l : CLay} {X : CrtPub → Prop} (p : CrtPub) (s₁ s₂ : State),
      Stage (fun p σ xb pb qb dpb dqb qib t => (AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ X p) ∧
        t.zf = some (decide (SizesOf l p.w p.pl p.ql))) p s₁ →
      Stage (fun p σ xb pb qb dpb dqb qib t => (AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ X p) ∧
        t.zf = some (decide (SizesOf l p.w p.pl p.ql))) p s₂ →
      isa.eval .e s₁ = isa.eval .e s₂ := fun p s₁ s₂ h₁ h₂ => by
    obtain ⟨_, _, _, _, _, _, _, _, _, _, z₁⟩ := h₁
    obtain ⟨_, _, _, _, _, _, _, _, _, _, z₂⟩ := h₂
    simp only [eval, z₁, z₂]
  -- A branch's state: `X` and what the test said.
  have cont : ∀ {l : CLay} {X Y : CrtPub → Prop} {b : Bool},
      (∀ p, X p → (decide (SizesOf l p.w p.pl p.ql) = b) → Y p) → ∀ x y,
      Two (fun p s => Stage (fun p σ xb pb qb dpb dqb qib t => (AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ X p) ∧
        t.zf = some (decide (SizesOf l p.w p.pl p.ql))) p s ∧ isa.eval .e s = some b) x y →
      Two (Stage fun p σ xb pb qb dpb dqb qib t => AtLay l2 RAp p σ xb pb qb dpb dqb qib t ∧ Y p) x y :=
    fun hY _ _ h => two_mono (fun p s ⟨⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, ⟨h, hx⟩, hz⟩, he⟩ =>
      ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, h, hY p hx (by simp only [eval, hz, Option.some.injEq] at he; exact he)⟩) h
  unfold CrtIfma.ifmaAny
  refine (RelCT.seq (sizesAS_ct (Or.inl rfl) (fun _ => True)) (two_ite cond
    ((ifmaL_ct h2 (Or.inl rfl) (fun p => SizesOf lay2048 p.w p.pl p.ql)
        fun _ _ _ _ _ _ _ _ _ _ h => (h2.sizes _ _ _).2 h).mono
      (cont fun _ _ e => of_decide_eq_true e) fun _ _ h => h) ?_)).mono
    (fun _ _ h => two_mono (fun p s ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, h⟩ =>
      ⟨σ, xb, pb, qb, dpb, dqb, qib, hσ, hv, h, trivial⟩) h) fun _ _ h => h
  refine (RelCT.seq (sizesAS_ct (Or.inr (Or.inl rfl)) (fun p => ¬SizesOf lay2048 p.w p.pl p.ql)) (two_ite cond
    ((ifmaL_ct h2 (Or.inr (Or.inl rfl)) (fun p => SizesOf lay3072 p.w p.pl p.ql) fun _ _ _ _ _ _ _ _ _ _ h => h).mono
      (cont fun _ _ e => of_decide_eq_true e) fun _ _ h => h)
    ((ifmaL_ct h2 (Or.inr (Or.inr rfl)) (fun p => ¬SizesOf lay2048 p.w p.pl p.ql ∧ ¬SizesOf lay3072 p.w p.pl p.ql)
      fun p _ _ _ _ _ _ _ _ h ⟨n1, n2⟩ => ?_).mono
      (cont fun _ hx e => ⟨hx, of_decide_eq_false e⟩) fun _ _ h => h))).mono
    (cont fun _ _ e => of_decide_eq_false e) fun _ _ h => h
  have hs := sizes_of_rap h2 h
  rcases layOf_of l2 p.w with e | e | e <;> rw [e] at hs
  · exact absurd ((h2.sizes _ _ _).1 hs) n1
  · exact absurd hs n2
  · exact hs


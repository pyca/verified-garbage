@[expose] public section
namespace VG.Proof.Bignum.AArch64.WindowSetup
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Proof.Bignum
open VG.Proof.Bignum.AArch64
open VG.Proof.Bignum.AArch64.BlockedRedc (FastW blocks RedcPreCtx)
open VG.Proof.Bignum.AArch64.ProductEight (fast_width input_separation productBase)
open VG.Proof.Bignum.AArch64.SquareEight (frame_header)

structure DiagCtx (a : Nat) (L : Ws) (s : State) : Prop where
  fast : FastW L s
  x8 : s.gpr .x8 = off L.B (slot L.w Public.aAcc+16)
  x9 : s.gpr .x9 = off L.B (slot L.w a)
  x12 : s.gpr .x12 = BitVec.ofNat 64 L.w
  x7 : s.gpr .x7 = 0

theorem start_ctx (L : Ws) (s : State) (h : FastW L s) :
    WP isa (.block VG.Impl.Bignum.AArch64.WindowSetup.start) s (RedcPreCtx L) := by
  obtain ⟨mi,hg,hz⟩ := h.1
  refine WP.mono (start_ok hg.scr hg.x0 hg.hdr hz) fun t ⟨⟨h8,h12,h7,hm⟩,kt⟩ => ?_
  exact ⟨⟨⟨mi,⟨hg.scr.congr kt.wr,(kt.gpr .x0 (by decide)).trans hg.x0,hm ▸ hg.hdr⟩,hz⟩,h.2⟩,h8,h12,h7⟩

theorem square_ctx {a : Nat} (ha : a < 8) (L : Ws) (s : State) (h : FastW L s)
    (h7 : s.gpr .x7 = 0) :
    WP isa (.block (VG.Impl.Bignum.AArch64.WindowSetup.square a)) s (DiagCtx a L) := by
  obtain ⟨mi,hg,hz⟩ := h.1
  refine WP.mono (square_ok hg.scr hg.x0 hg.hdr hz ha) fun t ⟨⟨h8,h9,h12,hm⟩,kt⟩ => ?_
  exact ⟨⟨⟨mi,⟨hg.scr.congr kt.wr,(kt.gpr .x0 (by decide)).trans hg.x0,hm ▸ hg.hdr⟩,hz⟩,h.2⟩,
    h8,h9,h12,(kt.gpr .x7 (by decide)).trans h7⟩

theorem product_ctx (L : Ws) (s : State) (h : FastW L s) (h7 : s.gpr .x7 = 0) :
    WP isa (.block VG.Impl.Bignum.AArch64.WindowSetup.product) s (RedcPreCtx L) := by
  obtain ⟨mi,hg,hz⟩ := h.1
  refine WP.mono (product_ok hg.scr hg.x0 hg.hdr hz) fun t ⟨⟨h8,h12,hm⟩,kt⟩ => ?_
  exact ⟨⟨⟨mi,⟨hg.scr.congr kt.wr,(kt.gpr .x0 (by decide)).trans hg.x0,hm ▸ hg.hdr⟩,hz⟩,h.2⟩,
    h8,h12,(kt.gpr .x7 (by decide)).trans h7⟩

theorem pins_start : Pins RedcPreCtx [.x0,.x8,.x12,.x7] := by
  intro L s t hs ht r hr
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl
  · exact pins_goodW L s t hs.fast.1 ht.fast.1 .x0 (by simp)
  · exact hs.ptr.trans ht.ptr.symm
  · exact hs.count.trans ht.count.symm
  · exact hs.zero.trans ht.zero.symm

theorem pins_diagonal (a : Nat) : Pins (DiagCtx a) [.x8,.x9,.x12] := by
  intro L s t hs ht r hr
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hr
  rcases hr with rfl | rfl | rfl
  · exact hs.x8.trans ht.x8.symm
  · exact hs.x9.trans ht.x9.symm
  · exact hs.x12.trans ht.x12.symm

theorem diagonal_ctx {a : Nat} (ha : a < 8) (ha1 : a ≠ Public.aAcc) (ha2 : a ≠ Public.aTmp)
    (L : Ws) (s : State) (h : DiagCtx a L s) :
    WP isa VG.Impl.Bignum.AArch64.WideLoops.diagonal s (RedcPreCtx L) := by
  have fast : FastW L s := h.fast
  obtain ⟨he, hk, hk'⟩ := fast_width fast
  obtain ⟨mi, hg, hz⟩ := fast.1
  have hn := hg.scr.nowrap
  have hsize : slot (8*blocks L) 8 ≤ L.Z := he.symm ▸ hz
  have hP : productBase (blocks L)+8*(16*blocks L+2) ≤ L.Z := by
    unfold productBase slot Public.aAcc at *
    omega_using [he, hz]
  have hA : slot (8*blocks L) a+64*blocks L ≤ L.Z := by
    have := slot_le (w := 8*blocks L) ha
    omega_using [hsize, this]
  have sep := input_separation fast ha1 ha2
  have h8 : s.gpr .x8 = off L.B (productBase (blocks L)) := by
    simpa only [productBase, he] using h.x8
  have h9 : s.gpr .x9 = off L.B (slot (8*blocks L) a) := by rw [he]; exact h.x9
  have h12 : s.gpr .x12 = BitVec.ofNat 64 (4*(2*blocks L)) := by
    rw [show 4*(2*blocks L) = 8*blocks L by omega_using [], he]
    exact h.x12
  refine WP.mono (WideLoops.diagonal_ok hg.scr h8 h9 h12 h.x7 (by omega_using [hk]) (by omega_using [hk'])
    (by omega_using [hP]) (by omega_using [hA]) (by omega_using [sep])) fun t ⟨_, hto, _, kt⟩ => ?_
  have hout : Outside L.B (productBase (blocks L)) (8*(16*blocks L+2)) s.mem t.mem :=
    hto.mono (by omega_using []) (by omega_using [])
  have hHt : Hdr t.mem L.B L.w mi := he ▸ frame_header hout (he.symm ▸ hg.hdr)
  exact ⟨⟨⟨mi, ⟨hg.scr.congr kt.wr, (kt.gpr _ (by decide)).trans hg.x0, hHt⟩, hz⟩, h.fast.2⟩,
    (kt.gpr _ (by decide)).trans h.x8, (kt.gpr _ (by decide)).trans h.x12,
    (kt.gpr _ (by decide)).trans h.x7⟩

end VG.Proof.Bignum.AArch64.WindowSetup

end

end

@[expose] public section
namespace VG.Proof.Bignum.AArch64.WindowRaw
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Proof.Bignum
open VG.Proof.Bignum.AArch64
open VG.Proof.Bignum.AArch64.BlockedRedc (FastW blocks RedcPreCtx)

open VG.Proof.Bignum.AArch64.ProductEight (SetupFast LoopCtx fast_width productBase start_ok)

def preparation (a : Nat) : Prog isa :=
 .seq VG.Impl.Bignum.AArch64.WideLoops.zero
  (.block [ldh .x8 (sArr a), .lsr .x .x12 .x12 3])

theorem preparation_ctx {a b : Nat} (ha : a < 8)
    (L : Ws) (s : State) (h : RedcPreCtx L s) :
    WP isa (preparation a) s fun t => 0 < blocks L ∧ LoopCtx a b L 0 t := by
  have fast : FastW L s := h.fast
  obtain ⟨he, hk, hk'⟩ := fast_width fast
  obtain ⟨mi, hg, hz⟩ := fast.1
  have hn := hg.scr.nowrap
  have hP : productBase (blocks L) + 8 * (16 * blocks L + 2) ≤ L.Z := by
    unfold productBase
    rw [he]
    unfold slot Public.aAcc at *
    omega_using [he, hz]
  have h8 : s.gpr .x8 = off L.B (productBase (blocks L)) := by
    simpa only [productBase, he] using h.ptr
  have h12 : s.gpr .x12 = BitVec.ofNat 64 (8 * blocks L) := by rw [he]; exact h.count
  unfold preparation
  refine WP.seq (WP.mono (WideLoops.zero_ok hg.scr h8 h.zero h12 hP hk hk')
    fun u ⟨hu0, huo, ku⟩ => ?_)
  have hlen : 2 * (8 * (blocks L)) = 16 * (blocks L) := by omega_using []
  have hframe := Square.scratch_arrays (s := s) (t := u) (B := L.B) (w := 8 * blocks L)
    (by simpa only [productBase, hlen] using huo)
  have hh : Hdr u.mem L.B (8 * blocks L) mi := hframe.hdr (he.symm ▸ hg.hdr)
  refine WP.mono (start_ok (hg.scr.congr ku.wr)
    ((ku.gpr .x0 (by decide)).trans hg.x0) hh (he.symm ▸ hz) ha hk'
    ((ku.gpr .x12 (by decide)).trans h12))
    fun t ⟨⟨ht8, ht12, htm, _⟩, kt⟩ => ?_
  have kall := ku.trans kt
  have hHt : Hdr t.mem L.B L.w mi := by
    rw [htm]
    exact he ▸ hh
  refine ⟨hk, ⟨⟨⟨mi, ⟨hg.scr.congr kall.wr, (kall.gpr .x0 (by decide)).trans hg.x0,
    hHt⟩, hz⟩, h.fast.2⟩, ht8, ht12, (kall.gpr .x7 (by decide)).trans h.zero, ?_⟩⟩
  rw [htm, hu0]
  simp only [wv, Nat.zero_mul]

def squarePreparation (a : Nat) : Prog isa :=
 .seq (.block VG.Impl.Bignum.AArch64.WindowSparse.padding)
  (.block [ldh .x8 (sArr a), .lsr .x .x12 .x12 3])

theorem square_preparation_ctx {a : Nat} (ha : a < 8)
    (L : Ws) (s : State) (h : RedcPreCtx L s) :
    WP isa (squarePreparation a) s fun t => 0 < blocks L ∧ WindowSparse.LoopCtx a L 0 t := by
  have fast : FastW L s := h.fast
  obtain ⟨he, hk, hk'⟩ := fast_width fast
  obtain ⟨mi, hg, hz⟩ := fast.1
  have hn := hg.scr.nowrap
  have hP : productBase (blocks L) + 8 * (16 * blocks L + 2) ≤ L.Z := by
    unfold productBase
    rw [he]
    unfold slot Public.aAcc at *
    omega_using [he, hz]
  have h8 : s.gpr .x8 = off L.B (productBase (blocks L)) := by
    simpa only [productBase, he] using h.ptr
  have h12 : s.gpr .x12 = BitVec.ofNat 64 (8 * blocks L) := by rw [he]; exact h.count
  unfold squarePreparation
  refine WP.seq (WP.mono (WindowSparse.padding_ok (e := productBase (blocks L)) hg.scr h8 h12 h.zero (by omega_using [hP]) hk')
    fun u ⟨hu0, huo, ku⟩ => ?_)
  have hlen : 2 * (8 * (blocks L)) = 16 * (blocks L) := by omega_using []
  have hframe := Square.scratch_arrays (s := s) (t := u) (B := L.B) (w := 8 * blocks L)
    (by simpa only [productBase, hlen] using huo.mono (o' := productBase (blocks L)) (n' := 8*(16*blocks L+2)) (by omega_using []) (by omega_using []))
  have hh : Hdr u.mem L.B (8 * blocks L) mi := hframe.hdr (he.symm ▸ hg.hdr)
  refine WP.mono (start_ok (hg.scr.congr ku.wr)
    ((ku.gpr .x0 (by decide)).trans hg.x0) hh (he.symm ▸ hz) ha hk'
    ((ku.gpr .x12 (by decide)).trans h12))
    fun t ⟨⟨ht8, ht12, htm, _⟩, kt⟩ => ?_
  have kall := ku.trans kt
  have hHt : Hdr t.mem L.B L.w mi := by
    rw [htm]
    exact he ▸ hh
  refine ⟨hk, ⟨⟨⟨mi, ⟨hg.scr.congr kall.wr, (kall.gpr .x0 (by decide)).trans hg.x0,
    hHt⟩, hz⟩, h.fast.2⟩, ht8, ht12, (kall.gpr .x7 (by decide)).trans h.zero, ?_⟩⟩
  rfl

theorem square_finish_ctx {a : Nat} (ha : a < 8)
    (L : Ws) (s : State) (h : WindowSparse.LoopCtx a L (blocks L) s) :
    WP isa (.block (VG.Impl.Bignum.AArch64.WindowSetup.square a)) s (WindowSetup.DiagCtx a L) :=
  WindowSetup.square_ctx ha L s h.fast h.zero

theorem product_finish_ctx {a b : Nat}
    (L : Ws) (s : State) (h : LoopCtx a b L (blocks L) s) :
    WP isa (.block VG.Impl.Bignum.AArch64.WindowSetup.product) s (RedcPreCtx L) :=
  WindowSetup.product_ctx L s h.fast h.zero

end VG.Proof.Bignum.AArch64.WindowRaw

end

end

@[expose] public section
namespace VG.Proof.Bignum.AArch64.WindowRaw
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Proof.Bignum
open VG.Proof.Bignum.AArch64
open VG.Proof.Bignum.AArch64.BlockedRedc (FastW RedcPreCtx)
open VG.Proof.Bignum.AArch64.ProductEight (SetupFast)

theorem triangle_ct : RelCT isa (Two FastW)
    (VG.Impl.Bignum.AArch64.WindowRaw.triangle 6) (Two (WindowSetup.DiagCtx 6)) := by
  unfold VG.Impl.Bignum.AArch64.WindowRaw.triangle
  refine RelCT.seq (two_piece _ ProductEight.pins_fast (by taint_decide)
    WindowSetup.start_ctx) ?_
  apply RelCT.assoc
  exact RelCT.seq (two_piece _ WindowSetup.pins_start (by taint_decide)
    (square_preparation_ctx (by decide)))
    (RelCT.seq (WindowSparse.rows_ct (by decide) (by decide) (by decide)
      (by taint_decide) (by taint_decide))
      (two_piece _ (fun L s t hs ht => pins_goodW L s t hs.fast.1 ht.fast.1) (by taint_decide) (square_finish_ctx (by decide))))

theorem square_ct : RelCT isa (Two FastW)
    (VG.Impl.Bignum.AArch64.WindowRaw.square 6) (Two RedcPreCtx) :=
  RelCT.seq triangle_ct (two_piece _ (WindowSetup.pins_diagonal 6) (by taint_decide)
    (WindowSetup.diagonal_ctx (by decide) (by decide) (by decide)))

theorem product_ct : RelCT isa (Two FastW)
    (VG.Impl.Bignum.AArch64.WindowRaw.product 6 5) (Two RedcPreCtx) := by
  unfold VG.Impl.Bignum.AArch64.WindowRaw.product
  refine RelCT.seq (two_piece _ ProductEight.pins_fast (by taint_decide)
    WindowSetup.start_ctx) ?_
  apply RelCT.assoc
  exact RelCT.seq (two_piece _ WindowSetup.pins_start (by taint_decide)
    (preparation_ctx (b := 5) (by decide)))
    (RelCT.seq (ProductEight.rows_ct (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by taint_decide))
      (two_piece _ (ProductEight.pins_final 6 5) (by taint_decide) product_finish_ctx))

end VG.Proof.Bignum.AArch64.WindowRaw

end


@[expose] public section
namespace VG.Proof.Bignum.AArch64.WindowShared
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Proof.Bignum.AArch64
open VG.Proof.MlKem.AArch64 (Keep)
open VG.Proof.Bignum.AArch64.WindowFive (TableCtx)

def LooseCtx (p : XPub) (s : State) : Prop :=
  ∃ mi X Xc, TableCtx s (off p.B p.o) p.wx mi X Xc ∧ 16 ≤ p.wx ∧ p.wx < 2^30 ∧ p.wx % 8 = 0

def workspace (p : XPub) : Ws := ⟨off p.B p.o,slot p.wx 8,p.wx⟩

theorem loose_fast {p : XPub} {s : State} (h : LooseCtx p s) : BlockedRedc.FastW (workspace p) s := by
  obtain ⟨mi,X,Xc,hc,hw,hw',hd⟩ := h
  exact ⟨⟨mi,hc.good,Nat.le_refl _⟩,hw,hd⟩

theorem pins_loose : Pins LooseCtx [.x0] := by
  intro p s t hs ht r hr
  obtain ⟨_,_,_,cs,_⟩ := hs
  obtain ⟨_,_,_,ct,_⟩ := ht
  have : r = .x0 := by simpa using hr
  subst r
  exact cs.good.x0.trans ct.good.x0.symm

def LoopP (p : XPub) (j : Nat) (s : State) : Prop :=
  LooseCtx p s ∧ word s.mem (off p.B p.o) (8*Crt.sBit) = BitVec.ofNat 64 (5-j)

theorem square_loop_ctx (p : XPub × Nat) (s : State) (h : LoopP p.1 p.2 s) :
    WP isa (VG.Impl.Bignum.AArch64.WindowArithmetic.square 6) s (LoopP p.1 p.2) := by
  obtain ⟨⟨mi,X,Xc,hc,hw,hw',hd⟩,hb⟩ := h
  refine WP.mono (square_ok hc hw hw' hd) fun t ⟨ct,_,hh,_,_⟩ => ?_
  exact ⟨⟨mi,X,Xc,ct,hw,hw',hd⟩,(hh _ (by decide)).trans hb⟩

theorem step_ct : RelCT isa (Two fun p : XPub × Nat => fun s => p.2 < 5 ∧ LoopP p.1 p.2 s)
    VG.Impl.Rsa.AArch64.WindowShared.step (fun _ _ => True) := by
  unfold VG.Impl.Rsa.AArch64.WindowShared.step
  refine RelCT.seq (two_post (two_map (fun p : XPub × Nat => workspace p.1)
    (fun _ _ h => loose_fast h.2.1) WindowArithmetic.square_ct)
    (fun p s h => square_loop_ctx p s h.2)) ?_
  exact two_taint [.x0] (fun p s t hs ht => pins_loose p.1 s t hs.1 ht.1) (by taint_decide)

theorem step_loop_ctx (p : XPub) (j : Nat) (s : State) (hj : j < 5) (h : LoopP p j s) :
    WP isa VG.Impl.Rsa.AArch64.WindowShared.step s fun t =>
      LoopP p (j+1) t ∧ t.gpr .x3 = BitVec.ofNat 64 (5-(j+1)) := by
  obtain ⟨⟨mi,X,Xc,hc,hw,hw',hd⟩,hb⟩ := h
  refine WP.mono (step_ok (k := 0) (A := wv s.mem (off p.B p.o) (slot p.wx Public.aY) p.wx)
    hc hw hw' hd hj hb (by simp)) fun t ⟨ct,_,hb',h3,_⟩ => ?_
  exact ⟨⟨⟨mi,X,Xc,ct,hw,hw',hd⟩,hb'⟩,h3⟩

theorem loop_ct : RelCT isa (Two fun p s => LoopP p 0 s)
    VG.Impl.Rsa.AArch64.WindowShared.squares (Two fun p s => LoopP p 5 s) := by
  apply RelCT.mono (two_loop (fun _ : XPub => 5) step_ct ?_) (fun _ _ h => ?_) (fun _ _ h => h)
  · intro p j s hj h
    refine WP.mono (step_loop_ctx p j s hj h) fun t ⟨ht,h3⟩ => ?_
    refine ⟨?_,fun _ => ht,fun he => he ▸ ht⟩
    rw [VG.Proof.MlKem.AArch64.eval_nonzero,h3,VG.Proof.MlKem.AArch64.ne_zero_iff,
      BitVec.toNat_ofNat,Nat.mod_eq_of_lt (show 5-(j+1) < 2^64 by omega_using [])]
    exact congrArg some (decide_eq_decide.mpr (by omega_using []))
  · obtain ⟨p,hs,ht,hsp⟩ := h
    exact ⟨p,⟨by decide,hs⟩,⟨by decide,ht⟩,hsp⟩

end VG.Proof.Bignum.AArch64.WindowShared

end

end

@[expose] public section
namespace VG.Proof.Bignum.AArch64.WindowShared
open VG VG.AArch64 VG.Impl.Bignum VG.Impl.Bignum.AArch64 VG.Proof.Bignum VG.Proof.Bignum.AArch64
open VG.Proof.MlKem.AArch64 (Keep)
open VG.Proof.Bignum.AArch64.WindowFive (TableCtx)

def FastPre (p : XPub) (s : State) : Prop :=
  ∃ mi X Xc v, TableCtx s (off p.B p.o) p.wx mi X Xc ∧
    CrtWindowFive.CTab s.mem (off p.B p.o) p.wx X False 0 ∧
    16 ≤ p.wx ∧ p.wx < 2^30 ∧ p.wx % 8 = 0 ∧ v < 32 ∧
    word s.mem (off p.B p.o) (8*Crt.sNib) = BitVec.ofNat 64 v

def CorePre (p : XPub) (s : State) : Prop :=
  FastPre p s ∧ word s.mem (off p.B p.o) (8*Crt.sBit) = BitVec.ofNat 64 5

theorem fast_loose {p : XPub} {s : State} (h : FastPre p s) : LooseCtx p s := by
  obtain ⟨mi,X,Xc,v,hc,ht,hw,hw',hd,hv,hn⟩ := h
  exact ⟨mi,X,Xc,hc,hw,hw',hd⟩

theorem squares_post (p : XPub) (s : State) (h : CorePre p s) :
    WP isa VG.Impl.Rsa.AArch64.WindowShared.squares s (FastPre p) := by
  obtain ⟨⟨mi,X,Xc,v,hc,ht,hw,hw',hd,hv,hn⟩,hb⟩ := h
  refine WP.mono (squares_ok hc hw hw' hd hb) fun t ⟨ct,_,hh,hf,_⟩ => ?_
  exact ⟨mi,X,Xc,v,ct,ht.of_win hf hc.scrT.nowrap,hw,hw',hd,hv,
    (hh _ (by decide) (by decide)).trans hn⟩

theorem core_ct : RelCT isa (Two CorePre)
    VG.Impl.Rsa.AArch64.WindowShared.core (fun _ _ => True) := by
  unfold VG.Impl.Rsa.AArch64.WindowShared.core
  refine RelCT.seq (two_post (two_map id (fun _ _ h => ⟨fast_loose h.1,h.2⟩)
    (loop_ct.mono (fun _ _ h => h) (fun _ _ _ => True.intro))) squares_post) ?_
  refine RelCT.seq (two_post (Ψ := fun p => BlockedRedc.FastW (workspace p))
    (two_map id ?_ WindowVector.blocked_ct) ?_)
    (two_map workspace (fun _ _ h => h) WindowArithmetic.product_ct)
  · rintro p s ⟨mi,X,Xc,v,hc,ht,hw,hw',hd,hv,hn⟩
    exact ⟨⟨mi,X,Xc,v,hc,by change 2 ≤ p.wx; omega_using [hw],hw',hv,ht.tab,hn⟩,by change 8 ≤ p.wx; omega_using [hw]⟩
  · rintro p s ⟨mi,X,Xc,v,hc,ht,hw,hw',hd,hv,hn⟩
    exact WP.mono (WindowVector.blocked_ok hc (by omega_using [hw]) hw' hd hv ht.tab hn)
      fun t ⟨ct,_⟩ => ⟨⟨mi,ct.good,Nat.le_refl _⟩,hw,hd⟩

theorem init_post (p : XPub) (s : State) (h : FastPre p s) :
    WP isa (.block [movi .x3 5,sth .x3 Crt.sBit]) s (CorePre p) := by
  obtain ⟨mi,X,Xc,v,hc,ht,hw,hw',hd,hv,hn⟩ := h
  refine WP.mono (init_ok hc) fun t ⟨hm,kt⟩ => ?_
  have hout := writeW_outside s.mem (off p.B p.o) (d := 8*Crt.sBit) (BitVec.ofNat 64 5) (by decide)
  rw [← hm] at hout
  have hf : Frm (off p.B p.o) (crtWinRanges p.wx) s.mem t.mem :=
    Frm.of_outside hout (by simp [crtWinRanges])
  refine ⟨⟨mi,X,Xc,v,hc.of_win hf kt.wr (kt.gpr .x0 (by decide)),
    ht.of_win hf hc.scrT.nowrap,hw,hw',hd,hv,?_⟩,?_⟩
  · rw [hm,hdrStore_hdr _ _ _ (by decide) (by decide) (by decide)]; exact hn
  · rw [hm,word_writeW_self]

theorem work_ct : RelCT isa (Two FastPre)
    VG.Impl.Rsa.AArch64.WindowShared.work (fun _ _ => True) :=
  RelCT.seq (two_piece [.x0] (fun p s t hs ht => pins_loose p s t (fast_loose hs) (fast_loose ht))
    (by taint_decide) init_post) core_ct


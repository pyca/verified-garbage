def subLowNormChk (p : Params) (i : Nat) : Bool :=
  inB (sgR p++sgW p) (wP p i) 1024 && inB (sgR p++sgW p) t1P 1024 &&
  inB (sgR p++sgW p) (hP i) 1024 && inB (sgW p) (wP p i) 1024 && inB (sgW p) (hP i) 1024 &&

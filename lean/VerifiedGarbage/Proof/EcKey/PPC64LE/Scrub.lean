/-!
# Elliptic-curve public keys on PPC64LE, without secret residue

For every curve, `vg_ec_<curve>_public_key`, `_compress_public_key` and
`_decompress_public_key`, each followed by `Impl.Scrub.PPC64LE.scrubTail`
(`PPC64LE.Scrub.withScrub`), which clears the volatile registers and the
stack its frames used. Their postconditions read the memory on return only
within `out` (`Proof/EcKey/PPC64LE/Scrub/Out.lean`).
-/

@[expose] public section

namespace VG.Proof.EcKey.PPC64LE.Scrub

open VG.PPC64LE VG.PPC64LE.Scrub VG.Spec.EcKey

/-! ## The registrations -/

/-- `Spec.EcKey.P192.publicKeyApi`. -/
def p192PublicKey : Registration Spec.EcKey.P192.publicKeyApi PPC64LE.target :=
  withScrub {
      code := Impl.EcKey.PPC64LE.publicKeyP192
      verified := Proof.EcKey.PPC64LE.P192.pk_verified Proof.P192.PPC64LE.hasLaw.law }
    (publicKeyOut _ _ [])

/-- `Spec.EcKey.P192.inst.compressPublicKeyApi`. -/
def p192Compress : Registration Spec.EcKey.P192.inst.compressPublicKeyApi PPC64LE.target :=
  withScrub {
      code := Impl.EcKey.Compressed.PPC64LE.compressP192
      verified := Proof.EcKey.Compressed.PPC64LE.P192.compress_verified }
    (compressOut _ _ [])


/-!
# Elliptic-curve public keys on PPC64LE, without secret residue

For every curve, `vg_ec_<curve>_public_key`, `_compress_public_key` and
`_decompress_public_key`, each followed by `Impl.Scrub.PPC64LE.scrubTail`
(`PPC64LE.Scrub.verifiedScrubbed`), which clears the volatile registers and the
stack its frames used. Their postconditions read the memory on return only
within `out` (`Proof/EcKey/PPC64LE/Scrub/Out.lean`).
-/

@[expose] public section

namespace VG.Proof.EcKey.PPC64LE.Scrub

open VG.PPC64LE VG.PPC64LE.Scrub VG.Spec.EcKey
open VG.Proof.Weierstrass (Law)

/-! ## The functions as emitted -/

/-- `Spec.EcKey.P192.publicKeyApi`'s function as emitted
(`Impl.EcKey.PPC64LE.Fn.p192PublicKey`) meets its contract in constant time
and returns without secret residue. -/
theorem p192PublicKey_scrubbed (hL : Law Spec.P192.curve) :
    VerifiedScrubbed PPC64LE.target Impl.EcKey.PPC64LE.Fn.p192PublicKey
      (Spec.EcKey.P192.inst.publicKeyContract PPC64LE.abi) 32 :=
  verifiedScrubbed (api := Spec.EcKey.P192.publicKeyApi) {
      code := Impl.EcKey.PPC64LE.publicKeyP192
      verified := Proof.EcKey.PPC64LE.P192.pk_verified hL }
    0 ⟨true, true, [.r4, .r5, .r6, .r7, .r8, .r9, .r10, .r11, .r12], true, []⟩
    (publicKeyOut _ _ [])
    (by dsimp only; lit_decide)


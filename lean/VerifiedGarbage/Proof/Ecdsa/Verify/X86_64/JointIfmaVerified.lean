  · exact VG.Taint.constantTime (A := taint) (Taint.ofRegs [.rdi]) (fun _ _ _ _ h => h) (by taint_decide)
  · exact VG.Taint.constantTime (A := taint) (Taint.ofRegs (nafPrepPublicN 4)) (fun _ _ _ _ h => h) (by taint_decide)


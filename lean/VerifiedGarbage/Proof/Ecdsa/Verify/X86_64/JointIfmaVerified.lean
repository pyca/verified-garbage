theorem joint_ifma_vchecks : VChecks publicJointIfma where
  head := VG.Taint.constantTime (A := taint) (Taint.ofRegs [.rdi, .r10, .r11, .rbx]) (fun _ _ _ _ h => h)
    (by taint_decide)

 have ca := CacheUpTo.ofMem ka.mem h.cache
 have a19 := (ka.gpr .x19 (by decide)).trans h.x19
 have ab : GBytes base u j a := ⟨by rw [ka.mem]; exact hbytes.lo,by rw [ka.mem]; exact hbytes.hi⟩

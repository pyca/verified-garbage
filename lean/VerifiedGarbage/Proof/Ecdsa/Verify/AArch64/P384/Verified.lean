   (by change 3152+2*j+2≤8192; omega_using [hj]) h.x19 hbytes.lo hbytes.hi) fun a ⟨a2,_,a3,ka⟩ sa => ?_
 have ia := (hi.of_keeps ka (by decide)).to_tmv

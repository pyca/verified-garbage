/-! ### `AesGcmSiv.RISCV64.KeysCT`, which only this module used -/

section

/-!
# AES-GCM-SIV on RISC-V: the keys in two runs

Untrusted: everything here is checked by Lean. `keys`, run from two states
in the same environment, leaks the same: the code between calls by the
taint analysis (`rel_env`), each call of `vg_aes_encrypt_blocks` and
`vg_aes_expand_key_scratch` by its proof. The
loops of `derive` run for `rounds / 2 - 1` steps, which the environment
fixes, and its call is on that many blocks (`s11`) in both runs.
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.Impl.AesGcmSiv.RISCV64 VG.RISCV64
open VG.RISCV64.Steps (wp_li)
open VG.Proof.Gather.RISCV64 (Eq2 TT)
open VG.Proof.AesCcm.RISCV64 (Runs Runs.of_wp Runs.mono Runs.and rel_seqR rel_of_eq2 rel_post)
open VG.Proof.AesGcm.RISCV64 (CtrCall)

/-- `derive`. -/
theorem derive_rel {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp) :
    RelCT isa (Eq2 σ₁ σ₂) derive TT := by
  unfold derive
  refine rel_seqR (rel_env [] E₁ E₂ hsp (by simp) ⟨_, by taint_decide⟩) (Runs.of_wp (build_wp L E₁))
    (Runs.of_wp (build_wp L E₂)) fun τ₁ τ₂ I₁ I₂ => ?_
  have hsp₁ : τ₁.sp = τ₂.sp := by rw [I₁.pk.sp, I₂.pk.sp, hsp]
  refine rel_seqR (rel_env [.s11] I₁.env I₂.env hsp₁ (fun r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr; subst hr; rw [I₁.s11, I₂.s11])
      ⟨_, by taint_decide⟩) (Runs.of_wp (dargs_wp L I₁.env I₁.s11)) (Runs.of_wp (dargs_wp L I₂.env I₂.s11))
    fun ρ₁ ρ₂ ⟨pk₁, _, s11₁, B₁⟩ ⟨pk₂, _, s11₂, B₂⟩ => ?_
  have hsp₂ : ρ₁.sp = ρ₂.sp := by rw [pk₁.sp, pk₂.sp, hsp₁]
  refine rel_seqR (rel_enc B₁ B₂ hsp₂) (enc_runs (I₁.env.of_pk pk₁) B₁) (enc_runs (I₂.env.of_pk pk₂) B₂)
    fun ω₁ ω₂ G₁ G₂ => ?_
  refine rel_env [.s11] G₁.1 G₂.1 (by rw [G₁.2.1, G₂.2.1, hsp₂]) (fun r hr => ?_) ⟨_, by taint_decide⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  subst hr
  rw [G₁.2.2 .s11 (by simp), G₂.2.2 .s11 (by simp), s11₁, s11₂, I₁.s11, I₂.s11]

/-- `expand`'s block: the call's arguments, and what it keeps. -/
theorem expArgs_runs {c : Cx} (L : Lay c) {t : State} (E : Env c t) :
    Runs (.block expandArgs) t fun t' =>
      Proof.AesGcm.RISCV64.KeyCall t' (c.W + BitVec.ofNat 64 32) (Spec.GcmSiv.keyLen c.R) (c.W + BitVec.ofNat 64 256)
        (c.W + BitVec.ofNat 64 1792) ∧ Kept c t t' :=
  (Runs.and (Runs.of_wp (expArgs_wp L E)) (Runs.kept E [.a0, .a1, .a2, .a3] (by decide +kernel))).mono
    fun _ ⟨⟨_, _, kc⟩, K⟩ => ⟨kc, K⟩

/-- `keys`. -/
theorem keys_rel {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp) :
    RelCT isa (Eq2 σ₁ σ₂) keys TT := by
  unfold keys
  refine rel_seqR (derive_rel L E₁ E₂ hsp) (Runs.of_wp (derive_wp L E₁)) (Runs.of_wp (derive_wp L E₂))
    fun τ₁ τ₂ I₁ I₂ => ?_
  have hsp₁ : τ₁.sp = τ₂.sp := by rw [I₁.pk.sp, I₂.pk.sp, hsp]
  refine rel_seqR ?_ (Runs.of_wp (expand_wp L I₁.env)) (Runs.of_wp (expand_wp L I₂.env)) fun ρ₁ ρ₂ X₁ X₂ => ?_
  · unfold expand
    refine rel_seqR (rel_env [] I₁.env I₂.env hsp₁ (by simp) ⟨_, by taint_decide⟩) (expArgs_runs L I₁.env)
      (expArgs_runs L I₂.env) fun ω₁ ω₂ ⟨k₁, K₁⟩ ⟨k₂, K₂⟩ => ?_
    exact rel_key k₁ k₂ (by rw [K₁.2.1, K₂.2.1, hsp₁])
  · exact rel_env [] (I₁.env.of_pk X₁.pk) (I₂.env.of_pk X₂.pk) (by rw [X₁.pk.sp, X₂.pk.sp, hsp₁]) (by simp)
      ⟨_, by taint_decide⟩

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-! ### `AesGcmSiv.RISCV64.CryptCT`, which only this module used -/

section

/-!
# AES-GCM-SIV on RISC-V: the tag and counter mode in two runs

Untrusted: everything here is checked by Lean. `tag o` and `crypt`, run from
two states in the same environment, leak the same: the code between calls
by the taint analysis (`rel_env`), from the pointer `s9`, the count `s10`
and a chunk's number of blocks `s11`, which are public in both runs, and
each call of `vg_aes_ctr32` and `vg_aes_encrypt_blocks` by its proof
(`rel_ctr`, `rel_enc`). The loop of chunks relates two runs after the same
number of blocks, which the correctness proofs describe (`BlocksPost`).
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.Impl.AesGcmSiv.RISCV64 VG.RISCV64
open VG.Proof.Gather.RISCV64 (Eq2 TT rel_ite)
open VG.Proof.AesCcm.RISCV64 (Runs Runs.of_wp Runs.mono Runs.and rel_seqR rel_of_eq2 rel_post)
open VG.Spec.Aes (bytesAt)

/-- `tag o`. -/
theorem tag_rel {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp)
    {o : Nat} (ho : o = 0 ∨ o = 240) : RelCT isa (Eq2 σ₁ σ₂) (tag o) TT := by
  have t : ∃ h, (taint.check (Taint.ofRegs (envRegs ++ []))
      (.block (copy16 cbO ccO ++ zero16 o ++ ctrArgs ++ ([.addi .a3 .s0 o, .li .a4 1] : List Instr))) h).isSome
        = true := by
    rcases ho with rfl | rfl <;> exact ⟨_, by taint_decide⟩
  unfold tag
  exact rel_seqR (rel_env [] E₁ E₂ hsp (by simp) t) (Runs.of_wp (tagArgs_wp L E₁ ho))
    (Runs.of_wp (tagArgs_wp L E₂ ho)) fun τ₁ τ₂ ⟨pk₁, _, C₁, _⟩ ⟨pk₂, _, C₂, _⟩ =>
      rel_ctr C₁ C₂ (by rw [pk₁.sp, pk₂.sp, hsp])

/-- One chunk, from two runs after the same number `j` of blocks. -/
theorem cryptChunk_rel {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂)
    (hsp : σ₁.sp = σ₂.sp) {j : Nat} (hj : j < c.n / 16) {icb₁ icb₂ : List Byte}
    (C₁ : CtrSt c.W icb₁ j σ₁.mem) (C₂ : CtrSt c.W icb₂ j σ₂.mem)
    (h9₁ : σ₁.gpr .s9 = c.D + BitVec.ofNat 64 (16 * j)) (h9₂ : σ₂.gpr .s9 = c.D + BitVec.ofNat 64 (16 * j))
    (h10₁ : σ₁.gpr .s10 = BitVec.ofNat 64 (c.n - 16 * j)) (h10₂ : σ₂.gpr .s10 = BitVec.ofNat 64 (c.n - 16 * j)) :
    RelCT isa (Eq2 σ₁ σ₂) cryptChunk TT := by
  have hn := L.n_lt
  generalize hkd : min ((c.n - 16 * j) / 16) 64 = k
  have hk1 : 1 ≤ k := by omega_using [hj, hkd]
  have hk : k ≤ 64 := by omega_using [hkd]
  unfold cryptChunk
  refine rel_seqR (rel_env [.s10] E₁ E₂ hsp (by simp [h10₁, h10₂]) ⟨_, by taint_decide⟩)
    (Runs.of_wp (chunkLen_wp (m := c.n - 16 * j) (by omega_using [hn]) h10₁))
    (Runs.of_wp (chunkLen_wp (m := c.n - 16 * j) (by omega_using [hn]) h10₂)) fun τ₁ τ₂ u₁ u₂ => ?_
  rw [hkd] at u₁ u₂
  have F₁ := E₁.of_pk (PK.ofUpd u₁)
  have F₂ := E₂.of_pk (PK.ofUpd u₂)
  have hsp₁ : τ₁.sp = τ₂.sp := by rw [u₁.sp, u₂.sp, hsp]
  refine rel_seqR (rel_env [.s11] F₁ F₂ hsp₁ (by simp [u₁.gpr, u₂.gpr]) ⟨_, by taint_decide⟩)
    (Runs.of_wp (ctrBuild_wp L F₁ hk1 hk (by rw [u₁.mem]; exact C₁) u₁.gpr))
    (Runs.of_wp (ctrBuild_wp L F₂ hk1 hk (by rw [u₂.mem]; exact C₂) u₂.gpr)) fun ρ₁ ρ₂ G₁ G₂ => ?_
  have hsp₂ : ρ₁.sp = ρ₂.sp := by rw [G₁.pk.sp, G₂.pk.sp, hsp₁]
  refine rel_seqR (rel_env [] G₁.env G₂.env hsp₂ (by simp) ⟨_, by taint_decide⟩)
    (Runs.of_wp (encArgs_wp L G₁.env hk G₁.s11)) (Runs.of_wp (encArgs_wp L G₂.env hk G₂.s11))
    fun ω₁ ω₂ ⟨pk₁, _, k₁, B₁⟩ ⟨pk₂, _, k₂, B₂⟩ => ?_
  have hsp₃ : ω₁.sp = ω₂.sp := by rw [pk₁.sp, pk₂.sp, hsp₂]
  refine rel_seqR (rel_enc B₁ B₂ hsp₃) (enc_runs (G₁.env.of_pk pk₁) B₁) (enc_runs (G₂.env.of_pk pk₂) B₂)
    fun χ₁ χ₂ K₁ K₂ => ?_
  refine rel_env [.s9, .s10, .s11] K₁.1 K₂.1 (by rw [K₁.2.1, K₂.2.1, hsp₃]) (fun r hr => ?_) ⟨_, by taint_decide⟩
  rw [K₁.2.2 r hr, K₂.2.2 r hr, k₁ r hr, k₂ r hr]
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl
  · rw [G₁.s9, G₂.s9, u₁.other _ (by decide), u₂.other _ (by decide), h9₁, h9₂]
  · rw [G₁.s10, G₂.s10, u₁.other _ (by decide), u₂.other _ (by decide), h10₁, h10₂]
  · rw [G₁.s11, G₂.s11]

/-- `crypt`. -/
theorem crypt_rel {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp) :
    RelCT isa (Eq2 σ₁ σ₂) crypt TT := by
  have hn := L.n_lt
  unfold crypt
  refine rel_seqR (rel_env [] E₁ E₂ hsp (by simp) ⟨_, by taint_decide⟩) (Runs.of_wp (cryptHead_wp L E₁))
    (Runs.of_wp (cryptHead_wp L E₂)) fun τ₁ τ₂ H₁ H₂ => ?_
  have F₁ := E₁.of_pk H₁.pk
  have F₂ := E₂.of_pk H₂.pk
  have hsp₁ : τ₁.sp = τ₂.sp := by rw [H₁.pk.sp, H₂.pk.sp, hsp]
  have hxl₁ : (bytesAt σ₁.mem c.D c.n).length = c.n := Proof.Cmac.bytesAt_length _ _ _
  have hxl₂ : (bytesAt σ₂.mem c.D c.n).length = c.n := Proof.Cmac.bytesAt_length _ _ _
  -- What the whole blocks leave in each run, from the correctness proofs.
  have mid : ∀ {σ τ : State}, Env c σ → HeadPost c σ τ → Runs (.ite (.zero .a7) (.block [])
      (.loop cryptChunk (.nonzero .a7))) τ fun ρ => PK τ ρ ∧ ρ.gpr .s9 = c.D + BitVec.ofNat 64 (16 * (c.n / 16)) ∧
        ρ.gpr .s10 = BitVec.ofNat 64 (c.n - 16 * (c.n / 16)) := fun {σ τ} E H => by
    refine Runs.of_wp (WP.ite (decide (c.n / 16 = 0)) (Steps.eval_zero_ofNat _ _ (by omega_using [hn]) H.a7) (fun ht => ?_) (fun hf => ?_))
    · have h0 : c.n / 16 = 0 := by simpa using ht
      exact WP.block_nil ⟨PK.refl _, by rw [H.s9, h0, Nat.mul_zero, BitVec.add_zero],
        by rw [H.s10, h0, Nat.mul_zero, Nat.sub_zero]⟩
    · have h0 : c.n / 16 ≠ 0 := by simpa using hf
      exact WP.mono (blocks_wp L (E.of_pk H.pk) (Proof.Cmac.bytesAt_length σ.mem c.D c.n) (by omega_using [h0]) H.s9 H.s10
        H.ctr H.data H.ciph) fun ρ B => ⟨B.pk, B.s9, B.s10⟩
  refine rel_seqR ?_ (mid E₁ H₁) (mid E₂ H₂) fun ρ₁ ρ₂ ⟨pk₁, s9₁, s10₁⟩ ⟨pk₂, s9₂, s10₂⟩ => ?_
  · refine rel_ite (Steps.eval_zero_ofNat _ _ (by omega_using [hn]) H₁.a7) (Steps.eval_zero_ofNat _ _ (by omega_using [hn]) H₂.a7) (fun _ => ?_) (fun hf => ?_)
    · exact rel_env [] F₁ F₂ hsp₁ (by simp) ⟨_, by taint_decide⟩
    have h0 : c.n / 16 ≠ 0 := by simpa using hf
    refine (RelCT.loop (Q := TT) (fun k (a b : State) => ∃ j, k = c.n / 16 - j ∧ j < c.n / 16 ∧
        BlocksPost c (Spec.GcmSiv.ctxCiph σ₁.mem (c.W + BitVec.ofNat 64 256) c.R)
          (Spec.GcmSiv.initialCounter (bytesAt σ₁.mem c.W 16)) (bytesAt σ₁.mem c.D c.n) j τ₁ a ∧
        BlocksPost c (Spec.GcmSiv.ctxCiph σ₂.mem (c.W + BitVec.ofNat 64 256) c.R)
          (Spec.GcmSiv.initialCounter (bytesAt σ₂.mem c.W 16)) (bytesAt σ₂.mem c.D c.n) j τ₂ b)
        (fun k => ?_) (c.n / 16 - 0)).mono
      (fun a b hab => by
        obtain ⟨rfl, rfl⟩ := hab
        exact ⟨0, rfl, by omega_using [h0],
          ⟨PK.refl _, by rw [H₁.s9, Nat.mul_zero, BitVec.add_zero], by rw [H₁.s10, Nat.mul_zero, Nat.sub_zero],
            H₁.ctr, by rw [H₁.data, Nat.mul_zero, GcmSiv.ctrPart_zero], Frame.refl _ _⟩,
          ⟨PK.refl _, by rw [H₂.s9, Nat.mul_zero, BitVec.add_zero], by rw [H₂.s10, Nat.mul_zero, Nat.sub_zero],
            H₂.ctr, by rw [H₂.data, Nat.mul_zero, GcmSiv.ctrPart_zero], Frame.refl _ _⟩⟩) fun _ _ h => h
    refine rel_of_eq2 fun a b ⟨j, hk, hj, P₁, P₂⟩ => ?_
    have hc₁ : Spec.GcmSiv.ctxCiph a.mem (c.W + BitVec.ofNat 64 256) c.R =
        Spec.GcmSiv.ctxCiph σ₁.mem (c.W + BitVec.ofNat 64 256) c.R := by rw [ciph_cryR L P₁.frame, H₁.ciph]
    have hc₂ : Spec.GcmSiv.ctxCiph b.mem (c.W + BitVec.ofNat 64 256) c.R =
        Spec.GcmSiv.ctxCiph σ₂.mem (c.W + BitVec.ofNat 64 256) c.R := by rw [ciph_cryR L P₂.frame, H₂.ciph]
    have G₁ := F₁.of_pk P₁.pk
    have G₂ := F₂.of_pk P₂.pk
    refine (rel_post (cryptChunk_rel L G₁ G₂ (by rw [P₁.pk.sp, P₂.pk.sp, hsp₁]) hj P₁.ctr P₂.ctr
        P₁.s9 P₂.s9 P₁.s10 P₂.s10)
      (Runs.of_wp (cryptChunk_wp L hxl₁ hj G₁ P₁ hc₁))
      (Runs.of_wp (cryptChunk_wp L hxl₂ hj G₂ P₂ hc₂))).mono
      (fun _ _ h => h) fun a' b' ⟨⟨Q₁, a7₁⟩, ⟨Q₂, a7₂⟩⟩ => ?_
    have ev₁ := Steps.eval_nonzero_ofNat _ _ (by omega_using [hn]) a7₁
    have ev₂ := Steps.eval_nonzero_ofNat _ _ (by omega_using [hn]) a7₂
    refine ⟨by rw [ev₁, ev₂], fun _ => trivial, fun ht => ⟨c.n / 16 - (j + min ((c.n - 16 * j) / 16) 64), ?_,
      j + min ((c.n - 16 * j) / 16) 64, rfl, ?_, Q₁, Q₂⟩⟩
    · rw [ev₁] at ht; simp at ht; omega_using [hk, hj]
    · rw [ev₁] at ht; simp at ht; omega_using [ht]
  · have G₁ := F₁.of_pk pk₁
    have G₂ := F₂.of_pk pk₂
    have hsp₂ : ρ₁.sp = ρ₂.sp := by rw [pk₁.sp, pk₂.sp, hsp₁]
    have q24₁ : ρ₁.gpr .s10 = BitVec.ofNat 64 (c.n % 16) := by rw [s10₁]; congr 1; omega_using []
    have q24₂ : ρ₂.gpr .s10 = BitVec.ofNat 64 (c.n % 16) := by rw [s10₂]; congr 1; omega_using []
    refine rel_ite (Steps.eval_zero_ofNat _ _ (by omega_using []) q24₁) (Steps.eval_zero_ofNat _ _ (by omega_using []) q24₂) (fun _ => ?_) (fun _ => ?_)
    · exact rel_env [] G₁ G₂ hsp₂ (by simp) ⟨_, by taint_decide⟩
    unfold cryptTail
    refine rel_seqR (tag_rel L G₁ G₂ hsp₂ (o := 240) (by decide)) (Runs.of_wp (tag_wp L G₁ (o := 240) (by decide)))
      (Runs.of_wp (tag_wp L G₂ (o := 240) (by decide))) fun ω₁ ω₂ T₁ T₂ => ?_
    refine rel_env [.s9, .s10] (G₁.of_pk T₁.pk) (G₂.of_pk T₂.pk) (by rw [T₁.pk.sp, T₂.pk.sp, hsp₂])
      (fun r hr => ?_) ⟨_, by taint_decide⟩
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl
    · rw [T₁.s9, T₂.s9, s9₁, s9₂]
    · rw [T₁.s10, T₂.s10, q24₁, q24₂]

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-! ### `AesGcmSiv.RISCV64.PolyCT`, which only this module used -/

section

/-!
# AES-GCM-SIV on RISC-V: POLYVAL in two runs

Untrusted: everything here is checked by Lean. As on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Verified.lean`): `polyval`, run from two states in
the same environment, leaks the same: the code between calls by the taint
analysis (`rel_env`), from the pointer `s9` and the count `s10`, which are
public in both runs, and each call of `vg_ghash` by its proof (`rel_gh`). The
loop of chunks relates two runs after the same number of blocks, which the
correctness proofs describe (`CInv`).
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.Impl.AesGcmSiv.RISCV64 VG.RISCV64
open VG.RISCV64.Steps (wp_srl wp_mv)
open VG.Proof.Gather.RISCV64 (Eq2 TT rel_ite)
open VG.Proof.AesCcm.RISCV64 (Runs Runs.of_wp Runs.mono Runs.and rel_seqR rel_of_eq2 rel_post rel_iteZ)
open VG.Spec.Aes (bytesAt)

/-- The additional data as the bytes to absorb. -/
theorem movA_wp {c : Cx} {σ : State} (E : Env c σ) :
    WP isa (.block [Impl.AesGcm.RISCV64.mov .s9 .s4, Impl.AesGcm.RISCV64.mov .s10 .s5]) σ fun t =>
      PK σ t ∧ t.mem = σ.mem ∧ t.gpr .s9 = c.A ∧ t.gpr .s10 = BitVec.ofNat 64 c.al :=
  wp_mv fun t₁ u₁ => wp_mv fun t₂ u₂ =>
    WP.block_nil ⟨(PK.ofUpd u₁).trans (PK.ofUpd u₂), by rw [u₂.mem, u₁.mem],
      by rw [u₂.other _ (by decide), u₁.gpr, E.s4], by rw [u₂.gpr, u₁.other _ (by decide), E.s5]⟩

/-- The data as the bytes to absorb. -/
theorem movD_wp {c : Cx} {σ : State} (E : Env c σ) :
    WP isa (.block [Impl.AesGcm.RISCV64.mov .s9 .s6, Impl.AesGcm.RISCV64.mov .s10 .s7]) σ fun t =>
      PK σ t ∧ t.mem = σ.mem ∧ t.gpr .s9 = c.D ∧ t.gpr .s10 = BitVec.ofNat 64 c.n :=
  wp_mv fun t₁ u₁ => wp_mv fun t₂ u₂ =>
    WP.block_nil ⟨(PK.ofUpd u₁).trans (PK.ofUpd u₂), by rw [u₂.mem, u₁.mem],
      by rw [u₂.other _ (by decide), u₁.gpr, E.s6], by rw [u₂.gpr, u₁.other _ (by decide), E.s7]⟩

section
variable {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp)
include L E₁ E₂ hsp

/-- A chunk of the `m` bytes at `Q`. -/
theorem chunk_rel [VG.Proof.Gcm.RISCV64.GhashLaw] {Q : Addr} {m : Nat} (hm : m < 2 ^ 64) (h16 : 16 ≤ m) (hQ₁ : Src c σ₁ Q (16 * (m / 16)))
    (hQ₂ : Src c σ₂ Q (16 * (m / 16))) (h9₁ : σ₁.gpr .s9 = Q) (h9₂ : σ₂.gpr .s9 = Q)
    (h10₁ : σ₁.gpr .s10 = BitVec.ofNat 64 m) (h10₂ : σ₂.gpr .s10 = BitVec.ofNat 64 m) :
    RelCT isa (Eq2 σ₁ σ₂) chunk TT := by
  unfold chunk
  refine rel_seqR (rel_env [.s9, .s10] E₁ E₂ hsp (fun r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl
      · rw [h9₁, h9₂]
      · rw [h10₁, h10₂]) ⟨_, by taint_decide⟩)
    (Runs.of_wp (chunkPre_wp L E₁ hm h16 hQ₁ h9₁ h10₁)) (Runs.of_wp (chunkPre_wp L E₂ hm h16 hQ₂ h9₂ h10₂))
    fun ρ₁ ρ₂ P₁ P₂ => ?_
  have hsp₁ : ρ₁.sp = ρ₂.sp := by rw [P₁.pk.sp, P₂.pk.sp, hsp]
  refine rel_seqR (rel_gh P₁.call P₂.call hsp₁) (gh_runs (E₁.of_pk P₁.pk) P₁.call)
    (gh_runs (E₂.of_pk P₂.pk) P₂.call) fun ω₁ ω₂ G₁ G₂ => ?_
  refine rel_env [.s10] G₁.1 G₂.1 (by rw [G₁.2.1, G₂.2.1, hsp₁]) (fun r hr => ?_) ⟨_, by taint_decide⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  subst hr
  rw [G₁.2.2 .s10 (by simp), G₂.2.2 .s10 (by simp), P₁.s10, P₂.s10]

end

/-- The chunks of the `m` bytes at `Q`, in two runs from `σ₁` and `σ₂`. -/
theorem chunks_rel [VG.Proof.Gcm.RISCV64.GhashLaw] {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp)
    {Q : Addr} {m : Nat} (hm : m < 2 ^ 64) (h16 : 16 ≤ m) (hQ₁ : Src c σ₁ Q (16 * (m / 16)))
    (hQ₂ : Src c σ₂ Q (16 * (m / 16))) (h9₁ : σ₁.gpr .s9 = Q) (h9₂ : σ₂.gpr .s9 = Q)
    (h10₁ : σ₁.gpr .s10 = BitVec.ofNat 64 m) (h10₂ : σ₂.gpr .s10 = BitVec.ofNat 64 m) :
    RelCT isa (Eq2 σ₁ σ₂) (.loop chunk (.nonzero .a7)) TT := by
  refine (RelCT.loop (Q := TT) (fun k (a b : State) => ∃ d, k = m / 16 - d ∧ d < m / 16 ∧
      CInv c σ₁ Q m d a ∧ CInv c σ₂ Q m d b) (fun k => ?_) (m / 16 - 0)).mono
    (fun a b hab => by
      obtain ⟨rfl, rfl⟩ := hab
      exact ⟨0, rfl, by omega_arith,
        ⟨⟨PK.refl _, Frame.refl _ _, by simp [elemsAt, Proof.Gcm.ghashFrom_nil]⟩,
          by rw [h9₁, Nat.mul_zero, BitVec.add_zero], by rw [h10₁, Nat.mul_zero, Nat.sub_zero]⟩,
        ⟨⟨PK.refl _, Frame.refl _ _, by simp [elemsAt, Proof.Gcm.ghashFrom_nil]⟩,
          by rw [h9₂, Nat.mul_zero, BitVec.add_zero], by rw [h10₂, Nat.mul_zero, Nat.sub_zero]⟩⟩)
    fun _ _ h => h
  refine rel_of_eq2 fun a b ⟨d, hk, hd, J₁, J₂⟩ => ?_
  have F₁ := E₁.of_pk J₁.abs.pk
  have F₂ := E₂.of_pk J₂.abs.pk
  have S₁ : Src c a (Q + BitVec.ofNat 64 (16 * d)) (16 * ((m - 16 * d) / 16)) :=
    (hQ₁.slice (by omega_arith) (by omega_arith)).of_eq J₁.abs.pk.rd J₁.abs.pk.wr
  have S₂ : Src c b (Q + BitVec.ofNat 64 (16 * d)) (16 * ((m - 16 * d) / 16)) :=
    (hQ₂.slice (by omega_arith) (by omega_arith)).of_eq J₂.abs.pk.rd J₂.abs.pk.wr
  refine (rel_post (chunk_rel L F₁ F₂ (by rw [J₁.abs.pk.sp, J₂.abs.pk.sp, hsp]) (by omega_arith) (by omega_arith) S₁ S₂
      J₁.s9 J₂.s9 J₁.s10 J₂.s10)
    (Runs.of_wp (chunk_wp L F₁ (by omega_arith) (by omega_arith) S₁ J₁.s9 J₁.s10))
    (Runs.of_wp (chunk_wp L F₂ (by omega_arith) (by omega_arith) S₂ J₂.s9 J₂.s10))).mono (fun _ _ h => h)
    fun a' b' ⟨C₁, C₂⟩ => ?_
  obtain ⟨I₁', a7₁⟩ := J₁.step L hQ₁ hd C₁
  obtain ⟨I₂', a7₂⟩ := J₂.step L hQ₂ hd C₂
  have ev₁ := Steps.eval_nonzero_ofNat _ _ (by omega_arith) a7₁
  have ev₂ := Steps.eval_nonzero_ofNat _ _ (by omega_arith) a7₂
  refine ⟨by rw [ev₁, ev₂], fun _ => trivial,
    fun ht => ⟨m / 16 - (d + min (m / 16 - d) 64), ?_, d + min (m / 16 - d) 64, rfl, ?_, I₁', I₂'⟩⟩
  · rw [ev₁] at ht; simp at ht; omega_arith
  · rw [ev₁] at ht; simp at ht; omega_arith

section
variable {c : Cx} (L : Lay c) {σ₁ σ₂ : State} (E₁ : Env c σ₁) (E₂ : Env c σ₂) (hsp : σ₁.sp = σ₂.sp)
include L E₁ E₂ hsp

/-- `absTail`: the last `r` bytes at `P`. -/
theorem absTail_rel [VG.Proof.Gcm.RISCV64.GhashLaw] {P : Addr} {r : Nat} (hr1 : 1 ≤ r) (hr : r < 16) (hc₁ : Covers [⟨P, r⟩] (σ₁.rd ++ σ₁.wr))
    (hc₂ : Covers [⟨P, r⟩] (σ₂.rd ++ σ₂.wr)) (hd : (⟨P, r⟩ : Region).Disjoint ⟨c.W, 3840⟩)
    (h9₁ : σ₁.gpr .s9 = P) (h9₂ : σ₂.gpr .s9 = P) (h10₁ : σ₁.gpr .s10 = BitVec.ofNat 64 r)
    (h10₂ : σ₂.gpr .s10 = BitVec.ofNat 64 r) : RelCT isa (Eq2 σ₁ σ₂) absTail TT := by
  unfold absTail
  refine rel_seqR (rel_env [.s9, .s10] E₁ E₂ hsp (fun q hq => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
      rcases hq with rfl | rfl
      · rw [h9₁, h9₂]
      · rw [h10₁, h10₂]) ⟨_, by taint_decide⟩)
    (Runs.of_wp (absTailPre_wp L E₁ hr1 hr hc₁ hd h9₁ h10₁)) (Runs.of_wp (absTailPre_wp L E₂ hr1 hr hc₂ hd h9₂ h10₂))
    fun ρ₁ ρ₂ T₁ T₂ => ?_
  exact chunk_rel L (E₁.of_pk T₁.pk) (E₂.of_pk T₂.pk) (by rw [T₁.pk.sp, T₂.pk.sp, hsp]) (m := 16) (by decide)
    (by decide) (srcB L (E₁.of_pk T₁.pk).perm) (srcB L (E₂.of_pk T₂.pk).perm) T₁.s9 T₂.s9 T₁.s10 T₂.s10

/-- `absorb`: the `m` bytes at `Q`. -/
theorem absorb_rel [VG.Proof.Gcm.RISCV64.GhashLaw] {Q : Addr} {m : Nat} (hm : m < 2 ^ 64) (hQ₁ : Src c σ₁ Q m) (hQ₂ : Src c σ₂ Q m)
    (hd : (⟨Q, m⟩ : Region).Disjoint ⟨c.W, 3840⟩) (h9₁ : σ₁.gpr .s9 = Q) (h9₂ : σ₂.gpr .s9 = Q)
    (h10₁ : σ₁.gpr .s10 = BitVec.ofNat 64 m) (h10₂ : σ₂.gpr .s10 = BitVec.ofNat 64 m) :
    RelCT isa (Eq2 σ₁ σ₂) absorb TT := by
  unfold absorb wholeLeft
  have run : ∀ {σ : State}, Env c σ → σ.gpr .s10 = BitVec.ofNat 64 m →
      Runs (.block [.shift .srl .d .a7 .s10 4]) σ fun t =>
        Steps.Upd σ t .a7 (BitVec.ofNat 64 (m / 16)) := fun E h10 =>
    Runs.of_wp (wp_srl (by decide) fun t u => WP.block_nil
      (by rw [← ofNat_lsr 4 hm, ← h10]; exact u))
  refine rel_seqR (rel_env [.s10] E₁ E₂ hsp (by simp [h10₁, h10₂]) ⟨_, by taint_decide⟩) (run E₁ h10₁)
    (run E₂ h10₂) fun τ₁ τ₂ u₁ u₂ => ?_
  have F₁ := E₁.of_pk (PK.ofUpd u₁)
  have F₂ := E₂.of_pk (PK.ofUpd u₂)
  have hsp₁ : τ₁.sp = τ₂.sp := by rw [u₁.sp, u₂.sp, hsp]
  have q23₁ : τ₁.gpr .s9 = Q := by rw [u₁.other _ (by decide), h9₁]
  have q23₂ : τ₂.gpr .s9 = Q := by rw [u₂.other _ (by decide), h9₂]
  have q24₁ : τ₁.gpr .s10 = BitVec.ofNat 64 m := by rw [u₁.other _ (by decide), h10₁]
  have q24₂ : τ₂.gpr .s10 = BitVec.ofNat 64 m := by rw [u₂.other _ (by decide), h10₂]
  have R₁ : Src c τ₁ Q m := hQ₁.of_eq u₁.rd u₁.wr
  have R₂ : Src c τ₂ Q m := hQ₂.of_eq u₂.rd u₂.wr
  refine rel_seqR ?_ (Runs.of_wp (absMid_wp L F₁ hm R₁ q23₁ q24₁ u₁.gpr))
    (Runs.of_wp (absMid_wp L F₂ hm R₂ q23₂ q24₂ u₂.gpr)) fun ρ₁ ρ₂ ⟨P₁, s9₁, s10₁⟩ ⟨P₂, s9₂, s10₂⟩ => ?_
  · refine rel_ite (Steps.eval_zero_ofNat _ _ (by omega_arith) u₁.gpr) (Steps.eval_zero_ofNat _ _ (by omega_arith) u₂.gpr) (fun _ => ?_) (fun hf => ?_)
    · exact rel_env [] F₁ F₂ hsp₁ (by simp) ⟨_, by taint_decide⟩
    · have h0 : m / 16 ≠ 0 := by simpa using hf
      exact chunks_rel L F₁ F₂ hsp₁ hm (by omega_arith) (R₁.take (by omega_arith)) (R₂.take (by omega_arith)) q23₁ q23₂ q24₁ q24₂
  · have G₁ := F₁.of_pk P₁.pk
    have G₂ := F₂.of_pk P₂.pk
    have hsp₂ : ρ₁.sp = ρ₂.sp := by rw [P₁.pk.sp, P₂.pk.sp, hsp₁]
    refine rel_ite (Steps.eval_zero_ofNat _ _ (by omega_arith) s10₁) (Steps.eval_zero_ofNat _ _ (by omega_arith) s10₂) (fun _ => ?_) (fun hf => ?_)
    · exact rel_env [] G₁ G₂ hsp₂ (by simp) ⟨_, by taint_decide⟩
    · have h0 : m % 16 ≠ 0 := by simpa using hf
      have hs₁ := R₁.slice (a := 16 * (m / 16)) (k := m % 16) (by omega_arith) (by omega_arith)
      have hs₂ := R₂.slice (a := 16 * (m / 16)) (k := m % 16) (by omega_arith) (by omega_arith)
      exact absTail_rel L G₁ G₂ hsp₂ (by omega_arith) (by omega_arith) (by rw [P₁.pk.rd, P₁.pk.wr]; exact hs₁.rd)
        (by rw [P₂.pk.rd, P₂.pk.wr]; exact hs₂.rd) (hd.sub_left (Offset.sub_base Q (by omega_arith))) s9₁ s9₂ s10₁ s10₂

/-- `lens`. -/
theorem lens_rel [VG.Proof.Gcm.RISCV64.GhashLaw] : RelCT isa (Eq2 σ₁ σ₂) lens TT := by
  unfold lens
  refine rel_seqR (rel_env [] E₁ E₂ hsp (by simp) ⟨_, by taint_decide⟩) (Runs.of_wp (lensBlk_wp L E₁))
    (Runs.of_wp (lensBlk_wp L E₂)) fun ρ₁ ρ₂ ⟨pk₁, _, s9₁, s10₁⟩ ⟨pk₂, _, s9₂, s10₂⟩ => ?_
  exact chunk_rel L (E₁.of_pk pk₁) (E₂.of_pk pk₂) (by rw [pk₁.sp, pk₂.sp, hsp]) (m := 16) (by decide) (by decide)
    (srcB L (E₁.of_pk pk₁).perm) (srcB L (E₂.of_pk pk₂).perm) s9₁ s9₂ s10₁ s10₂

/-- `polyval`. -/
theorem polyval_rel [VG.Proof.Gcm.RISCV64.GhashLaw] : RelCT isa (Eq2 σ₁ σ₂) polyval TT := by
  unfold polyval
  refine rel_seqR (rel_env [] E₁ E₂ hsp (by simp) ⟨_, by taint_decide⟩) (Runs.of_wp (movA_wp E₁))
    (Runs.of_wp (movA_wp E₂)) fun τ₁ τ₂ ⟨pk₁, m₁, a₁, l₁⟩ ⟨pk₂, m₂, a₂, l₂⟩ => ?_
  have F₁ := E₁.of_pk pk₁
  have F₂ := E₂.of_pk pk₂
  have hsp₁ : τ₁.sp = τ₂.sp := by rw [pk₁.sp, pk₂.sp, hsp]
  refine rel_seqR (absorb_rel L F₁ F₂ hsp₁ L.al_lt (srcA L F₁.perm) (srcA L F₂.perm) L.a_w a₁ a₂ l₁ l₂)
    (Runs.of_wp (absorb_wp L F₁ L.al_lt (srcA L F₁.perm) L.a_w a₁ l₁))
    (Runs.of_wp (absorb_wp L F₂ L.al_lt (srcA L F₂.perm) L.a_w a₂ l₂)) fun ρ₁ ρ₂ A₁ A₂ => ?_
  have G₁ := F₁.of_pk A₁.pk
  have G₂ := F₂.of_pk A₂.pk
  have hsp₂ : ρ₁.sp = ρ₂.sp := by rw [A₁.pk.sp, A₂.pk.sp, hsp₁]
  refine rel_seqR (rel_env [] G₁ G₂ hsp₂ (by simp) ⟨_, by taint_decide⟩) (Runs.of_wp (movD_wp G₁))
    (Runs.of_wp (movD_wp G₂)) fun ω₁ ω₂ ⟨pk₃, _, d₁, n₁⟩ ⟨pk₄, _, d₂, n₂⟩ => ?_
  have H₁ := G₁.of_pk pk₃
  have H₂ := G₂.of_pk pk₄
  have hsp₃ : ω₁.sp = ω₂.sp := by rw [pk₃.sp, pk₄.sp, hsp₂]
  refine rel_seqR (absorb_rel L H₁ H₂ hsp₃ L.n_lt (srcD L H₁.perm) (srcD L H₂.perm) L.d_w d₁ d₂ n₁ n₂)
    (Runs.of_wp (absorb_wp L H₁ L.n_lt (srcD L H₁.perm) L.d_w d₁ n₁))
    (Runs.of_wp (absorb_wp L H₂ L.n_lt (srcD L H₂.perm) L.d_w d₂ n₂)) fun υ₁ υ₂ B₁ B₂ => ?_
  have I₁ := H₁.of_pk B₁.pk
  have I₂ := H₂.of_pk B₂.pk
  have hsp₄ : υ₁.sp = υ₂.sp := by rw [B₁.pk.sp, B₂.pk.sp, hsp₃]
  refine rel_seqR (lens_rel L I₁ I₂ hsp₄) (Runs.of_wp (lens_wp L I₁)) (Runs.of_wp (lens_wp L I₂))
    fun φ₁ φ₂ C₁ C₂ => ?_
  exact rel_env [] (I₁.of_pk C₁.pk) (I₂.of_pk C₂.pk) (by rw [C₁.pk.sp, C₂.pk.sp, hsp₄]) (by simp)
    ⟨_, by taint_decide⟩

end


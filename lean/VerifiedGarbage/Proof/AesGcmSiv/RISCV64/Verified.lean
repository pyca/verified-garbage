/-!
# AES-GCM-SIV on RISC-V: the contracts the proofs are written against

Untrusted: everything here is checked by Lean. The artifacts' contracts are
the shared ones of `Spec/GcmSiv/Contract.lean`, which imply these
(`Verified.lean`), with a 3840-byte `work` buffer appended
(`Proof/AesGcmSiv/Scratch.lean`), its address the one stack argument. A call
stores nothing in memory; `vg_ghash`'s frame takes the 2048 bytes below the
stack pointer, which every buffer is apart from (AES-GCM's `stkOk`).
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.RISCV64
open VG.Spec.Aes (bytesAt)
open VG.Spec.GcmSiv (ctxCiph keyLen encryptWith decryptWith zeros)
open VG.Proof.AesGcm.RISCV64 (stkOk stkAll)

/-- AES-128's or AES-256's number of rounds. -/
abbrev rounds (r : BitVec 64) : Prop := r.toNat = 10 ∨ r.toNat = 14

/-- The stack argument, `work`. -/
abbrev args (s : State) : Region := ⟨stackArgAddr s 0, 8⟩

/-- What `vg_aes_gcm_siv_seal` and `vg_aes_gcm_siv_open` both need, but for
the permissions: `(schedule = a0, rounds = a1, nonce = a2, aad = a3,
aad_len = a4, data = a5, len = a6, tag = a7, work = [sp])`. -/
def oneLay (s : State) : Prop :=
  let sch : Region := ⟨s.gpr .a0, 240⟩
  let nonce : Region := ⟨s.gpr .a2, 12⟩
  let aad : Region := ⟨s.gpr .a3, (s.gpr .a4).toNat⟩
  let data : Region := ⟨s.gpr .a5, (s.gpr .a6).toNat⟩
  let tag : Region := ⟨s.gpr .a7, 16⟩
  let work : Region := ⟨stackArg s 0, 3840⟩
  sch.Disjoint data ∧ sch.Disjoint work ∧ nonce.Disjoint data ∧ nonce.Disjoint work ∧
    aad.Disjoint data ∧ aad.Disjoint work ∧ tag.Disjoint data ∧ tag.Disjoint work ∧
    data.Disjoint work ∧ data.Disjoint (args s) ∧ work.Disjoint (args s) ∧
    (s.gpr .a0).toNat + 240 ≤ 2 ^ 64 ∧ (s.gpr .a2).toNat + 12 ≤ 2 ^ 64 ∧
    (s.gpr .a3).toNat + (s.gpr .a4).toNat ≤ 2 ^ 64 ∧ (s.gpr .a5).toNat + (s.gpr .a6).toNat ≤ 2 ^ 64 ∧
    (s.gpr .a7).toNat + 16 ≤ 2 ^ 64 ∧ (stackArg s 0).toNat + 3840 ≤ 2 ^ 64 ∧
    (stackArgAddr s 0).toNat + 8 ≤ 2 ^ 64 ∧ (stackArg s 0).toNat % 8 = 0 ∧ rounds (s.gpr .a1) ∧
    stkOk s [sch, nonce, aad, data, tag, work, args s]

/-- What `vg_aes_gcm_siv_seal` needs: `oneLay`, with `tag` the 16 bytes to
write. -/
def sealPre (s : State) : Prop :=
  let sch : Region := ⟨s.gpr .a0, 240⟩
  let nonce : Region := ⟨s.gpr .a2, 12⟩
  let aad : Region := ⟨s.gpr .a3, (s.gpr .a4).toNat⟩
  let data : Region := ⟨s.gpr .a5, (s.gpr .a6).toNat⟩
  let tag : Region := ⟨s.gpr .a7, 16⟩
  let work : Region := ⟨stackArg s 0, 3840⟩
  s.rd = [sch, nonce, aad, args s] ∧ s.wr = [data, tag, work] ∧ tag.Disjoint (args s) ∧ oneLay s

/-- What `vg_aes_gcm_siv_open` needs: `oneLay`, with the received tag the 16
bytes at `tag`, to read. -/
def openPre (s : State) : Prop :=
  let sch : Region := ⟨s.gpr .a0, 240⟩
  let nonce : Region := ⟨s.gpr .a2, 12⟩
  let aad : Region := ⟨s.gpr .a3, (s.gpr .a4).toNat⟩
  let data : Region := ⟨s.gpr .a5, (s.gpr .a6).toNat⟩
  let tag : Region := ⟨s.gpr .a7, 16⟩
  let work : Region := ⟨stackArg s 0, 3840⟩
  s.rd = [sch, nonce, aad, tag, args s] ∧ s.wr = [data, work] ∧ oneLay s

def onePub (s₁ s₂ : State) : Prop :=
  s₁.gpr .a0 = s₂.gpr .a0 ∧ s₁.gpr .a1 = s₂.gpr .a1 ∧ s₁.gpr .a2 = s₂.gpr .a2 ∧
    s₁.gpr .a3 = s₂.gpr .a3 ∧ s₁.gpr .a4 = s₂.gpr .a4 ∧ s₁.gpr .a5 = s₂.gpr .a5 ∧
    s₁.gpr .a6 = s₂.gpr .a6 ∧ s₁.gpr .a7 = s₂.gpr .a7 ∧ s₁.sp = s₂.sp ∧ stackArg s₁ 0 = stackArg s₂ 0

/-- `vg_aes_gcm_siv_seal`. -/
def sealRISCV64 : Contract isa where
  pre := sealPre
  post s s' :=
    encryptWith (ctxCiph s.mem (s.gpr .a0) (s.gpr .a1).toNat) (keyLen (s.gpr .a1).toNat)
        (bytesAt s.mem (s.gpr .a2) 12) (bytesAt s.mem (s.gpr .a5) (s.gpr .a6).toNat)
        (bytesAt s.mem (s.gpr .a3) (s.gpr .a4).toNat) =
      (bytesAt s'.mem (s.gpr .a5) (s.gpr .a6).toNat, bytesAt s'.mem (s.gpr .a7) 16)
  pub := onePub

/-- What `vg_aes_gcm_siv_open` computes, for the arguments of `s`. -/
abbrev openRes (s : State) : Option (List Byte) :=
  decryptWith (ctxCiph s.mem (s.gpr .a0) (s.gpr .a1).toNat) (keyLen (s.gpr .a1).toNat)
    (bytesAt s.mem (s.gpr .a2) 12) (bytesAt s.mem (s.gpr .a5) (s.gpr .a6).toNat)
    (bytesAt s.mem (s.gpr .a3) (s.gpr .a4).toNat) (bytesAt s.mem (s.gpr .a7) 16)

/-- The result of `vg_aes_gcm_siv_open`: `a0` and the `n` bytes of the data
for the result `r` of the decryption. -/
@[irreducible] def openOut (r : Option (List Byte)) (a0 : BitVec 64) (out : List Byte) (n : Nat) : Prop :=
  match r with
  | some pt => a0.setWidth 32 = 1 ∧ out = pt
  | none => a0.setWidth 32 = 0 ∧ out = zeros n

/-- `vg_aes_gcm_siv_open`. It does not branch on whether the tag is right,
so its runs are related without the leak the shared contract allows. -/
def openRISCV64 : Contract isa where
  pre := openPre
  post s s' := openOut (openRes s) (s'.gpr .a0) (bytesAt s'.mem (s.gpr .a5) (s.gpr .a6).toNat) (s.gpr .a6).toNat
  pub := onePub

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-!
# AES-GCM-SIV on RISC-V: the arguments, the entry and the exit

Untrusted: everything here is checked by Lean. The preconditions `sealPre`
and `openPre` give the facts the proofs use about the arguments (`Args`,
`args_of_seal`, `args_of_open`). `entry` loads `work` from the stack, saves
our caller's registers and the return address at `W + 128` as AES-GCM's
functions do (`Proof.AesGcm.RISCV64.save_ok`), keeps the arguments in
`s0`–`s8` and copies the nonce to `W + 1520` (`entry_wp`); AES-GCM's
`restore_ok` is the exit. The pieces write only the parts of `W` in `mutR`,
the data and the stack below `sp`, so the slots stay as the entry left them.
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.RISCV64 VG.Impl.AesGcmSiv.RISCV64
open VG.Spec.Aes (bytesAt)
open VG.RISCV64.Steps (Upd wp_addSp wp_ld wp_mv)
open VG.Proof.AesGcm.RISCV64 (SavedAt savedR save_ok stkOk stkAll_mem in_off covers_prefix)

/-- The public values of the arguments of `s`. -/
def cxOf (s : State) : Cx where
  K := s.gpr .a0
  W := stackArg s 0
  N := s.gpr .a2
  A := s.gpr .a3
  D := s.gpr .a5
  T := s.gpr .a7
  SP := s.sp
  R := (s.gpr .a1).toNat
  al := (s.gpr .a4).toNat
  n := (s.gpr .a6).toNat

/-- What `seal` and `open` are given: the public values `c`. -/
structure Args (c : Cx) (s : State) : Prop where
  lay : Lay c
  a0 : s.gpr .a0 = c.K
  a1 : s.gpr .a1 = BitVec.ofNat 64 c.R
  a2 : s.gpr .a2 = c.N
  a3 : s.gpr .a3 = c.A
  a4 : s.gpr .a4 = BitVec.ofNat 64 c.al
  a5 : s.gpr .a5 = c.D
  a6 : s.gpr .a6 = BitVec.ofNat 64 c.n
  a7 : s.gpr .a7 = c.T
  w : stackArg s 0 = c.W
  sp : s.sp = c.SP
  perm : Perm c s
  argsC : Covers [args s] (s.rd ++ s.wr)

theorem ofNat_toNat64 (x : BitVec 64) : BitVec.ofNat 64 x.toNat = x := by simp

theorem covers_of_mem {r : Region} {rs : List Region} (h : r ∈ rs) : Covers [r] rs := fun _ _ ⟨r', hr', hc⟩ => by
  simp only [List.mem_singleton] at hr'; subst hr'; exact ⟨_, h, hc⟩

/-- `Args` from the layout, with the buffers covered as each function's
permissions say. -/
theorem args_of_lay {s : State} (h : oneLay s)
    (hk : Covers [⟨s.gpr .a0, 240⟩] (s.rd ++ s.wr)) (hN : Covers [⟨s.gpr .a2, 12⟩] (s.rd ++ s.wr))
    (hA : Covers [⟨s.gpr .a3, (s.gpr .a4).toNat⟩] (s.rd ++ s.wr)) (ha : Covers [args s] (s.rd ++ s.wr))
    (hT : Covers [⟨s.gpr .a7, 16⟩] (s.rd ++ s.wr))
    (hD : Covers [⟨s.gpr .a5, (s.gpr .a6).toNat⟩] s.wr) (hW : Covers [⟨stackArg s 0, 3840⟩] s.wr) :
    Args (cxOf s) s := by
  obtain ⟨d1, d2, d3, d4, d5, d6, d7, d8, d9, _, _, b1, b2, b3, b4, b5, b6, _, wal, hR, stk⟩ := h
  obtain bm : ∀ {r : Region}, r ∈ [(⟨s.gpr .a0, 240⟩ : Region), ⟨s.gpr .a2, 12⟩,
      ⟨s.gpr .a3, (s.gpr .a4).toNat⟩, ⟨s.gpr .a5, (s.gpr .a6).toNat⟩, ⟨s.gpr .a7, 16⟩, ⟨stackArg s 0, 3840⟩,
      args s] → (below s.sp 2048).Disjoint r := fun hr => stkAll_mem stk.2.2 hr
  exact {
    lay := ⟨b1, b6, b2, b3, b4, b5, d2, d1, d4, d3, d6, d5, d9, d8, d7, hR, BitVec.isLt _, BitVec.isLt _, wal,
      stk.1, stk.2.1, bm (r := ⟨stackArg s 0, 3840⟩) (by simp), bm (r := ⟨s.gpr .a3, (s.gpr .a4).toNat⟩) (by simp),
      bm (r := ⟨s.gpr .a5, (s.gpr .a6).toNat⟩) (by simp)⟩
    a0 := rfl
    a1 := (ofNat_toNat64 _).symm
    a2 := rfl
    a3 := rfl
    a4 := (ofNat_toNat64 _).symm
    a5 := rfl
    a6 := (ofNat_toNat64 _).symm
    a7 := rfl
    w := rfl
    sp := rfl
    perm := ⟨hk, hW, hN, hA, hD, hT⟩
    argsC := ha }

/-- `seal`'s arguments, and its tag, to write. -/
theorem args_of_seal {s : State} (h : sealPre s) : Args (cxOf s) s ∧ Covers [⟨s.gpr .a7, 16⟩] s.wr := by
  obtain ⟨hrd, hwr, _, hl⟩ := h
  obtain mrd : ∀ r ∈ [(⟨s.gpr .a0, 240⟩ : Region), ⟨s.gpr .a2, 12⟩, ⟨s.gpr .a3, (s.gpr .a4).toNat⟩, args s],
      Covers [r] (s.rd ++ s.wr) := fun r hr => covers_of_mem (List.mem_append_left _ (by rw [hrd]; exact hr))
  obtain mwr : ∀ r ∈ [(⟨s.gpr .a5, (s.gpr .a6).toNat⟩ : Region), ⟨s.gpr .a7, 16⟩, ⟨stackArg s 0, 3840⟩],
      Covers [r] s.wr := fun r hr => covers_of_mem (by rw [hwr]; exact hr)
  exact ⟨args_of_lay hl (mrd _ (by simp)) (mrd _ (by simp)) (mrd _ (by simp)) (mrd _ (by simp))
    (Covers.right (mwr _ (by simp))) (mwr _ (by simp)) (mwr _ (by simp)), mwr _ (by simp)⟩

/-- `open`'s arguments, with the received tag to read. -/
theorem args_of_open {s : State} (h : openPre s) : Args (cxOf s) s := by
  obtain ⟨hrd, hwr, hl⟩ := h
  obtain mrd : ∀ r ∈ [(⟨s.gpr .a0, 240⟩ : Region), ⟨s.gpr .a2, 12⟩, ⟨s.gpr .a3, (s.gpr .a4).toNat⟩,
      ⟨s.gpr .a7, 16⟩, args s], Covers [r] (s.rd ++ s.wr) := fun r hr =>
    covers_of_mem (List.mem_append_left _ (by rw [hrd]; exact hr))
  obtain mwr : ∀ r ∈ [(⟨s.gpr .a5, (s.gpr .a6).toNat⟩ : Region), ⟨stackArg s 0, 3840⟩], Covers [r] s.wr :=
    fun r hr => covers_of_mem (by rw [hwr]; exact hr)
  exact args_of_lay hl (mrd _ (by simp)) (mrd _ (by simp)) (mrd _ (by simp)) (mrd _ (by simp)) (mrd _ (by simp))
    (mwr _ (by simp)) (mwr _ (by simp))

/-! ## What the pieces write -/

/-- What the pieces write: the parts of `W` below the slots and above them,
the data and the stack below `sp`. -/
abbrev mutR (c : Cx) : List Region :=
  [⟨c.W, 128⟩, ⟨c.W + BitVec.ofNat 64 240, 3600⟩, ⟨c.D, c.n⟩, below c.SP 2048]

theorem sub_lo {c : Cx} {d k : Nat} (h : d + k ≤ 128) :
    ∃ r' ∈ mutR c, Region.Sub ⟨c.W + BitVec.ofNat 64 d, k⟩ r' :=
  ⟨⟨c.W, 128⟩, by simp, Offset.sub_base _ h⟩

theorem sub_hi {c : Cx} {d k : Nat} (h₁ : 240 ≤ d) (h₂ : d + k ≤ 3840) :
    ∃ r' ∈ mutR c, Region.Sub ⟨c.W + BitVec.ofNat 64 d, k⟩ r' :=
  ⟨⟨c.W + BitVec.ofNat 64 240, 3600⟩, by simp, Offset.sub _ h₁ (by omega_using [h₂])⟩

theorem sub_data {c : Cx} : ∃ r' ∈ mutR c, Region.Sub ⟨c.D, c.n⟩ r' := ⟨_, by simp, fun _ h => h⟩

theorem sub_below {c : Cx} : ∃ r' ∈ mutR c, Region.Sub (below c.SP 2048) r' := ⟨_, by simp, fun _ h => h⟩

/-- The slots are kept by what the pieces write. -/
theorem slots_mut {c : Cx} (L : Lay c) : ∀ r ∈ mutR c, (savedR c.W).Disjoint r := by
  intro r hr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl
  · exact (Lay.w0_w (c := c) (n := 128) (d := 128) (k := 104) (Nat.le_refl _) (by decide)).symm
  · exact L.w_w (.inl (by decide)) (by decide) (by decide)
  · exact (L.d_w' (by decide)).symm
  · exact (L.b_w' (by decide)).symm

/-- Our caller's registers, kept in their slots by writes to `mutR`. -/
theorem saved_mut {c : Cx} (L : Lay c) {s₀ : State} {m m' : Mem} (hf : Frame (mutR c) m m')
    (h : SavedAt m c.W s₀) : SavedAt m' c.W s₀ :=
  h.frame hf (slots_mut L)

/-! ## Copies of bytes -/

/-- `copyBytes` of `n` bytes from `S` to a part `D` apart from it. -/
theorem copy_wp {s : State} {src dst : Reg} {soff doff n : Nat} {S D : Addr}
    (hts : Reg.t0 ≠ src) (htd : Reg.t0 ≠ dst) (hso : soff + n ≤ 2048) (hdo : doff + n ≤ 2048) (hn : n ≤ 16)
    (hs : s.gpr src + BitVec.ofNat 64 soff = S) (hd : s.gpr dst + BitVec.ofNat 64 doff = D)
    (hr : Covers [⟨S, n⟩] (s.rd ++ s.wr)) (hw : Covers [⟨D, n⟩] s.wr) (hsep : (⟨S, n⟩ : Region).Disjoint ⟨D, n⟩) :
    WP isa (.block (Impl.Words.RISCV64.copyBytes .t0 src dst soff doff n)) s fun s' =>
      Bytes.Keep .t0 s s' ∧ bytesAt s'.mem D n = bytesAt s.mem S n ∧ Frame [⟨D, n⟩] s.mem s'.mem := by
  refine WP.mono (Bytes.copyBytes_ok hts htd hso hdo (fun i hi => ?_) (fun i hi => ?_) (fun i hi hc => ?_))
    fun s' C => ⟨C.toKeep, ?_, by have := C.frame; rwa [hd] at this⟩
  · rw [← Offset.add_add, hs]; exact in_off hr (d := i) (n := 1) (by omega) (by omega)
  · rw [← Offset.add_add, hd]; exact in_off hw (d := i) (n := 1) (by omega) (by omega)
  · rw [hd, ← Offset.add_add, hs] at hc
    exact hsep _ (Offset.contains_base S (show i + 1 ≤ n by omega) (by omega)) hc
  · simp only [bytesAt]
    refine List.map_congr_left fun i hi => ?_
    have := C.copied i (List.mem_range.mp hi)
    rwa [← Offset.add_add, ← Offset.add_add, hs, hd] at this

/-! ## The entry -/

/-- What the entry leaves. -/
structure Entered (c : Cx) (s s₁ : State) : Prop where
  env : Env c s₁
  saved : SavedAt s₁.mem c.W s
  frame : Frame [savedR c.W, ⟨nP c.W, 12⟩] s.mem s₁.mem
  nonce : bytesAt s₁.mem (nP c.W) 12 = bytesAt s.mem c.N 12
  rd : s₁.rd = s.rd
  wr : s₁.wr = s.wr
  sp : s₁.sp = s.sp

theorem entry_wp {c : Cx} {s : State} (Ar : Args c s) : WP isa (.block entry) s (Entered c s) := by
  have L := Ar.lay
  have hww := L.ww
  unfold entry
  rw [List.append_assoc, List.append_assoc]
  refine WP.block_append (wp_addSp (imm := 0) (by decide) fun s₁ u₁ => ?_)
  refine wp_ld (a := stackArgAddr s 0) (by decide) (by rw [u₁.gpr, stackArgAddr, Nat.mul_zero, BitVec.add_zero, BitVec.add_zero])
    (by rw [stackArgAddr, Ar.sp]; exact Spill.al8 (by have := L.spal; omega_using [this]) (by decide))
    (by rw [u₁.rd, u₁.wr]; simpa using in_off Ar.argsC (d := 0) (n := 8) (by decide) (by decide))
    fun s₂ u₂ => WP.block_nil ?_
  obtain W₂ : s₂.gpr .t1 = c.W := by rw [u₂.gpr, u₁.mem, ← Ar.w]; rfl
  obtain rd₂ : s₂.rd = s.rd := by rw [u₂.rd, u₁.rd]
  obtain wr₂ : s₂.wr = s.wr := by rw [u₂.wr, u₁.wr]
  obtain g₂ : ∀ r, r ≠ .t1 → s₂.gpr r = s.gpr r := fun r h => by rw [u₂.other _ h, u₁.other _ h]
  refine WP.block_append (WP.mono (save_ok (b := .t1)
    (by rw [W₂, wr₂]; exact covers_prefix Ar.perm.w (by decide)) (by rw [W₂]; exact L.wal))
    fun s₃ ⟨g₃, s0₃, k₃, sv₃, f₃⟩ => ?_)
  rw [W₂] at s0₃ sv₃ f₃
  rw [u₂.mem, u₁.mem] at f₃
  refine WP.block_append (wp_mv fun s₄ u₄ => wp_mv fun s₅ u₅ => wp_mv fun s₆ u₆ => wp_mv fun s₇ u₇ =>
    wp_mv fun s₈ u₈ => wp_mv fun s₉ u₉ => wp_mv fun s₁₀ u₁₀ => wp_mv fun s₁₁ u₁₁ => WP.block_nil ?_)
  obtain gA : ∀ r, r ∉ [Reg.s1, .s2, .s3, .s4, .s5, .s6, .s7, .s8] → s₁₁.gpr r = s₃.gpr r := fun r hr => by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hr
    obtain ⟨h1, h2, h3, h4, h5, h6, h7, h8⟩ := hr
    rw [u₁₁.other _ h8, u₁₀.other _ h7, u₉.other _ h6, u₈.other _ h5, u₇.other _ h4, u₆.other _ h3,
      u₅.other _ h2, u₄.other _ h1]
  obtain v : ∀ r, r ≠ .s0 → r ≠ .t1 → s₃.gpr r = s.gpr r := fun r h0 h1 => by rw [g₃ r h0, g₂ r h1]
  obtain s0₁₁ : s₁₁.gpr .s0 = c.W := by rw [gA _ (by decide), s0₃]
  obtain rd₁₁ : s₁₁.rd = s.rd := by
    rw [u₁₁.rd, u₁₀.rd, u₉.rd, u₈.rd, u₇.rd, u₆.rd, u₅.rd, u₄.rd, k₃.rd, rd₂]
  obtain wr₁₁ : s₁₁.wr = s.wr := by
    rw [u₁₁.wr, u₁₀.wr, u₉.wr, u₈.wr, u₇.wr, u₆.wr, u₅.wr, u₄.wr, k₃.wr, wr₂]
  obtain sp₁₁ : s₁₁.sp = s.sp := by
    rw [u₁₁.sp, u₁₀.sp, u₉.sp, u₈.sp, u₇.sp, u₆.sp, u₅.sp, u₄.sp, k₃.sp, u₂.sp, u₁.sp]
  obtain m₁₁ : s₁₁.mem = s₃.mem := by
    rw [u₁₁.mem, u₁₀.mem, u₉.mem, u₈.mem, u₇.mem, u₆.mem, u₅.mem, u₄.mem]
  obtain s1₁₁ : s₁₁.gpr .s1 = c.N := by
    rw [u₁₁.other _ (by decide), u₁₀.other _ (by decide), u₉.other _ (by decide), u₈.other _ (by decide),
      u₇.other _ (by decide), u₆.other _ (by decide), u₅.other _ (by decide), u₄.gpr,
      v _ (by decide) (by decide), Ar.a2]
  obtain E₁₁ : Env c s₁₁ := by
    refine ⟨s0₁₁, s1₁₁, ?_, ?_, ?_, ?_, ?_, ?_, ?_, by rw [sp₁₁, Ar.sp], Ar.perm.of_eq rd₁₁ wr₁₁⟩
    · rw [u₁₁.other _ (by decide), u₁₀.other _ (by decide), u₉.other _ (by decide), u₈.other _ (by decide),
        u₇.other _ (by decide), u₆.other _ (by decide), u₅.gpr, u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a0]
    · rw [u₁₁.other _ (by decide), u₁₀.other _ (by decide), u₉.other _ (by decide), u₈.other _ (by decide),
        u₇.other _ (by decide), u₆.gpr, u₅.other _ (by decide), u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a1]
    · rw [u₁₁.other _ (by decide), u₁₀.other _ (by decide), u₉.other _ (by decide), u₈.other _ (by decide),
        u₇.gpr, u₆.other _ (by decide), u₅.other _ (by decide), u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a3]
    · rw [u₁₁.other _ (by decide), u₁₀.other _ (by decide), u₉.other _ (by decide), u₈.gpr,
        u₇.other _ (by decide), u₆.other _ (by decide), u₅.other _ (by decide), u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a4]
    · rw [u₁₁.other _ (by decide), u₁₀.other _ (by decide), u₉.gpr, u₈.other _ (by decide),
        u₇.other _ (by decide), u₆.other _ (by decide), u₅.other _ (by decide), u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a5]
    · rw [u₁₁.other _ (by decide), u₁₀.gpr, u₉.other _ (by decide), u₈.other _ (by decide),
        u₇.other _ (by decide), u₆.other _ (by decide), u₅.other _ (by decide), u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a6]
    · rw [u₁₁.gpr, u₁₀.other _ (by decide), u₉.other _ (by decide), u₈.other _ (by decide),
        u₇.other _ (by decide), u₆.other _ (by decide), u₅.other _ (by decide), u₄.other _ (by decide),
        v _ (by decide) (by decide), Ar.a7]
  -- The nonce's copy.
  obtain dN : (⟨c.N, 12⟩ : Region).Disjoint ⟨nP c.W, 12⟩ := L.n_w' (by decide)
  refine WP.mono (copy_wp (S := c.N) (D := nP c.W) (soff := 0) (doff := nO) (n := 12) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by rw [s1₁₁, BitVec.add_zero]) (by rw [s0₁₁, nP]; rfl)
    E₁₁.perm.nc (E₁₁.perm.wC (d := 1520) (by decide)) dN) fun s' ⟨K, hb, hf⟩ => ?_
  obtain pk : PK s₁₁ s' := ⟨K.rd, K.wr, K.sp, fun r hr => K.gpr r (by revert r hr; decide)⟩
  obtain dS : ∀ r ∈ [(⟨nP c.W, 12⟩ : Region)], (savedR c.W).Disjoint r := fun r hr => by
    simp only [List.mem_singleton] at hr; subst hr; exact L.w_w (.inl (by decide)) (by decide) (by decide)
  obtain nN : bytesAt s₁₁.mem c.N 12 = bytesAt s.mem c.N 12 := by
    rw [m₁₁]
    exact Proof.Cmac.bytesAt_frame f₃ (fun r hr => by
      simp only [List.mem_singleton] at hr; subst hr; exact L.n_w' (by decide)) (by decide)
  obtain sv : SavedAt s'.mem c.W s := fun p hp => by
    rw [(sv₃.frame (by rw [← m₁₁]; exact hf) dS) p hp]
    exact g₂ _ ((show ∀ q ∈ Impl.AesGcm.RISCV64.saved, q.1 ≠ .t1 by decide) p hp)
  refine ⟨E₁₁.of_pk pk, sv, ?_, by rw [hb, nN], by rw [pk.rd, rd₁₁],
    by rw [pk.wr, wr₁₁], by rw [pk.sp, sp₁₁]⟩
  rw [← m₁₁] at f₃
  exact (f₃.mono fun r hr => by simp only [List.mem_singleton] at hr; subst hr; simp).trans
    (hf.mono fun r hr => by simp only [List.mem_singleton] at hr; subst hr; simp)

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-!
# AES-GCM-SIV on RISC-V: the tags in and out, the comparison and the mask

Untrusted: everything here is checked by Lean. As on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Verified.lean`): `recv` copies the received tag to `W`
and `tagOut` the computed one from `W` to `tag`, a byte at a time
(`recv_wp`, `tagOut_wp`); `cmp` leaves 1 in `s11` iff the tags at `W` and
`W + 240` are equal, without a branch (`cmp_wp`); `mask` ANDs every byte of
the data with `0 − s11` (`mask_wp`).
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.Impl.AesGcmSiv.RISCV64 VG.WriteBytes VG.RISCV64
open VG.RISCV64.Steps (Upd Mupd wp_addi wp_subi wp_li wp_sub wp_ld wp_xor wp_or wp_srl wp_lbu wp_sb wp_mv)
open VG.Proof.AesCcm.RISCV64 (eval_z eval_nz)
open VG.Proof.AesGcm.RISCV64 (in_off covers_prefix)
open VG.Spec.Aes (bytesAt)
open VG.Proof.AesCcm (length_bytesAt)

/-! ## The tags in and out -/

/-- `recv`: the received tag copied to `W`. -/
theorem recv_wp {c : Cx} (L : Lay c) {s : State} (E : Env c s) :
    WP isa (.block recv) s fun s' => PK s s' ∧ bytesAt s'.mem c.W 16 = bytesAt s.mem c.T 16 ∧
      Frame [⟨c.W, 16⟩] s.mem s'.mem :=
  WP.mono (copy_wp (S := c.T) (D := c.W) (soff := 0) (doff := tagO) (n := 16) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by rw [E.s8, BitVec.add_zero]) (by rw [E.s0]; exact BitVec.add_zero _)
    E.perm.t (covers_prefix E.perm.w (by decide)) (L.t_w.sub_right (Region.sub_prefix (by decide))))
    fun s' ⟨K, hb, hf⟩ => ⟨⟨K.rd, K.wr, K.sp, fun r hr => K.gpr r (by revert r hr; decide)⟩, hb, hf⟩

/-- `tagOut`: the tag copied from `W` to `tag`. -/
theorem tagOut_wp {c : Cx} (L : Lay c) {s : State} (E : Env c s) (hT : Covers [⟨c.T, 16⟩] s.wr) :
    WP isa (.block tagOut) s fun s' => PK s s' ∧ bytesAt s'.mem c.T 16 = bytesAt s.mem c.W 16 ∧
      Frame [⟨c.T, 16⟩] s.mem s'.mem :=
  WP.mono (copy_wp (S := c.W) (D := c.T) (soff := tagO) (doff := 0) (n := 16) (by decide) (by decide)
    (by decide) (by decide) (by decide) (by rw [E.s0]; exact BitVec.add_zero _) (by rw [E.s8, BitVec.add_zero])
    (covers_prefix (Covers.right E.perm.w) (by decide)) hT
    (L.t_w.sub_right (Region.sub_prefix (by decide))).symm)
    fun s' ⟨K, hb, hf⟩ => ⟨⟨K.rd, K.wr, K.sp, fun r hr => K.gpr r (by revert r hr; decide)⟩, hb, hf⟩

/-! ## The comparison -/

/-- `1 − ((d ||| −d) >>> 63)`: 1 if `d` is 0, else 0. -/
theorem zero_test (d : BitVec 64) :
    BitVec.ofNat 64 1 - ((d ||| (BitVec.ofNat 64 0 - d)) >>> 63) = BitVec.ofNat 64 (if d = 0 then 1 else 0) := by
  obtain h := Proof.AesCcm.neg_or_msb d
  rw [show BitVec.ofNat 64 0 = (0 : BitVec 64) from rfl, h]
  by_cases hd : d = 0 <;> simp only [hd, ite_true, ite_false] <;> decide

/-- `cmp`: `s11` is 1 iff the 16 bytes at `W` and at `W + 240` are equal. -/
theorem cmp_wp {c : Cx} (L : Lay c) {s : State} (E : Env c s) :
    WP isa (.block cmp) s fun s' => PK s s' ∧ s'.mem = s.mem ∧
      s'.gpr .s11 = BitVec.ofNat 64 (if bytesAt s.mem c.W 16 = bytesAt s.mem (c.W + BitVec.ofNat 64 240) 16
        then 1 else 0) := by
  unfold cmp
  refine wp_ld (a := c.W + BitVec.ofNat 64 0) (by decide) (by rw [E.s0] <;> rfl)
    (L.wal8 (by decide) (by decide))
    (E.perm.wR (by decide)) fun s₁ u₁ => ?_
  refine wp_ld (a := c.W + BitVec.ofNat 64 240) (by decide) (by rw [u₁.other _ (by decide), E.s0] <;> rfl)
    (L.wal8 (by decide) (by decide)) (by rw [u₁.rd, u₁.wr]; exact E.perm.wR (by decide))
    fun s₂ u₂ => wp_xor fun s₃ u₃ => ?_
  refine wp_ld (a := c.W + BitVec.ofNat 64 0 + BitVec.ofNat 64 8) (by decide) (by rw [u₃.other _ (by decide), u₂.other _ (by decide), u₁.other _ (by decide), E.s0, Offset.add_add] <;> rfl)
    (by rw [Offset.add_add]; exact L.wal8 (by decide) (by decide))
    (by rw [u₃.rd, u₃.wr, u₂.rd, u₂.wr, u₁.rd, u₁.wr, Offset.add_add]; exact E.perm.wR (by decide)) fun s₄ u₄ => ?_
  refine wp_ld (a := c.W + BitVec.ofNat 64 240 + BitVec.ofNat 64 8) (by decide) (by rw [u₄.other _ (by decide), u₃.other _ (by decide), u₂.other _ (by decide), u₁.other _ (by decide),
      E.s0, Offset.add_add] <;> rfl)
    (by rw [Offset.add_add]; exact L.wal8 (by decide) (by decide))
    (by rw [u₄.rd, u₄.wr, u₃.rd, u₃.wr, u₂.rd, u₂.wr, u₁.rd, u₁.wr, Offset.add_add]; exact E.perm.wR (by decide))
    fun s₅ u₅ => ?_
  refine wp_xor fun s₆ u₆ => wp_or fun s₇ u₇ => wp_li (by decide) fun s₈ u₈ => wp_sub fun s₉ u₉ =>
    wp_or fun s₁₀ u₁₀ => wp_srl (by decide) fun s₁₁ u₁₁ => wp_li (by decide) fun s₁₂ u₁₂ =>
    wp_sub fun s₁₃ u₁₃ => WP.block_nil ?_
  refine ⟨(PK.ofUpd u₁).trans ((PK.ofUpd u₂).trans ((PK.ofUpd u₃).trans ((PK.ofUpd u₄).trans
    ((PK.ofUpd u₅).trans ((PK.ofUpd u₆).trans ((PK.ofUpd u₇).trans ((PK.ofUpd u₈).trans
    ((PK.ofUpd u₉).trans ((PK.ofUpd u₁₀).trans ((PK.ofUpd u₁₁).trans ((PK.ofUpd u₁₂).trans
    (PK.ofUpd u₁₃)))))))))))),
    by rw [u₁₃.mem, u₁₂.mem, u₁₁.mem, u₁₀.mem, u₉.mem, u₈.mem, u₇.mem, u₆.mem, u₅.mem, u₄.mem, u₃.mem,
      u₂.mem, u₁.mem], ?_⟩
  obtain hd : s₇.gpr .a0 =
      (s.mem.readW (c.W + BitVec.ofNat 64 0) 64 ^^^ s.mem.readW (c.W + BitVec.ofNat 64 240) 64) |||
      (s.mem.readW (c.W + BitVec.ofNat 64 0 + BitVec.ofNat 64 8) 64 ^^^
        s.mem.readW (c.W + BitVec.ofNat 64 240 + BitVec.ofNat 64 8) 64) := by
    rw [u₇.gpr, u₆.gpr, u₆.other .a0 (by decide), u₅.gpr, u₅.other .a1 (by decide), u₄.gpr,
      u₅.other .a0 (by decide), u₄.other .a0 (by decide), u₃.gpr, u₂.gpr, u₂.other .a0 (by decide), u₁.gpr,
      u₄.mem, u₃.mem, u₂.mem, u₁.mem]
  rw [u₁₃.gpr, u₁₂.gpr, u₁₂.other .a0 (by decide), u₁₁.gpr, u₁₀.gpr, u₉.gpr, u₉.other .a0 (by decide),
    u₈.gpr, u₈.other .a0 (by decide), hd, zero_test]
  obtain hw := Proof.AesCcm.words_eq s.mem (c.W + BitVec.ofNat 64 0) (c.W + BitVec.ofNat 64 240)
  rw [BitVec.add_zero] at hw ⊢
  congr 2
  exact propext hw

/-! ## The mask -/

/-- One byte ANDed with `0 − s11`: the byte if `P`, else 0. -/
theorem mask_byte (b : Byte) (P : Prop) [Decidable P] :
    ((b.setWidth 64 &&& (BitVec.ofNat 64 0 - BitVec.ofNat 64 (if P then 1 else 0))).setWidth 8 : Byte) =
      if P then b else 0 := by
  rw [BitVec.setWidth_and, Proof.AesCcm.RISCV64.byte_rt]
  by_cases hP : P <;> simp only [hP, ite_true, ite_false]
  · rw [show ((BitVec.ofNat 64 0 - BitVec.ofNat 64 1).setWidth 8 : Byte) = BitVec.allOnes 8 by decide,
      BitVec.and_allOnes]
  · rw [show ((BitVec.ofNat 64 0 - BitVec.ofNat 64 0).setWidth 8 : Byte) = 0 by decide]
    simp

/-- The byte just past what `writeBytes` writes is unchanged. -/
theorem writeBytes_end (m : Mem) (q : Addr) (xs : List Byte) (h : xs.length < 2 ^ 64) :
    writeBytes m q xs (q + BitVec.ofNat 64 xs.length) = m (q + BitVec.ofNat 64 xs.length) := by
  simp only [writeBytes]
  rw [Offset.add_sub_cancel_left, BitVec.toNat_ofNat, Nat.mod_eq_of_lt h]
  simp

/-- `mask`: every byte of the data kept if `P`, zeroed if not, for `s11` the
indicator of `P`. -/
theorem mask_wp {c : Cx} (L : Lay c) {s : State} (E : Env c s) {P : Prop} [Decidable P]
    (h25 : s.gpr .s11 = BitVec.ofNat 64 (if P then 1 else 0)) :
    WP isa mask s fun s' => PK s s' ∧ s'.gpr .s11 = s.gpr .s11 ∧
      s'.mem = writeBytes s.mem c.D ((bytesAt s.mem c.D c.n).map fun b => if P then b else 0) := by
  have hn := L.n_lt
  unfold mask
  refine WP.seq (wp_li (by decide) fun s₁ u₁ => wp_sub fun s₂ u₂ => wp_mv fun s₃ u₃ => wp_mv fun s₄ u₄ =>
    WP.block_nil ?_)
  obtain pk₄ : PK s s₄ := (PK.ofUpd u₁).trans ((PK.ofUpd u₂).trans ((PK.ofUpd u₃).trans (PK.ofUpd u₄)))
  obtain m₄ : s₄.mem = s.mem := by rw [u₄.mem, u₃.mem, u₂.mem, u₁.mem]
  obtain s11₄ : s₄.gpr .s11 = s.gpr .s11 := by
    rw [u₄.other _ (by decide), u₃.other _ (by decide), u₂.other _ (by decide), u₁.other _ (by decide)]
  obtain a2₄ : s₄.gpr .a2 = BitVec.ofNat 64 0 - BitVec.ofNat 64 (if P then 1 else 0) := by
    rw [u₄.other _ (by decide), u₃.other _ (by decide), u₂.gpr, u₁.gpr, u₁.other _ (by decide), h25]
  obtain a0₄ : s₄.gpr .a0 = c.D := by
    rw [u₄.other _ (by decide), u₃.gpr, u₂.other _ (by decide), u₁.other _ (by decide), E.s6]
  obtain a1₄ : s₄.gpr .a1 = BitVec.ofNat 64 c.n := by
    rw [u₄.gpr, u₃.other _ (by decide), u₂.other _ (by decide), u₁.other _ (by decide), E.s7]
  let f : Byte → Byte := fun b => if P then b else 0
  refine WP.ite (decide (c.n = 0)) (eval_z a1₄ hn) (fun ht => ?_) (fun hf => ?_)
  · have h0 : c.n = 0 := of_decide_eq_true ht
    refine WP.block_nil ⟨pk₄, s11₄, ?_⟩
    rw [m₄, h0]
    simp [bytesAt, writeBytes_nil]
  · have h0 : c.n ≠ 0 := by simpa using hf
    refine WP.loop (M := isa)
      (fun (w : Nat) (t : State) => ∃ i, w = c.n - i ∧ i < c.n ∧ t.gpr .a0 = c.D + BitVec.ofNat 64 i ∧
        t.gpr .a1 = BitVec.ofNat 64 (c.n - i) ∧ t.gpr .a2 = s₄.gpr .a2 ∧ t.gpr .s11 = s.gpr .s11 ∧
        t.mem = writeBytes s.mem c.D ((bytesAt s.mem c.D i).map f) ∧ PK s t) ?_ (c.n - 0) _
      ⟨0, rfl, by omega_arith, by rw [a0₄]; exact (BitVec.add_zero _).symm, by rw [a1₄, Nat.sub_zero], rfl, s11₄,
        by rw [m₄]; simp [bytesAt, writeBytes_nil], pk₄⟩
    rintro w t ⟨i, rfl, hi, a0, a1, a2, s11, mem, pk⟩
    obtain Et := E.of_pk pk
    obtain hin : i + 1 ≤ c.n := by omega_arith
    have hD : Covers [⟨c.D, c.n⟩] t.wr := Et.perm.d
    unfold maskBody
    refine wp_lbu (a := c.D + BitVec.ofNat 64 i) (by decide) (by rw [a0]; exact BitVec.add_zero _)
      (in_off (Covers.right hD) hin hn) fun t₁ u₁ => ?_
    refine wp_and fun t₂ u₂ => ?_
    refine wp_sb (a := c.D + BitVec.ofNat 64 i) (by decide) (by rw [u₂.other _ (by decide), u₁.other _ (by decide), a0]; exact BitVec.add_zero _)
      (by rw [u₂.wr, u₁.wr]; exact in_off hD hin hn) fun t₃ u₃ => ?_
    refine wp_addi (by decide) fun t₄ u₄ => wp_subi (imm := 1) (by decide) fun t₅ u₅ =>
      WP.block_nil ?_
    obtain pk₅ : PK s t₅ := pk.trans ((PK.ofUpd u₁).trans ((PK.ofUpd u₂).trans ((PK.ofMupd u₃).trans
      ((PK.ofUpd u₄).trans (PK.ofUpd u₅)))))
    obtain hlen : ((bytesAt s.mem c.D i).map f).length = i := by rw [List.length_map, length_bytesAt]
    obtain hb : t.mem (c.D + BitVec.ofNat 64 i) = s.mem (c.D + BitVec.ofNat 64 i) := by
      rw [mem]
      have := writeBytes_end s.mem c.D ((bytesAt s.mem c.D i).map f) (by rw [hlen]; omega_arith)
      rwa [hlen] at this
    obtain hmem : t₅.mem = writeBytes s.mem c.D ((bytesAt s.mem c.D (i + 1)).map f) := by
      rw [u₅.mem, u₄.mem, u₃.mem, u₂.gpr, u₁.gpr, u₁.other .a2 (by decide), a2, a2₄, u₂.mem,
        u₁.mem, mask_byte, hb, mem, Proof.Cmac.Stream.bytesAt_append, Proof.AesCcm.RISCV64.bytesAt_one,
        List.map_append, List.map_singleton]
      rw [writeBytes_snoc _ _ _ _ (by rw [hlen]; omega_arith), hlen]
    obtain hstep : c.D + BitVec.ofNat 64 i + BitVec.ofNat 64 1 = c.D + BitVec.ofNat 64 (i + 1) := by
      rw [BitVec.add_assoc, ← BitVec.ofNat_add]
    obtain a0' : t₅.gpr .a0 = c.D + BitVec.ofNat 64 (i + 1) := by
      rw [u₅.other _ (by decide), u₄.gpr, u₃.gpr, u₂.other _ (by decide), u₁.other _ (by decide), a0, hstep]
    obtain a1' : t₅.gpr .a1 = BitVec.ofNat 64 (c.n - (i + 1)) := by
      rw [u₅.gpr, u₄.other _ (by decide), u₃.gpr, u₂.other _ (by decide), u₁.other _ (by decide), a1,
        Proof.AesCcm.RISCV64.ofNat_sub_one (by omega_arith), Nat.sub_sub]
    obtain a2' : t₅.gpr .a2 = s₄.gpr .a2 := by
      rw [u₅.other _ (by decide), u₄.other _ (by decide), u₃.gpr, u₂.other _ (by decide), u₁.other _ (by decide), a2]
    obtain s11' : t₅.gpr .s11 = s.gpr .s11 := by
      rw [u₅.other _ (by decide), u₄.other _ (by decide), u₃.gpr, u₂.other _ (by decide), u₁.other _ (by decide),
        s11]
    obtain ev := eval_nz (r := .a1) (a := c.n - (i + 1)) a1' (by omega_arith)
    by_cases he : i + 1 = c.n
    · left
      exact ⟨by rw [ev]; simp [he], pk₅, s11', by rw [hmem, he]⟩
    · right
      exact ⟨by rw [ev]; simp; omega_arith, c.n - (i + 1), by omega_arith, i + 1, rfl, by omega_arith, a0', a1', a2', s11', hmem, pk₅⟩

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-!
# AES-GCM-SIV on RISC-V: `vg_aes_gcm_siv_seal`

Untrusted: everything here is checked by Lean. As on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Verified.lean`): `seal` is `entry`, the keys
(`keys`), POLYVAL and the tag input (`polyval`), the tag at `W` (`tag 0`),
counter mode over the data from it (`crypt`), the tag copied to `tag`
(`tagOut`) and `restore` (`seal_wp`), computing `encryptWith` (RFC 8452 §4)
given that the tag input computed with GHASH is RFC 8452's (`TagInputEq`,
proven in `Verified.lean`). The lemmas about what each piece writes serve
`open` too.
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.RISCV64 VG.Impl.AesGcmSiv.RISCV64
open VG.Spec.Aes (bytesAt)
open VG.Proof.AesGcm.RISCV64 (SavedAt savedR restore_ok covers_prefix)
open VG.Proof.GcmSiv.Words (tagInputG)

/-- The tag input of RFC 8452 is the one computed with GHASH. -/
abbrev TagInputEq : Prop := ∀ a n pt d : List Byte, Spec.GcmSiv.tagInput a n pt d = tagInputG a n pt d

/-- Regions of `W` as offsets and lengths. -/
abbrev wRs (W : Addr) (rs : List (Nat × Nat)) : List Region := rs.map fun q => ⟨W + BitVec.ofNat 64 q.1, q.2⟩

theorem keyR_eq (W : Addr) : keyR W = wRs W [(16, 112), (240, 1280), (1792, 2048)] := rfl

theorem polyR_eq (c : Cx) :
    polyR c = wRs c.W [(96, 16), (240, 16), (80, 16), (496, 1024), (1536, 256)] ++ [below c.SP 2048] := rfl

theorem tagR_eq (W : Addr) (o : Nat) : tagR W o = wRs W [(112, 16), (o, 16), (1792, 2048)] := rfl

/-- Parts of `W` the pieces write are within `mutR`. -/
theorem wRs_mut {c : Cx} {rs : List (Nat × Nat)} (h : ∀ q ∈ rs, q.1 + q.2 ≤ 128 ∨ (240 ≤ q.1 ∧ q.1 + q.2 ≤ 3840)) :
    ∀ r ∈ wRs c.W rs, ∃ r' ∈ mutR c, Region.Sub r r' := by
  intro r hr
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hr
  rcases h q hq with h₁ | ⟨h₁, h₂⟩
  · exact sub_lo h₁
  · exact sub_hi h₁ h₂

/-- And the stack below `sp`. -/
theorem wRsB_mut {c : Cx} {rs : List (Nat × Nat)} (h : ∀ q ∈ rs, q.1 + q.2 ≤ 128 ∨ (240 ≤ q.1 ∧ q.1 + q.2 ≤ 3840)) :
    ∀ r ∈ wRs c.W rs ++ [below c.SP 2048], ∃ r' ∈ mutR c, Region.Sub r r' := by
  intro r hr
  rcases List.mem_append.mp hr with hr | hr
  · exact wRs_mut h r hr
  · simp only [List.mem_singleton] at hr; subst hr; exact sub_below

theorem cryR_mut (c : Cx) : ∀ r ∈ cryR c.W c.D c.n, ∃ r' ∈ mutR c, Region.Sub r r' := by
  intro r hr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl
  · exact sub_lo (by decide)
  · exact sub_hi (by decide) (by decide)
  · exact sub_hi (by decide) (by decide)
  · exact sub_hi (by decide) (by decide)
  · exact sub_data

/-- A part of `W` missing the parts `rs` of `W`. -/
theorem w_keep {c : Cx} (L : Lay c) {rs : List (Nat × Nat)} {d k : Nat}
    (h : ∀ q ∈ rs, (d + k ≤ q.1 ∨ q.1 + q.2 ≤ d) ∧ q.1 + q.2 ≤ 3840) (hd : d + k ≤ 3840) :
    ∀ r ∈ wRs c.W rs, (⟨c.W + BitVec.ofNat 64 d, k⟩ : Region).Disjoint r := by
  intro r hr
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hr
  exact L.w_w (h q hq).1 hd (h q hq).2

/-- And the stack below `sp`. -/
theorem w_keepB {c : Cx} (L : Lay c) {rs : List (Nat × Nat)} {d k : Nat}
    (h : ∀ q ∈ rs, (d + k ≤ q.1 ∨ q.1 + q.2 ≤ d) ∧ q.1 + q.2 ≤ 3840) (hd : d + k ≤ 3840) :
    ∀ r ∈ wRs c.W rs ++ [below c.SP 2048], (⟨c.W + BitVec.ofNat 64 d, k⟩ : Region).Disjoint r := by
  intro r hr
  rcases List.mem_append.mp hr with hr | hr
  · exact w_keep L h hd r hr
  · simp only [List.mem_singleton] at hr; subst hr; exact (L.b_w' hd).symm

/-- A buffer missing `W` misses the parts `rs` of `W`. -/
theorem buf_keep {c : Cx} {P : Addr} {len : Nat} (hP : (⟨P, len⟩ : Region).Disjoint ⟨c.W, 3840⟩)
    {rs : List (Nat × Nat)} (h : ∀ q ∈ rs, q.1 + q.2 ≤ 3840) :
    ∀ r ∈ wRs c.W rs, (⟨P, len⟩ : Region).Disjoint r := by
  intro r hr
  obtain ⟨q, hq, rfl⟩ := List.mem_map.mp hr
  exact hP.sub_right (Lay.wSub (h q hq))

/-- And the stack below `sp`, for a buffer missing it. -/
theorem buf_keepB {c : Cx} {P : Addr} {len : Nat} (hP : (⟨P, len⟩ : Region).Disjoint ⟨c.W, 3840⟩)
    (hb : (below c.SP 2048).Disjoint ⟨P, len⟩) {rs : List (Nat × Nat)} (h : ∀ q ∈ rs, q.1 + q.2 ≤ 3840) :
    ∀ r ∈ wRs c.W rs ++ [below c.SP 2048], (⟨P, len⟩ : Region).Disjoint r := by
  intro r hr
  rcases List.mem_append.mp hr with hr | hr
  · exact buf_keep hP h r hr
  · simp only [List.mem_singleton] at hr; subst hr; exact hb.symm

theorem bytesAt_keep {rs : List Region} {m m' : Mem} (hf : Frame rs m m') {P : Addr} {n : Nat}
    (hd : ∀ r ∈ rs, (⟨P, n⟩ : Region).Disjoint r) (hn : n ≤ 2 ^ 64) : bytesAt m' P n = bytesAt m P n :=
  Proof.Cmac.bytesAt_frame hf hd hn

theorem ciph_keep {rs : List Region} {m m' : Mem} (hf : Frame rs m m') {K : Addr} {R : Nat}
    (hd : ∀ r ∈ rs, (⟨K, 240⟩ : Region).Disjoint r) (hR : 16 * (R + 1) ≤ 240) :
    Spec.GcmSiv.ctxCiph m' K R = Spec.GcmSiv.ctxCiph m K R := by
  unfold Spec.GcmSiv.ctxCiph
  rw [bytesAt_keep hf (fun r hr => (hd r hr).sub_left (Region.sub_prefix hR)) (by omega_using [hR])]

/-- The entry keeps a buffer missing `W`. -/
theorem entry_buf {c : Cx} {s s₁ : State} (hf : Frame [savedR c.W, ⟨nP c.W, 12⟩] s.mem s₁.mem) {P : Addr}
    {len : Nat} (hP : (⟨P, len⟩ : Region).Disjoint ⟨c.W, 3840⟩) (hl : len ≤ 2 ^ 64) :
    bytesAt s₁.mem P len = bytesAt s.mem P len :=
  bytesAt_keep hf (fun r hr => by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl
    · exact hP.sub_right (Lay.wSub (by decide))
    · exact hP.sub_right (Lay.wSub (by decide))) hl

/-- The registers `restore` reloads from, at the exit. -/
theorem exit_covers {c : Cx} {s : State} (E : Env c s) : Covers [⟨c.W, 2560⟩] (s.rd ++ s.wr) :=
  covers_prefix (Covers.right E.perm.w) (by decide)

/-- `vg_aes_gcm_siv_seal`, for its arguments. -/
theorem seal_wp' [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) {c : Cx} {s : State} (Ar : Args c s) (hTw : Covers [⟨c.T, 16⟩] s.wr) :
    WP isa «seal» s fun s' => abiPreserved s s' ∧
      Spec.GcmSiv.encryptWith (Spec.GcmSiv.ctxCiph s.mem c.K c.R) (Spec.GcmSiv.keyLen c.R) (bytesAt s.mem c.N 12)
        (bytesAt s.mem c.D c.n) (bytesAt s.mem c.A c.al) = (bytesAt s'.mem c.D c.n, bytesAt s'.mem c.T 16) := by
  have L := Ar.lay
  have hRb := L.rb
  have hn := L.n_lt
  have hal := L.al_lt
  unfold «seal»
  refine WP.seq (WP.mono (entry_wp Ar) fun s₁ En => ?_)
  -- The keys.
  refine WP.seq (WP.mono (keys_wp L En.env) fun s₂ Ky => ?_)
  obtain E₂ := En.env.of_pk Ky.pk
  have fK := Ky.frame
  rw [keyR_eq] at fK
  -- What the pieces read.
  obtain hK₁ : Spec.GcmSiv.ctxCiph s₁.mem c.K c.R = Spec.GcmSiv.ctxCiph s.mem c.K c.R := by
    unfold Spec.GcmSiv.ctxCiph
    rw [entry_buf En.frame (L.k_w.sub_left (Region.sub_prefix hRb)) (by omega_using [hRb])]
  obtain n₁ : bytesAt s₁.mem c.N 12 = bytesAt s.mem c.N 12 := entry_buf En.frame L.n_w (by decide)
  obtain n₂ : bytesAt s₂.mem c.N 12 = bytesAt s.mem c.N 12 := by
    rw [bytesAt_keep fK (buf_keep L.n_w (by decide)) (by decide), n₁]
  obtain nP₂ : bytesAt s₂.mem (nP c.W) 12 = bytesAt s₂.mem c.N 12 := by
    rw [n₂, ← En.nonce]
    exact bytesAt_keep fK (w_keep L (d := 1520) (k := 12) (by decide) (by decide)) (by decide)
  -- POLYVAL and the tag input.
  refine WP.seq (WP.mono (polyval_wp L E₂ Ky.hkey Ky.acc nP₂) fun s₃ Po => ?_)
  obtain E₃ := E₂.of_pk Po.pk
  -- The tag.
  refine WP.seq (WP.mono (tag_wp L E₃ (o := 0) (by decide)) fun s₄ Tg => ?_)
  obtain E₄ := E₃.of_pk Tg.pk
  -- Counter mode.
  refine WP.seq (WP.mono (crypt_wp L E₄) fun s₅ Cr => ?_)
  obtain E₅ := E₄.of_pk Cr.pk
  obtain pk₅ : PK s₁ s₅ := Ky.pk.trans (Po.pk.trans (Tg.pk.trans Cr.pk))
  -- The copy of the tag, and `restore`.
  have fP := Po.frame
  have fT := Tg.frame
  rw [polyR_eq] at fP
  rw [tagR_eq] at fT
  obtain f₅ : Frame (mutR c) s₁.mem s₅.mem :=
    (((fK.sub (wRs_mut (by decide))).trans (fP.sub (wRsB_mut (by decide)))).trans
      (fT.sub (wRs_mut (by decide)))).trans (Cr.frame.sub (cryR_mut c))
  refine WP.block_append (WP.mono (tagOut_wp L E₅ (by rw [pk₅.wr, En.wr]; exact hTw)) fun s₆ ⟨pk₆, tO, fO⟩ => ?_)
  obtain sv₆ : SavedAt s₆.mem c.W s :=
    (saved_mut L f₅ En.saved).frame fO fun r hr => by
      simp only [List.mem_singleton] at hr; subst hr
      exact (L.t_w.sub_right (Lay.wSub (by decide))).symm
  obtain pk₁₆ : PK s₁ s₆ := pk₅.trans pk₆
  obtain E₆ := E₅.of_pk pk₆
  refine WP.mono (restore_ok E₆.s0 L.wal (exit_covers E₆) sv₆ (by rw [pk₁₆.sp, En.sp]))
    fun s' ⟨abi, hm, _⟩ => ⟨abi, ?_⟩
  obtain a₂ : bytesAt s₂.mem c.A c.al = bytesAt s.mem c.A c.al := by
    rw [bytesAt_keep fK (buf_keep L.a_w (by decide)) (by omega_using [hal]), entry_buf En.frame L.a_w (by omega_using [hal])]
  obtain d₂ : bytesAt s₂.mem c.D c.n = bytesAt s.mem c.D c.n := by
    rw [bytesAt_keep fK (buf_keep L.d_w (by decide)) (by omega_using [hn]), entry_buf En.frame L.d_w (by omega_using [hn])]
  obtain d₄ : bytesAt s₄.mem c.D c.n = bytesAt s.mem c.D c.n := by
    rw [bytesAt_keep fT (buf_keep L.d_w (by decide)) (by omega_using [hn]),
      bytesAt_keep fP (buf_keepB L.d_w L.b_d (by decide)) (by omega_using [hn]), d₂]
  obtain key₃ : Spec.GcmSiv.ctxCiph s₃.mem (c.W + BitVec.ofNat 64 256) c.R =
      Spec.GcmSiv.ctxCiph s₂.mem (c.W + BitVec.ofNat 64 256) c.R :=
    ciph_keep fP (w_keepB L (by decide) (by decide)) hRb
  obtain key₄ : Spec.GcmSiv.ctxCiph s₄.mem (c.W + BitVec.ofNat 64 256) c.R =
      Spec.GcmSiv.ctxCiph s₂.mem (c.W + BitVec.ofNat 64 256) c.R := by
    rw [ciph_keep fT (w_keep L (by decide) (by decide)) hRb, key₃]
  obtain t₅ : bytesAt s₅.mem (c.W + BitVec.ofNat 64 0) 16 = bytesAt s₄.mem (c.W + BitVec.ofNat 64 0) 16 :=
    bytesAt_keep Cr.frame (fun r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl
      · exact L.w_w (.inl (by decide)) (by decide) (by decide)
      · exact L.w_w (.inl (by decide)) (by decide) (by decide)
      · exact L.w_w (.inl (by decide)) (by decide) (by decide)
      · exact L.w_w (.inl (by decide)) (by decide) (by decide)
      · exact (L.d_w' (by decide)).symm) (by decide)
  rw [BitVec.add_zero] at t₅
  have tg := Tg.out
  rw [BitVec.add_zero] at tg
  obtain d₆ : bytesAt s₆.mem c.D c.n = bytesAt s₅.mem c.D c.n :=
    bytesAt_keep fO (fun r hr => by
      simp only [List.mem_singleton] at hr; subst hr; exact L.t_d.symm) (by omega_using [hn])
  have au := Ky.auth
  have ci := Ky.ciph
  rw [hK₁, En.nonce] at au ci
  have po := Po.out
  rw [n₂, a₂, d₂] at po
  rw [hm, d₆, tO, Cr.data, t₅, d₄, key₄, ci, tg, key₃, ci, po, ← au]
  unfold Spec.GcmSiv.encryptWith
  generalize Spec.GcmSiv.deriveKeys (Spec.GcmSiv.ctxCiph s.mem c.K c.R) (Spec.GcmSiv.keyLen c.R)
    (bytesAt s.mem c.N 12) = dk
  obtain ⟨a, e⟩ := dk
  simp only [hti]

/-- `vg_aes_gcm_siv_seal`. -/
theorem seal_wp [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) {s : State} (h : sealRISCV64.pre s) :
    WP isa «seal» s fun s' => abiPreserved s s' ∧ sealRISCV64.post s s' := by
  obtain A := args_of_seal h
  refine WP.mono (seal_wp' hti A.1 A.2) fun s' ⟨ga, hp⟩ => ⟨ga, ?_⟩
  simp only [sealRISCV64]
  simpa only [cxOf] using hp

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-!
# AES-GCM-SIV on RISC-V: `vg_aes_gcm_siv_open`

Untrusted: everything here is checked by Lean. As on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Open.lean`): `open` is `entry`, the received tag
copied to `W` (`recv`), the keys, counter mode from it (`crypt`), POLYVAL of
the plaintext (`polyval`), its tag at `W + 240` (`tag 240`), the comparison
(`cmp`), the mask and `restore` (`open_wp`): `decryptWith`'s result, without
a branch on whether the tag is right.
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.RISCV64 VG.Impl.AesGcmSiv.RISCV64 VG.WriteBytes
open VG.Spec.Aes (bytesAt)
open VG.Proof.AesGcm.RISCV64 (SavedAt savedR restore_ok)
open VG.Proof.GcmSiv.Words (tagInputG)
open VG.RISCV64.Steps (wp_mv)

theorem decrypt_eq (hti : TagInputEq) (ciph : Spec.GcmSiv.Cipher) (kl : Nat) (nonce ct aad tag : List Byte) :
    Spec.GcmSiv.decryptWith ciph kl nonce ct aad tag =
      let dk := Spec.GcmSiv.deriveKeys ciph kl nonce
      if Spec.GcmSiv.aes dk.2 (tagInputG dk.1 nonce
          (Spec.GcmSiv.ctr (Spec.GcmSiv.aes dk.2) (Spec.GcmSiv.initialCounter tag) ct) aad) = tag then
        some (Spec.GcmSiv.ctr (Spec.GcmSiv.aes dk.2) (Spec.GcmSiv.initialCounter tag) ct)
      else none := by
  unfold Spec.GcmSiv.decryptWith
  generalize Spec.GcmSiv.deriveKeys ciph kl nonce = dk
  obtain ⟨a, e⟩ := dk
  simp only [hti]

/-- A buffer missing `W` and the data misses what counter mode writes. -/
theorem buf_cryR {c : Cx} {P : Addr} {len : Nat} (hw : (⟨P, len⟩ : Region).Disjoint ⟨c.W, 3840⟩)
    (hd : (⟨P, len⟩ : Region).Disjoint ⟨c.D, c.n⟩) : ∀ r ∈ cryR c.W c.D c.n, (⟨P, len⟩ : Region).Disjoint r := by
  intro r hr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl
  · exact hw.sub_right (Lay.wSub (by decide))
  · exact hw.sub_right (Lay.wSub (by decide))
  · exact hw.sub_right (Lay.wSub (by decide))
  · exact hw.sub_right (Lay.wSub (by decide))
  · exact hd

/-- `vg_aes_gcm_siv_open`, for its arguments. -/
theorem open_wp' [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) {c : Cx} {s : State} (Ar : Args c s) :
    WP isa «open» s fun s' => abiPreserved s s' ∧
      openOut (Spec.GcmSiv.decryptWith (Spec.GcmSiv.ctxCiph s.mem c.K c.R) (Spec.GcmSiv.keyLen c.R)
        (bytesAt s.mem c.N 12) (bytesAt s.mem c.D c.n) (bytesAt s.mem c.A c.al) (bytesAt s.mem c.T 16))
        (s'.gpr .a0) (bytesAt s'.mem c.D c.n) c.n := by
  have L := Ar.lay
  have hRb := L.rb
  have hn := L.n_lt
  have hal := L.al_lt
  unfold «open»
  refine WP.seq (WP.mono (entry_wp Ar) fun s₁ En => ?_)
  -- The received tag, copied to `W`.
  refine WP.seq (WP.mono (recv_wp L En.env) fun s₂ ⟨pk₂, hb₂, fR⟩ => ?_)
  obtain E₂ := En.env.of_pk pk₂
  obtain fR' : Frame (wRs c.W [(0, 16)]) s₁.mem s₂.mem := by
    simp only [wRs, List.map_cons, List.map_nil, BitVec.add_zero]; exact fR
  -- The keys.
  refine WP.seq (WP.mono (keys_wp L E₂) fun s₃ Ky => ?_)
  obtain E₃ := E₂.of_pk Ky.pk
  -- Counter mode from the received tag.
  refine WP.seq (WP.mono (crypt_wp L E₃) fun s₄ Cr => ?_)
  obtain E₄ := E₃.of_pk Cr.pk
  have fK := Ky.frame
  rw [keyR_eq] at fK
  obtain dC : ∀ {d : Nat}, d + 16 ≤ 96 → ∀ r ∈ cryR c.W c.D c.n, (⟨c.W + BitVec.ofNat 64 d, 16⟩ : Region).Disjoint r :=
    fun hd r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl
      · exact L.w_w (.inl hd) (by omega_using [hd]) (by decide)
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact (L.d_w' (by omega_using [hd])).symm
  obtain a₄ : bytesAt s₄.mem (c.W + BitVec.ofNat 64 16) 16 = bytesAt s₃.mem (c.W + BitVec.ofNat 64 16) 16 :=
    bytesAt_keep Cr.frame (dC (by decide)) (by decide)
  obtain hG₄ : Spec.Gcm.blockAt s₄.mem (c.W + BitVec.ofNat 64 64) =
      GcmSiv.Words.hkeyOf (Spec.GcmSiv.ofBytes (bytesAt s₄.mem (c.W + BitVec.ofNat 64 16) 16)) := by
    rw [blockAt_frame Cr.frame (dC (by decide)), Ky.hkey, a₄]
  obtain hY₄ : Spec.Gcm.blockAt s₄.mem (c.W + BitVec.ofNat 64 80) = 0 := by
    rw [blockAt_frame Cr.frame (dC (by decide)), Ky.acc]
  -- What the pieces read.
  obtain hK₁ : Spec.GcmSiv.ctxCiph s₂.mem c.K c.R = Spec.GcmSiv.ctxCiph s.mem c.K c.R := by
    rw [ciph_keep fR' (buf_keep L.k_w (by decide)) hRb]
    unfold Spec.GcmSiv.ctxCiph
    rw [entry_buf En.frame (L.k_w.sub_left (Region.sub_prefix hRb)) (by omega_using [hRb])]
  obtain n₂ : bytesAt s₂.mem c.N 12 = bytesAt s.mem c.N 12 := by
    rw [bytesAt_keep fR' (buf_keep L.n_w (by decide)) (by decide), entry_buf En.frame L.n_w (by decide)]
  obtain n₄ : bytesAt s₄.mem c.N 12 = bytesAt s.mem c.N 12 := by
    rw [bytesAt_keep Cr.frame (buf_cryR L.n_w L.n_d) (by decide),
      bytesAt_keep fK (buf_keep L.n_w (by decide)) (by decide), n₂]
  obtain dN : ∀ r ∈ cryR c.W c.D c.n, (⟨nP c.W, 12⟩ : Region).Disjoint r := fun r hr => by
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
    rcases hr with rfl | rfl | rfl | rfl | rfl
    · exact L.w_w (.inr (by decide)) (by decide) (by decide)
    · exact L.w_w (.inr (by decide)) (by decide) (by decide)
    · exact L.w_w (.inr (by decide)) (by decide) (by decide)
    · exact L.w_w (.inl (by decide)) (by decide) (by decide)
    · exact (L.d_w' (by decide)).symm
  obtain e₄ : bytesAt s₄.mem (nP c.W) 12 = bytesAt s₃.mem (nP c.W) 12 := bytesAt_keep Cr.frame dN (by decide)
  obtain e₃ : bytesAt s₃.mem (nP c.W) 12 = bytesAt s₂.mem (nP c.W) 12 :=
    bytesAt_keep fK (w_keep L (d := 1520) (k := 12) (by decide) (by decide)) (by decide)
  obtain e₂ : bytesAt s₂.mem (nP c.W) 12 = bytesAt s₁.mem (nP c.W) 12 :=
    bytesAt_keep fR' (w_keep L (d := 1520) (k := 12) (by decide) (by decide)) (by decide)
  obtain nP₄ : bytesAt s₄.mem (nP c.W) 12 = bytesAt s₄.mem c.N 12 := by rw [e₄, e₃, e₂, En.nonce, n₄]
  -- POLYVAL of the plaintext and the tag input.
  refine WP.seq (WP.mono (polyval_wp L E₄ hG₄ hY₄ nP₄) fun s₅ Po => ?_)
  obtain E₅ := E₄.of_pk Po.pk
  -- Its tag at `W + 240`.
  refine WP.seq (WP.mono (tag_wp L E₅ (o := 240) (by decide)) fun s₆ Tg => ?_)
  obtain E₆ := E₅.of_pk Tg.pk
  -- The comparison.
  refine WP.seq (WP.mono (cmp_wp L E₆) fun s₇ ⟨pk₇, hm₇, s11₇⟩ => ?_)
  obtain E₇ := E₆.of_pk pk₇
  -- The mask.
  refine WP.seq (WP.mono (mask_wp L E₇ s11₇) fun s₈ ⟨pk₈, s11₈, hm₈⟩ => ?_)
  obtain E₈ := E₇.of_pk pk₈
  have fP := Po.frame
  have fT := Tg.frame
  rw [polyR_eq] at fP
  rw [tagR_eq] at fT
  obtain fM : Frame [⟨c.D, c.n⟩] s₇.mem s₈.mem := by
    rw [hm₈]
    exact VG.WriteBytes.writeBytes_frame _ _ _ (by
      rw [List.length_map, Proof.Cmac.bytesAt_length]; exact Region.contains_self _ _)
  obtain f₈ : Frame (mutR c) s₁.mem s₈.mem :=
    (((((fR'.sub (wRs_mut (by decide))).trans (fK.sub (wRs_mut (by decide)))).trans
      (Cr.frame.sub (cryR_mut c))).trans (fP.sub (wRsB_mut (by decide)))).trans
      (hm₇ ▸ fT.sub (wRs_mut (by decide)))).trans (fM.sub fun r hr => by
        simp only [List.mem_singleton] at hr; subst hr; exact sub_data)
  obtain pk₁₈ : PK s₁ s₈ := pk₂.trans (Ky.pk.trans (Cr.pk.trans (Po.pk.trans (Tg.pk.trans (pk₇.trans pk₈)))))
  -- The result, and `restore`.
  refine WP.block_append (wp_mv fun s₉ u₉ => WP.block_nil ?_)
  obtain sv₉ : SavedAt s₉.mem c.W s := by rw [u₉.mem]; exact saved_mut L f₈ En.saved
  obtain pk₁₉ : PK s₁ s₉ := pk₁₈.trans (PK.ofUpd u₉)
  obtain E₉ := E₈.of_pk (PK.ofUpd u₉)
  refine WP.mono (restore_ok E₉.s0 L.wal (exit_covers E₉) sv₉ (by rw [pk₁₉.sp, En.sp]))
    fun s' ⟨abi, hm, ha0, _, _⟩ => ⟨abi, ?_⟩
  obtain a₄' : bytesAt s₄.mem c.A c.al = bytesAt s.mem c.A c.al := by
    rw [bytesAt_keep Cr.frame (buf_cryR L.a_w L.a_d) (by omega_using [hal]),
      bytesAt_keep fK (buf_keep L.a_w (by decide)) (by omega_using [hal]),
      bytesAt_keep fR' (buf_keep L.a_w (by decide)) (by omega_using [hal]), entry_buf En.frame L.a_w (by omega_using [hal])]
  obtain d₃ : bytesAt s₃.mem c.D c.n = bytesAt s.mem c.D c.n := by
    rw [bytesAt_keep fK (buf_keep L.d_w (by decide)) (by omega_using [hn]),
      bytesAt_keep fR' (buf_keep L.d_w (by decide)) (by omega_using [hn]), entry_buf En.frame L.d_w (by omega_using [hn])]
  obtain tag₃ : bytesAt s₃.mem (c.W + BitVec.ofNat 64 0) 16 = bytesAt s.mem c.T 16 := by
    rw [bytesAt_keep fK (w_keep L (by decide) (by decide)) (by decide), BitVec.add_zero, hb₂,
      entry_buf En.frame L.t_w (by decide)]
  obtain tag₆ : bytesAt s₆.mem (c.W + BitVec.ofNat 64 0) 16 = bytesAt s.mem c.T 16 := by
    rw [bytesAt_keep fT (w_keep L (by decide) (by decide)) (by decide),
      bytesAt_keep fP (w_keepB L (by decide) (by decide)) (by decide),
      bytesAt_keep Cr.frame (dC (by decide)) (by decide), tag₃]
  rw [BitVec.add_zero] at tag₃ tag₆
  obtain ci₅ : Spec.GcmSiv.ctxCiph s₅.mem (c.W + BitVec.ofNat 64 256) c.R =
      Spec.GcmSiv.ctxCiph s₃.mem (c.W + BitVec.ofNat 64 256) c.R := by
    rw [ciph_keep fP (w_keepB L (by decide) (by decide)) hRb, ciph_cryR L Cr.frame]
  obtain d₇ : bytesAt s₇.mem c.D c.n = bytesAt s₄.mem c.D c.n := by
    rw [hm₇, bytesAt_keep fT (buf_keep L.d_w (by decide)) (by omega_using [hn]),
      bytesAt_keep fP (buf_keepB L.d_w L.b_d (by decide)) (by omega_using [hn])]
  have au := Ky.auth
  have ci := Ky.ciph
  rw [hK₁, e₂, En.nonce] at au ci
  have pt₄ := Cr.data
  rw [tag₃, d₃, ci] at pt₄
  have po := Po.out
  rw [a₄, ← au, n₄, a₄', pt₄] at po
  have tg := Tg.out
  rw [ci₅, ci, po] at tg
  obtain r3' : s'.gpr .a0 = s₇.gpr .s11 := by rw [ha0, u₉.gpr, s11₈]
  rw [s11₇, tag₆, tg] at r3'
  obtain md : bytesAt s'.mem c.D c.n = (bytesAt s₇.mem c.D c.n).map fun b =>
      if bytesAt s.mem c.T 16 = Spec.GcmSiv.ctxCiph s₅.mem (c.W + BitVec.ofNat 64 256) c.R
        (bytesAt s₅.mem (c.W + BitVec.ofNat 64 96) 16) then b else 0 := by
    obtain e := Proof.ChaCha20Poly1305.bytesAt_writeBytes_self s₇.mem c.D
      ((bytesAt s₇.mem c.D c.n).map fun b => if bytesAt s₆.mem c.W 16 =
        bytesAt s₆.mem (c.W + BitVec.ofNat 64 240) 16 then b else 0)
      (by rw [List.length_map, Proof.Cmac.bytesAt_length]; omega_using [hn])
    rw [List.length_map, Proof.Cmac.bytesAt_length, Proof.ChaCha20Poly1305.bytesAt_eq_aes] at e
    rw [hm, u₉.mem, hm₈, e, tag₆, Tg.out]
  rw [d₇, pt₄, ci₅, ci, po] at md
  rw [decrypt_eq hti]
  simp only
  generalize Spec.GcmSiv.deriveKeys (Spec.GcmSiv.ctxCiph s.mem c.K c.R) (Spec.GcmSiv.keyLen c.R)
    (bytesAt s.mem c.N 12) = dk at md r3'
  obtain hlen : (Spec.GcmSiv.ctr (Spec.GcmSiv.aes dk.2) (Spec.GcmSiv.initialCounter (bytesAt s.mem c.T 16))
      (bytesAt s.mem c.D c.n)).length = c.n := by
    rw [GcmSiv.length_ctr (Spec.GcmSiv.aes dk.2) (fun y => GcmSiv.aesWith_length _ _ y), Proof.Cmac.bytesAt_length]
  by_cases hc : Spec.GcmSiv.aes dk.2 (tagInputG dk.1 (bytesAt s.mem c.N 12)
      (Spec.GcmSiv.ctr (Spec.GcmSiv.aes dk.2) (Spec.GcmSiv.initialCounter (bytesAt s.mem c.T 16))
        (bytesAt s.mem c.D c.n)) (bytesAt s.mem c.A c.al)) = bytesAt s.mem c.T 16
  · rw [ite_eq_left_of_eq_true _ _ (eq_true hc)]
    have hc' := hc.symm
    unfold openOut
    refine ⟨?_, ?_⟩
    · rw [r3', ite_eq_left_of_eq_true _ _ (eq_true hc')]; rfl
    · rw [md]; simp only [ite_eq_left_of_eq_true _ _ (eq_true hc'), List.map_id']
  · rw [ite_eq_right_of_eq_false _ _ (eq_false hc)]
    obtain hc' : ¬bytesAt s.mem c.T 16 = Spec.GcmSiv.aes dk.2 (tagInputG dk.1 (bytesAt s.mem c.N 12)
        (Spec.GcmSiv.ctr (Spec.GcmSiv.aes dk.2) (Spec.GcmSiv.initialCounter (bytesAt s.mem c.T 16))
          (bytesAt s.mem c.D c.n)) (bytesAt s.mem c.A c.al)) := fun h => hc h.symm
    unfold openOut
    refine ⟨?_, ?_⟩
    · rw [r3', ite_eq_right_of_eq_false _ _ (eq_false hc')]; rfl
    · rw [md]; simp only [ite_eq_right_of_eq_false _ _ (eq_false hc'), List.map_const', hlen, Spec.GcmSiv.zeros]

/-- `vg_aes_gcm_siv_open`. -/
theorem open_wp [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) {s : State} (h : openRISCV64.pre s) :
    WP isa «open» s fun s' => abiPreserved s s' ∧ openRISCV64.post s s' := by
  obtain A := args_of_open h
  refine WP.mono (open_wp' hti A) fun s' ⟨ga, hp⟩ => ⟨ga, ?_⟩
  simp only [openRISCV64]
  simpa only [cxOf] using hp

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-!
# AES-GCM-SIV on RISC-V: constant time

Untrusted: everything here is checked by Lean. As on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Verified.lean`): two runs with the same public
arguments have the same public values (`args_two`). The entry loads `work`
from the stack, which the taint analysis takes as secret (it reads memory):
the block is split after the load, and the rest runs from `t1`, which holds
`work` in both runs, and the arguments (`entry_rel`). The keys, POLYVAL, the
tag and counter mode are related by `KeysCT.lean`, `PolyCT.lean` and
`CryptCT.lean`, the code between them by the taint analysis (`seal_rel`,
`open_rel`). `open` compares the tags and masks the plaintext without a
branch: whether it succeeds is not leaked.
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.Impl.AesGcmSiv.RISCV64 VG.RISCV64
open VG.RISCV64.Steps (wp_addSp wp_ld)
open VG.Proof.Gather.RISCV64 (Eq2 TT rel_taint ct_of)
open VG.Proof.AesGcm.RISCV64 (in_off)
open VG.Proof.AesCcm.RISCV64 (Runs Runs.of_wp rel_seqR)
open VG.Spec.Aes (bytesAt)

/-- Two runs with the same public arguments: both from the public values of
the first. -/
theorem args_two {σ₁ σ₂ : State} (A₂ : Args (cxOf σ₂) σ₂) (hq : onePub σ₁ σ₂) : Args (cxOf σ₁) σ₂ := by
  obtain ⟨q0, q1, q2, q3, q4, q5, q6, q7, qs, qa⟩ := hq
  obtain hcx : cxOf σ₂ = cxOf σ₁ := by simp only [cxOf, q0, q1, q2, q3, q4, q5, q6, q7, qs, qa]
  rw [hcx] at A₂
  exact A₂

/-- The arguments' registers. -/
abbrev inRegs : List Reg := [.a0, .a1, .a2, .a3, .a4, .a5, .a6, .a7]

theorem Args.agree {c : Cx} {σ₁ σ₂ : State} (A₁ : Args c σ₁) (A₂ : Args c σ₂) :
    ∀ r ∈ inRegs, σ₁.gpr r = σ₂.gpr r := by
  intro r hr
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
  rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · rw [A₁.a0, A₂.a0]
  · rw [A₁.a1, A₂.a1]
  · rw [A₁.a2, A₂.a2]
  · rw [A₁.a3, A₂.a3]
  · rw [A₁.a4, A₂.a4]
  · rw [A₁.a5, A₂.a5]
  · rw [A₁.a6, A₂.a6]
  · rw [A₁.a7, A₂.a7]

/-- `work` loaded. -/
theorem entryLd_wp {c : Cx} {s : State} (Ar : Args c s) :
    WP isa (.block [.addSp .t1 0, .load .d .t1 .t1 0]) s fun s' =>
      s'.gpr .t1 = c.W ∧ (∀ r, r ≠ .t1 → s'.gpr r = s.gpr r) ∧ s'.sp = s.sp := by
  have L := Ar.lay
  refine wp_addSp (imm := 0) (by decide) fun s₁ u₁ => ?_
  refine wp_ld (a := stackArgAddr s 0) (by decide) (by rw [u₁.gpr, stackArgAddr, Nat.mul_zero, BitVec.add_zero, BitVec.add_zero])
    (by rw [stackArgAddr, Ar.sp]; exact Spill.al8 (by have := L.spal; omega_using [this]) (by decide))
    (by rw [u₁.rd, u₁.wr]; simpa using in_off Ar.argsC (d := 0) (n := 8) (by decide) (by decide))
    fun s₂ u₂ => WP.block_nil ⟨by rw [u₂.gpr, u₁.mem, ← Ar.w]; rfl,
      fun r hr => by rw [u₂.other _ hr, u₁.other _ hr], by rw [u₂.sp, u₁.sp]⟩

/-- The entry in two runs. -/
theorem entry_rel {c : Cx} {σ₁ σ₂ : State} (A₁ : Args c σ₁) (A₂ : Args c σ₂) (hsp : σ₁.sp = σ₂.sp) :
    RelCT isa (Eq2 σ₁ σ₂) (.block entry) TT := by
  have e : entry = [.addSp .t1 0, .load .d .t1 .t1 0] ++ entry.drop 2 := rfl
  rw [e]
  refine RelCT.block_append (rel_seqR (rel_taint [] hsp (by simp) (by taint_decide))
    (Runs.of_wp (entryLd_wp A₁)) (Runs.of_wp (entryLd_wp A₂)) fun τ₁ τ₂ ⟨a₁, b₁, c₁⟩ ⟨a₂, b₂, c₂⟩ => ?_)
  refine rel_taint (.t1 :: inRegs) (by rw [c₁, c₂, hsp]) (fun r hr => ?_) (by taint_decide)
  rcases List.mem_cons.mp hr with rfl | hr
  · rw [a₁, a₂]
  · have h : r ≠ .t1 := by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> decide
    rw [b₁ r h, b₂ r h, A₁.agree A₂ r hr]

/-- The nonce's copy, after the entry and the keys. -/
theorem nP_keys {c : Cx} {s s₁ s₂ : State} (Ar : Args c s) (En : Entered c s s₁) (K : KeysPost c s₁ s₂) :
    bytesAt s₂.mem (nP c.W) 12 = bytesAt s₂.mem c.N 12 := by
  have L := Ar.lay
  have fK := K.frame
  rw [keyR_eq] at fK
  rw [bytesAt_keep (P := nP c.W) fK (w_keep L (d := 1520) (k := 12) (by decide) (by decide)) (by decide),
    bytesAt_keep fK (buf_keep L.n_w (by decide)) (by decide), En.nonce, entry_buf En.frame L.n_w (by decide)]

/-- `vg_aes_gcm_siv_seal` in two runs. -/
theorem seal_rel [VG.Proof.Gcm.RISCV64.GhashLaw] {c : Cx} {σ₁ σ₂ : State} (A₁ : Args c σ₁) (A₂ : Args c σ₂) (hsp : σ₁.sp = σ₂.sp) :
    RelCT isa (Eq2 σ₁ σ₂) «seal» TT := by
  have L := A₁.lay
  unfold «seal»
  refine rel_seqR (entry_rel A₁ A₂ hsp) (Runs.of_wp (entry_wp A₁)) (Runs.of_wp (entry_wp A₂))
    fun s₁ t₁ En En' => ?_
  obtain h₁ : s₁.sp = t₁.sp := by rw [En.sp, En'.sp, hsp]
  refine rel_seqR (keys_rel L En.env En'.env h₁) (Runs.of_wp (keys_wp L En.env))
    (Runs.of_wp (keys_wp L En'.env)) fun s₂ t₂ K K' => ?_
  obtain E₂ := En.env.of_pk K.pk
  obtain E₂' := En'.env.of_pk K'.pk
  obtain h₂ : s₂.sp = t₂.sp := by rw [K.pk.sp, K'.pk.sp, h₁]
  refine rel_seqR (polyval_rel L E₂ E₂' h₂) (Runs.of_wp (polyval_wp L E₂ K.hkey K.acc (nP_keys A₁ En K)))
    (Runs.of_wp (polyval_wp L E₂' K'.hkey K'.acc (nP_keys A₂ En' K'))) fun s₃ t₃ P P' => ?_
  obtain E₃ := E₂.of_pk P.pk
  obtain E₃' := E₂'.of_pk P'.pk
  obtain h₃ : s₃.sp = t₃.sp := by rw [P.pk.sp, P'.pk.sp, h₂]
  refine rel_seqR (tag_rel L E₃ E₃' h₃ (o := 0) (.inl rfl)) (Runs.of_wp (tag_wp L E₃ (o := 0) (.inl rfl)))
    (Runs.of_wp (tag_wp L E₃' (o := 0) (.inl rfl))) fun s₄ t₄ T T' => ?_
  obtain E₄ := E₃.of_pk T.pk
  obtain E₄' := E₃'.of_pk T'.pk
  obtain h₄ : s₄.sp = t₄.sp := by rw [T.pk.sp, T'.pk.sp, h₃]
  refine rel_seqR (crypt_rel L E₄ E₄' h₄) (Runs.of_wp (crypt_wp L E₄)) (Runs.of_wp (crypt_wp L E₄'))
    fun s₅ t₅ C C' => ?_
  exact rel_env [] (E₄.of_pk C.pk) (E₄'.of_pk C'.pk) (by rw [C.pk.sp, C'.pk.sp, h₄]) (by simp) ⟨_, by taint_decide⟩

/-- `vg_aes_gcm_siv_open` in two runs. -/
theorem open_rel [VG.Proof.Gcm.RISCV64.GhashLaw] {c : Cx} {σ₁ σ₂ : State} (A₁ : Args c σ₁) (A₂ : Args c σ₂) (hsp : σ₁.sp = σ₂.sp) :
    RelCT isa (Eq2 σ₁ σ₂) «open» TT := by
  have L := A₁.lay
  unfold «open»
  refine rel_seqR (entry_rel A₁ A₂ hsp) (Runs.of_wp (entry_wp A₁)) (Runs.of_wp (entry_wp A₂))
    fun s₁ t₁ En En' => ?_
  obtain h₁ : s₁.sp = t₁.sp := by rw [En.sp, En'.sp, hsp]
  refine rel_seqR (rel_env [] En.env En'.env h₁ (by simp) ⟨_, by taint_decide⟩) (Runs.of_wp (recv_wp L En.env))
    (Runs.of_wp (recv_wp L En'.env)) fun s₂ t₂ R R' => ?_
  obtain E₂ := En.env.of_pk R.1
  obtain E₂' := En'.env.of_pk R'.1
  obtain h₂ : s₂.sp = t₂.sp := by rw [R.1.sp, R'.1.sp, h₁]
  refine rel_seqR (keys_rel L E₂ E₂' h₂) (Runs.of_wp (keys_wp L E₂)) (Runs.of_wp (keys_wp L E₂'))
    fun s₃ t₃ K K' => ?_
  obtain E₃ := E₂.of_pk K.pk
  obtain E₃' := E₂'.of_pk K'.pk
  obtain h₃ : s₃.sp = t₃.sp := by rw [K.pk.sp, K'.pk.sp, h₂]
  refine rel_seqR (crypt_rel L E₃ E₃' h₃) (Runs.of_wp (crypt_wp L E₃)) (Runs.of_wp (crypt_wp L E₃'))
    fun s₄ t₄ C C' => ?_
  obtain E₄ := E₃.of_pk C.pk
  obtain E₄' := E₃'.of_pk C'.pk
  obtain h₄ : s₄.sp = t₄.sp := by rw [C.pk.sp, C'.pk.sp, h₃]
  -- What POLYVAL needs: the key as the keys left it, and the nonce's copy.
  obtain hP : ∀ {s s₁ s₂ s₃ s₄ : State}, Args c s → Entered c s s₁ →
      (PK s₁ s₂ ∧ bytesAt s₂.mem c.W 16 = bytesAt s₁.mem c.T 16 ∧ Frame [⟨c.W, 16⟩] s₁.mem s₂.mem) →
      KeysPost c s₂ s₃ → CryptPost c s₃ s₄ →
      Spec.Gcm.blockAt s₄.mem (c.W + BitVec.ofNat 64 64) =
        GcmSiv.Words.hkeyOf (Spec.GcmSiv.ofBytes (bytesAt s₄.mem (c.W + BitVec.ofNat 64 16) 16)) ∧
      Spec.Gcm.blockAt s₄.mem (c.W + BitVec.ofNat 64 80) = 0 ∧
      bytesAt s₄.mem (nP c.W) 12 = bytesAt s₄.mem c.N 12 := fun {s s₁ s₂ s₃ s₄} Ar En R K C => by
    obtain dC : ∀ {d : Nat}, d + 16 ≤ 96 → ∀ r ∈ cryR c.W c.D c.n,
        (⟨c.W + BitVec.ofNat 64 d, 16⟩ : Region).Disjoint r := fun hd r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact L.w_w (.inl (by omega_using [hd])) (by omega_using [hd]) (by decide)
      · exact (L.d_w' (by omega_using [hd])).symm
    obtain dN : ∀ r ∈ cryR c.W c.D c.n, (⟨nP c.W, 12⟩ : Region).Disjoint r := fun r hr => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hr
      rcases hr with rfl | rfl | rfl | rfl | rfl
      · exact L.w_w (.inr (by decide)) (by decide) (by decide)
      · exact L.w_w (.inr (by decide)) (by decide) (by decide)
      · exact L.w_w (.inr (by decide)) (by decide) (by decide)
      · exact L.w_w (.inl (by decide)) (by decide) (by decide)
      · exact (L.d_w' (by decide)).symm
    obtain a₄ : bytesAt s₄.mem (c.W + BitVec.ofNat 64 16) 16 = bytesAt s₃.mem (c.W + BitVec.ofNat 64 16) 16 :=
      bytesAt_keep C.frame (dC (by decide)) (by decide)
    have fK := K.frame
    rw [keyR_eq] at fK
    obtain fR : Frame (wRs c.W [(0, 16)]) s₁.mem s₂.mem := by
      simp only [wRs, List.map_cons, List.map_nil, BitVec.add_zero]; exact R.2.2
    refine ⟨by rw [blockAt_frame C.frame (dC (by decide)), K.hkey, a₄],
      by rw [blockAt_frame C.frame (dC (by decide)), K.acc], ?_⟩
    rw [bytesAt_keep (P := nP c.W) C.frame dN (by decide),
      bytesAt_keep (P := nP c.W) fK (w_keep L (d := 1520) (k := 12) (by decide) (by decide)) (by decide),
      bytesAt_keep (P := nP c.W) fR (w_keep L (d := 1520) (k := 12) (by decide) (by decide)) (by decide), En.nonce,
      bytesAt_keep C.frame (buf_cryR L.n_w L.n_d) (by decide),
      bytesAt_keep fK (buf_keep L.n_w (by decide)) (by decide),
      bytesAt_keep fR (buf_keep L.n_w (by decide)) (by decide), entry_buf En.frame L.n_w (by decide)]
  obtain Q := hP A₁ En R K C
  obtain Q' := hP A₂ En' R' K' C'
  refine rel_seqR (polyval_rel L E₄ E₄' h₄) (Runs.of_wp (polyval_wp L E₄ Q.1 Q.2.1 Q.2.2))
    (Runs.of_wp (polyval_wp L E₄' Q'.1 Q'.2.1 Q'.2.2)) fun s₅ t₅ P P' => ?_
  obtain E₅ := E₄.of_pk P.pk
  obtain E₅' := E₄'.of_pk P'.pk
  obtain h₅ : s₅.sp = t₅.sp := by rw [P.pk.sp, P'.pk.sp, h₄]
  refine rel_seqR (tag_rel L E₅ E₅' h₅ (o := 240) (.inr rfl)) (Runs.of_wp (tag_wp L E₅ (o := 240) (.inr rfl)))
    (Runs.of_wp (tag_wp L E₅' (o := 240) (.inr rfl))) fun s₆ t₆ T T' => ?_
  exact rel_env [] (E₅.of_pk T.pk) (E₅'.of_pk T'.pk) (by rw [T.pk.sp, T'.pk.sp, h₅]) (by simp) ⟨_, by taint_decide⟩

theorem seal_ct [VG.Proof.Gcm.RISCV64.GhashLaw] : ConstantTime isa sealRISCV64.pre sealRISCV64.pub «seal» :=
  ct_of fun _ _ h₁ h₂ hq => seal_rel (args_of_seal h₁).1 (args_two (args_of_seal h₂).1 hq) hq.2.2.2.2.2.2.2.2.1

theorem open_ct [VG.Proof.Gcm.RISCV64.GhashLaw] : ConstantTime isa openRISCV64.pre openRISCV64.pub «open» :=
  ct_of fun _ _ h₁ h₂ hq => open_rel (args_of_open h₁) (args_two (args_of_open h₂) hq) hq.2.2.2.2.2.2.2.2.1

end VG.Proof.AesGcmSiv.RISCV64

end

end

/-!
# AES-GCM-SIV on RISC-V: `Verified`

Untrusted: everything here is checked by Lean. As on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Verified.lean`): correctness and constant time,
given that the tag input computed with GHASH is the RFC's (`TagInputEq`,
which the registration file binds to
`Proof.GcmSiv.Polyval.tagInput_eq_tagInputG`), a state satisfying each
precondition, and the shared contracts of `Spec/GcmSiv/Contract.lean` with
the working space as a last argument (`Proof/AesGcmSiv/Scratch.lean`, 480
doublewords) and the 2048 bytes of stack `vg_ghash`'s frame takes. Then the
code in a frame that allocates the working space
(`Verified.stackScratchArgs`): it is the one stack argument, so the frame of
3856 bytes holds its address and the working space.
-/

@[expose] public section

namespace VG.Proof.AesGcmSiv.RISCV64

open VG VG.RISCV64 VG.Impl.AesGcmSiv.RISCV64
open VG.Proof.AesGcm.RISCV64 (stkOk stkAll)

/-! ## Correctness and constant time -/

theorem seal_correct [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) (s : State) (hs : sealRISCV64.pre s) :
    ∃ t s', Exec isa «seal» s t s' ∧ abiPreserved s s' ∧ sealRISCV64.post s s' :=
  seal_wp hti hs

theorem open_correct [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) (s : State) (hs : openRISCV64.pre s) :
    ∃ t s', Exec isa «open» s t s' ∧ abiPreserved s s' ∧ openRISCV64.post s s' :=
  open_wp hti hs

/-- A state satisfying the precondition of `vg_aes_gcm_siv_seal`: no
additional data, no data, the tag at `0x5000` and `work` at `0x6000`, its
address at `sp`. -/
def sealSat : State where
  gpr r := match r with
    | .a0 => 0x1000 | .a1 => 10 | .a2 => 0x2000 | .a3 => 0x3000 | .a5 => 0x4000 | .a7 => 0x5000 | _ => 0
  sp := 0x9000
  mem a := bif Nat.beq a.toNat 0x9001 then 0x60 else 0
  rd := [⟨0x1000, 240⟩, ⟨0x2000, 12⟩, ⟨0x3000, 0⟩, ⟨0x9000, 8⟩]
  wr := [⟨0x4000, 0⟩, ⟨0x5000, 16⟩, ⟨0x6000, 3840⟩]

/-- A state satisfying the precondition of `vg_aes_gcm_siv_open`: as
`sealSat`, with the tag read only. -/
def openSat : State :=
  { sealSat with rd := [⟨0x1000, 240⟩, ⟨0x2000, 12⟩, ⟨0x3000, 0⟩, ⟨0x5000, 16⟩, ⟨0x9000, 8⟩],
                 wr := [⟨0x4000, 0⟩, ⟨0x6000, 3840⟩] }

/-! ## The shared contracts -/

theorem seal_verified [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) :
    Verified RISCV64.target «seal» (Proof.AesGcmSiv.sealScratchContract RISCV64.abi 480 2048) :=
  Verified.of_correct (seal_correct hti) seal_ct
      { pre := by
          intro s h
          sig_pre [Proof.AesGcmSiv.sealScratchContract, Proof.AesGcmSiv.sealScratchSig, Spec.GcmSiv.sealPre,
            Proof.AesGcmSiv.sealRoundsPost, sealRISCV64, sealPre, oneLay, onePub, args, rounds, RISCV64.abi,
            RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range,
            List.range.loop] at h
          sig_split h
          sig_reduce [Proof.AesGcmSiv.sealScratchContract, Proof.AesGcmSiv.sealScratchSig, Spec.GcmSiv.sealPre,
            Proof.AesGcmSiv.sealRoundsPost, sealRISCV64, sealPre, oneLay, onePub, args, rounds, RISCV64.abi,
            RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range,
            List.range.loop]
          sig_and_intros
          sig_close
          all_goals first
            | with_reducible assumption
            | sig_disjoint_symm
            | omega
            | bv_omega
        post := by
          sig_implies_post [Proof.AesGcmSiv.sealScratchContract, Proof.AesGcmSiv.sealScratchSig,
            Spec.GcmSiv.sealPre, Proof.AesGcmSiv.sealRoundsPost, sealRISCV64, sealPre, oneLay, onePub, args, rounds,
            RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range,
            List.range.loop]
        pub := by
          sig_implies_pub [Proof.AesGcmSiv.sealScratchContract, Proof.AesGcmSiv.sealScratchSig,
            Spec.GcmSiv.sealPre, Proof.AesGcmSiv.sealRoundsPost, sealRISCV64, sealPre, oneLay, onePub, args, rounds,
            RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range,
            List.range.loop]
        sat := by
          sig_implies_sat [Proof.AesGcmSiv.sealScratchContract, Proof.AesGcmSiv.sealScratchSig,
            Spec.GcmSiv.sealPre, Proof.AesGcmSiv.sealRoundsPost, sealRISCV64, sealPre, oneLay, onePub, args, rounds,
            RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range,
            List.range.loop]
            [sealSat, stackArg, stackArgAddr, Mem.readW, Mem.read] using sealSat }

theorem open_verified [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) :
    Verified RISCV64.target «open» (Proof.AesGcmSiv.openScratchContract RISCV64.abi 480 2048) :=
  Verified.of_correct (open_correct hti) open_ct
      { pre := by
          intro s h
          sig_pre [Proof.AesGcmSiv.openScratchContract, Proof.AesGcmSiv.openScratchSig, Spec.GcmSiv.openPre,
            Proof.AesGcmSiv.openRoundsPost, Spec.GcmSiv.openLeak, openRISCV64, openPre, oneLay, onePub, openRes, openOut,
            args, rounds, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD,
            List.range, List.range.loop] at h
          sig_split h
          sig_reduce [Proof.AesGcmSiv.openScratchContract, Proof.AesGcmSiv.openScratchSig, Spec.GcmSiv.openPre,
            Proof.AesGcmSiv.openRoundsPost, Spec.GcmSiv.openLeak, openRISCV64, openPre, oneLay, onePub, openRes, openOut,
            args, rounds, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD,
            List.range, List.range.loop]
          sig_and_intros
          sig_close
          all_goals first
            | with_reducible assumption
            | sig_disjoint_symm
            | omega
            | bv_omega
        -- `h` and the goal match on the same outcome of `decryptWith` with
        -- different matchers (`openOut`'s and `openContract`'s): split on it
        -- rather than have `exact h` unfold both to unify them.
        post := by
          intro s s' _ h
          sig_post [Proof.AesGcmSiv.openScratchContract, Proof.AesGcmSiv.openScratchSig, Spec.GcmSiv.openPre,
            Proof.AesGcmSiv.openRoundsPost, Spec.GcmSiv.openLeak, openRISCV64, openPre, oneLay, onePub, openRes,
            args, rounds, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD,
            List.range, List.range.loop]
          sig_reduce [Proof.AesGcmSiv.openScratchContract, Proof.AesGcmSiv.openScratchSig, Spec.GcmSiv.openPre,
            Proof.AesGcmSiv.openRoundsPost, Spec.GcmSiv.openLeak, openRISCV64, openPre, oneLay, onePub, openRes,
            args, rounds, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD,
            List.range, List.range.loop] at h
          intro _
          unfold openOut at h
          split at h <;> rename_i heq <;> rw [heq] <;> exact h
        pub := by
          sig_implies_pub [Proof.AesGcmSiv.openScratchContract, Proof.AesGcmSiv.openScratchSig,
            Spec.GcmSiv.openPre, Proof.AesGcmSiv.openRoundsPost, Spec.GcmSiv.openLeak, openRISCV64, openPre, oneLay,
            onePub, openRes, openOut, args, rounds, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg,
            RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range, List.range.loop]
        sat := by
          sig_implies_sat [Proof.AesGcmSiv.openScratchContract, Proof.AesGcmSiv.openScratchSig,
            Spec.GcmSiv.openPre, Proof.AesGcmSiv.openRoundsPost, Spec.GcmSiv.openLeak, openRISCV64, openPre, oneLay,
            onePub, openRes, openOut, args, rounds, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg,
            RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range, List.range.loop]
            [openSat, sealSat, stackArg, stackArgAddr, Mem.readW, Mem.read] using openSat }

/-! ## The working space on the stack -/

/-- A state satisfying `vg_aes_gcm_siv_seal`'s precondition, without the
working space: no stack arguments. -/
def sealFrameSat : State :=
  { sealSat with rd := [⟨0x1000, 240⟩, ⟨0x2000, 12⟩, ⟨0x3000, 0⟩], wr := [⟨0x4000, 0⟩, ⟨0x5000, 16⟩] }

theorem sealFrameSat_pre : ∃ s, (Proof.AesGcmSiv.sealRoundsContract RISCV64.abi 5904).pre s := by
  implies_sat [Proof.AesGcmSiv.sealRoundsContract, Spec.GcmSiv.sealSig, Spec.GcmSiv.sealPre, Proof.AesGcmSiv.sealRoundsPost,
    RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr, stackBelow, stkOk, stkAll, and_true, List.getD, List.range,
    List.range.loop] [sealFrameSat, sealSat, stackArg, stackArgAddr, Mem.readW, Mem.read]
    using sealFrameSat

theorem seal_framed [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) :
    Verified RISCV64.target (Impl.StackScratch.RISCV64.withStackScratchArgs 3856 0 «seal»)
      (Proof.AesGcmSiv.sealRoundsContract RISCV64.abi 5904) :=
  RISCV64.Verified.stackScratchArgs (sig := Spec.GcmSiv.sealSig) (nm := "work") (e := .u64)
    (n := 480) (pre := Spec.GcmSiv.sealPre RISCV64.abi.ptrBits)
    (post := Proof.AesGcmSiv.sealRoundsPost RISCV64.abi.ptrBits) (wa := true) (stack := 2048) (bytes := 3856) (m := 0)
    (seal_verified hti) (by decide) (by decide) (Proof.AesGcmSiv.sealPre_local _) (Proof.AesGcmSiv.sealPost_local _)
    (fun vs m m₁ m₂ r hl _ => Proof.AesGcmSiv.sealPostOut_local _ vs m m₁ m₂ r hl)
    sealFrameSat_pre

/-- A state satisfying `vg_aes_gcm_siv_open`'s precondition, without the
working space: no stack arguments. -/
def openFrameSat : State :=
  { sealSat with rd := [⟨0x1000, 240⟩, ⟨0x2000, 12⟩, ⟨0x3000, 0⟩, ⟨0x5000, 16⟩], wr := [⟨0x4000, 0⟩] }

theorem openFrameSat_pre : ∃ s, (Proof.AesGcmSiv.openRoundsContract RISCV64.abi 5904).pre s := by
  implies_sat [Proof.AesGcmSiv.openRoundsContract, Spec.GcmSiv.openSig, Spec.GcmSiv.openPre, Proof.AesGcmSiv.openRoundsPost,
    Spec.GcmSiv.openLeak, RISCV64.abi, RISCV64.argRegs, RISCV64.stackArg, RISCV64.stackArgAddr,
    List.getD, List.range, List.range.loop] [openFrameSat, sealSat, stackArg, stackArgAddr,
    Mem.readW, Mem.read] using openFrameSat

theorem open_framed [VG.Proof.Gcm.RISCV64.GhashLaw] (hti : TagInputEq) :
    Verified RISCV64.target (Impl.StackScratch.RISCV64.withStackScratchArgs 3856 0 «open»)
      (Proof.AesGcmSiv.openRoundsContract RISCV64.abi 5904) :=
  RISCV64.Verified.stackScratchArgs (sig := Spec.GcmSiv.openSig) (nm := "work") (e := .u64)
    (n := 480) (pre := Spec.GcmSiv.openPre RISCV64.abi.ptrBits)
    (post := Proof.AesGcmSiv.openRoundsPost RISCV64.abi.ptrBits) (wa := true) (stack := 2048) (bytes := 3856) (m := 0)
    (leak := some (Spec.GcmSiv.openLeak RISCV64.abi.ptrBits))
    (Proof.AesGcmSiv.Verified.of_openScratch (open_verified hti)) (by decide) (by decide)
    (Proof.AesGcmSiv.openPre_local _) (Proof.AesGcmSiv.openPost_local _)
    (fun vs m m₁ m₂ r hl _ => Proof.AesGcmSiv.openPostOut_local _ vs m m₁ m₂ r hl)
    openFrameSat_pre (hleak := Proof.AesGcmSiv.openLeak_local _)

end VG.Proof.AesGcmSiv.RISCV64

/-! ## AES-GCM-SIV on RISC-V, without secret residue

`vg_aes_gcm_siv_seal` and `vg_aes_gcm_siv_open`, each followed by
`Impl.Scrub.RISCV64.scrubTail` (`RISCV64.Scrub.verifiedScrubbedAll`), which clears the
caller-saved registers and all 5904 bytes of stack their frames and callees
use, the derived keys among them: the residue analysis (`RISCV64.rtaint`)
finds that all but the deepest 400 may hold secrets. Their postconditions
read the memory on return only within the data and the tag, as on PPC64LE
(`Proof/AesGcmSiv/PPC64LE/Scrub.lean`). The registrations take the law of
GHASH and the equation of POLYVAL's input with GHASH's, as `seal_framed`
does, from the registration file. -/

namespace VG.Proof.AesGcmSiv.RISCV64.Scrub

open VG.RISCV64 VG.RISCV64.Scrub VG.Proof.Aes.ScrubLocal VG.Proof.AesGcmSiv.RISCV64

theorem sealOut (stack : Nat) :
    PostOut (Spec.GcmSiv.sealContract RISCV64.abi stack) (Spec.GcmSiv.sealSig.retBits 64) :=
  postOut_of_local (leak := none) ScrubAbi.plain fun vs m m₁ m₂ r hlen hb h => by
    match vs, hlen with

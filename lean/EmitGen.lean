import VerifiedGarbage.TCB.Emit

/-!
# Prototype: the emitter's drivers and audits as Lake modules

Writes, under `.lake/emit/src` (the library `VGEmit`, `lakefile.toml`), for
each target directory (`VG.Emit.parts`):

* `VGEmit/Driver/<Target>.lean`, a module defining `VG.Emit.<Target>.all`,
  the target's artifacts, importing each registration, generic and variant
  module both ways (`public import` for `all`'s statement, `public meta
  import` for the IR that running it needs);
* `VGEmit/Audit/<Target>.lean`, a file that is not a module, importing the
  driver and running the three audits on that same `all` (and on the legacy
  list of `Artifacts.lean`, which no module can import).

`lake build VGEmit` then audits each target once per change to what it
imports, and caches the result. Run from `lean/`:
`lake env lean --run EmitGen.lean`. A file whose text is unchanged is not
rewritten.
-/

open System

/-- The registration, generic and variant modules of `mods`, `gens`, `vars`. -/
def importsOf (mods : List String) (gens : List (List String × List String))
    (vars : List (String × List String)) : List String :=
  mods ++ gens.flatMap (·.2) ++ vars.flatMap (·.2)

/-- The driver module of target `t`. -/
def driverText (t : String) (mods : List String) (gens : List (List String × List String))
    (vars : List (String × List String)) : String :=
  let groups := gens.map fun (is, gs) =>
    (gs, is.map fun i => ((vars.find? (·.1 == i)).map (·.2)).getD [])
  "-- Generated by EmitGen.lean. DO NOT EDIT.\n" ++
  "module\n\n" ++
  "public import VerifiedGarbage.TCB.Emit\n" ++
  "public meta import VerifiedGarbage.TCB.Emit\n" ++
  String.join ((importsOf mods gens vars).map fun m =>
    s!"public import {m}\npublic meta import {m}\n") ++
  "\n@[expose] public section\n\n" ++
  s!"namespace VG.Emit.{t}\n\n" ++
  "def all : List Artifact := List.flatten [\n" ++
  String.join (mods.map fun m => s!"  {VG.Emit.listOf m},\n") ++
  String.join (groups.map fun (gs, vs) => s!"  {VG.Emit.instances gs vs},\n") ++
  "  []]\n\n" ++
  s!"end VG.Emit.{t}\n"

/-- The audit file of target `t`. -/
def auditText (t : String) : String :=
  "-- Generated by EmitGen.lean. DO NOT EDIT.\n" ++
  "import VerifiedGarbage.TCB.Audit\n" ++
  "import VerifiedGarbage.TCB.Axioms\n" ++
  "import VerifiedGarbage.Artifacts\n" ++
  s!"import VGEmit.Driver.{t}\n\n" ++
  s!"#assert_standard_axioms VG.Emit.{t}.all\n" ++
  "#assert_standard_axioms VG.artifacts\n" ++
  s!"#assert_no_compiler_overrides VG.Emit.{t}.all VG.artifacts VG.Emit.run\n" ++
  "#assert_spec_origin\n"

def writeIfChanged (path : FilePath) (text : String) : IO Unit := do
  if ← path.pathExists then
    if (← IO.FS.readFile path) == text then return
  if let some d := path.parent then IO.FS.createDirAll d
  IO.FS.writeFile path text
  IO.println s!"wrote {path}"

def main : IO UInt32 := do
  let parts ← match VG.Emit.parts (← VG.Emit.registrations)
      (← VG.Emit.genericGroups VG.Emit.genericDir) (← VG.Emit.grouped VG.Emit.variantDir) with
    | .ok parts => pure parts
    | .error e => do IO.eprintln e; return 1
  let root : FilePath := ".lake" / "emit" / "src" / "VGEmit"
  for (t, mods, gens, vars) in parts do
    writeIfChanged (root / "Driver" / s!"{t}.lean") (driverText t mods gens vars)
    writeIfChanged (root / "Audit" / s!"{t}.lean") (auditText t)
  return 0

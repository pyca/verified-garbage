def chiMix (n : Nat) : List Instr := match n with
 | 5 => chi5 | 10 => chi10 | 15 => chi15 | 20 => chi20 | 25 => chi25 | _ => chi0
def rounds (n : Nat) : List Instr := (List.range 24).flatMap fun r =>
 constant (Spec.Sha3.RC r) ++ theta.map Op.instr ++ rhoPi.map Op.instr ++ chiMix n ++ iota
def wrapper (n : Nat) : Prog isa := .block <|
 (List.range 8).map (fun i => .strq (vreg (8+i)) .x1 (16*i)) ++
 VG.Impl.Sha3.AArch64.Neon.Pair.load .x0 ++ rounds n ++
 VG.Impl.Sha3.AArch64.Neon.Pair.store .x0 ++
 (List.range 8).map (fun i => .ldrq (vreg (8+i)) .x1 (16*i))
end WindowKeccakMix

def main : IO Unit := do
 for n in [0,5,10,15,20,25] do
  IO.FS.writeFile ("/tmp/vg-window-keccak-mix"++toString n++".body") (String.join ((printer.function (.block (WindowKeccakMix.rounds n))).map (Rust.line printer.call)))
  IO.FS.writeFile ("/tmp/vg-window-keccak-mix"++toString n++"-wrapper.body") (String.join ((printer.function (WindowKeccakMix.wrapper n)).map (Rust.line printer.call)))

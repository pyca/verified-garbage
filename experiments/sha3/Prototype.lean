def tableInit : List Instr := (List.range 24).flatMap fun r =>
 constant (VG.Spec.Sha3.RC r) ++ [.str .x .x16 .x1 (128+8*r)]
def counted (unroll : Nat) : Prog isa :=
 .seq (.block (tableInit ++ [.addImm .x .x9 .x1 128, .movz .x .x8 24 0]))
 (.loop (.block ((List.range unroll).flatMap (fun _ =>
   (theta ++ rhoPi ++ chi).map Op.instr ++ [.ldr .x .x16 .x9 0, .addImm .x .x9 .x9 8] ++ iota) ++
   [.subImm .x .x8 .x8 unroll])) (.nonzero .x .x8))
def emitFunction (name : String) (p : Prog isa) (apple : Bool) : String :=
 let symbolPrefix := if apple then "_" else ""
 ".p2align 6\n.globl " ++ symbolPrefix ++ name ++ "\n" ++ symbolPrefix ++ name ++ ":\n" ++
 String.intercalate "\n" ((printer.function p).map fun l => match l with
 | .text s => s | .call n => "bl " ++ symbolPrefix ++ n
 | .sym .. => "UNEXPECTED_SYMBOL") ++ "\n"
def wrap (p : Prog isa) : Prog isa :=
 .seq (.block (save ++ load)) (.seq p (.block (store ++ restore)))
